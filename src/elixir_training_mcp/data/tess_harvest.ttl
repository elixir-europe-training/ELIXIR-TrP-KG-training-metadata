<https://tess.elixir-europe.org/events/introduction-to-hpc-for-life-scientists> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """High-performance computing (HPC) is a fundamental technology used to solve a wide range of scientific research problems. Many important challenges in science such as protein folding, drug discovery, and tumour evolution, all depend on simulations, models and analyses run on HPC facilities to make progress.

This course introduces HPC to life science researchers, focusing on the aspects that are most important for those new to this technology to understand. It will help you judge how HPC can best benefit your research, and equip you to go on to successfully and efficiently make use of HPC facilities in future. The course will cover basic concepts in HPC hardware, software, user environments, filesystems, and programming models. It also provides an opportunity to gain hands-on practical experience and assistance using an HPC system (MARENOSTRUM) through examples drawn from the life sciences, such as biomolecular simulation (GROMACS) and multicellular simulations (PhysiCell).

The course is organised and funded by PerMedCoE - the HPC/Exascale Centre of Excellence in Personalised Medicine ([https://permedcoe.eu/](https://permedcoe.eu/)) and BioExcel - the Centre of Excellence for Computational Biomolecular Research ([http://bioexcel.eu](http://bioexcel.eu/)) using the HPC infrastructure at the Barcelona Supercomputing Centre. This course will take place face-to-face on the premises of the Universitat Politècnica de Catalunya - BarcelonaTech (UPC).""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-03-08 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Spain" ;
                            schema1:addressRegion "Barcelona" ;
                            schema1:postalCode "08034" ;
                            schema1:streetAddress "UPC: Vèrtex building, Vèrtex Building, Universitat Politècnica de Catalunya (UPC), Plaça d'Eusebi Güell, 6" ] ] ;
            schema1:maximumAttendeeCapacity 40 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2023-03-07 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Introduction to HPC for Life Scientists" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "UPC: Vèrtex building" ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/introduction-hpc-life-scientists-0> .

<https://tess.elixir-europe.org/events/introduction-to-hpc-structure-and-practice> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This course is part of a micro-credential track, a micro-credential has the added value of being like a mini-diploma. When following the full track you will become able to improve the reproducibility of your research. Check this opportunity : Reproducible Data Analysis: an Essential Capability in Modern Science. In this half day introduction, you will have the opportunity to know a bit more about the structure of the HPC (tiers), what resources you have available, and most importantly, how to use and navigate the HPC. In this course, you will learn the differences and similarities betweenVSC (Vlaams Supercomputer Centrum) instances in Gent and LeuvenVIB Data CoreAnd a glimpse of what you could find beyond. It is our aim that you can more easily adjust to any HPC system that you encounter in your professional life." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-03-28 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Belgium" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-03-28 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "ELIXIR",
        "advanced bioinformatics",
        "programming",
        "research data management" ;
    schema1:name "Introduction to HPC: structure and practice" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Access existing HPC infrastructures in Flanders such as VSC and VIB Data Core”",
        "“Check information about submitted jobs”",
        "“Describe differences and similarities among HPC Tiers and usage”",
        "“Querying and using modules and their versions in the HPC”",
        "“Submit jobs to use software and scripts on the cluster “",
        "“Use the different environments in the HPC (storage analysis debug)”" ;
    schema1:url <https://training.vib.be/all-trainings/introduction-hpc-structure-and-practice> .

