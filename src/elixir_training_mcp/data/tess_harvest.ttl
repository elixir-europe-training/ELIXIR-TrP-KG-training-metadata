<https://tess.elixir-europe.org/events/bio-it-world-conference-amp-expo-2018> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """There's been dramatic progress in life science technologies over the years, yet the fundamental goal of the Bio-IT community remains the same — to make the most of data and computing to advance medicine. Since 2002, Bio-IT World has played an integral role in this, bringing together clever, innovative people from all areas of life sciences for expert commentary and industry insight. Our 2017 event brought together more than 3,400 attendees from 35 countries to make connections and forge collaborations across the life sciences. Next year promises to be even better. With 16 tracks, 14 pre-conference workshops, and three industry awards, the 2018 Bio-IT World Conference &amp; Expo will offer more opportunities to build the relationships that drive the Bio-IT industry forward.\r
\r
Chris Evelo, from Maastricht University will be giving a presentation on 'Easier Integration and Enrichment of Your Data by Making Public Data More FAIR ELIXIR' on Wednesday 16 May at 5pm.\r
\r
For full details on this conference, including how to regsiter, please visit the Bio IT website.\r
\r
 \r
\r
 """ ;
    schema1:endDate "2018-05-17 16:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "United States of America" ;
                    schema1:postalCode "02494" ] ;
            schema1:latitude "42.299917" ;
            schema1:longitude "-71.220955" ] ;
    schema1:name "Bio IT World Conference &amp; Expo 2018" ;
    schema1:startDate "2018-05-15 08:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/bio-it-world-conference-expo-2018> .

