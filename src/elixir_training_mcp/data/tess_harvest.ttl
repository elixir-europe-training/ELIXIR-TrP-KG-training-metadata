<https://tess.elixir-europe.org/materials/workshop-hybrid-de-novo-genome-assembly> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Hall, Grace (orcid: 0000-0002-5105-8347)" ],
