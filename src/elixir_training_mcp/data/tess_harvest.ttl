            schema1:endDate "2020-03-24 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2020-03-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Introduction to Python Programming 2020" ;
