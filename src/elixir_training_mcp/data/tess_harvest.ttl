<https://tess.elixir-europe.org/events/data-manipulation-and-visualisation-with-python> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description "One of the strengths of the Python language is the availability of mature, high-quality libraries for working with scientific data. Integration between the most popular libraries has lead to the concept of a \"scientific Python stack\": a collection of packages which are designed to work well together. In this workshop we will see how to leverage these libraries to efficiently work with and visualise large volumes of data." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2018-04-13 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Edinburgh" ;
                            schema1:postalCode "EH9 3JN" ;
                            schema1:streetAddress "The King's Buildings, The University of Edinburgh" ] ;
                    schema1:latitude "55.922536" ;
                    schema1:longitude "-3.175467" ] ;
            schema1:startDate "2018-04-09 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Bioinformatics",
        "Programming",
        "Python" ;
    schema1:name "Data Manipulation and Visualisation with Python" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Edinburgh Genomics" ;
            schema1:url <https://genomics.ed.ac.uk> ] ;
    schema1:url <https://genomics.ed.ac.uk/services/data-manipulation-and-visualisation-python> .

