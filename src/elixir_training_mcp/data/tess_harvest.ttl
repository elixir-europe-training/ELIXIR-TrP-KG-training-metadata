<https://tess.elixir-europe.org/events/data-visualisation-principles-for-enhancing-effective-scientific-communication> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0092> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Research presentation" ] ;
    schema1:description """This webinar will provide an introduction to data visualisation principles. It includes a review of basic concepts and showcases tools to improve your understanding and use of data visualisation for improved accessibility to your research. 

As we know, collecting data is just the first step to advancing scientific knowledge. Data presentation techniques are the key to communicating your findings in a concise manner to improve understanding across audiences and ultimately strengthening your contributions to your field.

The webinar speaker, Isabel Romero Calvo, PhD, MS, Scientific Illustrator, will present information that will help you gain insights into:

- Gestalt principles
- Concept of salience and graphic perception
- Use of colour in data visualisation
- Accessibility in data visualisation

We will conclude with a Q&amp;A session for the webinar attendees. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-06-26 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-06-26 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Data presentation",
        "Research presentation",
        "Scientific communication",
        "Scientific presentation" ;
    schema1:name "Data visualisation principles for enhancing effective scientific communication" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
