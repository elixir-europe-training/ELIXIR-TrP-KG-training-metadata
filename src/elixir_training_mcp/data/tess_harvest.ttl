        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Cyril Pommier" ],
        [ a schema1:Person ;
            schema1:name "Elizabeth Arnaud" ],
        [ a schema1:Person ;
            schema1:name "Célia Michotey" ],
        [ a schema1:Person ;
            schema1:name "Evangelia Papoutsoglou" ],
        [ a schema1:Person ;
            schema1:name "Daniel Faria" ],
        [ a schema1:Person ;
            schema1:name "Anne-Françoise Adam-Blondon" ] ;
    schema1:description """This training material has been used in a two-day training workshop on data management organized by Elixir and the Wheat Initiative.\r
\r
It provides  an overview of current practices and methods for plant phenotyping data standardization, and how to deal with the variability and heterogeneity inherent to research and breeding data sets. Data management approaches at some of the major research organizations will be given as examples. \r
\r
In addition to presentations, this material includes practices on the datasets of training attendees, hence allowing to format them according to published standards (www.miappe.org) and descriptive vocabularies from the Crop Ontology (www.cropontology.org). They will benefit from the advice of the expert presenters during hands-on exercise as well as learn from their experience in the research domain.""" ;
