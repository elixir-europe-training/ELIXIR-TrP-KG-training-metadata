<https://tess.elixir-europe.org/events/oxford-nanopore-minion-sequencing> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Data Handling\\,Analysis And Applications" ;
