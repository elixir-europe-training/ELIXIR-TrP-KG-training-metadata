<https://tess.elixir-europe.org/events/les-langages-de-workflows-pour-une-analyse-bioinformatique-reproductible-session-2024-workflow-languages-for-reproducible-bioinformatics-analysis-2024-session> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "WF4bioinfo 2024" ;
    schema1:description """L’Institut Français de Bioinformatique (IFB) organise en partenariat avec iPOP-UP (représenté par EDC) une formation sur les langages de workflows en bioinformatique à destination des bioinformaticien·ne·s et des bioanalystes. La formation abordera les fondamentaux et les fonctionnalités avancées des deux langages Snakemake et Nextflow. Ces outils sont en effet devenus indispensables pour assurer la reproductibilité et l’efficacité des analyses bioinformatiques. La formation sera structurée en deux séquences :\r
- une journée commune qui abordera les grands principes des gestionnaires de workflow, en particulier dans le domaine de la bioinformatique et en lien avec les infrastructures de calcul de type cluster et cloud proposés au sein de l’IFB \r
- une  journée de session pratique  avec 1 atelier snakemake et 1 atelier nextflow en parallèle au choix des participants. Nous proposons aux participants qui le souhaitent de travailler sur leur propre workflow dans une approche “Bring your own script” avec l’aide de l’équipe pédagogique.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-10-16 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Paris" ] ;
                    schema1:latitude "48.85889" ;
                    schema1:longitude "2.320041" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "IFB (https://www.france-bioinformatique.fr/), PB-IBENS (https://www.ibens.ens.fr/?rubrique55)" ] ;
            schema1:startDate "2024-10-14 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Les langages de workflows pour une analyse bioinformatique reproductible - session 2024 / Workflow languages for reproducible bioinformatics analysis -2024 session" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "IFB French Institute of Bioinformatics" ;
            schema1:url <http://www.france-bioinformatique.fr> ] ;
    schema1:url <https://moodle.france-bioinformatique.fr/course/view.php?id=29> .

<https://tess.elixir-europe.org/events/les-langages-de-workflows-pour-une-analyse-bioinformatique-reproductible-workflow-languages-for-reproducible-bioinformatics-analysis> a schema1:Course ;
