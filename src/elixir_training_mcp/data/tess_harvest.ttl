<https://tess.elixir-europe.org/events/codata-rda-advanced-bioinformatics-workshop> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "NGS Data Analysis and Machine Learning Applications" ;
    schema1:description """As part of the [CODATA-RDA Research Data Science Summer School](http://www.codata.org/datatrieste2018) in Trieste (6-17 Aug 2018), ELIXIR Training has contributed in the organization of the flanking Advanced Bioinformatics workshop (20-24 Aug 2018) with a particular focus on Machine Learning applications, as part of the ELIXIR Implementation Study on Learning Paths.\r
\r
This advanced bioinformatics course provided an overview of the current status of different NGS workflows (variant calling, RNA-Seq, ChIP-Seq, Metagenomics etc), and combined them with the appropriate Machine Learning and Data Mining approaches. After providing a strong foundation of the underlying theory and concepts, the course relied heavily on hand-on exercises and tutorials in order for the participants to directly apply and practice on methods and techniques  presented throughout each day.\r
\r
The course was led by [Fotis E. Psomopoulos](https://fpsom.github.io/) (INAB-CERTH) from  ELIXIR Greece, with [Amel Ghouila](https://github.com/amelgh) (Institut Pasteur de Tunis / [H3ABionet](https://www.h3abionet.org)) and [Gabriele Schweikert](http://homepages.inf.ed.ac.uk/gschweik/) (Cyber Valley Initiative, University of Tübingen, DE / Computational Biology, University of Dundee, UK) as co-instructors of the course. Moreover, the daily training activities were supported by three helpers; Maria Tsagiopoulou (INAB|CERTH), Ola Karrar (University of Khartoum) and a past learner to the CODATA-RDA Research Data Science Summer School, and David Helekal (University of Dundee).""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2018-08-24 18:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Italy" ;
                            schema1:addressLocality "Grignano" ;
                            schema1:addressRegion "Provincia di Trieste" ;
                            schema1:streetAddress """Adriatico Guest House - Denardo Lecture Hall\r
International Centre for Theoretical Physics\r
Trieste, Italy""" ] ;
                    schema1:latitude "45.707337" ;
                    schema1:longitude "13.714562" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:startDate "2018-08-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "ELIXIR / CODATA-RDA Research Data Science Advanced Workshop on Bioinformatics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Greece" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
