<https://tess.elixir-europe.org/materials/biocuration-in-disprot> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "biocurators" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bioinformaticians" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Federica Quaglia" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:description """Course for biocurators and researchers interested in contributing to DisProt, manually curated resource of intrinsically disordered proteins (IDPs). DisProt is a service of the Italian node of ELIXIR. This course, or attending a virtual or in person training session, is required to begin curation in DisProt.\r
\r
The DisProt curation course encompasses key topics: 1. Overview of the curation process in DisProt; 2. Structuring IDP-related data with ontologies; 3. Retrieving IDP-related data and defining experiments; 4. Annotating states, transitions and functions of IDPs; 5. MIADE: Minimum Information About Disorder Experiments; 6. Curation in DisProt: thematic datasets and use case.\r
\r
To access the course, fill out the registration form (https://elixir.mf.uni-lj.si/course/view.php?id=101).""" ;
    schema1:keywords "Biocuration",
        "Intrinsically disordered proteins" ;
    schema1:learningResourceType "How-to guide",
        "Training materials",
        "e-learning",
        "lessons",
        "video" ;
    schema1:license <https://spdx.org/licenses/CC-BY-NC-ND-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "DisProt" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.dt9z89> ] ;
    schema1:name "Biocuration in DisProt" ;
    schema1:provider [ a schema1:Organization ;
