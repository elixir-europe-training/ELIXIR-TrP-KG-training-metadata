<https://tess.elixir-europe.org/events/quickgo-gene-ontology-annotation-184af2c2-48b4-48b6-afca-e47b0a769444> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_0582>,
        <http://edamontology.org/data_2223>,
        <http://edamontology.org/data_3754> ;
    schema1:description """This webinar focuses on how to use [QuickGO](https://www.ebi.ac.uk/QuickGO/), our online browser for viewing the gene ontology (GO) and GO annotations. We will be reviewing what GO is, how to read an annotation, and how you can use QuickGO to find the information youneed. 

The Gene Ontology Annotation (GOA) project provides high-quality functional annotations to gene products, such as proteins, protein complexes and non-coding RNAs. Currently our database contains over 390 million annotations to 60 million distinct gene products from almost 725,000 taxa. It is therefore critical to be able to easily and quickly mine and visualise the available information. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2018-10-10 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 200 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2018-10-10 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Controlled vocabulary",
        "Gene ontology",
        "Gene ontology annotation",
        "Ontologies (ontologies)",
        "QuickGO" ;
    schema1:name "QuickGO: Gene ontology annotation" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/quickgo-gene-ontology-annotation> .

