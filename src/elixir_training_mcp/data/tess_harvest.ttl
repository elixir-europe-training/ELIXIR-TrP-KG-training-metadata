<https://tess.elixir-europe.org/events/easy-quick-visualizing-ngs-count-data-with-python-epps25> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """Educators:\r
Daniel Wibberg (CAU), Sebastian Beier (GCBN), Anna-Maria Möller, Daniela Dey (both WGGC)\r
\r
Date:\r
17 September (9:00 - 10:30)\r
\r
Location:\r
Bonn - EPPS2025 (https://epps2025.plant-phenotyping-network.de/EPPS_Home)\r
\r
Contents:\r
In this 90-minute hands-on workshop, participants will learn how to load, explore, and visualize small-scale NGS transcriptomic count data using Python in Galaxy Hub’s JupyterLab environment. After a brief introduction to NGS data and its importance, we will dive into practical work with pandas to inspect and manipulate the data. Participants will then explore basic statistics and create quick histograms to interpret count distributions. In the final block, we will generate polished plots using seaborn and matplotlib, with optional challenges for advanced participants. The session concludes with a short discussion on how these foundational skills prepare for more complex transcriptomic analyses like normalization or PCA.\r
\r
The workshop is a cooperation between de.NBI &amp; ELIXIR-DE and the West German Genome Center (WGGC)\r
\r
Learning goals:\r
- Get familiar with the programming language Python (no pre-knowledge required)\r
- build a basic understanding of data handling and\r
- visualization with Python\r
- introduction to commonly required applications/tools\r
\r
Prerequisites:\r
Attendees should be equipped with a personal laptop. None programming knowledge is needed.\r
\r
\r
Keywords:\r
Python\r
\r
Tools:\r
Python""" ;
    schema1:endDate "2025-09-17 10:30:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Germany" ;
                    schema1:addressLocality "Bonn" ;
                    schema1:addressRegion "Köln" ;
                    schema1:postalCode "53113" ;
                    schema1:streetAddress "World Conference Center Bonn, 2 Platz der Vereinten Nationen" ] ;
            schema1:latitude "50.718156" ;
            schema1:longitude "7.122559" ] ;
    schema1:name "Easy & Quick - Visualizing NGS Count Data with Python - EPPS25" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "de.NBI & ELIXIR-DE, WGGC" ] ;
    schema1:startDate "2025-09-17 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.denbi.de/training-courses-2025/1911-easy-quick-visualizing-ngs-count-data-with-python-epps25> .

