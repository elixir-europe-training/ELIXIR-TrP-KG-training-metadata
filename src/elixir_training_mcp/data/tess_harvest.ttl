    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Astrid Gall" ;
    schema1:description "The Ensembl project (www.ensembl.org) offers integrated genome, variation, gene regulation and comparative genomics data of mainly vertebrate genomes on an open access web browser platform. This webinar will introduce you to the analysis of Linkage Disequilibrium (LD) between variants with Ensembl. We will look at different ways to explore and visualise LD in the Ensembl genome browser website. We will discuss the new LD Calculator tool (https://www.ensembl.org/Homo_sapiens/Tools/LD?db=core) which has been released with Ensembl 91 and show how to use it." ;
    schema1:endDate "2018-03-21 17:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "Analysing Linkage Disequilibrium with Ensembl" ;
    schema1:startDate "2018-03-21 16:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2018/analysing-linkage-disequilibrium-ensembl> .

<https://tess.elixir-europe.org/events/analysing-linkage-disequilibrium-with-ensembl-2faedef2-487b-403d-b73f-8ba03220b30e> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_1033>,
        <http://edamontology.org/operation_0488>,
        <http://edamontology.org/topic_3053> ;
    schema1:description """The [Ensembl project](www.ensembl.org) offers integrated genome, variation, gene regulation and comparative genomics data of mainly vertebrate genomes on an open access web browser platform.

This webinar will introduce you to the analysis of Linkage Disequilibrium (LD) between variants with Ensembl. We will look at different ways to explore and visualise LD in the Ensembl genome browser website. We will discuss the new [LD Calculator tool](https://www.ensembl.org/Homo_sapiens/Tools/LD?db=core) which has been released with Ensembl 91 and show how to use it.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
