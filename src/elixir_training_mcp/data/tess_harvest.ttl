<https://tess.elixir-europe.org/events/single-cell-omics-workshop-first-steps-in-building-an-elixir-community-and-white-paper> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """This workshop aims to consolidate key themes and challenges in the Single Cell Omics field, which the emerging ELIXIR Community will tackle.\r
\r
Everyone with an interest in the field of Single Cell Omics is welcome to join the workshop, which will be divided into three main parts: \r
\r
\r
	Introduction of the field and focus, with highlight presentations \r
	Joint discussion around the Community's themes and challenges\r
	Identification of key themes and planning of the white paper writing. \r
\r
\r
The event is restricted to ELIXIR members and invited guests. The registration link is available on this page for those logged into the ELIXIR intranet. \r
\r
Please log in to see the registration link. \r
\r
A more detailed agenda will be shared closer in time.""" ;
    schema1:endDate "2021-09-16 13:00:00 UTC"^^schema1:Date ;
    schema1:name "Single-Cell Omics Workshop - First steps in building an ELIXIR Community and white paper" ;
    schema1:startDate "2021-09-16 10:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/single-cell-omics-workshop-first-steps-building-elixir-community-and-white-paper> .

