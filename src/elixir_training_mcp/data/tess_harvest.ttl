        "data protection",
        "data publication",
        "metadata",
        "sensitive data" ;
    schema1:maximumAttendeeCapacity 45 ;
    schema1:name "Life Science Data Management: Planning workshop" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ] ;
    schema1:startDate "2022-09-26 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.digitallifenorway.org/services/data-management/events/dmp-workshop-for-life-science-05.html> .

<https://tess.elixir-europe.org/events/life-science-data-management-planning-workshop-1b2930e4-3785-4c74-b076-2e226d5627ca> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
