<https://tess.elixir-europe.org/events/data-collection-analysis-and-interpretation-for-genomic-medicine-692621e1-d432-4336-8293-aab6e1dff066> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0199> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType """This workshop is aimed at bioinformaticians, software engineers and data analysts working in genomic medicine. Participants are likely to be working to set up and operate compute infrastructure and analysis pipeline to support clinical decision making in genomic medicine.\r
\r
Participants will require a basic knowledge of computational script writing and command line tools. Knowledge of next generation sequencing technologies and familiarity with genomic data will be useful for comprehending the content.""" ] ;
    schema1:description """This workshop will introduce cloud technologies for creating bioinformatics pipelines relevant to clinical decision making. The content will guide participants through the process of building data flows, using GA4GH standards and infrastructure available from ELIXIR nodes and the EMBL-EBI. Expertise and support will be available during the workshop from the trainers, allowing participants to tailor pipelines to suit their own needs, data types and analysis methods.\r
\r
The workshop content will cover aspects of data storage and collection with regards to standards and file formats; sharing data and metadata within the cloud community; visualisation and analysis of data with regards to end-point clinical decision making.   """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2020-06-25 17:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-06-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Data collection, analysis and interpretation for genomic medicine" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/data-collection-analysis-and-interpretation-genomic-medicine> .

<https://tess.elixir-europe.org/events/data-collection-analysis-and-interpretation-for-genomic-medicine-virtual> a schema1:Event ;
