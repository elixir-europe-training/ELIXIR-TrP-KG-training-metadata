<https://tess.elixir-europe.org/events/analysis-of-huge-metabolic-models-with-cobrexa-jl> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_3869>,
        <http://edamontology.org/topic_2259>,
        <http://edamontology.org/topic_3316>,
        <http://edamontology.org/topic_3524> ;
    schema1:description """[COBREXA.jl](https://permedcoe.eu/cobrexa-jl-release/) is a new software package to enable the analysis and simulation of large metabolic models by taking advantages of modern HPC infrastructure. Mainly, it advanced the scalability of constraint-based method, using the Julia programing language and its mathematic ecosystem as a base building block. We will talk about the problems that motivated the development of COBREXA.jl and show several of its main applications. We will show the COBREXA.jl interface that allows biologists and bioinformaticians to easily specify large amounts of analyses and execute it on supercomputers. Later, we will use COBREXA for creating a model of a small microorganism community, and demonstrate how the software helps to answer questions about the viability and chemical activity of microbe ecosystems. 

## About the speaker

Miroslav Kratochvíl has recently finished his PhD in computer science at Charles University in Prague; currently he is a researcher focusing on bioinformatics-oriented topics at Luxembourg Centre for Systems Biomedicine. His research concerns mainly the high-performance algorithms for processing large datasets from life sciences.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-10-21 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 500 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2021-10-21 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Cell-level simulations" ;
    schema1:name "Analysis of huge metabolic models with COBREXA.jl" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/analysis-huge-metabolic-models-cobrexajl> .

