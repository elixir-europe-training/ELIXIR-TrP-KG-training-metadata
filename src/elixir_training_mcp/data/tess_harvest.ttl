            schema1:url <https://zenodo.org/records/14365542> ],
        [ a schema1:Thing ;
            schema1:name "STAR" ;
            schema1:url <https://bio.tools/tool/star> ] ;
    schema1:name "Neoantigen 1a: Fusion-Database-Generation" ;
    schema1:provider [ a schema1:Organization ;
