<https://tess.elixir-europe.org/events/elixir-software-carpentry> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3316> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Biologists with little or no prior computational experience" ] ;
    schema1:description """The workshop is aimed at biologists with little or no prior computational experience and is focused on Reproducible Scientific Analysis. The curriculum will include: The Unix Shell, R for Reproducible Scientific Analysis, Version Control with Git.\r
For instance, after attending this workshop you will be able to: automate repetitive tasks, capture small data manipulation steps that are normally not recorded to make research reproducible, R data and plot manipulation, use a few easy-to-remember commands to do most day-to-day version control tasks.\r
\r
Full details at: https://elixir-iib-training.github.io/website/2019/02/11/SWC-Naples.html\r
""" ;
