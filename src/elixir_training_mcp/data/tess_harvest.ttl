    schema1:url <http://www.bioinformatics.babraham.ac.uk/training.html#ggplot> .

<https://tess.elixir-europe.org/materials/an-introduction-to-mathematical-modelling> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Nicolas Le Novère" ],
        [ a schema1:Person ;
            schema1:name "Boo Virk" ],
        [ a schema1:Person ;
            schema1:name "Viji Chelliah," ] ;
    schema1:description """This course provides an introduction to the concepts of modelling biological systems. It is intended for biologists who have no experience in modelling but would like to know how it might apply to their area of research. The course provides a complete background to the history of modelling and the different approaches through which a biological system can be approximated by mathematical methods. The course also provides a practical introduction to the [COPASI](http://copasi.org/) modelling environment.\r
\r
**Course Content**\r
\r
* An introduction to modelling\r
* An overview of chemical kinetics\r
* Mathematical modelling with COPASI\r
\r
**Course Material**\r
\r
* [Introduction to Modelling (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Mathematical_Modelling/Introduction_to_Modelling.pdf)\r
* [Introduction to Chemical Kinetics (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Mathematical_Modelling/Introduction_to_Chemical_Kinetics.pdf)\r
* [COPASI Modelling Tutorial (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Mathematical_Modelling/Mathematical_Modelling_COPASI_tutorial.pdf)\r
* [Course Data (zip, 9.3MB)](http://www.bioinformatics.babraham.ac.uk/training/Mathematical_Modelling/Mathematical_Modelling_Data.zip)""" ;
    schema1:educationalLevel "beginner" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:name "An Introduction to Mathematical Modelling" ;
    schema1:url <http://www.bioinformatics.babraham.ac.uk/training.html#modelling> .

<https://tess.elixir-europe.org/materials/an-introduction-to-mobidb> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Database users" ],
        [ a schema1:Audience ;
            schema1:audienceType "Computational biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Curators" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bench biologists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Federica Quaglia" ] ;
    schema1:competencyRequired "Basic knowledge of biology and proteins is required." ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2022-09-25"^^schema1:Date ;
    schema1:description "In this course you will learn what type of information is stored in the MobiDB database (URL: https://mobidb.org/) that provides predictions and annotations for intrinsically disordered proteins. You will explore the main features of the database, its entries along with the related documentation. Basic knowledge of biology and proteins is required." ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Databases",
        "intrinsic disorder prediction",
        "intrinsically disordered proteins",
        "protein sequence" ;
    schema1:learningResourceType "Training materials",
        "Webinar" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "MobiDB" ;
            schema1:url <https://mobidb.bio.unipd.it/> ] ;
    schema1:name "An introduction to MobiDB" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Italy" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:teaches """At the end of this course you will be able to\r
• Explain what MobiDB is and how you can use it\r
• Explain how to navigate the MobiDB database: \r
      • Explain and describe the home page features\r
      • Discuss and interpret the MobiDB entries\r
• Explain what are the key features of a MobiDB entry\r
• Explain how to download the output of a search in MobiDB\r
• Identify where to find the MobiDB Documentation\r
      • List the various pages and content available in the documentation: Statistics, Release Notes, Help and About\r
      • Explain how to download the output of a search in MobiDB""" ;
    schema1:url <https://www.youtube.com/watch?v=1Mr0n3JNV1s> .

