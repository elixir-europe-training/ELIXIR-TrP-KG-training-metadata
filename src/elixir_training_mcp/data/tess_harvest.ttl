<https://tess.elixir-europe.org/events/exploring-gene-and-environmental-exposure-interactions-to-understand-human-health-and-disease> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0625>,
        <http://edamontology.org/topic_3307>,
        <http://edamontology.org/topic_3517> ;
    schema1:description """This introductory course explores the complex interplay between genes and the environment in shaping human phenotypes. Participants will gain knowledge of cohort datasets, environmental readouts, and computational resources to investigate gene-environment interactions. Ethical and legal frameworks related to data privacy, consent, and genetic discrimination will be discussed. The course also covers computational modelling techniques for integrating genotype and environmental effects. By the end, attendees will be equipped to analyse cohort datasets, make use of computational resources, and interpret the results. 

Please note that you will not analyse your own data as part of the course. There will, however, be ample opportunity to discuss your research and ideas with other course participants and trainers""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-02-23 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
