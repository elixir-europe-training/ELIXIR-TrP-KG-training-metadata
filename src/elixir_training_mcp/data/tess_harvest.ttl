<https://tess.elixir-europe.org/materials/introduction-to-the-complex-portal> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3047> ;
    schema1:description "This webinar will introduce the Complex Portal, an encyclopaedic database for information on macromolecular complexes. In this webinar we will explain the coverage and curation priorities of the Complex Portal, show how to search for complexes using a variety of accession numbers, keywords and how to use the organism search. We will also demonstrate examples of complex details pages that include visualisation tools and link-outs to related database." ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Introduction to the Complex Portal" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/introduction-complex-portal> .

<https://tess.elixir-europe.org/materials/introduction-to-the-ega-and-its-ecosystem-of-tools> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0622> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Professors" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:description """The [European Genome-phenome Archive (EGA)](https://ega-archive.org/) is a resource for archiving of all types of potentially identifiable genetic, phenotypic, and clinical data resulting from biomedical research projects. Its mission is to foster hosted data reuse, enable reproducibility, and accelerate biomedical and translational research.\r
\r
To promote the use and interaction with professionals in research and education, we invite you to attend our first online workshop on the EGA and its ecosystem of tools. The goal of this training would be to present EGA repositories and tools so that they can be incorporated into your research or teaching. This online course is aimed at teachers, professors and trainers interested in incorporating these concepts and tools in their curriculums.""" ;
    schema1:keywords "ELIXIR-CONVERGE",
        "FEGA",
        "Federated EGA",
        "Genomics",
        "bioinformatics",
        "e-learning" ;
    schema1:learningResourceType "Presentation",
        "Video" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Slides | Introduction to the EGA and sharing sensitive data" ;
            schema1:url <https://veis.bsc.es/files/introduction_to_ega_and_sharing_senstive_data_slides.pdf> ],
        [ a schema1:Thing ;
            schema1:name "Slides | Beacon v2: a discovery tool for genomic and pheno-clinical data" ;
            schema1:url <https://veis.bsc.es/files/beacon_veis_sep2022_slides.pdf> ],
        [ a schema1:Thing ;
            schema1:name "Introduction to the EGA and sharing sensitive data" ;
            schema1:url <https://youtube.com/watch?v=jiUP_0jKUis&feature=share&u5IiRIQ> ],
        [ a schema1:Thing ;
            schema1:name "GPAP: the RD-Connect Genome-Phenome Analysis Platform for diagnosis and gene discovery in rare disease research" ;
            schema1:url <https://youtube.com/watch?v=LZ6en4GMf6k&feature=share&utm_source=EKLEiJECCKjOmKnC5IiRIQ> ],
        [ a schema1:Thing ;
