<https://tess.elixir-europe.org/events/elabftw-course-ccmar> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Laboratory technicians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Data managers" ] ;
    schema1:description "On September 22, 2025, the Research Data Management Centres GLIM-BioData and CIMAR-LA will host a hands-on training session on eLabFTW, the open-source electronic lab notebook and lab management system. The session will take place at CCMAR, Universidade do Algarve (Campus de Gambelas, Edifício 1, Sala 0.10, Faro), and is aimed at researchers, lab technicians, and data managers. We’ll cover key eLabFTW features—experiment documentation, inventory management, and team collaboration tools—to help you adopt best practices in data management and reproducibility." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-09-22 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "Recovery and Resilience Plan" ],
                [ a schema1:Organization ;
                    schema1:name "European Union - NextGenerationEU" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Portugal" ;
                            schema1:addressLocality "Faro" ;
                            schema1:addressRegion "Faro" ;
                            schema1:postalCode "8005-139" ;
                            schema1:streetAddress "CCMAR - Center of Marine Sciences (Building 1, Room 0.10)" ] ;
                    schema1:latitude "37.043161" ;
                    schema1:longitude "-7.973279" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "GLIM-BioData, CIMAR-LA" ] ;
            schema1:startDate "2025-09-22 14:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "eLabFTW" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "eLabFTW" ;
            schema1:url <https://elabftw.net> ] ;
    schema1:name "eLabFTW Course: CCMAR" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "BioData.pt" ;
            schema1:url <https://biodata.pt> ],
        [ a schema1:Organization ;
            schema1:name "CCMAR, Centre for Marine Sciences" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Portugal" ;
            schema1:url <https://elixir-portugal.org> ] ;
    schema1:url <https://events.biodata.pt/e/elabftw-ccmar2025> .

<https://tess.elixir-europe.org/events/elabftw-course-ciimar> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "On April 28th, the Research Data Management Centres GLIM-BioData and FAIRway will host a training session on [eLabFTW, an open-source electronic lab notebook and laboratory management system](https://www.elabftw.net/). The session will take place at CiiMAR, in Matosinhos, from 14h to 16h30. Aimed at researchers, lab technicians, and data managers, this hands-on session will explore the key features of eLabFTW, including experiment documentation, inventory management, and team collaboration tools, helping participants adopt best practices in data management and reproducibility." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-04-28 15:30:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "European Union" ],
