            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "United Kingdom" ;
                    schema1:addressLocality "Hinxton" ;
                    schema1:postalCode "CB10 1SD" ;
                    schema1:streetAddress "South Building" ] ;
            schema1:latitude "52.078961" ;
            schema1:longitude "0.18684" ] ;
    schema1:name "ELIXIR Campus Open Day 2020" ;
    schema1:startDate "2020-02-06 10:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/elixir-campus-open-day-2020> .

