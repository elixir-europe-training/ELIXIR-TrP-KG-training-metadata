                    schema1:longitude "18.297982" ] ;
            schema1:startDate "2025-06-09 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "RaukR • R Beyond the Basics" ;
