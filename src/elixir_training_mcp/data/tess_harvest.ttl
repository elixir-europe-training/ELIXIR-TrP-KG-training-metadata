            schema1:url <https://training.galaxyproject.org/training-material/topics/single-cell/tutorials/scrna-case_alevin/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/4574153> ],
        [ a schema1:Thing ;
            schema1:name "anndata" ;
            schema1:url <https://bio.tools/tool/anndata> ],
        [ a schema1:Thing ;
            schema1:name "DropletUtils" ;
            schema1:url <https://bio.tools/tool/dropletutils> ],
        [ a schema1:Thing ;
            schema1:name "Alevin" ;
            schema1:url <https://bio.tools/tool/Alevin> ],
        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ] ;
    schema1:name "Generating a single cell matrix using Alevin" ;
    schema1:provider [ a schema1:Organization ;
