            schema1:endDate "2021-10-13 16:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BioData.pt" ] ;
            schema1:startDate "2021-10-12 09:00:00 UTC"^^schema1:Date ] ;
