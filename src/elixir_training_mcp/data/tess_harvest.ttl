<https://tess.elixir-europe.org/events/bioimaging-data-analysis-on-the-high-performance-computing-hpc> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This introductory course is designed for scientists who work with microscopy or bioimage data and want to scale up their analysis using high-performance computing (HPC). As datasets grow in size and complexity, traditional desktop tools often fall short. This training will show you how to leverage the Flemish Supercomputer Center (VSC) infrastructure to run image analysis workflows more efficiently and reproducibly. You’ll learn to access HPC resources via the Open OnDemand portal, run GUI-based tools (like napari or Fiji), and adapt existing pipelines (e.g., from ZeroCostDL4Mic or the BioImage Model Zoo) in a Jupyter notebook environment. By the end of the course, you’ll be equipped to identify suitable HPC resources for your analysis tasks and integrate them into your research workflows." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-09-19 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "Vlaams Supercomputer Centrum" ],
                [ a schema1:Organization ;
                    schema1:name "Flanders BioImaging" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3000" ;
                            schema1:streetAddress "Leuven - Campus Gasthuisberg, Herestraat 49" ] ;
                    schema1:latitude "50.879202" ;
                    schema1:longitude "4.701168" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-09-18 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "HPC",
        "imaging" ;
    schema1:name "Bioimaging data analysis on the High Performance Computing (HPC)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Access the VSC supercomputer infrastructure using the Open OnDemand portal to manage bioimage datasets”",
        "“Adapt existing image analysis pipelines (e.g. from ZeroCostDL4Mic or BioImage Model Zoo) to run efficiently on the HPC infrastructure”",
        "“Describe the scientific high-performance computing (HPC) infrastructure”",
        "“Evaluate the reproducibility of bioimage analysis workflows and propose improvements using HPC-based solutions”",
        "“Execute pre-installed bioimage analysis tools (e.g. Ilastik Fiji Napari) on the VSC for tasks such as segmentation and denoising”",
        "“Run image analysis pipeline using a Jupyter notebook”",
        "“Transfer and organize microscopy data on the HPC system to prepare for scalable analysis workflows”" ;
    schema1:url <https://training.vib.be/all-trainings/bioimaging-data-analysis-high-performance-computing-hpc> .

