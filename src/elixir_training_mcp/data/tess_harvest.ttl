<https://tess.elixir-europe.org/events/linux-shell-scripting-for-high-throughput-biological-data-processing-on-supercomputers> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3473> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Biomedical researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "beginner bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD Students or young researchers in molecular biology and/or genetics with little or no background in bioinformatics. " ] ;
    schema1:description """An unprecedented amount of biomedical data have been produced and stored in the last years. Managing such biological big data is often not affordable without high-performance computing architectures, needed to analyze and process large-scale datasets. Running high-throughput (HTP) bioinformatics data pipelines on supercomputing machines requires advanced Linux shell command line and scripting skills. Most scientists working with such data often lack such skills or have acquired them by self-learning without becoming fully independent and fluent. This may have repercussions on the quality, reproducibility, and reliability of the analyses. In this two-day course, we will introduce the Linux shell and, on day one, we will show how to navigate and work with files and directories, how to combine commands to do new things, how to perform the same actions on many different files, how to filter and selectively extract data from tables, and how to find objects in files. Moreover, we will show how to connect to a remote supercomputer and how to utilise a supercomputing environment to analyse big amount of biological data, run simple shell scripts and bioinformatics pipelines. Day 2 will be wholly practical. Participants are invited to let us know in advance which are the typical file format(s) they have to deal with (e.g. fastq, table, etc), the typical processes they need to perform on them (e.g. filtering, ordering, etc.) and the typical programs they need to run (e.g. bwa, hisat2, etc.) so that we can prepare tailored practicals. Participants are also welcome to come to the course with one or more files they wish to work with, provided they do not exceed a given size.\r
""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2018-01-17 18:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Italy" ;
                            schema1:addressLocality "Roma" ;
                            schema1:addressRegion "Città Metropolitana di Roma" ;
                            schema1:postalCode "00185" ;
                            schema1:streetAddress "Via dei Tizii, 6B" ] ;
                    schema1:latitude "41.89897" ;
                    schema1:longitude "12.51185" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Allegra Via (ELIXIR-IIB Training Coordinator, IBPM-CNR, IT) Loredana Le Pera (ELIXIR-IIB Training Team, IBIOM-CNR, IT) Tiziana Castrignanò (SCAI Department, CINECA, Roma, IT) " ] ;
            schema1:startDate "2018-01-16 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "HTP data",
        "Managing and Processing data",
        "Shell script",
        "Unix/Linux",
