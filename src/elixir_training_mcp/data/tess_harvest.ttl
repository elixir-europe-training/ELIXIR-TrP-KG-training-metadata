<https://tess.elixir-europe.org/events/finding-and-using-publicly-available-data-q-a-session> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0219>,
