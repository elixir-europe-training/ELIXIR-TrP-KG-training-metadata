<https://tess.elixir-europe.org/materials/retrieving-biological-data-from-embl-ebi-resources-using-dbfetch> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description """Dbfetch provides a single point of access to retrieve biological data entries from various databases at EMBL-EBI.\r
\r
This webinar will provide a brief overview of the Dbfetch service and illustrate various output formats of data retrievable via Dbfetch. In addition to the web browser-based applications of Dbfetch, we will also demonstrate accessing Dbfetch using the API.""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Retrieving biological data from EMBL-EBI resources using Dbfetch" ;
    schema1:provider [ a schema1:Organization ;
