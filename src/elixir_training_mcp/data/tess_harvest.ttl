<https://tess.elixir-europe.org/events/life-science-data-management-planning-workshop-8cc7b714-86c6-48fd-90c7-7a129fe31f99> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
