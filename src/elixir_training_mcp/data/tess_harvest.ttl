<https://tess.elixir-europe.org/materials/metagenomics-bioinformatics> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3174> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Life Scientists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Varsha Kale" ],
        [ a schema1:Person ;
            schema1:name "Rob Finn" ],
        [ a schema1:Person ;
            schema1:name "Alex Mitchell" ],
        [ a schema1:Person ;
            schema1:name "Guillermo Rangel Pineros" ],
        [ a schema1:Person ;
            schema1:name "Rebecca Campos" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Rob Finn" ],
        [ a schema1:Person ;
            schema1:name "Rebecca Campos" ],
        [ a schema1:Person ;
            schema1:name "Varsha Kale" ],
        [ a schema1:Person ;
            schema1:name "Guillermo Rangel Pineros" ],
        [ a schema1:Person ;
            schema1:name "Alex Mitchell" ] ;
    schema1:description """Metagenomics, the genomic analysis of microbial communities from samples like water and soil, involves high throughput sequencing of the microbial DNA, collecting, archiving and resharing the genomic data for taxonomic and functional analysis.\r
\r
This course covers the use of publicly available resources to manage, share, analyse and interpret metagenomics data, including marker gene, whole gene shotgun (WGS) and assembly-based approaches. It makes use of recorded lecutures and materials from the “Metagenomics Bioinformatics” training course that took place 17 - 20 July 2018 at EMBL-EBI.\r
\r
The recorded lecutre material is aimed at life scientists working in the field of metagenomics who are in the early stages of their data analysis. These recordings are suitable for beginners with an undergraduate knowledge of metagenomics.\r
\r
The exercises included in this course are intended for an audience with experience of using bioinformatics in their research. A working knowledge of Unix command line and the R statistical package is required. \r
\r
The exercises included in this course are optional and require the installation of tools and software. To simplify the installation of this software we have packaged the tools and software into a series of Docker containers that can be downloaded and installed. \r
\r
Please ensure that you have admin permission for your computer or computing environment. If downloading the container for the entire course you will need a minimum of 4CPUs, 16GB RAM of memory, 100GB Disk memory, 500MB GPU.""" ;
    schema1:identifier "10.6019/TOL.Metagenomics-t.2019.00001.1" ;
    schema1:keywords "MGnify",
        "Metagenomics",
        "Microbiology",
        "Sequence Analysis" ;
    schema1:learningResourceType "Tutorial" ;
    schema1:license <https://spdx.org/licenses/CC-BY-NC-SA-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "MGnify (was EBI Metagenomics)" ;
            schema1:url <https://bio.tools/tool/ebi_metagenomics> ] ;
    schema1:name "Metagenomics Bioinformatics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:url <https://www.ebi.ac.uk/training/online/course/metagenomics-bioinformatics> .

