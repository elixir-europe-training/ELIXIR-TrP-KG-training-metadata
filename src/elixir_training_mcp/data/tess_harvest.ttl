<https://tess.elixir-europe.org/events/clinic-mastering-long-term-goals-and-milestones> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This session is designed to hone your skills in setting and achieving long-term goals. Whether it's personal growth or professional advancement you're after, this course has got you covered.
Here's what you can look forward to:


	Discover the Power of Long-Term Planning: Dive deep into the world of long-term planning and understand its critical role in shaping a successful future.
	Set Meaningful Goals: Learn how to define clear, impactful goals in both your personal and professional life, turning your aspirations into reality.
	Actionable Milestones: We'll guide you through transforming these goals into achievable, measurable milestones. It's all about breaking down the big picture into manageable steps.
	Progress Tracking Tools: Stay on top of your journey with effective tools and strategies for monitoring your progress. Learn how to flexibly adjust your plans to meet evolving circumstances.
	Daily Tasks Alignment: Discover the art of aligning your daily tasks with your long-term objectives, ensuring every step you take is a step towards your ultimate goals.


This interactive session is more than just a learning experience; it's a hands-on workshop where you will create your own multi-year milestone plan. With expert guidance, templates, and exercises, you're all set to chart a course for success.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-06-19 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-06-19 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "online",
        "personal effectiveness",
        "time management" ;
    schema1:name "Clinic Mastering Long-Term Goals and Milestones" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/clinic-mastering-long-term-goals-and-milestones> .

