            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/basic-image-processing-using-fiji-3> .

<https://tess.elixir-europe.org/events/basic-linux-unix-workshop> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0605> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Graduate students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:coursePrerequisites "No prior knowledge is expected. " ;
    schema1:description """On the 3rd of March 2023, ELIXIR-Estonia will organize a face-to-face data management course in English: Basic LINUX/Unix workshop.\r
\r
This course is aimed to provide basic survival skills in Linux and the terminal environment. We will teach you how to access files and folders, move around and hopefully shake off the fear of getting stuck somewhere.​\r
\r
No prior knowledge is expected.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-03-03 16:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Estonia" ;
                            schema1:addressLocality "Tallinn" ;
                            schema1:postalCode "12618" ;
                            schema1:streetAddress "Akadeemia tee 23" ] ;
                    schema1:latitude "59.39908" ;
                    schema1:longitude "24.659934" ] ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Estonia" ] ;
            schema1:startDate "2023-03-03 11:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Command line",
        "Shell",
        "Workshop",
        "unix" ;
    schema1:name "Basic LINUX/Unix workshop" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <http://elixir.ut.ee> ],
        [ a schema1:Organization ;
            schema1:name "University of Tartu, Institute of Computer Science" ] ;
    schema1:teaches """* Obtain basic knowledge of dealing with files using the command line (Linux or Mac)\r
* Learn how to search over several text files, combine files, and extract specific knowledge.\r
* Tips and tricks for effective command line hacks that would save a lot of time.\r
""" ;
    schema1:url <https://elixir.ut.ee/node/477> .

