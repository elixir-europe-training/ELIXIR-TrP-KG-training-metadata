<https://tess.elixir-europe.org/events/ngs-data-analysis-on-the-command-line-session-4> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "NGS-analysis-cli - session4" ;
    schema1:description """This hands-on course will teach bioinformatic approaches for analyzing Illumina sequencing data. Our goal is to introduce the command line skills you need to make the most of your NGS data. \r
During this 4-day training we will first introduce the Linux environment, shell commands and basic R scripting.  And then we will focus on two NGS data analyses -- small RNA-seq and RNA-seq -- based on published datasets from the model organism Arabidopsis thaliana""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2022-04-04 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Strasbourg" ] ;
                    schema1:latitude "48.584614" ;
                    schema1:longitude "7.750713" ] ;
            schema1:maximumAttendeeCapacity 12 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BiGEst (http://bigest.unistra.fr/), UPR2357 (http://www.ibmp.cnrs.fr/)" ] ;
            schema1:startDate "2022-03-31 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "NGS data analysis on the command line - session 4" ;
    schema1:provider [ a schema1:Organization ;
