            schema1:url <https://doi.org/10.5281/zenodo.8130567> ],
        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ] ;
    schema1:name "Creating FAIR Quality assessment reports and draft of Data Papers from EML metadata with MetaShRIMPS" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Learn how to use the interactive tool Metashrimps
- Understand the challenges MetaShRIMPS is trying to respond to
- Learn how to create a FAIR Quality assessment report from a metadata using EML standard
- Understand the concept of Data Paper and learn how to produce it
- Explain the necessity of using such tools when producing ecological metadata""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/Metashrimps_tutorial/tutorial.html> ;
    schema1:version "6" .

