<https://tess.elixir-europe.org/materials/hands-on-for-visualize-ebv-cube-data-with-panoply-netcdf-viewer-tutorial> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
