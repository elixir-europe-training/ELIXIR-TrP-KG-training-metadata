            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.wUoZKE> ] ;
    schema1:name "ARC – Getting Started Guide" ;
    schema1:teaches """- Create an ARC\r
- Structure experimental data and metadata\r
- Annotate datasets with FAIR metadata\r
- Upload and share the ARC via the PlantDataHub""" ;
    schema1:url <https://nfdi4plants.org/nfdi4plants.knowledgebase/start-here/> .

