<https://tess.elixir-europe.org/events/software-carpentry-workshop-01-2021> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Rabea Müller, Konrad Förstner, Till Sauerwein (ZB MED/Associated Partner)\r
\r
Date\r
March 08-09 \r
\r
Location:\r
Online\r
\r
Contents:\r
Data, Shell, Git and GitHub, Python:\r
\r
Day 1\r
Before 	Pre-workshop survey\r
09:00 	Data Intro\r
10:30 	Morning break\r
12:00 	Lunch break\r
13:00 	Shell Lessons\r
14:15 	Afternoon break\r
15:30 	Wrap-up\r
16:00 	END\r
\r
Day 2\r
09:00 	Python Intro\r
10:30 	Morning break\r
12:00 	Lunch break\r
13:00 	Git Intro\r
14:15 	Afternoon break\r
15:30 	Wrap-up\r
15:45 	Post-workshop Survey\r
16:00 	END\r
\r
\r
Learning goals:\r
Get basic knowledge of the programming language python, the unix-shell, automating tasks, the version control software git and the cloud service GitHub,\r
\r
Prerequisites:\r
Attendees must use their own laptop with the following software already installed: Gitbash (Windows) / Shell (Linux) / Terminal (MAC OS) , Anaconda3 and Git. Every attendee also needs a GitHub account.\r
\r
Keywords:\r
programming, automation, version control, reproducible science\r
\r
Tools:\r
Shell, Git and GitHub,""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-03-09 16:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2021-03-08 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Software Carpentry Workshop 01 2021 " ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "de.NBI" ;
            schema1:url <https://www.denbi.de> ],
