    schema1:name "Mammalian Genetics and Genomics" ;
    schema1:startDate "2017-10-24 00:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.embl.de/training/events/2017/MMM17-01/index.html> .

<https://tess.elixir-europe.org/events/managing-a-bioinformatics-core-facility> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Charlotte Pearton" ;
    schema1:description "Bioinformatics core facilities play an essential role in enabling research in the molecular life sciences. This is constantly evolving as new research tools emerge, as experiments become increasingly data intensive, and as their clients – experimental researchers – become more exposed to the power of data-driven biology." ;
    schema1:endDate "2019-06-06 17:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
