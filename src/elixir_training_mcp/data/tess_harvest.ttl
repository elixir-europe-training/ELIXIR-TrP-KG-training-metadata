<https://tess.elixir-europe.org/events/accessing-and-interpreting-predicted-protein-structures-from-alphafold-database> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_1460>,
        <http://edamontology.org/data_1710>,
        <http://edamontology.org/topic_1317>,
        <http://edamontology.org/topic_3538> ;
    schema1:description "[AlphaFold database](https://alphafold.ebi.ac.uk/) (AlphaFold DB) provides open access to over 200 million protein structure predictions to accelerate scientific research. This webinar aims to provide a comprehensive introduction to AlphaFold DB. Participants will gain a clear understanding of the fundamental concepts, principles, and functionalities of the database. They will learn how to access and evaluate predicted protein structures, explore the underlying technologies and algorithms used in AlphaFold, and identify the potential applications of AlphaFold DB in their research" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-10-11 17:00:00 UTC"^^schema1:Date ;
