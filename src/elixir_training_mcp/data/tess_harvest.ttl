    schema1:inLanguage "en" ;
    schema1:keywords "ELN",
        "hands-on",
        "personal effectiveness" ;
    schema1:name "eLab Journal introduction - ELN - Brussels" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Comment on the lab set-up”",
        "“Compare different ways to structure the research topics in the ELN”",
        "“Configure inventory: sample types and storage units”",
        "“Create a naming structure for the lab: unified naming for samples projects studies and experiments”",
        "“Create and edit protocols”",
        "“Create and organise experiments”",
        "“Create experiments and experiment templates”",
        "“Differentiate the 3 components of the ELN: inventory protocols journal”",
        "“Explain advantages of the chosen platform: eLabJournal”",
        "“Explain and use the different levels of support available”",
        "“Explain the importance of ELN for your project”",
        "“Explain the importance of the ELN”",
        "“Guided activities”",
        "“Interact with the inventory within the lab group”",
        "“List benefits of using ELN in their research”",
        "“Search and find inventory and journal entries”",
        "“Track samples in the inventory”",
        "“Track supplies and booking equipment”",
        "“Use collaborative features (sharing experiments add collaborators etc)”" ;
    schema1:url <https://training.vib.be/all-trainings/elab-journal-introduction-eln-brussels> .

