<https://tess.elixir-europe.org/events/project-management-67a76372-95ba-40e9-9119-74771323c62a> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Managing research projects often involves uncertainty, multiple stakeholders, and shifting priorities. Unlike traditional project environments, academic and scientific projects rarely follow a linear path. This course offers a pragmatic, research-specific approach to project management, helping researchers gain more structure and control over their work without losing flexibility. Through a combination of online learning, interactive workshops, and peer engagement, participants will learn to lead projects more effectively and deliver results with greater confidence." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
