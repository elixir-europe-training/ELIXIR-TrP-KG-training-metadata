<https://tess.elixir-europe.org/materials/bioinformatics-for-proteomics> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0121> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "biologists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Lennart Martens" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:description """Mass spectrometry based proteomics studies typically aim at measuring and comparing changes in biological samples. This however strongly relies on our ability to interpret the massive amounts of data produced by modern mass spectrometers. Therefore, methods and tools have been developed to tackle four major topics:\r
\r
- [Identification](https://www.compomics.com/bioinformatics-for-proteomics/identification/)\r
- [Functional Analysis](https://www.compomics.com/bioinformatics-for-proteomics/functional-analysis/)\r
- [Data Sharing](https://www.compomics.com/bioinformatics-for-proteomics/data-sharing/)\r
- [Quantification](https://www.compomics.com/bioinformatics-for-proteomics/quantification/)\r
\r
This tutorial aims at providing the basis for any user to go through the following workflow: (1) identify peptides, proteins, and their modifications, (2) annotate the data with existing biological knowledge, and (3) share the data using online repositories. Finally, the different techniques for quantifying peptides and proteins will be introduced.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Proteomics" ;
    schema1:learningResourceType "scripts",
        "slides" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:name "Bioinformatics for Proteomics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Belgium" ;
            schema1:url <https://www.elixir-belgium.org/training> ] ;
    schema1:url <https://www.compomics.com/bioinformatics-for-proteomics/> .

<https://tess.elixir-europe.org/materials/bioinformatics-for-t-cell-immunology> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description "The Bioinformatics for T-Cell immunology course, which introduced and explored a number of key bioinformatics tools and resources that can be applied to T-cell immunological research, ran in July 2022. Here, we have made the course materials available for you to access at any time." ;
    schema1:learningResourceType "Course materials" ;
