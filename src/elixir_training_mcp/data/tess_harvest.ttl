<https://tess.elixir-europe.org/materials/dsw-template-development-kit-the-tutorial> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "data stewards" ],
        [ a schema1:Audience ;
            schema1:audienceType "data managers" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Marek Suchanek" ] ;
    schema1:description """[Data Stewardship Wizard](ds-wizard.org) is a flexible questionnaire-based tool that uses Jinja2 templates to produce documents. It allows creating documents in practically any textual format. Such documents can be intended for both humans (HTML, Markdown, reStructuredText, etc.) and machines (e.g. RDF, YAML, or JSON). Our Template Development Kit (DSW TDK) is a command-line tool to make the work on templates efficient.\r
\r
In this tutorial, we demonstrate all the features of TDK (v2.8.1) and also how to access and print out replies from a questionnaire using Jinja2 templates. Data Stewardship Wizard as a cutting-edge data management planning tool \r
\r
Video available [here](https://youtu.be/FFElv-e24NE).""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:identifier "10.5281/zenodo.4286272" ;
    schema1:keywords "DMP templates",
        "FAIR",
        "data management",
        "data management plan",
        "data stewardship",
        "software tools",
        "template development" ;
    schema1:learningResourceType "Slides",
