<https://tess.elixir-europe.org/events/computational-approaches-to-understanding-and-engineering-enzyme-catalysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "FEBS Advanced Practical and Lecture Course" ;
    schema1:coursePrerequisites "Application time : 17th February - 30th June" ;
    schema1:description """The course is aimed at disseminating important in silico tools, such that experimental researchers, Ph.D. students, and young postdocs, can apply them in their research projects. The topics addressed in the course are covered by leading scientists. The computational expert speakers will give comprehensive lectures and demonstrations on how to use their web-based applications and software, whereas the experimental researchers will give lectures on how these in silico tools have successfully guided them towards finding answers related to their research in the field of enzyme catalysis. The aim of this advanced course is to bring together computational and experimental communities providing a valuable bridge between theory and experiment. Our program provides opportunities for active interactions between all the participants through lectures, demonstrations, tutorials, discussions, as well as poster and oral presentations given by the student participants.\r
 \r
\r
Looking forward to meeting you in September!\r
\r
Aleksandra Maršavelski and Outi Lampela\r
On behalf of the Course Organizing committee""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-09-29 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Croatia" ;
                            schema1:addressLocality "Zagreb" ;
                            schema1:postalCode "10000" ;
                            schema1:streetAddress "University of Zagreb, Faculty of Science, Department of Chemistry" ] ;
                    schema1:latitude "45.826322" ;
                    schema1:longitude "15.988476" ] ;
            schema1:startDate "2023-09-25 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Computational Approaches to Understanding and Engineering Enzyme Catalysis" ;
    schema1:url <https://computationalenzymeengineering2023.febsevents.org/> .

<https://tess.elixir-europe.org/events/computational-approaches-to-understanding-and-engineering-enzyme-catalysis-0f3999b9-710e-4f94-8973-fc5eb8a3aa9e> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:alternateName "FEBS advanced course" ;
    schema1:description "The course is aimed at disseminating important in silico tools, such that experimental researchers, Ph.D. students, and young postdocs, can apply them in their research projects. The topics addressed in the course are covered by leading scientists. The computational expert speakers will give comprehensive lectures and demonstrations on how to use their web-based applications and software, whereas the experimental researchers will give lectures on how these in silico tools have successfully guided them towards finding answers related to their research in the field of enzyme catalysis and protein design. The aim of this advanced course is to bring together computational and experimental communities providing a valuable bridge between theory and experiment. Our program provides opportunities for active interactions between all the participants through lectures, demonstrations, tutorials, discussions, as well as poster and oral presentations given by the student participants." ;
    schema1:endDate "2025-10-03 12:00:00 UTC"^^schema1:Date ;
