<https://tess.elixir-europe.org/events/containers-and-workflow-pipelines-for-reproducible-and-automated-data-analysis-a6630c2e-fbc6-4626-80bd-ed31e248029c> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """Containers\r
\r
\r
	Learn the concept of and the difference between Docker &amp; Singularity containers \r
	Write a Docker recipe, build and run a Docker image and containers\r
	Pull and push Docker container to / from Docker hub\r
	Docker files and layers; Docker cashing\r
	Working with volumes\r
	Pull Docker containers as a Singularity image\r
\r
\r
Pipelines\r
\r
\r
	Understand Nextflow's basic concepts: channels, processes, modules, workflows, etc. \r
	Write and run a Nextflow pipeline \r
	Write and modify config files for storing parameters related to computing hardware as well as pipeline dependent parameters\r
\r
  \r
\r
\r
This workshop will be organised online on Thursday 20 and 27 May 2021. \r
\r
\r
\r
\r
 """ ;
    schema1:endDate "2021-05-27 00:00:00 UTC"^^schema1:Date ;
    schema1:name "Containers and Workflow Pipelines for reproducible and automated data analysis" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "VIB Bioinformatics Core" ] ;
    schema1:startDate "2021-05-20 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://training.vib.be/product/322> .

<https://tess.elixir-europe.org/events/elixir-beacons-at-ismb-eccb> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Federating Data Discoverability" ;
    schema1:description """This workshop will demonstrate the Beacon API, a data discovery protocol that allows users to determine the presence or absence of a particular allele in a dataset, without disclosing any further data differentiating the individuals it contains.\r
\r
The ELIXIR Beacons project is a Driver Project of the Global Alliance for Genomics and Health that provides a simple way to federate data discoverability. The ELIXIR Beacons protocol can allows any variation data back end to be connected to the ELIXIR Beacons network which can then be queried to ask questions like _'does this dataset have any information about allele 'X' at position 'Y' in the genome?'_.\r
\r
This workshop will show how recent extensions to the Beacon API has extended its functionality by adding support for additional types of genomic variants and improved metadata support. \r
\r
Additionally we will also demonstrate the accompanying ELIXIR Beacon reference implementation which utilises risk mitigation strategies by integrating the ELIXIR Authorization and Authentication Infrastructure (AAI), demonstrating to data owners how to light Beacons at different tiers of data access: open, registered, or controlled.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-07-22 16:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Switzerland" ;
                            schema1:addressLocality "Basel" ;
                            schema1:streetAddress "Congress Center Basel" ] ;
                    schema1:latitude "47.559599" ;
                    schema1:longitude "7.588576" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Gary Saunders" ] ;
            schema1:startDate "2019-07-22 14:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "beacon" ;
    schema1:name "ELIXIR Beacons (at ISMB / ECCB)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Spain" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:url <https://elixir-europe.org/events/elixir-ismb-eccb-2019> .

