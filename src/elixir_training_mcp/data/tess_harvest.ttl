<https://tess.elixir-europe.org/materials/advanced-r> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Simon Andrews" ] ;
    schema1:description """This course follows on from the introductory course. It goes into more detail on practical guides to filtering and combining complex data sets. It also looks at other core R concepts such as looping with apply statements and using packages. Finally it looks at how to document your R analyses and generate complete analysis reports.\r
\r
**Course Content**\r
\r
* Filtering and selection review\r
* Text manipulation\r
* Merging large datasets\r
* Looping\r
* Using and writing functions\r
* R packages\r
* Documenting your analysis\r
\r
**Course Material**\r
\r
* [Course Manual (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Advanced_R_Course/Advanced%20R%20course%20booklet.pdf)\r
* [Course Manual (docx)](http://www.bioinformatics.babraham.ac.uk/training/Advanced_R_Course/Advanced%20R%20course%20booklet.docx)\r
* [Course Exercises (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Advanced_R_Course/Advanced%20R%20course%20Exercises.pdf)\r
* [Course Exercises (docx)](http://www.bioinformatics.babraham.ac.uk/training/Advanced_R_Course/Advanced%20R%20course%20Exercises.docx)\r
* [Course data (zip)](http://www.bioinformatics.babraham.ac.uk/training/Advanced_R_Course/Advanced%20R%20Data.zip)""" ;
    schema1:educationalLevel "advanced" ;
    schema1:keywords "Babraham Institute",
        "R programming" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/other-nc> ;
    schema1:name "Advanced R" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Bioinformatics and Biomathematics Training Hub" ;
