<https://tess.elixir-europe.org/events/making-clinical-datasets-fair> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:coursePrerequisites """Familiarity with FAIR principles.\r
Participants are encouraged to check the Galaxy platform and available training materials.""" ;
    schema1:description """The life science community is generally very good at sharing omics data on platforms such as GEO and ArrayExpress.  However, the metadata and clinical data associated with the omics datasets are often very sparse.  Tracking the metadata and clinical data of omics datasets can be time-consuming for both the data owner and the researcher.  It is a significant hurdle when compiling enriched omics datasets for data analysis and using machine learning techniques.\r
\r
In this training, you will learn the benefits of making clinical datasets FAIR (Findable, Accessible, Interoperable, and Reusable) and the tools and techniques to do so.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-05-17 14:00:00 UTC"^^schema1:Date ;
            schema1:startDate "2024-05-17 12:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Making clinical datasets FAIR" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ],
        [ a schema1:Organization ;
            schema1:name "ELXIR-UK DaSH" ;
            schema1:url <https://elixiruknode.org/projects/elixir-uk-dash/> ] ;
    schema1:url <https://elixiruknode.org/event/making-clinical-datasets-fair/> .

