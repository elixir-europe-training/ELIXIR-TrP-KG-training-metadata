<https://tess.elixir-europe.org/events/high-performance-computing-on-the-vlaamse-supercomputer-42c32edd-a255-4ece-b6c8-20c6e546e0c4> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "High Performance Computing (HPC) is essential for researchers working with large datasets, software that only runs on Linux, or computationally intensive tasks. This introductory training is designed for researchers new to HPC who need to use the Vlaamse SuperComputer (VSC) infrastructure in one of our advanced trainings, like Variant analysis using long-reads and Genome assembly using long-reads. By attending this course, participants will gain the practical skills needed to access and navigate the VSC, manage data transfers, and run jobs efficiently. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
