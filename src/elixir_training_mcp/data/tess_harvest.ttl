<https://tess.elixir-europe.org/events/best-practices-in-research-data-management-and-stewardship> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description "This course is aimed at project managers,  researchers and graduate students in the biomedical sciences who wish to  improve their skills on data handling. The course will introduce the concepts  of the FAIR principles for data,  the concept and implementation of data stewardship as well as practical  aspects of day to day data management and data management plans, which are  required in many grant applications." ;
    schema1:endDate "2020-05-19 00:00:00 UTC"^^schema1:Date ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:streetAddress "Esch-sur-Alzette, Luxembourg" ] ] ;
    schema1:name "Best practices in research data management and stewardship" ;
    schema1:startDate "2020-05-19 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://elixir-luxembourg.org/events/2020_01_27_research_data_management> .

<https://tess.elixir-europe.org/events/best-practices-in-research-data-management-and-stewardship-03cd7411-34d0-41bc-9c6a-50d6f8963ad0> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "ELIXIR-DMP-DS-training" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Life Science Researchers" ] ;
    schema1:description """The course is made up of seven sessions covering:\r
    - Data management planning\r
    - Data protection in research, requirements and responsibilities originating from GDPR\r
    - Practicalities of data handling\r
    - Reproducible computational analyses\r
    - Exploratory analyses, reproducible manuscripts\r
    - FAIR data principles\r
    - Data publishing and archival\r
""" ;
