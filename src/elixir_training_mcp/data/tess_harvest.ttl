                            schema1:addressLocality "Online" ;
                            schema1:streetAddress "United Kingdom" ] ;
                    schema1:latitude "55.378051" ;
                    schema1:longitude "-3.435973" ] ;
            schema1:startDate "2024-02-20 09:30:00 UTC"^^schema1:Date ] ;
    schema1:name "NEOF - Phylogenomics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
