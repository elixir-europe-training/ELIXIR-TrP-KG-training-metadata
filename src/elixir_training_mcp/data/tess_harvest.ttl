<https://tess.elixir-europe.org/materials/bioinformatics-sequence-analysis-web-services-with-job-dispatcher> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3372> ;
    schema1:description "The EMBL-EBI Job Dispatcher framework (https://www.ebi.ac.uk/services) provides free access to several core Bioinformatics tools and related data, via the web or programmatically via Web Services APIs. In this webinar, we will give an overview of the Web Interface and RESTful API. We will then explore how to use our Sample Clients to perform various bioinformatics analysis, and how we can leverage CWL to run analysis workflows." ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Bioinformatics sequence analysis web services with Job Dispatcher" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/bioinformatics-sequence-analysis-web-services-job-dispatcher> .

<https://tess.elixir-europe.org/materials/bioinformatics-summer-school-2019> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0121>,
        <http://edamontology.org/topic_2269>,
        <http://edamontology.org/topic_3170>,
        <http://edamontology.org/topic_3391> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD students" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Lieven Clement" ],
        [ a schema1:Person ;
            schema1:name "Laurent Gatto" ],
        [ a schema1:Person ;
            schema1:name "Koen Van den Berge" ],
        [ a schema1:Person ;
            schema1:name "Janick Mathys" ],
        [ a schema1:Person ;
            schema1:name "Oliver Crook" ],
        [ a schema1:Person ;
            schema1:name "Charlotte Soneson" ],
        [ a schema1:Person ;
            schema1:name "Martin Morgan" ] ;
    schema1:description "This one-week intensive summer school in bioinformatics will focus on data analysis and high throughput biology, with a special focus on R/Bioconductor and its application to a wide range of topics across bioinformatics and computational biology. The course is intended for researchers who are familiar with omics experimental technologies and their applications in biology, have had some exposure with R, and who want to learn or expand their bioinformatics skills." ;
    schema1:educationalLevel "intermediate" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Bioinformatics Summer School 2019" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "UCLouvain Bioinformatics Platform" ;
            schema1:url <https://uclouvain.be/en/research/bioinfo> ] ;
    schema1:url <https://uclouvain-cbio.github.io/BSS2019/#schedule> .

<https://tess.elixir-europe.org/materials/bioinformatics-the-power-of-computers-in-biology-a-practical-guide> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0080> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Terri Attwood" ] ;
    schema1:description """This Practical Guide in the Bringing Bioinformatics into the Classroom series introduces simple bioinformatics approaches for database searching and sequence analysis. A ‘mystery’ gene is used as an exemplar: we first characterise the gene, then use it to explore the impact of gene loss in humans. Analyses are run both online and at the command line, the latter using Raspberry Pi computers running the 4273π variant of Linux (4273pi.org).
Specifically, this Guide introduces a popular Web-based tool for searching biological sequence databases, and shows how similar functionality can be achieved using the Linux command line. On reading the Guide and completing the exercises, users will be able to: i) search biological sequence databases using the online program BLAST, and navigate GenPept sequence records; ii) execute some basic Linux commands to perform a set of simple file-manipulation tasks; iii) perform BLAST searches via the Linux command line; and iv) evaluate the biological implications of search results, with reference to mutations and function.""" ;
    schema1:keywords "Basic bioinformatics",
        "Basic linux commands",
        "Bioinformatics schools",
        "Gene loss",
        "Genetic mutation",
        "Raspberry pi computers",
        "Sequence analysis",
        "Sequence database searching",
        "Training materials" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Bioinformatics - the Power of Computers in Biology: A Practical Guide" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GOBLET" ;
            schema1:url <http://www.mygoblet.org> ] ;
    schema1:url <https://www.mygoblet.org/training-portal/materials/bioinformatics-power-computers-biology-practical-guide> .

