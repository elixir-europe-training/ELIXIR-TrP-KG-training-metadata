<https://tess.elixir-europe.org/events/software-carpentry-workshop-3acee97f-5c7d-48a0-b87d-a6523f239ce9> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
