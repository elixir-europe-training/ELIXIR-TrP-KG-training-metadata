<https://tess.elixir-europe.org/materials/bioinformatics-for-the-terrified> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0089>,
        <http://edamontology.org/topic_0091> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Clinicians" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ] ;
    schema1:description "What is bioinformatics and where does it fit with bench-based life science research? Find out more about bioinformatics tools and resources that are available and how you can start to apply them in your research." ;
