<https://tess.elixir-europe.org/events/helis-course-fair-data-stewardship> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_4012> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD candidate" ] ;
    schema1:description """Did you ever wonder how to improve your data handling in your daily research practice? Want to improve the FAIRness of your data? Did you recently start a job as data steward? Are you thinking of starting a career as a data steward in the life sciences in academia or industry? Join this introductory course to FAIR data stewardship in the life sciences!\r
\r
The course exists of the following six half-days, that together form a full course:\r
* March 17, 2021 (13-17 CET)\r
* March 18 (13-17)\r
* March 22 (9-13)\r
* March 24 (9-13) \r
* March 29 (9-13)\r
* March 31 (9-13)\r
\r
During this course researchers, data stewards and experts of fields related to data stewardship will introduce you to several areas of research data management and technologies which ease the process of creating and maintaining FAIR research data.\r
\r
The course will introduce the trainees to important concepts of data stewardship and the data steward competency framework. We start with a general introduction covering the data life cycle and the FAIR data principles.\r
\r
We will pass the stages of the data life cycle in more detail in the training modules of the course. The following topics will be discussed at an introductory level:\r
* Data stewardship competency framework &amp; the FAIR data stewardship landscape\r
* (Reviewing) data management plans\r
* Informed consent procedures \r
* Data discovery and capturing data \r
* Preregistration \r
* Data security and privacy\r
* Infrastructure for storing and sharing data\r
* Tools for processing and analysing data\r
* Organising, versioning and documenting data\r
* Data and software carpentry\r
* Archiving data\r
* Data rights\r
* FAIR data \r
* Metadata &amp; ontologies """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-03-31 00:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Online" ;
                            schema1:addressLocality "Online" ;
                            schema1:streetAddress "Online" ] ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "DTLS - Dutch Techcentre For Life Sciences" ] ;
            schema1:startDate "2021-03-17 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Data analysis",
        "Data collection",
        "Data management planning",
        "Data preserving",
        "Data processing",
        "Data reuse",
        "Data sharing" ;
    schema1:name "Helis Academy course FAIR data stewardship 2021" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Netherlands" ;
            schema1:url <http://www.dtls.nl/courses/> ],
        [ a schema1:Organization ;
            schema1:name "DTLS - Dutch Techcentre For Life Sciences" ;
            schema1:url <http://www.dtls.nl> ] ;
    schema1:url <https://www.aanmelder.nl/fair-data-stewardship-2021> .

