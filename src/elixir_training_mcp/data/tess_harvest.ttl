<https://tess.elixir-europe.org/materials/using-bioinformatics-to-hunt-sars-cov-2-its-variants-its-origins-a-practical-guide> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Training Designers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Trainers" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training instructors" ],
        [ a schema1:Audience ;
            schema1:audienceType "Life Science Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "post-docs" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "The GOBLET Foundation" ],
        [ a schema1:Person ;
            schema1:name "Philippe Lemercier" ],
        [ a schema1:Person ;
            schema1:name "Marie-Claude Blatter" ],
        [ a schema1:Person ;
            schema1:name "Teresa Attwood" ] ;
    schema1:description """This Practical Guide outlines basic bioinformatics approaches for exploring the SARS-CoV-2 genome and its corresponding proteins, focusing on the protein exposed on the viral particle surface: the spike protein. The ways in which bioinformatics can be harnessed to study a new virus, its genome, its proteins, its origins and its evolution are explored.\r
\r
Specifically, this Guide introduces a range of bioinformatics tools for comparing and analysing nucleotide and protein sequences. On reading the Guide and completing the exercises, you will be able to:\r
- discover SARS-CoV-2 genome(s) available in a public nucleotide repository;\r
- compare SARS-CoV-2 genome sequences, look for their differences (mutations) and identify the variants;\r
- translate the spike gene into its encoded protein sequence;\r
- discover the 3D structure of the spike protein;\r
- understand the impact of mutations on infectivity and immune responses; and\r
- infer the origin of SARS-CoV-2 by comparing coronavirus spike protein sequences from different animal origins.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "https://doi.org/10.7490/f1000research.1118746.1" ;
    schema1:keywords "Bioinformatics for schools, basic bioinformatics, SARS-CoV-2 pandemic, genome analysis, protein sequence analysis, protein structure analysis, virus variants, spike protein, training material" ;
    schema1:learningResourceType "Training materials" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:name "Using bioinformatics to hunt SARS-CoV-2, its variants & its origins – a practical guide" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Switzerland" ;
            schema1:url <http://www.sib.swiss/training/> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ],
        <https://ror.org/002n09z45> ;
    schema1:url <https://f1000research.com/documents/10-836> .

<https://tess.elixir-europe.org/materials/using-bioinformatics-to-understand-genetic-diseases-a-practical-guide> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Terri Attwood" ] ;
    schema1:description """This Practical Guide in the Bringing Bioinformatics into the Classroom series outlines a number of basic bioinformatics approaches that can be used to understand the molecular basis of genetic diseases. A rare variation in the insulin gene is discussed, and the impact of the variation on the gene product, and how this results in disease, is explored.
Specifically, this Guide introduces a range of commonly used bioinformatics tools and databases with which to analyse both DNA and protein sequences, and protein structures. On reading the Guide and completing the exercises, users will be able to: i) investigate the locations of genes on the human genome using a genome browser; ii) compare DNA sequences using an alignment tool; iii) translate a DNA sequence into its protein product; iv) search a protein structure database, and visualise the 3D structure of insulin; and v) infer whether insulin is specific to humans by using protein sequence database search tools.""" ;
    schema1:keywords "Basic bioinformatics",
        "Bioinformatics schools",
        "Gene finding",
        "Genetic mutation",
        "Insulin structure",
        "Sequence alignment",
        "Sequence database searching",
        "Training material" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Using Bioinformatics to Understand Genetic Diseases: A Practical Guide" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GOBLET" ;
            schema1:url <http://www.mygoblet.org> ] ;
    schema1:url <https://www.mygoblet.org/training-portal/materials/using-bioinformatics-understand-genetic-diseases-practical-guide> .

