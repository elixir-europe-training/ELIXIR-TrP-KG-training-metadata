<https://tess.elixir-europe.org/events/leadership-in-practice-443696a8-2a5b-43e5-9f6b-8c1b6e5f361c> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Leadership is not reserved for formal management roles — it starts during your PhD, when guiding students, collaborating in teams, or influencing peers. This workshop is designed for early-career researchers who want to explore what leadership means in practice and build essential skills for guiding others.You will explore the differences between managing, coaching, and leading, gain insights into your personal leadership style, and discover practical tools for setting goals and giving feedback. Whether you’re leading a thesis student or preparing for a future leadership role, this course will help you grow with confidence and clarity." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
