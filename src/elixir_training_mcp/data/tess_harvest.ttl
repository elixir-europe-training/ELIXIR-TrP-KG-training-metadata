<https://tess.elixir-europe.org/materials/rdmbites-rnaseq-data-submission-arrayexpress> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Robert Andrews" ],
        [ a schema1:Person ;
            schema1:name "Korneel Hens" ] ;
    schema1:description """Relevant links:\r
RDMbite “High-throughput sequencing data repositories”: https://youtu.be/ZoU4R3xVn3o?si=NfD_FWIW7CNZV-1-\r
MIAME: https://www.fged.org/projects/miame/\r
MINSEQE: https://www.fged.org/projects/minseqe/\r
Submitting data to ArrayExpress: https://www.ebi.ac.uk/training/online/courses/array-express-quick-tour/submitting-data-to-arrayexpress/\r
Accepted Raw data formats: https://www.ebi.ac.uk/fg/annotare/help/accepted_raw_ma_file_formats.html\r
ArrayExpress: https://www.ebi.ac.uk/biostudies/arrayexpress\r
Submitting RNAseq data via ArrayExpress: https://www.ebi.ac.uk/biostudies/arrayexpress \r
__________________\r
Creators: Korneel Hens (https://orcid.org/0000-0002-0362-7007 )\r
Reviewers: Robert Andrews (https://orcid.org/0000-0002-3491-2361) \r
___________________\r
The RDMbites are funded by the ELIXIR-UK: FAIR Data Stewardship training UKRI award (MR/V038966/1)\r
___________________\r
00:13 Learning objectives\r
00:27 What is ArrayExpress\r
