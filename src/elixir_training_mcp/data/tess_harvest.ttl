    schema1:url <https://www.mygoblet.org/training-portal/materials/using-r-python> .

<https://tess.elixir-europe.org/materials/using-rnacentral-to-explore-and-investigate-non-coding-rna-sequences> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0659> ;
    schema1:description """Non-coding RNAs (ncRNAs) are a key molecule for life. They are involved in many complex biological processes, from gene regulation to translation. This complexity has led to an explosion of many different databases with specialised focuses and data. RNAcentral provides users a single entry point into the complexity of ncRNA data. \r
\r
This webinar will show users how to effectively navigate and search RNAcentral. Additionally, we will show users how to download data for their own analysis and tooling. We will highlight commonly used data formats such as BED/GFF3 and FASTA files. Finally, we will demonstrate how to use the RNAcentral sequence search to quickly explore sequences.\r
\r
 """ ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Using RNAcentral to explore and investigate non-coding RNA sequences" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/using-rnacentral-explore-and-investigate-non-coding-rna-sequences> .

<https://tess.elixir-europe.org/materials/using-the-interpro-website-in-your-research> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0078>,
        <http://edamontology.org/topic_1775> ;
    schema1:description """This is the second part of a webinar series on InterPro which is held between May 6th 2020 and May 20th 2020.\r
\r
InterPro is a database that helps users to understand the possible functions of proteins sequence by identifying what family it belongs to or what domains and motifs it contains.\r
\r
To deal with the growing volume of protein sequence data and an increasing demand to retrieve subsets of the data, the InterPro website has been entirely redesigned. It allows more flexibility and provides additional features to be used by the scientific community working on protein sequences. This webinar will guide you through searching and exploring the data available in the InterPro database and will show you how it can help finding data for your research.""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Using the InterPro website in your research" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/using-interpro-website-your-research> .

<https://tess.elixir-europe.org/materials/using-the-norwegian-e-infrastructure-for-life-science-and-usegalaxy-no> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
