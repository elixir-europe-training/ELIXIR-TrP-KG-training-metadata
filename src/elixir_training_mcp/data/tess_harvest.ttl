<https://tess.elixir-europe.org/materials/fairtracks-and-omnipy-fairtracks-interoperability-story> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0219>,
        <http://edamontology.org/topic_0769>,
        <http://edamontology.org/topic_3345>,
        <http://edamontology.org/topic_3571>,
        <http://edamontology.org/topic_3572> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "EIP members" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Sveinung Gundersen" ] ;
    schema1:dateCreated "2023-03-07"^^schema1:Date ;
    schema1:datePublished "2024-01-29"^^schema1:Date ;
    schema1:description "Presentation of the FAIRtracks project and the Omnipy Python library, part of a presentation series on \"ELIXIR Interoperability stories\" for the ELIXIR Interoperability Platform, in a meeting March 7, 2023. FAIRtracks is a metadata model and related service infrastructure developed to help FAIRify genomic annotation datasets. Omnipy was developed in the context of the FAIRtracks project as a means to develop scalable and maintainable metadata transformation flows. This presentation has a particular focus on Omnipy as it is a general Python library that is relevant for use in a range of contexts where there is a need for structured functionality for (meta)data wrangling and transformation." ;
    schema1:educationalLevel "intermediate" ;
    schema1:identifier "10.5281/zenodo.10580646" ;
    schema1:learningResourceType "Presentation" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Ontology Lookup Service" ;
            schema1:url <https://bio.tools/tool/ols> ],
        [ a schema1:Thing ;
            schema1:name "FAIRtracks" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.807b9d> ],
        [ a schema1:Thing ;
            schema1:name "omnipy" ;
            schema1:url <https://bio.tools/tool/omnipy> ],
        [ a schema1:Thing ;
            schema1:name "Identifiers.org" ;
            schema1:url <https://bio.tools/tool/identifiers.org> ] ;
    schema1:name "FAIRtracks and Omnipy – FAIRtracks interoperability story" ;
    schema1:url <https://zenodo.org/records/10580646> .

