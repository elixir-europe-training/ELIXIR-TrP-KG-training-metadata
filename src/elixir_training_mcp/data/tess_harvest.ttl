<https://tess.elixir-europe.org/materials/managing-and-making-the-most-of-your-data> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Marta Teperek" ],
        [ a schema1:Person ;
            schema1:name "Yasemin Türkyilmaz-van der Velden" ] ;
    schema1:description "In this webinar Marta Teperek &amp; Yasemin Türkyilmaz-van der Velden provide an overview of what data management is highlighting common misconceptions, pitfalls and best practice. They pose the questions 'Is there a reproducibility crisis in science'? and 'How much data would lose if your laptop was stolen?'. This is followed up with an exploration of the selfish benefits of data management and a few hints, tips to get you started on your data management journey." ;
    schema1:learningResourceType "Video" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:name "Managing and making the most of your data" ;
    schema1:provider [ a schema1:Organization ;
