<https://tess.elixir-europe.org/materials/query-an-annotated-mobile-genetic-element-database-to-identify-and-annotate-genetic-elements-e-g-plasmids-in-metagenomics-data> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0080>,
        <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_0798>,
        <http://edamontology.org/topic_3174>,
        <http://edamontology.org/topic_3301>,
        <http://edamontology.org/topic_3697> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
