<https://tess.elixir-europe.org/events/cabana-symposium-bioinformatics-and-biodiversity-unlocking-new-tools-for-biodiversity-research> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Derrin Crawte" ;
    schema1:description "This 3-day symposium will cover a broad range of topics in DNA barcoding and metabarcoding bioinformatics for biodiversity studies." ;
    schema1:endDate "2019-09-04 17:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Brazil" ;
                    schema1:addressLocality "Belem" ;
                    schema1:postalCode "66055-090" ;
                    schema1:streetAddress "Vale Institute of Technology (ITV), R. Boaventura da Silva" ] ;
            schema1:latitude "-1.45056" ;
            schema1:longitude "-48.468245" ] ;
    schema1:name "CABANA Symposium: Bioinformatics and Biodiversity - Unlocking new tools for biodiversity research" ;
    schema1:startDate "2019-09-02 08:30:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2019/cabana-symposium-bioinformatics-and-biodiversity-unlocking-new-tools-biodiversity-research> .

<https://tess.elixir-europe.org/events/cabana-symposium-bioinformatics-and-biodiversity-unlocking-new-tools-for-biodiversity-research-96b152bc-2755-49f7-a23a-e7ab9f53669d> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3050> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType """This symposium is aimed at a broad audience. We will welcome researchers from postgraduate level upwards who conduct biodiversity studies and are interested in initiating or boosting molecular and computational approaches to their work. We also welcome participation from those in industry, government, funding agencies or other stakeholders interested in establishing projects or programs on the use of molecular tools for biodiversity assessment, monitoring or species identification.\r
\r
\r
The symposium will present a higher level view of the topic. Specific molecular or computational skills are not necessary. However, a general understanding of molecular approaches will be very useful, as will an understanding of current practices for biodiversity assessment.\r
\r
Please note this symposium will be in English, however, the speakers may be fluent in either Spanish/Portuguese, and can offer language support where feasible.\r
\r
A number of travel fellowships are available for this course - early-stage researchers and researchers from underrepresented groups are especially encouraged to apply for CABANA travel fellowships. You can apply for travel fellowships via the course application form.\r
&nbsp;""" ] ;
    schema1:description """This symposium will cover a broad range of topics in DNA barcoding and metabarcoding bioinformatics for biodiversity studies. Biodiversity experts from across Latin America and beyond will provide an introduction to the field, including general approaches and technologies for studying biodiversity in different contexts. Sample collection and processing, selecting appropriate markers and various analysis methods will be covered, as will regulatory issues in Latin America.

**2 day symposium in Bragança, Pará State**

There will be a second symposium titled, “**IV North Northeast Symposium on Bioinformatics**” in Bragança - PA between 4-5th September. The topic will also be biodiversity. It will be a good opportunity to connect with a wider bioinformatics community and to also see a beautiful spot near the coast. For further information please follow this [link](https://doity.com.br/ivsnnb).""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-09-04 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Brazil" ;
                            schema1:addressRegion "Belém" ;
                            schema1:postalCode "66055-090" ;
                            schema1:streetAddress "Vale Institute of Technology (ITV), R. Boaventura da Silva, , 955 - Nazaré" ] ] ;
            schema1:maximumAttendeeCapacity 100 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-09-02 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "CABANA Symposium: Bioinformatics and Biodiversity - Unlocking new tools for biodiversity research" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "Vale Institute of Technology (ITV)" ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/cabana-symposium-bioinformatics-and-biodiversity-unlocking-new-tools-biodiversity-research> .

