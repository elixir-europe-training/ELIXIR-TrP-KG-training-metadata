<https://tess.elixir-europe.org/events/ips-cell-technology-in-drug-discovery-and-development> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """Since their discovery/invention a little less than a decade ago, induced pluripotent stem (iPS) cells inspired hope to become a powerful tool for drug discovery and development applications. With advances in reprogramming and differentiation technologies, as well as with the recent availability of gene editing approaches, we are finally able to create more complex and phenotypically accurate cellular models based on iPS cell technology. This opens new and exciting opportunities for iPS cell utilization in early discovery, preclinical and translational research. Cambridge Healthtech Institute’s inaugural iPS Cell Technology in Drug Discovery and Development conference is designed to bring together experts and bench scientists working with iPS cells and end users of their services, researchers working on finding cures for specific diseases and disorders.
""" ;
    schema1:endDate "2016-06-16 00:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "United States of America" ;
                    schema1:addressLocality "Boston" ;
                    schema1:streetAddress "Westin Boston Waterfront" ] ;
            schema1:latitude "42.360083" ;
            schema1:longitude "-71.05888" ] ;
    schema1:name "iPS Cell Technology in Drug Discovery and Development" ;
    schema1:startDate "2016-06-15 09:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.worldpreclinicalcongress.com/iPS-Cell-Technology/#__1> .

