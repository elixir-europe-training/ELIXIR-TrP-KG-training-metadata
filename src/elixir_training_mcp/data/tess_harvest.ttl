            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2021-04-12 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "KNIME Analytics Platform for Data Scientists (Life Science): Advanced - Online" ;
