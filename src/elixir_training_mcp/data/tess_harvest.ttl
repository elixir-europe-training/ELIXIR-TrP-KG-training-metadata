                    schema1:name "Australian BioCommons" ] ;
            schema1:startDate "2023-05-18 13:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Nextflow",
        "Pipelines",
        "Workflows",
        "nf-core" ;
    schema1:name "WORKSHOP: Unlocking nf-core - customising workflows for your research" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Australian BioCommons" ;
            schema1:url <https://www.biocommons.org.au/> ],
        [ a schema1:Organization ;
            schema1:name "Sydney Informatics Hub" ],
        [ a schema1:Organization ;
            schema1:name "Sequera" ] ;
    schema1:teaches """* Recognise how Nextflow and nf-core enable reproducible and portable bioinformatics \r
* Write and run a basic nf-core run command\r
* Describe nf-core code/directory structure (config, modules, submodules, workflow, main.nf)\r
* Adjust the run command to customise the workflow\r
* Describe Nextflow configuration hierarchy \r
* Create and use a params file to customise workflow parameters \r
* Create and use a custom config file to adjust resource usage  \r
* Apply external arguments not available as a workflow parameter to a process""" ;
    schema1:url <https://www.biocommons.org.au/events/custom-nfcore> .

<https://tess.elixir-europe.org/events/workshop-upskilling-and-training-users-in-science-and-research> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """BioExcel and RItrainPlus are organising a workshop on ‘Upskilling and training users in science and research’, which aims to bring together experts, trainers and other staff involved in training, building capacity and upskilling users of core facilities (CFs), research infrastructures (RIs) or scientific software. The aims are to exchange experiences, define best practices in upskilling users and communities, and learn about new pedagogical ideas and tools. \r
\r
**Dates:** 24 - 25 September\r
**Location:** Faculty of Pharmacy, Complutense University of Madrid, Spain\r
**Application:** Selections on a first-come first-served basis to be closed when full or by Friday 28 June 2024.\r
**Application Link:** https://www.eventsforce.net/embl/frontend/reg/tRegisterEmailNew.csp?pageID=95687&amp;eventID=150&amp;tempPersonID=42602\r
**Contact:** Daniel Thomas López (dthlopez@ebi.ac.uk) \r
**Costs:** registration is free, travel and accommodation not included""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
