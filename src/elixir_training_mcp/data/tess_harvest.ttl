    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_3572> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Postdocs and Staff members" ],
        [ a schema1:Audience ;
            schema1:audienceType "Students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "PI" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Diana Pilvar" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:description """The practical workshop on cleaning your messy data with OpenRefine software.\r
\r
First, we will cover spreadsheet best practices. Then, we will put that knowledge into practice with OpenRefine. This course will explore the depths of OpenRefine software and see what it can offer. This will include cleaning the data in bigger batches and unifying the data in one sweep (transforms and expressions). Additionally, we will introduce the possibility of downloading additional data from other databases and different extensions OpenRefine software has.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.10224703" ;
    schema1:keywords "Data exploration",
        "Data validation",
        "data cleaning",
        "data quality" ;
    schema1:learningResourceType "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "How to make your messy data usable? / OpenRefine" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <http://elixir.ut.ee> ] ;
    schema1:teaches """Learning outcomes for the participants: \r
* Describe spreadsheet best practices\r
* Compare Excel and OpenRefine\r
* Apply transforms (cell editing, column editing, transposing) in OpenRefine\r
* Write simple expressions in OpenRefine\r
* Match your dataset with that of an external source""" ;
    schema1:url <https://doi.org/10.5281/zenodo.10224703> ;
    schema1:version "1.0" .

<https://tess.elixir-europe.org/materials/how-to-make-your-research-open-with-europe-pmc> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3068> ;
    schema1:description "Europe PMC is an open global database of life science publications and preprints hosted by European Bioinformatics Institute (EMBL-EBI). Europe PMC is endorsed and supported by a group of international science funders, including Wellcome, World Health Organisation, European Research Council, and many others, as their repository of choice.The Europe PMC funders expect research outputs arising from research they support to be made freely and readily available. In this webinar we will explain how researchers can make their research open using Europe PMC and cover the benefits of including publications and preprints in Europe PMC for authors and readers. We will provide guidance on open access policies of Europe PMC funders and demonstrate how to include research publications in Europe PMC and PubMed Central USA." ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "How to make your research open with Europe PMC" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/how-make-your-research-open-europe-pmc> .

