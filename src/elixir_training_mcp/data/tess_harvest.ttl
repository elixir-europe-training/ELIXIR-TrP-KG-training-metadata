                    schema1:latitude "50.881367" ;
                    schema1:longitude "3.710014" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-05-08 09:00:00 UTC"^^schema1:Date ] ;
