            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/computational-chemistry/tutorials/zauberkugel/workflows/> ] ;
    schema1:name "Protein target prediction of a bioactive ligand with Align-it and ePharmaLib" ;
    schema1:provider [ a schema1:Organization ;
