	use basic statistical techniques in R : t-tests, wilcoxon tests, one-way ANOVA, Kruskal Wallis tests, chi square tests, correlations, survival analysis...\r
	write and use R scripts\r
""" ;
    schema1:endDate "2021-10-26 00:00:00 UTC"^^schema1:Date ;
