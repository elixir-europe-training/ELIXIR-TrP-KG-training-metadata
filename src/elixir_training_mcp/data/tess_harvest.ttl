<https://tess.elixir-europe.org/events/cabana-workshop-introduction-to-r-and-bioconductor-for-genomic-analyses> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Derrin Crawte" ;
    schema1:description "This course will provide training on how to program using R, one of the most popular languages for performing bioinformatic and statistical analyses for genomics applications." ;
    schema1:endDate "2019-05-24 17:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Mexico" ;
                    schema1:addressLocality "Irapuato" ;
                    schema1:postalCode "36821" ;
