<https://tess.elixir-europe.org/materials/discovering-scientific-evidence-using-europe-pmc-scilite-annotation> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Dayane Araujo" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Aravind Venkatesan" ] ;
    schema1:description """For readers of life sciences journal articles, annotations make it easier to scan an article and get a quick overview, find key concepts, and discover evidence, such as gene disease associations or molecular interactions. This webinar will demonstrate how to use the power of text mining to find evidence in scientific literature.\r
\r
Who is this course for?\r
This webinar is suitable for scientists, database curators or anyone who wishes to learn more about how to use annotations.\r
\r
Outcomes\r
By the end of the webinar you will be able to:\r
\r
Explore Europe PubMed Central\r
Use text mining for scientific literature searches""" ;
    schema1:identifier "DOI: 10.6019/TOL.ePMC-SciLite-w.2020.00001.1" ;
