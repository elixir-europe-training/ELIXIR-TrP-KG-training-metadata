    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Use OpenRefine faceting functionalities to apply mass editing and manage duplicates
- Use OpenRefine clustering and filtering functionalities to edit, transform data notably using regular expression
- Use OpenRefine to apply API services on your data""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/openrefine_gbif/tutorial.html> ;
    schema1:version "5" .

<https://tess.elixir-europe.org/materials/clinical-bioinformatics-i-tutor-notes> a schema1:LearningResource ;
