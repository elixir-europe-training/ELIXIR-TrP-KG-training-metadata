            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/6610704> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/phylogeny-data-prep/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "Clustal 1.8 (Clustal W, Clustal X)" ;
            schema1:url <https://bio.tools/tool/clustalw> ],
        [ a schema1:Thing ;
            schema1:name "funannotate" ;
            schema1:url <https://bio.tools/tool/funannotate> ],
        [ a schema1:Thing ;
            schema1:name "RepeatMasker" ;
            schema1:url <https://bio.tools/tool/repeatmasker> ] ;
    schema1:name "Preparing genomic data for phylogeny reconstruction" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Mask repetitive elements from a genome
- Annotate (predict protein-coding genes) the genomes of the samples to compare
- Find a set of common proteins across the samples (orthologs)
- Align orthologs across samples""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/phylogeny-data-prep/tutorial.html> ;
    schema1:version "5" .

