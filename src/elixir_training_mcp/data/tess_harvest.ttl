                            schema1:addressRegion "Matosinhos" ;
                            schema1:streetAddress "CIIMAR" ] ;
                    schema1:latitude "41.177392" ;
                    schema1:longitude "-8.700905" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BioData.pt, FAIRway" ] ;
            schema1:startDate "2025-04-28 13:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
