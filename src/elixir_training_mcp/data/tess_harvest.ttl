<https://tess.elixir-europe.org/events/taller-data-management-tips> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_4012> ;
    schema1:alternateName "Tips for FAIR data management and what resources to use to carry out this task" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "researchers" ] ;
    schema1:coursePrerequisites "No pre-requisites" ;
    schema1:description "Resumen: En este taller hablaremos sobre qué es la gestión de datos, porqué es importante, después haremos una introducción a ELIXIR y los recursos que tenemos que pueden ayudar a la gestión de datos, con especial énfasis en el RDMkit. Laura Portell Silva (F), máster en biotecnología, se incorporó al Barcelona Supercomputing Center (BSC) como ingeniera investigadora en el grupo del Instituto Nacional de Bioinformática. Está participando en varios proyectos europeos centrados principalmente en la gestión de datos en las ciencias de la vida. Forma parte de los proyectos FAIRplus y ELIXIR Converge, que tienen como objetivo desarrollar pautas para hacer que los datos de ciencias de la vida sean FAIR y estandarizar las buenas prácticas en toda Europa. Más relacionado con el ámbito sanitario, participa en el proyecto HealthyCloud para el desarrollo de una agenda estratégica para el European Health and Innovation Cloud y BY-COVID, para desarrollar una plataforma de gestión de datos de COVID-19 y futuras pandemias." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2022-11-23 20:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BioInfoGRX (RSG Spain Granada)" ] ;
            schema1:startDate "2022-11-23 19:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "DMP",
        "DMP evaluation",
        "DMP templates",
        "DMP tools",
        "DSW",
        "Data Stewardship Wizard",
        "ELIXIR-CONVERGE",
        "FAIR principles",
        "RDMkit",
        "Spanish",
        "data management plan",
        "español",
        "research data management",
        "template",
        "tool" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "RDMkit" ;
            schema1:url <https://bio.tools/tool/rdmkit> ],
