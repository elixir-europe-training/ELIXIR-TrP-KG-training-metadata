<https://tess.elixir-europe.org/events/oxford-nanopore-minion-sequencing-data-handling-analysis-and-applications> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description "Nanopore sequencing is one of the newest sequence technologies, in which single DNA molecules are sequenced directly, without the need for an intervening PCR amplification step or a chemical labelling step. It offers the potential of read lengths of tens of kilobases. The Oxford Nanopore MinION is a portable sequencing device that already has proven its power in e.g. the rapid identification of viral pathogens, the monitoring of ebola, genome assembly improvement, and environmental and food safety monitoring. As a member of the pre-release MinION Access Programme (MAP), Edinburgh Genomics has considerable experience in both generating and analyzing MinION sequence data, and also has published one of the first software tools to visualize and analyze these data (M Watson et al. poRe: an R package for the visualization and analysis of nanopore sequencing data. Bioinformatics. 2015 Jan 1;31(1):114-5)." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2016-11-01 00:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Edinburgh" ;
                            schema1:streetAddress "The King's Buildings, The University of Edinburgh" ] ;
                    schema1:latitude "55.953252" ;
                    schema1:longitude "-3.188267" ] ;
            schema1:startDate "2016-11-01 00:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Bioinformatics" ;
    schema1:name "Oxford Nanopore MinION Sequencing - Data Handling, Analysis and Applications" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "iAnn" ;
            schema1:url <http://iann.pro> ] ;
    schema1:url <http://genomics.ed.ac.uk/services/oxford-nanopore-minion-sequencing-data-handling-analysis-and-applications> .

