                    schema1:addressCountry "Germany" ;
                    schema1:addressLocality "Gatersleben" ;
                    schema1:postalCode "06466" ;
                    schema1:streetAddress "Corrensstraße 3, 3 Corrensstraße" ] ;
            schema1:latitude "51.824698" ;
            schema1:longitude "11.279206" ] ;
    schema1:name "Gatersleben Research Conference - 19th International  Symposium on Integrative Bioinformatics" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "Leibniz Institute of Plant Genetics and Crop Plant Research (IPK) Gatersleben" ] ;
