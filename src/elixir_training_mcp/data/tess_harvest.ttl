<https://tess.elixir-europe.org/materials/genebridge-inferring-the-evolutionary-rooting-of-orthologous-genes> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_2259>,
        <http://edamontology.org/topic_3299> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bioinformaticians" ],
        [ a schema1:Audience ;
