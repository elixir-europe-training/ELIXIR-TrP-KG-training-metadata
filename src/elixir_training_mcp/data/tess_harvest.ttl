<https://tess.elixir-europe.org/materials/working-with-beacon-v2-a-comprehensive-guide-to-creating-uploading-and-searching-for-variants-with-beacons> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0199> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Krzysztof Poterlowicz" ],
