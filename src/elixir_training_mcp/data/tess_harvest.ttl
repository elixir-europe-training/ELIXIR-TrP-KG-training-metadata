<https://tess.elixir-europe.org/materials/workshop-translating-workflows-into-nextflow-with-janis> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
