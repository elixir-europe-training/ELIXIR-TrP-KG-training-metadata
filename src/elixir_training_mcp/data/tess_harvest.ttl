<https://tess.elixir-europe.org/events/chip-seq-and-atac-seq-analysis-6d40f9a8-82b4-4fea-a9aa-d5dbf6681399> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:description """The primary aim of this course is to familiarise participants with the analysis of ChIP-seq and ATAC-seq data and provide hands-on training on the latest analytical approaches.\r
\r
The course starts with an introduction to ChIP-seq experiments for the detection of genome-wide DNA binding sites of transcription factors and other proteins. We first show data quality control and basic analytical steps such as alignment, peak calling and motif analysis, followed by practical examples on how to work with biological replicates and fundamental quality metrics for ChIP-seq datasets. On the second day, we then focus on the analysis of differential binding, comparing between different samples. We will also give an introduction to ATAC-seq data analysis for the detection of regions of open chromatin.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-10-24 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressRegion "Cambridgeshire" ;
                            schema1:streetAddress "University of Cambridge, Trinity Ln" ] ;
                    schema1:latitude "52.204267" ;
                    schema1:longitude "0.114909" ] ;
            schema1:startDate "2019-10-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "ATAC-seq",
        "Bioinformatics",
        "ChIP-Seq",
        "Genomics" ;
    schema1:name "ChIP-seq and ATAC-seq analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University of Cambridge Bioinformatics Training" ;
            schema1:url <http://training.csx.cam.ac.uk/bioinformatics/> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:url <https://www.training.cam.ac.uk/event/3049814> .

<https://tess.elixir-europe.org/events/chip-seq-and-atac-seq-analysis-cee4dfb5-310c-4c50-b8cd-78d29ad162ed> a schema1:Course ;
