            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Learn the tools necessary to perform a de novo assembly of a vertebrate genome
- Evaluate the quality of the assembly""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/assembly/tutorials/vgp_workflow_training/tutorial.html> ;
    schema1:version "26" .

