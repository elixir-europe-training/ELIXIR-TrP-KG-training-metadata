<https://tess.elixir-europe.org/events/elixir-train-the-trainer-7a4b258b-c999-4ce8-91e7-9578fd9e6f90> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Training instructors" ],
        [ a schema1:Audience ;
            schema1:audienceType "teachers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Trainers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training Designers" ] ;
    schema1:description """The ELIXIR Training Platform, in collaboration with ELIXIR-IT, is pleased to announce a Train the Trainer (TtT) event online. This course is meant to offer guidance, ideas and tips for training/teaching design, development and delivery based on research-driven educational principles. \r
\r
Important dates:\r
Course ONLINE sessions: December 1st-4th, 14:00-17:30 CET\r
\r
Instructors: \r
Allegra Via ELIXIR-IT, Patricia Palagi ELIXIR-CH, Jessica Lindvall ELIXIR-SE, Loredana Le Pera ELIXIR-IT\r
\r
This course will cover four main topics:\r
Learning principles and how they apply to education and training;\r
Design of lessons, course and materials;\r
Teaching techniques that enhance learner engagement and participation;\r
Assessment and feedback in training and teaching.\r
Examples and discussions will also focus on the challenges presented by academic teaching.\r
\r
""" ;
