        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ],
        [ a schema1:Thing ;
            schema1:name "Clustal 1.8 (Clustal W, Clustal X)" ;
            schema1:url <https://bio.tools/tool/clustalw> ],
        [ a schema1:Thing ;
            schema1:name "GECKO" ;
            schema1:url <https://bio.tools/tool/gecko> ] ;
    schema1:name "From small to large-scale genome comparison" ;
