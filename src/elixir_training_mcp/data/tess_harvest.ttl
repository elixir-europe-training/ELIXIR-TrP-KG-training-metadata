                            schema1:addressCountry "Australia" ;
                            schema1:addressLocality "Newcastle" ;
                            schema1:streetAddress "Callaghan" ] ;
                    schema1:latitude "-32.928333" ;
                    schema1:longitude "151.781667" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "University of Newcastle" ] ;
            schema1:startDate "2016-09-21 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "ABR",
        "SoftwareCarpentry" ;
    schema1:name "  Software Carpentry at UoN Callaghan" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "iAnn" ;
            schema1:url <http://iann.pro> ] ;
    schema1:url <http://www.intersect.org.au/energy/training#__2> .

