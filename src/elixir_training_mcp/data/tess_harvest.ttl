<https://tess.elixir-europe.org/events/immunogenicity-bioassay-summit-2016> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:about <http://edamontology.org/topic_0804> ;
    schema1:description "Following year-on-year success, CHI presents the Eighth Annual Immunogenicity and Bioassay Summit 2016: 3 conferences, FDA presenters plus 40+ additional presentations, 15+ interactive breakout round table and panel discussions, short courses, exhibit/poster hall, and networking opportunities with 250+ delegates. Immunogenicity Prediction &amp; Control is designed to help investigators design and select non-immunogenic products for early-stage decision making, while Immunogenicity Assessment &amp; Clinical Relevance and Optimizing Bioassays for Biologics will enable investigators to overcome the complexities of immunogenicity assessment and bioassays, and develop programs that ensure their products are safe and efficacious, and satisfy regulatory requirements." ;
    schema1:endDate "2016-10-28 00:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:location [ a schema1:Place ;
