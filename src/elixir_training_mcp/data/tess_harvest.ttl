<https://tess.elixir-europe.org/events/cwlexec-a-new-open-source-tool-to-run-cwl-workflows-on-lsf> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_0769> ;
    schema1:alternateName "BioExcel Webinar" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "HPC users" ] ;
    schema1:description """The [Common Workflow Language (CWL)](http://www.commonwl.org/) is a community-led specification for describing analysis _workflows_ and tools in a way that makes them portable and scalable across a variety of software and hardware environments, from workstations to cluster, cloud, and _high performance computing_ (HPC) environments. \r
\r
[IBM Spectrum LSF](https://www.ibm.com/us-en/marketplace/hpc-workload-management) (formerly IBM Platform LSF) is a complete workload management solution for demanding HPC environments. Featuring intelligent, policy-driven scheduling, it helps organizations accelerate research and design while controlling costs through superior resource utilization. \r
\r
Recognizing the popularity of CWL among LSF users, we introduce a new open source project **CWLEXEC** to support running CWL workflows on LSF. The project will feature smooth integration with LSF with high efficiency and scalability, self-healing of workflows, support user-specified submission options while keeping CWL definitions portable, and other benefits.\r
\r
* **Title**: CWLEXEC: A new open source tool to run CWL workflows on LSF\r
* **Presenter:** Qingda Wang, Principal Architect, IBM Spectrum LSF Family Products and OEM\r
* **Time**: 2018-02-28 14:00 GMT / 15:00 CET\r
""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2018-02-28 15:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BioExcel" ] ;
            schema1:startDate "2018-02-28 14:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "CWL",
        "HPC",
        "LSF",
        "Workflows" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Register for webinar" ;
            schema1:url <https://attendee.gotowebinar.com/register/2186673929445788931> ] ;
    schema1:name "CWLEXEC: Run Common Workflow Language on HPC with IBM Spectrum LSF" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "BioExcel" ;
            schema1:url <http://bioexcel.eu/> ],
        [ a schema1:Organization ;
            schema1:name "University of Manchester" ],
        [ a schema1:Organization ;
            schema1:name "BioExcel CoE" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:url <https://bioexcel.eu/webinar-cwlexec-a-new-open-source-tool-to-run-cwl-workflows-on-lsf/> .

<https://tess.elixir-europe.org/events/cycle-analyse-de-donnees-de-sequencage-a-haut-debit-module-analyses-chip-seq-sous-galaxy-session-juin-2024> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Bilille, la plateforme de bioinformatique, biostatistique et bioanalyse de la métropole lilloise, propose chaque année un cycle de formation d'introduction à l'analyse des données de séquençage à haut débit.\r
Ce cycle est composé des modules suivants, à la carte : \r
- Analyses ADN\r
- Analyses de variants\r
- Métagénomique\r
- Analyses ChIP-seq\r
- Analyses RNA-seq\r
Les fiches descriptives sont accessibles sur le site de bilille. Chaque module comprend des présentations générales et des séances pratiques sur ordinateur, avec Galaxy.\r
\r
Les objectifs du module Analyses ChIP-seq sont :\r
 Savoir analyser des données de ChIP-seq, du peak-calling à la découverte de motifs :\r
-	Savoir détecter les pics et obtenir un signal\r
-	Comprendre les différentes structures de données\r
-	Savoir effectuer les contrôles qualité\r
-	Savoir effectuer une analyse d’enrichissement de motifs\r
-	Etre capable de préparer ses résultats pour leur annotation\r
-	Comprendre comment croiser plusieurs résultats de ChIP-seq""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-06-07 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Villeneuve d'Ascq" ;
                            schema1:streetAddress "Université de Lille" ] ;
                    schema1:latitude "50.619317" ;
                    schema1:longitude "3.1314" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Bilille (https://bilille.univ-lille.fr), CNRS (http://www.cnrs.fr/index.php), INSERM (http://english.inserm.fr/), UDL (https://www.univ-lille.fr/home/)" ] ;
            schema1:startDate "2024-06-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Cycle « Analyse de données de séquençage à haut-débit » - Module Analyses ChIP-seq  (sous Galaxy)- session Juin 2024" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "IFB French Institute of Bioinformatics" ;
            schema1:url <http://www.france-bioinformatique.fr> ] ;
    schema1:url <https://bilille.univ-lille.fr/training/training-offer> .

