    schema1:datePublished "2024-02-06"^^schema1:Date ;
    schema1:description """## Abstract

Metaproteomics is the large-scale characterization of the entire complement of proteins expressed by microbiota. However, metaproteomics analysis of clinical samples is challenged by the presence of abundant human (host) proteins which hampers the confident detection of lower abundant microbial proteins ; .


## About This Material

This is a Hands-on Tutorial from the GTN which is usable either for individual self-study, or as a teaching material in a classroom.


## Questions this  will address

 - Why do we need to generate a customized database for metaproteomics research?
 - How do we reduce the size of the database?


## Learning Objectives

- Downloading databases related to 16SrRNA data
- For better identification results, combine host and microbial proteins.
- Reduced database provides better FDR stats.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Proteomics",
        "label-TMT11" ;
    schema1:learningResourceType "e-learning" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://doi.org/10.5281/zenodo.10105821> ],
        [ a schema1:Thing ;
            schema1:name "UniProt" ;
            schema1:url <https://bio.tools/tool/uniprot> ],
        [ a schema1:Thing ;
            schema1:name "MetaNovo" ;
            schema1:url <https://bio.tools/tool/metanovo> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/clinical-mp-1-database-generation/workflows/> ] ;
    schema1:name "Clinical Metaproteomics 1: Database-Generation" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Downloading databases related to 16SrRNA data
- For better identification results, combine host and microbial proteins.
- Reduced database provides better FDR stats.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/clinical-mp-1-database-generation/tutorial.html> ;
    schema1:version "7" .

<https://tess.elixir-europe.org/materials/clinical-mp-2-discovery> a schema1:LearningResource ;
