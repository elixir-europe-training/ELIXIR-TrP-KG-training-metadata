                            schema1:addressLocality "Bordeaux" ;
                            schema1:streetAddress "146 Rue léo Saignat" ] ;
                    schema1:latitude "44.841225" ;
                    schema1:longitude "-0.580036" ] ;
            schema1:maximumAttendeeCapacity 12 ;
            schema1:organizer [ a schema1:Organization ;
