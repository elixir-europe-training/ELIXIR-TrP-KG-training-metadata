<https://tess.elixir-europe.org/materials/rna-seq-analysis-d7e62d71-a253-4168-8b5d-6838a2384978> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3170> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Simon Andrews" ] ;
    schema1:description """This course builds on the core skills introduced in the Introduction to R, Introduction to Unix and Introduction to SeqMonk courses to provide a more in depth look at the analysis of RNA-Seq data. The course starts with a comprehensive lecture covering the theory of RNA-Seq data generation and analysis and is then followed by a long hands-on practical session which runs though the entire RNA-Seq analysis pipeline from raw fastq files to a list of differentially expressed candidate genes.\r
\r
**Course Content**\r
\r
* The theory of RNA-Seq analysis\r
* Raw data QC\r
* Mapping RNA-Seq data with tophat\r
* Viewing RNA-Seq data with SeqMonk\r
* Differential expression analysis with DESeq\r
* Reviewing and visualising differential expression hits\r
\r
**Course Material**\r
\r
* [Course Presentation (pptx)](http://www.bioinformatics.babraham.ac.uk/training/RNASeq_Course/RNA-Seq_analysis_course.pptx)\r
* [Course Presentation (pdf)](http://www.bioinformatics.babraham.ac.uk/training/RNASeq_Course/RNA-Seq_analysis_course.pdf)\r
* [Practical instructions (docx)](http://www.bioinformatics.babraham.ac.uk/training/RNASeq_Course/Analysing%20RNA-Seq%20data%20Exercise.docx)\r
* [Practical instructions (pdf)](http://www.bioinformatics.babraham.ac.uk/training/RNASeq_Course/Analysing%20RNA-Seq%20data%20Exercise.pdf)\r
* [Course Data (tar.gz) (1.5GB)](http://www.bioinformatics.babraham.ac.uk/training/RNASeq_Course/RNA-Seq_Course_Data.tar.gz)""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "RNA-Seq Analysis" ;
    schema1:url <http://www.bioinformatics.babraham.ac.uk/training.html#rnaseq> .

