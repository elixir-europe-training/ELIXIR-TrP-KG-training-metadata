<https://tess.elixir-europe.org/materials/an-introduction-to-disprot> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Computational biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bench biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Database users" ],
        [ a schema1:Audience ;
            schema1:audienceType "Curators" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Federica Quaglia" ] ;
    schema1:competencyRequired "Basic knowledge of biology and proteins is required." ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2022-08-22"^^schema1:Date ;
    schema1:datePublished "2022-08-22"^^schema1:Date ;
    schema1:description "In this course you will learn what type of information is stored in DisProt, gold standard resource of manually curated Intrinsically Disordered Proteins (IDPs) and Intrinsically Disordered Regions (IDRs) from the literature. You will explore the main features of the database, its entries and annotations along with the related documentation." ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Curation",
        "Databases",
        "Intrinsically disordered proteins",
        "Ontologies",
        "Protein function analysis",
        "Protein sequence analysis" ;
    schema1:learningResourceType "Training materials",
        "Webinar" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "DisProt" ;
            schema1:url <https://disprot.org/> ] ;
    schema1:name "An introduction to DisProt" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Italy" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:teaches """At the end of this course you will be able to:\r
• Explain what DisProt is and how you can use it\r
• Explain how to navigate the DisProt database: \r
• Explain and describe the home page features (e.g. datasets, blog, Twitter)\r
• Discuss and interpret the DisProt entries\r
• Identify where to find the DisProt Documentation\r
• List the various pages and content available in the documentation: Biocuration, Help and About""" ;
    schema1:url <https://youtu.be/FsFOQYXy1pE> .

<https://tess.elixir-europe.org/materials/an-introduction-to-embl-ebi-resources> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description "EMBL-EBI is the home of the world's most comprehensive range of freely available molecular databases and resources. Our resources help researchers share and analyse data and perform complex queries in many different ways. Join us for a tour of the core data resources at EMBL-EBI.During this webinar, we will introduce the types of data available, how you can search for data and the various ways of getting assistance. We will also discuss the role of EMBL-EBI in making data open and accessible, and how you can include EMBL-EBI data in your workflows. We will also provide information on further online training to help you learn more about specific topics in bioinformatics and EMBL-EBI resources, including an introduction to the training collections. The collections bring together videos, and online tutorials on a specific topic to help get started." ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "An introduction to EMBL-EBI resources" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/introduction-embl-ebi-resources-2025> .

<https://tess.elixir-europe.org/materials/an-introduction-to-ggplot> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Anne Segonds-Pichon" ] ;
    schema1:description """Ggplot is the most popular plotting extension to R and replicates many of the graph types found in the core plotting libraries. This course provides an introduction to the ggplot2 libraries and gives a practical guide for how to use these to create different types of graphs.\r
\r
**Course Content**\r
\r
* How ggplot2 works\r
* Plotting different graph types\r
* Scatterplots\r
* Stripcharts\r
* Histograms\r
* Boxplots\r
* Violin / Beanplots\r
* Bar charts\r
* Line graphs\r
* Writing plots to files\r
\r
**Course Material**\r
\r
* [Course Manual (pdf)](http://www.bioinformatics.babraham.ac.uk/training/ggplot_course/Introduction%20to%20ggplot.pdf)\r
* [Course Manual (docx)](http://www.bioinformatics.babraham.ac.uk/training/ggplot_course/Introduction%20to%20ggplot.docx)\r
* [Course data (zip)](http://www.bioinformatics.babraham.ac.uk/training/ggplot_course/GGplot%20course%20data.zip)""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords "Babraham Institute",
        "ggPlot" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/other-nc> ;
