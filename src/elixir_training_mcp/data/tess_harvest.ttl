                    schema1:longitude "9.98717" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI & ELIXIR-DE" ] ;
            schema1:startDate "2025-08-25 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "CIC Summer School on Cheminformatics 2025" ;
