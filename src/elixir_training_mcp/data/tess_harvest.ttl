<https://tess.elixir-europe.org/events/popular-science-writing-62c1edfd-7e4b-434c-91e4-4187c6ee58b8> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """How may you turn your research into a captivating story? We guide you from initial idea to finished text.

During a physical workshop on Monday 28 November 2022, our coach Ann De Ron reveals all the secrets of a popular science text.

During the workshop we immediately roll up our sleeves: you develop the concept of your own article, and you start writing.

You will continue the writing process at home and send the first version to our coach.

But you are not alone: ​​you may repeat the most important lessons online. We will try to inspire you with many good examples, in different styles, forms and genres.

You also receive individual feedback on your text in a short online call with the instructor on 8 December.

As icing on the cake, we will get your piece out there. If your article is about the life sciences, it may be published by our media partner Biovox. If not, we will help you find the most suitable platform on a case-by-case basis.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2022-12-08 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "SciComm Academy" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Brussels" ;
                            schema1:postalCode "1000" ;
                            schema1:streetAddress "Brussels - SciMingo Office, Leopoldstraat 6" ] ;
                    schema1:latitude "50.846557" ;
                    schema1:longitude "4.351697" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2022-11-28 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "communication skills" ;
    schema1:name "Popular Science Writing" ;
    schema1:provider [ a schema1:Organization ;
