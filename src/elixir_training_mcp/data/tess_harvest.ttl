            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/statistics/tutorials/gpu_jupyter_lab/workflows/> ] ;
    schema1:name "A Docker-based interactive Jupyterlab powered by GPU for artificial intelligence in Galaxy" ;
    schema1:provider [ a schema1:Organization ;
