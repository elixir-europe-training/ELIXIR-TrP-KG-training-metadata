<https://tess.elixir-europe.org/materials/data-stewardship-wizard-workshop-feb-2020> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_3571> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "data stewards" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Jan Slifka" ] ;
    schema1:description """[Data Stewardship Wizard](ds-wizard.org) brings together data stewards and researchers to allow managing data in projects efficiently and in a FAIR manner. Data stewards can easily capture the knowledge including required project data and decisions in knowledge models that are then turned into per-project questionnaires to be filled by researchers.\r
\r
Apart from interactively going through questionnaires that show only relevant questions to the user, the questionnaires can be easily edited or customized using an inheritance hierarchy. The benefit lies not only in having a (nowadays often obligatory) DMP for funders but mainly learning how to handle data correctly, make them FAIR, maintain them well during the project, and curate them long-term.\r
\r
This workshop explains the core functionality of the Data Stewardship Wizard.\r
\r
Video recording from the workshop is available **[here](https://www.youtube.com/watch?v=aGpr6JFMuiE)**.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "10.5281/zenodo.3689221" ;
