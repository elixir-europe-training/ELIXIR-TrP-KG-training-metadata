                    schema1:postalCode "NW1 2BE" ;
                    schema1:streetAddress "Virtual Event" ] ;
            schema1:latitude "51.52555" ;
            schema1:longitude "-0.134873" ] ;
    schema1:name "ELIXIR Bioinformatics Industry Forum" ;
    schema1:startDate "2020-04-28 14:00:00 UTC"^^schema1:Date ;
