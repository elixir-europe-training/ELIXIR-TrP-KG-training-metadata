<https://tess.elixir-europe.org/events/using-r-tidyverse-to-analyze-and-visualize-genomic-data> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:alternateName "How to analyze & visualize processed genomics data" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Intermediate" ],
        [ a schema1:Audience ;
            schema1:audienceType "Beginners who have very little background in using the command line and are enthusiastic to learn more" ] ;
    schema1:contact "batool@liverpool.ac.uk" ;
    schema1:description """**This workshop will present how to analyze &amp; visualize processed genomics data. The session will be divided into 5 parts:**\r
\r
Part 1: Getting started w/ readr\r
Part 2: Reshaping data w/ tidyr\r
Part 3: Data wrangling w/ dplyr\r
Part 4: Visualizing tidy data w/ ggplot\r
Part 5: Export and Wrap-up w/ rmarkdown\r
\r
**Learning Objectives**\r
By the end of this workshop, you will be able to load your genomic dataset, perform basic data tidying &amp; wrangling, data visualization, and save/export your results using tidyverse! Hopefully, you will also have a newfound appreciation for reproducible research and R!\r
\r
**Resources, including set-up instructions**\r
https://github.com/jananiravi/workshop-tidyverse\r
""" ;
    schema1:endDate "2022-05-21 11:00:00 UTC"^^schema1:Date ;
    schema1:keywords "Data Representation",
        "R/Bioconductor",
        "bioinformatics",
        "introduction" ;
    schema1:maximumAttendeeCapacity 30 ;
    schema1:name "Using R/tidyverse to analyze and visualize genomic data" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "ISCB Academy" ] ;
    schema1:startDate "2022-05-21 08:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.iscb.org/iscbacademy> .

<https://tess.elixir-europe.org/events/using-rnacentral-to-explore-and-investigate-non-coding-rna-sequences> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_3495>,
        <http://edamontology.org/topic_0659> ;
    schema1:description """Non-coding RNAs (ncRNAs) are a key molecule for life. They are involved in many complex biological processes, from gene regulation to translation. This complexity has led to an explosion of many different databases with specialised focuses and data. RNAcentral provides users a single entry point into the complexity of ncRNA data. 

This webinar will show users how to effectively navigate and search RNAcentral. Additionally, we will show users how to download data for their own analysis and tooling. We will highlight commonly used data formats such as BED/GFF3 and FASTA files. Finally, we will demonstrate how to use the RNAcentral sequence search to quickly explore sequences.

 """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
