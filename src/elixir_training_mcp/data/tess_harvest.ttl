<https://tess.elixir-europe.org/events/lectures-at-itqb-phd-programme> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_4012> ;
    schema1:description """On December 6th, BioData.pt's **Ready for BioData Management?** team was invited to give two lectures at the "Bioprocess Data Analysis" course of the ITQB PhD programme.

Daniel Faria gave the first lecture, about the role of data management in modern science and current policies such as Open Science and the FAIR data principles (Findability, Accessibility, Interoperability and Reusability).

 ![Daniel Faria](https://legacy.biodata.pt/sites/default/files/inline-images/06-12-19_01.jpg)

João Cardoso gave the second lecture, about data management plans, including a detailed example of how to make one for a mock research project.

 ![João Cardoso](https://legacy.biodata.pt/sites/default/files/inline-images/06-12-19_02.jpg)

The students posed interesting questions, and there were some nice discussions on key issues such as publishing data.

The materials for the lectures are available at BioData.pt's [GitHub](https://github.com/BioData-PT/Ready4BioDataManagement/tree/master/Lectures%2006-12-2019%20%40ITQB).

We thank Professor Isabel Rocha for the invitation and opportunity!""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-12-06 17:00:00 UTC"^^schema1:Date ;
            schema1:startDate "2019-12-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Lectures at ITQB PhD Programme" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "BioData.pt" ;
            schema1:url <https://biodata.pt> ] ;
    schema1:url <https://biodata.pt/training/events/lectures-itqb-phd-programme> .

