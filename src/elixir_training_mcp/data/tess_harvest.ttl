    schema1:author [ a schema1:Person ;
            schema1:name "Personalized Health Informatics Group" ],
        [ a schema1:Person ;
            schema1:name "Deepak Unni" ] ;
    schema1:competencyRequired "It is recommended to have a basic understanding of FAIR principles." ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Sabine Österle" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2023-05-23"^^schema1:Date ;
    schema1:dateModified "2023-05-23"^^schema1:Date ;
    schema1:datePublished "2023-05-23"^^schema1:Date ;
    schema1:description """This training was developed in the context of the [Swiss Personalized Health Network (SPHN)](https://sphn.ch) initiative and is part of a series of trainings centered around the [SPHN Semantic Interoperability Framework](https://sphn.ch/network/data-coordination-center/the-sphn-semantic-interoperability-framework/) developed by the SPHN Data Coordination Center (DCC). The framework aims at facilitating collaborative research by providing a decentralized infrastructure sustained by a strong semantic layer (SPHN Dataset) and graph technology, based on RDF, for the exchange and storage of data.\r
\r
The training explores the best practices in making terminologies Findable, Accessible, Interoperable, and Reusable (FAIR).\r
\r
The training will cover the following topics:\r
-	Introduction to terminologies\r
-	Best practices for making terminologies FAIR\r
-	Semantic Web standards for FAIRification of terminologies\r
-	Versioning strategies for better management of terminologies\r
\r
The training is intended for researchers, data analysts, data engineers, and data managers interested in terminology management and how to go about bringing their terminologies into RDF, especially in the context of SPHN.\r
\r
\r
\r
\r
__Resources:__\r
All resources are available on the training's [GitLab space]( https://git.dcc.sib.swiss/sphn-semantic-framework/sphn-training-material/-/tree/master/FAIRification%20of%20Terminologies)""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Clinical data",
        "FAIR",
        "Ontology",
        "Semantic Framework",
        "Terminology",
        "Versioning of Terminology" ;
    schema1:learningResourceType "E-learning",
        "Video" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:name "FAIRification of external terminologies" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Switzerland" ;
            schema1:url <http://www.sib.swiss/training/> ],
        <https://ror.org/002n09z45> ;
    schema1:teaches """__After the training you will be able to:__\r
-	Know how to make terminologies FAIR in the context of SPHN by applying best practices\r
-	Use Semantic Web standards to FAIRify terminologies\r
-	Know a few approaches for handling versions of a terminology""" ;
    schema1:url <https://youtu.be/bhqkNxeCWeo> .

<https://tess.elixir-europe.org/materials/fairify-your-data-data-documentation-and-metadata> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
