    schema1:description """The questions this  addresses are:
 - How can yeast strains in a beer sample be identified?
 - How can we process metagenomic data sequenced using Nanopore?


The objectives are:
 - Inspect metagenomics data
 - Run metagenomics tools
 - Identify yeast species contained in a sequenced beer sample using DNA
 - Visualize the microbiome community of a beer sample""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "beer",
        "citizen science",
        "metagenomics",
        "nanopore" ;
    schema1:learningResourceType "hands-on tutorial" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Hands-on for 'Identification of the micro-organisms in a beer using Nanopore sequencing' tutorial" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
