    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2024-05-17"^^schema1:Date ;
    schema1:dateModified "2024-05-17"^^schema1:Date ;
    schema1:datePublished "2024-05-17"^^schema1:Date ;
    schema1:description """This workshop provides a comprehensive introduction to g:Profiler, a tool designed for functional enrichment analysis, gene ID conversion, and orthology mapping, and requires no prior knowledge. Specifically intended for beginners, the session emphasizes efficient usage of g:Profiler for mapping genes to known functional information sources and identifying statistically significantly enriched terms.\r
\r
Key topics:\r
\r
* Basics of enrichment analysis.\r
* Performing gene ID conversion.\r
* Understanding orthology mapping with g:Profiler.\r
* Navigating and utilizing g:Profiler’s web interface.\r
* Introduction to programmatic interactions with g:Profiler.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.11207911" ;
    schema1:keywords "Enrichment",
        "Enrichment analysis",
        "g:Profiler" ;
    schema1:learningResourceType "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Introduction to g:Profiler" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <https://elixir.ut.ee> ] ;
    schema1:teaches """* Gain a foundational understanding of enrichment analysis.\r
* Learn to use g:Profiler for gene ID conversion and orthology mapping.\r
* Acquire skills to interpret results from g:Profiler analyses.\r
* Get familiar with web and programmatic access to g:Profiler.""" ;
    schema1:url <https://doi.org/10.5281/zenodo.11207911> ;
    schema1:version "1.0" .

