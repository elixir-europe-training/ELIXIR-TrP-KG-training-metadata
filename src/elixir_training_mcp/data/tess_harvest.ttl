    schema1:competencyRequired "For this lesson you will need RStudio and a GitHub account" ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Niclas Jareborg" ],
        [ a schema1:Person ;
            schema1:name "Mattias Strömberg" ],
        [ a schema1:Person ;
            schema1:name "Elin Kronander" ],
        [ a schema1:Person ;
