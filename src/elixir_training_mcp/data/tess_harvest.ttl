    schema1:creativeWorkStatus "active" ;
    schema1:description """part of the data workflow is preparing the data for analysis. Some of this involves data cleaning, where errors in the data are identified and corrected, or formatting made consistent. This step must be taken with the same care and attention to reproducibility as the analysis.\r
\r
OpenRefine is a powerful free and open source tool for working with messy data: cleaning it and transforming it from one format into another.\r
\r
This lesson will teach you to use OpenRefine to effectively clean and format data and automatically track any changes that you make. Many people comment that this tool saves them literally months of work trying to make these edits by hand.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "CONVERGE",
        "Data management",
        "FAIR",
        "Open science" ;
    schema1:learningResourceType "e-learning",
        "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "The Carpentries" ;
            schema1:url <https://carpentries.org/learn/> ],
        [ a schema1:Thing ;
            schema1:name "OpenRefine" ;
            schema1:url <https://openrefine.org/> ] ;
    schema1:name "Introduction to Data Management Practices - Cleaning tabular data with OpenRefine" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Sweden" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "NBIS" ;
            schema1:url <http://nbis.se> ] ;
    schema1:url <https://nbisweden.github.io/module-openrefine-dm-practices/> .

