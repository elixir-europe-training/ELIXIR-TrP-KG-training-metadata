<https://tess.elixir-europe.org/events/clinic-e-mail-management> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This two-hour online clinic-training session is dedicated to mastering inbox management for enhanced efficiency. The focus is on developing strategies to effectively control email inflow and manage the deluge of information and communication tasks. Participants will explore techniques for prioritizing emails, setting up filters and labels, and creating an organized system to quickly process incoming messages. The session also delves into understanding the rights and duties related to workplace communication, providing insights into establishing a more effective email policy. Attendees will learn how to influence their work environment positively by promoting best practices in email communication. Through practical exercises and real-world examples, participants will gain the skills necessary to maintain a streamlined, efficient inbox, contributing to overall productivity and better workplace communication. This session is ideal for professionals seeking to improve their email management skills and positively impact their organization's email culture." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-04-29 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-04-29 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "personal effectiveness",
        "time management" ;
    schema1:name "Clinic E-mail Management" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/clinic-e-mail-management> .

