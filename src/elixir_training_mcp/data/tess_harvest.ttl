    schema1:name "Identification of the micro-organisms in a beer using Nanopore sequencing" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Inspect metagenomics data
- Run metagenomics tools
- Identify yeast species contained in a sequenced beer sample using DNA
- Visualize the microbiome community of a beer sample""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/microbiome/tutorials/beer-data-analysis/tutorial.html> ;
    schema1:version "5" .

