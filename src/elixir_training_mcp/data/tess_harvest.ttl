<https://tess.elixir-europe.org/materials/calculating-and-diversity-from-microbiome-taxonomic-data> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3174>,
        <http://edamontology.org/topic_3697> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Bérénice Batut" ],
        [ a schema1:Person ;
