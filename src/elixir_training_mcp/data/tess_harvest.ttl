<https://tess.elixir-europe.org/materials/navigating-the-data-rich-literature-finding-evidence-in-biomedical-publications> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Maria Levchenko" ] ;
    schema1:description """In the age of data‐driven science, discovering all the data associated with a study can be tricky. In this webinar, we will demonstrate how to locate primary data in a publication, find facts and evidence to support your hypothesis, and scan a paper for important biological concepts using tools provided by Europe PMC.\r
\r
This webinar was recorded on 4th October 2017. It is best viewed in full-screen mode using Google Chrome. The slides from this webinar can be downloaded here.\r
\r
This webinar is aimed at scientists with an interest in learning more about the literature search tools provided by Europe PMC.\r
\r
No prior knowledge of bioinformatics is required, but an undergraduate-level understanding of biology would be useful.\r
\r
If you would like to learn more about Europe PMC have a look at our other webinar on Europe PMC: get the most from literature searches and our Europe PMC: Quick tour.\r
\r
See the EMBL-EBI training pages for a list of upcoming webinars.""" ;
    schema1:keywords "Biomedical Literature",
        "Europe PMC",
        "Literature search" ;
    schema1:learningResourceType "Webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Navigating the data-rich literature: finding evidence in biomedical publications" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/online/course/navigating-data-rich-literature-finding-evidence-biomedical-publications> .

<https://tess.elixir-europe.org/materials/navigating-uniprot-a-brief-overview-and-recent-updates> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description "Join us for an engaging webinar that will guide you through the new and enhanced features and functionalities of the UniProt website.Designed with user experience at the forefront, the website offers seamless access to the comprehensive data provided by the UniProt consortium.In this session, we will walk you through the structure of the UniProt website and highlight key improvements, including new data integrations and enhanced visualisations. We will also introduce you to our updated feature viewer, which now incorporates data from multiple sources such as PTMs from large scale data, epitopes, RNA editing, and AlphaMissense predictions. We will explore the different methods for downloading data and guide you on choosing the right one based on your specific needs" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Navigating UniProt: a brief overview and recent updates" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/navigating-uniprot-brief-overview-and-recent-updates-2025> .

