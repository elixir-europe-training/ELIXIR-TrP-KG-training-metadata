            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-07-25 14:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Australian BioCommons" ] ;
            schema1:startDate "2023-07-25 12:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Bioinformatics",
        "Galaxy",
        "Galaxy Australia",
        "Training" ;
    schema1:name "WEBINAR: Managing hands-on data analysis training with Galaxy" ;
    schema1:provider [ a schema1:Organization ;
