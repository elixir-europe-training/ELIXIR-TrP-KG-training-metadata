<https://tess.elixir-europe.org/materials/course-design-considerations-for-trainers-a-professional-guide> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Training instructors" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training Designers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Trainers" ],
        [ a schema1:Audience ;
            schema1:audienceType "teachers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Anyone who wants to become a good trainer or teacher" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Patricia Palagi" ],
        [ a schema1:Person ;
            schema1:name "The GOBLET Foundation" ],
        [ a schema1:Person ;
            schema1:name "Rochelle E. Tractenberg" ],
        [ a schema1:Person ;
            schema1:name "Allegra Via" ],
        [ a schema1:Person ;
            schema1:name "Teresa Attwood" ],
        [ a schema1:Person ;
            schema1:name "Jessica Lindvall" ] ;
    schema1:description """This Professional Guide in the Resources for Training Trainers series introduces a structured approach to course design, highlighting the importance of articulating learning outcomes commensurate with the cognitive complexity of the target learning, prior to devising learning experiences and course content. The specific focus here is on face-to-face activities, but the guidance is also relevant for those designing online courses. \r
\r
Specifically, this Guide outlines a series of steps that can help trainers to devise and deploy effective courses. On reading this Guide, and engaging with the reflective exercises, you will be able to:\r
- list five key phases of curriculum &amp; course development;\r
- explain the primary role of learning outcomes;\r
- write learning outcomes for a course;   \r
- identify the Bloom’s-level accomplishments that different types of learning experience are likely to support;\r
- describe the role of learning outcomes in selecting relevant content;\r
- distinguish different types of assessment &amp; their role in supporting learner progression towards learning outcomes; and\r
- summarise the benefits of course evaluation.""" ;
    schema1:identifier "https://doi.org/10.7490/f1000research.1118395.1" ;
    schema1:keywords "Curriculum development, course design, learning outcomes, Bloom's Taxonomy, assessment, course evaluation, training trainers, training material" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:name "Course design: Considerations for trainers – a Professional Guide" ;
    schema1:provider [ a schema1:Organization ;
