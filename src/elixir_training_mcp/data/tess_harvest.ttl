                    schema1:latitude "38.696861" ;
                    schema1:longitude "-9.314601" ] ;
            schema1:startDate "2017-11-24 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Train the Trainer Workshop: From knowledge, skills and abilities to learning paths: developing mastery rubrics for training" ;
    schema1:provider [ a schema1:Organization ;
