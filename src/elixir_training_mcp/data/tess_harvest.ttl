    schema1:url <https://training.vib.be/all-trainings/effective-oral-presentations-6> .

<https://tess.elixir-europe.org/events/effective-oral-presentations-2c5f3e62-1d6f-470e-b5f1-1e8a2cb33fad> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Due to the increasing number of Corona infections, the second day of the theoretical part (29 Nov) will be organized online. 

Top-notch scientists who strive to publish, patent and ultimately translate their scientific findings from the laboratory bench to the patient’s bedside/plant, must be very talented in a wide variety of life science disciplines. Though, more than being a superb scientist, they also need to be skilled to put their findings in the picture at events such as lab meetings, seminars, workshops, etc. The simple reason therefore is that in fact any scientific breakthrough or technical achievement is only as good as the scientists’ ability to clearly and concisely explain and/or present its content to others in language they can understand (and relate to).

In modern life sciences, it is thus a prerequisite for embarking scientists to impress their colleagues, their boss, granting bodies and eventually the entire research community via spoken and/or written communications dealing with their research findings in such a way that the take home messages hit the scientific minds! Sounds easy, but in fact it is challenging to bring a scientific story in such a way that some years later the essence is still remembered for the good, instead of the bad reasons.

VIB is aware of the myriad of skills required to do so successfully and offers doctoral researchers and postdoctoral researchers the ability to participate in a four days training program that will give them concrete insights and guided practice to develop expert communication and presentation skills. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2021-12-16 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.012803" ;
                    schema1:longitude "3.713854" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2021-11-16 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "communication skills" ;
    schema1:name "Effective Oral Presentations" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/effective-oral-presentations-1> .

<https://tess.elixir-europe.org/events/effective-oral-presentations-7cfa477b-763f-4579-939f-4f83ef2cf0b3> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Top-notch scientists who strive to publish, patent and ultimately translate their scientific findings from the laboratory bench to the patient’s bedside/plant, must be very talented in a wide variety of life science disciplines. Though, more than being a superb scientist, they also need to be skilled to put their findings in the picture at events such as lab meetings, seminars, workshops, etc. The simple reason therefore is that in fact any scientific breakthrough or technical achievement is only as good as the scientists’ ability to clearly and concisely explain and/or present its content to others in language they can understand (and relate to).

In modern life sciences, it is thus a prerequisite for embarking scientists to impress their colleagues, their boss, granting bodies and eventually the entire research community via spoken and/or written communications dealing with their research findings in such a way that the take home messages hit the scientific minds! Sounds easy, but in fact it is challenging to bring a scientific story in such a way that some years later the essence is still remembered for the good, instead of the bad reasons.

VIB is aware of the myriad of skills required to do so successfully and offers doctoral researchers and postdoctoral researchers the ability to participate in a four days training program that will give them concrete insights and guided practice to develop expert communication and presentation skills. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
