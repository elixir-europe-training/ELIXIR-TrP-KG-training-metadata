<https://tess.elixir-europe.org/materials/rstudio-basic> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "PI" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Priit Adler" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Nurlan Kerimov" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2023-10-24"^^schema1:Date ;
    schema1:dateModified "2024-09-01"^^schema1:Date ;
    schema1:datePublished "2024-10-02"^^schema1:Date ;
    schema1:description """R is a free software environment for statistical computing and graphics. It compiles and runs on various UNIX platforms, Windows and MacOS.\r
\r
RStudio is an essential tool for anyone involved in R programming. It plays a vital role in data analysis by facilitating data import, access, transformation, exploration, visualization, and modeling tasks. If you're embarking on your journey to learn R, now is the perfect moment to familiarize yourself with RStudio. Discover what RStudio is, how to install it, and begin harnessing its capabilities to enhance your data analysis and programming skills.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "R",
        "R Studio" ;
    schema1:learningResourceType "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "RStudio Basic" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <http://elixir.ut.ee> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR" ;
            schema1:url <https://www.elixir-europe.org/> ] ;
    schema1:teaches """* Navigate RStudio features\r
* Write and execute R scripts\r
* Manage projects efficiently within the IDE\r
* Import, clean, and manipulate data""" ;
    schema1:url <https://github.com/ELIXIREstonia/2025-09-01-R-basic> .

