<https://tess.elixir-europe.org/events/introduction-to-git-github-39836a1e-23bb-428c-9036-1bfb0d9f9150> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This course is part of a micro-credential track, which offers the added value of being akin to a mini-diploma. If you'd like to follow the full track, you will be able to improve the reproducibility of your research. Check this opportunity: Reproducible Data Analysis: an Essential Capability in Modern Science.This course is designed for researchers and support staff who are new to version control and want to adopt best practices for managing code and collaborating on scientific projects. As research becomes increasingly computational, using free tools like Git and GitHub is essential for tracking changes, ensuring reproducibility, and working efficiently in teams. In this hands-on session, you will learn how to set up Git, manage your project history, and collaborate using GitHub. By the end of the course, you will be able to confidently use Git from the command line, create and manage repositories, and contribute to shared projects through branching and pull requests." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-10-10 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Belgium" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.033713" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-10-09 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "ELIXIR",
        "basic bioinformatics",
        "hands-on",
        "research data management" ;
    schema1:name "Introduction to Git & GitHub" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Apply basic Git operations (e.g. staging committing pushing) to work effectively with local and remote repositories”",
        "“Collaborate with other people in your project”",
        "“Configure Git on a local machine to prepare for version control in research projects”",
        "“Create and manage repositories using Git commands to track changes and maintain project history”",
        "“Implement branching and pull request workflows to collaborate with others on shared codebases”",
        "“Interpret Git logs and history to understand project evolution and troubleshoot issues”" ;
    schema1:url <https://training.vib.be/all-trainings/introduction-git-github-14> .

