<https://tess.elixir-europe.org/events/from-reads-to-disease-variants> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "GATK Workshop and Disease variant prioritization tutorial" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "GATK users" ],
        [ a schema1:Audience ;
            schema1:audienceType "GATK experts" ],
        [ a schema1:Audience ;
            schema1:audienceType "variant discovery newbies" ],
        [ a schema1:Audience ;
            schema1:audienceType "GATK newbies" ],
        [ a schema1:Audience ;
            schema1:audienceType "mixed audience" ] ;
    schema1:description """Massive sequencing is becoming mainstream in many fields of biomedicine, including the clinical practice.\r
\r
However, the management of sequencing raw data to transform them into valuable biological information on variants and its further interpretation is still a complex task that requires of intensive computing and trained personnel.\r
\r
This course covers all the steps from the raw sequencing data, produced by the sequencers, to the obtention of lists of variants using the popular GATK software. The course is followed by a tutorial on the IVA, a powerful and intuitive web interface for the interactive prioritization and detection of disease variants. GATK workshops are designed to provide a comprehensive onboarding experience to new users, as well as access to more advanced understanding for users who are already familiar with the toolkit. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-10-25 13:30:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Spain" ;
                            schema1:addressLocality "Granada" ] ;
                    schema1:latitude "37.183054" ;
                    schema1:longitude "-3.602193" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Fundación Progreso y Salud (FPS), Broad Institute and the Spanish National Bioinformatics Institute (INB/ELIXIR-ES)" ] ;
            schema1:startDate "2019-10-21 09:15:00 UTC"^^schema1:Date ] ;
    schema1:keywords "GATK",
        "Variant calling",
        "Variant discovery",
        "disease variant",
        "genomics",
        "priorization" ;
    schema1:name "From reads to disease variants" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "INB: Spanish National Bioinformatics Institute" ;
            schema1:url <https://inb-elixir.es> ],
        [ a schema1:Organization ;
            schema1:name "Fundación Progreso y Salud (FPS)" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Spain" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:url <http://courseswiki.clinbioinfosspa.es/gatk2019/start> .

