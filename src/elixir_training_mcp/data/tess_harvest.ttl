<https://tess.elixir-europe.org/events/vizbi-2025-data-visualisation-masterclass-cambridge-uk-2025> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0092> ;
    schema1:description """Data visualization is essential for validating datasets, verifying AI-driven insights, and communicating your findings across all fields, not just the life sciences. Data Visualization Masterclasses offers participants the opportunity to rapidly learn key principles, methods, and tools from international experts.\r
\r
The Cambridge masterclass is a one day hybrid event that takes place prior to [VIZBI 2025](https://vizbi.org/2025/Program). \r
It features sessions delivered by:\r
*  [Drew Berry](https://wehi.tv/)\r
*  [Andy Lomas](https://andylomas.com/)\r
*  [Barbora Kozlikova](https://www.fi.muni.cz/~xkozlik/)\r
*  [Christian Stolte](https://stoltedesign.com/)\r
*  [Daniel Hahn](https://danielhaehn.com/)\r
\r
### Who should attend\r
If you work with large or complex datasets—whether you're a data analyst, programmer, or scientist—this Masterclass is designed for you. The course also covers data-driven storytelling, so will be valuable for designers, visual artists, as well as marketing and communications professionals.\r
\r
### Can I bring my own data?\r
Participants can present their own data visualization challenges in a ~1 minute “lightning talk” with up to three slides, and you'll have the opportunity to gain feedback from trainers as well as other participants.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "hybrid" ;
            schema1:endDate "2025-04-08 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressLocality "Cambridge" ;
                            schema1:addressRegion "Cambridgeshire" ;
                            schema1:postalCode "CB4 3AD" ;
                            schema1:streetAddress "Cripps Court Magdalene College, 1-3 Chesterton Road" ] ;
                    schema1:latitude "52.211974" ;
                    schema1:longitude "0.116784" ] ;
            schema1:startDate "2025-04-08 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "VIZBI 2025 Data Visualisation Masterclass - Cambridge UK - 2025" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ISCB" ],
        [ a schema1:Organization ;
            schema1:name "VIZBI" ] ;
    schema1:teaches """* Visualization principles\r
* Strategies for complex data\r
* Case studies (including participant examples)\r
* Web based data visualisation\r
* Visual Aesthetics\r
* Data-driven storytelling""" ;
    schema1:url <https://www.datavismasterclass.org/uk/cambridge> .

