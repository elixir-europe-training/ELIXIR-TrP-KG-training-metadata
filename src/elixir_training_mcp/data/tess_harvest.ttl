            schema1:latitude "51.012913" ;
            schema1:longitude "3.707981" ] ;
    schema1:name "Hands-On introduction to NGS variant analysis" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "VIB Bioinformatics Core" ] ;
    schema1:startDate "2020-01-20 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://training.vib.be/product/149> .

