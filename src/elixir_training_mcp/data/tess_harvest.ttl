                    schema1:latitude "20.719499" ;
                    schema1:longitude "-101.352765" ] ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-06-25 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "CABANA Workshop: Genomic Analysis of Crop Biodiversity using R" ;
