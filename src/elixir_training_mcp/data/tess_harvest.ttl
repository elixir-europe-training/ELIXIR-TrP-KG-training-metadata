<https://tess.elixir-europe.org/events/introduction-to-identifying-and-characterising-somatic-variants> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This course covers state-of-the-art and best-practice tools for the analysis of genomes. We describe, and give hands-on experience of, the entire analysis workflow from raw data generated by a sequencing machine to deriving variant calls (e.g. Single Nucleotide Variants) that are ready for downstream analysis, interpretation and prioritisation. We will describe the steps involved to go from sequencing library to a prioritised, clinically-relevant list of DNA variants. Practical sessions will use the user-friendly Galaxy interface (https://usegalaxy.org/) to demonstrate tasks such as alignment, quality control, variant-calling and annotation." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-05-10 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Sheffield" ;
                            schema1:postalCode "S1 3JD" ;
                            schema1:streetAddress "Pam Liversidge Design Studio 1 - D06" ] ;
                    schema1:latitude "53.380663" ;
                    schema1:longitude "-1.470228" ] ;
            schema1:startDate "2019-05-10 09:30:00 UTC"^^schema1:Date ] ;
    schema1:keywords "DNA-seq",
        "NGS",
        "bioinformatics",
        "variant-calling" ;
    schema1:name "Introduction to identifying and characterising somatic variants" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Sheffield Bioinformatics Core" ;
            schema1:url <http://sbc.shef.ac.uk//training/> ] ;
    schema1:url <http://sbc.shef.ac.uk/training/somatic-variants-introduction-2019-05-10> .

