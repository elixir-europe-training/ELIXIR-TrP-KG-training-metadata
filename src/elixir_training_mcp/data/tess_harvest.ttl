            schema1:endDate "2021-08-23 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2021-08-23 09:00:00 UTC"^^schema1:Date ] ;
