            schema1:url <https://training.galaxyproject.org/training-material/topics/evolution/tutorials/abc_intro_phylo/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "iqtree" ;
            schema1:url <https://bio.tools/tool/iqtree> ],
        [ a schema1:Thing ;
            schema1:name "MAFFT" ;
            schema1:url <https://bio.tools/tool/MAFFT> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/records/11089653> ],
        [ a schema1:Thing ;
            schema1:name "FastTree" ;
            schema1:url <https://bio.tools/tool/fasttree> ],
        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ] ;
    schema1:name "Phylogenetics - Back to basics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Describe the basic concepts behind phylogenetic trees and how they are made
- Read and interrogate a phylogeny encountered in the literature
- Use standard tools to align a set of molecular sequences
- Assess the quality of a molecular sequence alignment and be able to modify it appropriately for phylogenetic analysis
- Use standard tools to estimate a phylogenetic tree based on a set of aligned molecular sequences
- Assess the reliability of estimated phylogenies with bootstrapping
- Explore phylogenetic signal using phylogenetic networks""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/evolution/tutorials/abc_intro_phylo/tutorial.html> ;
    schema1:version "1" .

