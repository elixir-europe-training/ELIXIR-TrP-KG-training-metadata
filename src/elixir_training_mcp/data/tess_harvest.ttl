<https://tess.elixir-europe.org/events/the-biotrain-project-opportunities-from-latin-america> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """In this webinar, we present the BiotrAIn project, which focuses on a strategy to expand the capabilities of artificial intelligence (AI) and its application in the life sciences in Latin America. The project involves the participation and recruitment of professionals working in this field across the region, as well as the development of various phases: from resource preparation and outreach activities to the establishment of an active community. Additionally, we address the activities carried out in the final phase, which culminate in the evaluation of the pilot course.   
  
This webinar is part of the [“Applications of artificial intelligence for biosciences in Latin America”](https://www.ebi.ac.uk/training/events/applications-artificial-intelligence-biosciences-latin-america/) webinar series, organised as part of the [BiotrAIn project](https://www.ebi.ac.uk/training/our-partnerships/biotrain), a collaboration between [University of Costa Rica](https://www.ucr.ac.cr/),  [CABANAnet](https://cabana.network/) and EMBL-EBI, funded by the Chan Zuckerberg initiative.    
  
Please note that this webinar is delivered in Spanish. Synchronised captions are provided in both Spanish and English. The English translation has been automatically generated and is currently under review. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2025-10-17 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2025-10-17 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "The BiotrAIn project: opportunities from Latin America" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
