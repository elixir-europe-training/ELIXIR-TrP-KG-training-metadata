            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2021-05-19 00:00:00 UTC"^^schema1:Date ] ;
    schema1:name "A guide to identifying and prioritising drug targets with the Open Targets Platform" ;
    schema1:provider [ a schema1:Organization ;
