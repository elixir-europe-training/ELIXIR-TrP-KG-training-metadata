<https://tess.elixir-europe.org/materials/single-cell-and-spatial-omics-technologies-in-plant-science> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3173>,
        <http://edamontology.org/topic_3308>,
        <http://edamontology.org/topic_3391> ;
    schema1:description """Recent technological advances in single-cell and spatial omics have revolutionised how we study biology by enabling researchers to see what used to be hidden behind the heterogeneity within the tissue. Such technologies have been readily applied to study plants recently. \r
\r
This webinar will showcase the application of single-cell multiomics (transcriptome and epigenome) and spatial transcriptomics in plant research, focusing on the development of a plant cell atlas and the understanding of plant-microbe interactions. """ ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Single-cell and spatial omics technologies in plant science" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/single-cell-and-spatial-omics-technologies-plant-science> .

<https://tess.elixir-europe.org/materials/single-cell-atac-seq-standard-processing-with-snapatac2> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
