    schema1:datePublished "2024-10-29"^^schema1:Date ;
    schema1:description """This course is aimed to provide basic survival skills in Linux and the terminal environment. We will teach you how to access files and folders, move around and hopefully shake off the fear of getting stuck somewhere along the way.\r
\r
No prior knowledge is expected.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Command line",
        "Linux",
        "Linux basics",
        "Shell",
        "UNIX",
        "Unix Shell",
