<https://tess.elixir-europe.org/events/trainer-community-event-ghent> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "VIB Training &amp; Conferences is committed to fostering a strong culture of lifelong learning within the VIB. A key element in achieving this goal is building a community of internal trainers who share their knowledge and expertise. Supporting and recognizing the community is essential to strengthening lifelong learning! To facilitate the knowledge exchange and interaction, we plan to launch various initiatives like train-the-trainer workshops and seminars. Additionally, we aim to acknowledge the valuable contributions of our trainers by offering training and conference vouchers, as well as increasing your online visibility. To strengthen collaboration and understand the trainers' needs, VIB Training and Conferences is organizing its first trainer community event. Join us for an event that celebrates this community. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-05-13 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-05-13 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "career development",
        "personal effectiveness" ;
    schema1:name "Trainer community event - Ghent" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/trainer-community-event-ghent> .

