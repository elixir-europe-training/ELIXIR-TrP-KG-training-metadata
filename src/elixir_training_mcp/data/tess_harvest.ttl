<https://tess.elixir-europe.org/events/exploring-molecular-interactions-in-depth-across-species> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_2600>,
        <http://edamontology.org/operation_3925>,
        <http://edamontology.org/topic_0602> ;
    schema1:description "This webinar provides an introduction to the visualisation of molecular networks across species. It will begin with a presentation of the [IntAct](https://www.ebi.ac.uk/intact/home) Portal’s approach to molecular network modelling. Subsequently, the implementation of this modelling within the IntAct Cytoscape app will be demonstrated. This section will cover the construction of networks, methods for accessing detailed information, the available visualisation modes, and approaches to styling and filtering. Additionally, it will illustrate how network participants can be grouped according to orthology." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
