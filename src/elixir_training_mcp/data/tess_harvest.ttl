                    schema1:addressCountry "Switzerland" ;
                    schema1:addressLocality "Streamed" ] ] ;
    schema1:name "Introduction to High-performance Computing (sciCORE Cluster)" ;
    schema1:organizer <https://ror.org/002n09z45> ;
    schema1:startDate "2023-09-19 00:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.sib.swiss/training/course/20230919_IHPC> .

