            schema1:url <https://zenodo.org/record/6010176> ],
        [ a schema1:Thing ;
            schema1:name "snippy" ;
            schema1:url <https://bio.tools/tool/snippy> ] ;
    schema1:name "Identifying tuberculosis transmission links: from SNPs to transmission clusters" ;
    schema1:provider [ a schema1:Organization ;
