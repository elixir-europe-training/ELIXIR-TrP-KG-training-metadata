                    schema1:latitude "55.378051" ;
                    schema1:longitude "-3.435973" ] ;
            schema1:startDate "2024-04-16 09:30:00 UTC"^^schema1:Date ] ;
    schema1:name "NEOF - Community analysis in R" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:url <https://docs.google.com/forms/d/1Vi5eNTEshPQqOCip50uJC8ngBCbXVyj4o46FU8SLAgU/viewform?edit_requested=true> .

