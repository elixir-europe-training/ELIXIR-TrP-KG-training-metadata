            schema1:url <https://bio.tools/tool/open_phacts_api> ],
        [ a schema1:Thing ;
            schema1:name "Gromacs" ;
            schema1:url <https://bio.tools/tool/Gromacs2> ],
        [ a schema1:Thing ;
            schema1:name "Register for Webinar" ;
            schema1:url <https://attendee.gotowebinar.com/register/295609582301212161> ] ;
    schema1:name "Building pharmacological workflow blocks for virtual screening (BioExcel and OpenPHACTS)" ;
    schema1:provider [ a schema1:Organization ;
