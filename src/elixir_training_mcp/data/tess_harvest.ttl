<https://tess.elixir-europe.org/materials/docker-version-of-welsh-gene-park-ngs-course> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Mark Fernandes" ],
        [ a schema1:Person ;
            schema1:name "Welsh Gene Park" ] ;
    schema1:description """Welcome to the IFR Dockerised version of the Welsh Genepark's \r
Introduction to Command-line NGS Analysis course!\r
The original materials belong to Wesh Genepark and the original\r
materials and software can be found [here](http://www.walesgenepark.cardiff.ac.uk/bioinformatics/training/).\r
\r
This was originally designed to be deployed onto Raspberry pi\r
computers.  Our version will run on any linux machine running Docker \r
Host (or on Windows PC &amp; Macs running Docker Toolbox (Kitematic)).\r
\r
There are updated links to data files and we have provided an i86 \r
version of the GATK (rather than the original ARM version).\r
\r
*** NB ****\r
In Kitematic you will need to map the volume /coursehome to a directory \r
on your hard disk. Next stop then start the container (buttons towards \r
top RH corner) log in again and type '/scripts/copy_course.sh' to\r
copy the tools, data and documents to the mapped directory on your\r
local hard disk.\r
***********""" ;
