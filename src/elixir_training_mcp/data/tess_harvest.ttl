<https://tess.elixir-europe.org/events/research-data-management-for-advanced-users> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_4010> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Project Manager" ],
        [ a schema1:Audience ;
            schema1:audienceType "Data Managers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Principal Investigators" ],
        [ a schema1:Audience ;
            schema1:audienceType "PostDocs" ] ;
    schema1:coursePrerequisites "Experience working with research data and data management plans, either as a researcher or as a support to researchers." ;
    schema1:description "The main goal of this course is to give advanced notions and practical examples and exercises about the Data Management activities for researchers and research support staff, with special attention to the management of sensitive data." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-11-28 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "Spanish Supercomputing Network (RES)" ],
                [ a schema1:Organization ;
                    schema1:name "Spanish National Bioinformatics Institute (INB/ELIXIR-ES)" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Spain" ;
                            schema1:addressLocality "Barcelona" ;
                            schema1:addressRegion "Barcelona" ;
                            schema1:postalCode "08034" ;
                            schema1:streetAddress "UPC Campus Nord" ] ;
                    schema1:latitude "41.387949" ;
                    schema1:longitude "2.112542" ] ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Data Management group members, Network and Security group members, Data Protection Officer, Life Science data managers, Earth Science data managers, BSC" ] ;
            schema1:startDate "2024-11-27 10:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "Clinical data",
        "DMP",
        "Data Management",
        "Data Management Plan",
        "FAIR principles",
        "Licences",
        "Open Data",
        "Open Science",
        "Research Data Management",
        "Sensitive data",
        "Software",
        "anonymisation",
        "data repositories",
        "encryption",
        "intellectual property protection",
        "legislation",
        "personal data",
        "security",
        "storage",
        "storage needs" ;
    schema1:name "Research Data Management for Advanced Users" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Spain" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "Barcelona Supercomputing Center (BSC)" ;
            schema1:url <http://www.bsc.es> ] ;
    schema1:teaches """The objectives of the course are:\r
-    Understand the main characteristics of different kinds of data storage and storage supports, to be able to take the most appropriate decision.\r
-    Examine and compare the most used data repositories, and how they can respond to the needs of your project.\r
-    Learn the basic concepts of the current European and Spanish legislation for managing correctly personal data, and when the collaboration of an expert is mandatory.\r
-    Examine the security measures a data manager must consider when managing data. Understand and compare methods for managing sensitive data: anonymization and encryption.\r
-    See an application of those concepts in the management of clinical data.\r
-    Learn how to manage software applying the FAIR principles.\r
-    Understand the basic management of IP and licenses and their implications in a project.\r
-    Experiment how to solve practical DMPs issues and real cases (practical sessions).\r
\r
\r
Upon completing this course, participants will be able to choose the best storage and repositories for their projects; recognise if professional support is necessary to apply the right security measures and be compliant with the current legislation; apply FAIR principles not only to data but also to software; choose the suitable license with the help of specialised staff.""" ;
    schema1:url <https://www.bsc.es/education/training/bsc-training/bsc-training-research-data-management-advanced-users/agenda> .

