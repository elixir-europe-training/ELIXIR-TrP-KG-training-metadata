    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_3571> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Life Scientists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Nazeefa Fatima" ],
        [ a schema1:Person ;
            schema1:name "Federico Bianchini" ] ;
    schema1:competencyRequired "None" ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2023-12-13"^^schema1:Date ;
    schema1:datePublished "2023-12-13"^^schema1:Date ;
    schema1:description """This is the training material used for a workshop at the 2023 edition of the Oslo Bioinformatics Workshop week\r
\r
This workshop aims to provide a hands-on session on creating a data management plan (DMP) using the Data Stewardship Wizard (DSW), a dynamic web forms system provided by ELIXIR Europe. The Norwegian node of ELIXIR is curating a national instance of DSW (https://elixir-no.ds-wizard.org) and provides a DMP form customised for life scientists in Norway. The audience will learn about the information that needs to be captured into a DMP and how to use DSW for this purpose. We will demonstrate how to create a DMP, starting either from scratch or from a set of recommendations based on specific scientific domains including, among others, sequencing, light microscopy and high-throughput screening. A demonstration of how to work collaboratively on DMPs and how to export them to a document compliant with national and international funding bodies' requirements will also be given. In the second part of the workshop, the participants will work, individually or as groups, on a DMP for projects they are involved in or for projects of interest.""" ;
    schema1:identifier "10.5281/zenodo.10619103" ;
    schema1:learningResourceType "Presentation" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Data Stewardship Wizard" ;
            schema1:url <https://bio.tools/tool/Data_Stewardship_Wizard> ],
        [ a schema1:Thing ;
            schema1:name "FAIRsharing" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.2abjs5> ],
        [ a schema1:Thing ;
            schema1:name "RDMkit" ;
            schema1:url <https://bio.tools/tool/rdmkit> ],
        [ a schema1:Thing ;
            schema1:name "RDA DMP Common Standard for Machine-Actionable Data Management Plans" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.6e60e5> ] ;
    schema1:name "Create and Handle a Data Management Plan" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ;
            schema1:url <http://elixir-norway.org> ] ;
    schema1:teaches """After this workshop, learners will: \r
\r
* Understand the relevant information to be captured in a DMP Start a new DMP on DSW, from scratch or from a set of pre-filled recommendations \r
* Share a DMP and work collaboratively on it Assess good practices in research data management and FAIRness \r
* Export a DMP according to formal requirements from funding bodies such as the Research Council of Norway, Science Europe, and Horizon Europe""" ;
    schema1:url <https://zenodo.org/records/10619104> ;
    schema1:version "v1" .

<https://tess.elixir-europe.org/materials/create-customise-and-maintain-a-data-management-plan-4199172c-6508-448b-bbd7-c9f330bec616> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
