<https://tess.elixir-europe.org/events/7th-hands-on-computational-enzyme-design-course> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3307> ;
