        "hands-on",
        "research data management" ;
    schema1:name "Introduction to Research Data Management (RDM) in Life Sciences" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Apply appropriate metadata standards to describe datasets effectively”",
        "“Appraise and select repositories to deposit research data”",
        "“Define key concepts such as Research Data Management (RDM) FAIR data Open data and Personal and Sensitive Data”",
        "“Distinguish between general and discipline-specific repositories for data sharing”",
        "“Evaluate the components of the Data Management Plan and justify its relevance to research projects”",
        "“Explain the role of data documentation in enhancing publication quality and reproducibility”",
        "“Identify reliable sources and institutional resources that support RDM practices”",
        "“Organize research data and documentation in a structured and standardized format”",
        "“Recognize the ethical and legal implications of data handling under GDPR”" ;
    schema1:url <https://training.vib.be/all-trainings/introduction-research-data-management-rdm-life-sciences-0> .

<https://tess.elixir-europe.org/events/introduction-to-rna-seq> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "High-throughput RNA-sequencing is now the standard technique for quantifying transcript abundance in a biological sample of interest. In this course we will describe the processes that take place once you submit a library for RNA sequencing, and what data you should expect to receive from the Bioinformatics Core. We will describe the steps involved to go from sequencing library to a list of genes that show statistically significant differences between your biological conditions of interest. Practical sessions will use the user-friendly Galaxy interface (https://usegalaxy.org/) to demonstrate tasks such as alignment, quality control and assessing differential expression. We will also showcase some web sites you can use for enrichment and pathways analysis." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2018-03-27 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Sheffield" ;
                            schema1:postalCode "S1 3JD" ;
                            schema1:streetAddress "Pam Liversidge Design Studio 1 - D06" ] ] ;
            schema1:startDate "2018-03-27 09:30:00 UTC"^^schema1:Date ] ;
    schema1:keywords "NGS",
        "RNA-seq",
        "bioinformatics",
        "galaxy" ;
    schema1:name "Introduction to RNA-seq" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Sheffield Bioinformatics Core" ;
            schema1:url <http://sbc.shef.ac.uk//training/> ] ;
    schema1:url <http://sbc.shef.ac.uk/training/rna-seq-introduction-2018-03-27> .

