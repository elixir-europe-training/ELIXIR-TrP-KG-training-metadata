        [ a schema1:Thing ;
            schema1:name "Jupyter Notebook (with Solutions)" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/data-science/tutorials/python-conda/data-science-python-conda.ipynb> ] ;
    schema1:name "Conda Environments For Software Development" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Set up a Conda environment for our software project using `conda`.
- Run our software from the command line.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/data-science/tutorials/python-conda/tutorial.html> ;
    schema1:version "3" .

