<https://tess.elixir-europe.org/events/cgr-python-for-bioinformatics> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """The Centre for Genomic Research (CGR) at the University of Liverpool (UoL) presents this in-person Python for Bioinformatics workshop.\r
\r
Overview\r
Python is one of the most popular programming languages for bioinformatics and data analysis in general. It is a very flexible language with countless applications in the manipulation and processing of data files. This workshop is aimed at Python beginners and will give you transferable skills to manipulate your own data and experience in Python modules tailored specifically for bioinformatics and genomics analyses.\r
\r
Date &amp; Times: 10am-4pm (1st &amp; 2nd May 2025)\r
\r
Location: MerseyBIO, Crown St, Liverpool L69 7ZB (Google maps)\r
Building 216, the red arrow pointing north on the top right of F8 in the Campus Map\r
\r
Price \r
The price rates for this workshops are:\r
Academic: £250\r
Non higher education public institute: £350\r
\r
For more information and to register please see the following link: https://forms.gle/pHLMcv29uPucdJfM7\r
\r
Contacts\r
If you have a query about the, your suitability of the workshop, its contents, running of the workshop or payment please email Matthew Gemmell (mgemmell@liverpool.ac.uk)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-05-02 16:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressLocality "Liverpool" ;
                            schema1:addressRegion "Merseyside" ;
                            schema1:postalCode "L69 7ZB" ;
                            schema1:streetAddress "Biosciences Building,  Crown Street" ] ;
                    schema1:latitude "53.407398" ;
                    schema1:longitude "-2.962509" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Centre for Genomic Research, University of Liverpool" ] ;
            schema1:startDate "2025-05-01 10:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "CGR - Python for bioinformatics (In-person)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:teaches """Create, edit, run, and save python scripts with Jupyter-notebook.\r
Understand and use fundamental python concepts including operators, annotations, variables, and variable classes.\r
Utilise a variety of python functions and methods.\r
Store and manipulate data within lists, sets, and dictionaries.\r
Produce If and else statements to print out different results based on logical conditions (True or False).\r
Carry out the same task on multiple items with loops.\r
Read in and write out fastq files with the biopython library.\r
Filter sequences from fastq data.\r
Use logical operators to test multiple conditions at once.""" ;
    schema1:url <https://forms.gle/pHLMcv29uPucdJfM7> .

