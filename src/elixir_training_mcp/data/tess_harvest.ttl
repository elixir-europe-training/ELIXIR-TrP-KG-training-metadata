<https://tess.elixir-europe.org/events/spatial-data-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This training will give an overview of spatial data analysis for a variety of targeted and untargeted spatial omics approaches. The training aims to provide early-career researchers an entry point into spatial data analysis and to give experienced users the opportunity to broaden their knowledge.

In a series of presentations, we will give an overview of the available tools for targeted transcriptomics and proteomics, untargeted transcriptomics, visualization, annotation and downstream spatial analyses such as neighborhood analysis, spatial enrichment, cell-cell interactions... The SPArrOW pipeline, developed by the Yvan Saeys group (VIB) for the analysis of spatial transcriptomics data, will be introduced. After each section, discussion and the exchange of expertise among attendants will be encouraged.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-01-19 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Ghent" ;
                            schema1:postalCode "9000" ;
                            schema1:streetAddress "Ghent - Clemenspoort, Overwale 3" ] ;
                    schema1:latitude "51.053829" ;
                    schema1:longitude "3.725012" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-01-19 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "omics" ;
    schema1:name "Spatial data analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/spatial-data-analysis> .

<https://tess.elixir-europe.org/events/spatial-data-analysis-fa605b33-b95a-4e6c-a6e4-4631c6727b8d> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This training will give an overview of spatial data analysis for a variety of targeted and untargeted spatial omics approaches. The training aims to provide early-career researchers an entry point into spatial data analysis and to give experienced users the opportunity to broaden their knowledge.

In a series of presentations, we will give an overview of the available tools for targeted transcriptomics and proteomics, untargeted transcriptomics, visualization, annotation and downstream spatial analyses such as neighborhood analysis, spatial enrichment, cell-cell interactions... The SPArrOW pipeline, developed by the Yvan Saeys group (VIB) for the analysis of spatial transcriptomics data, will be introduced. After each section, discussion and the exchange of expertise among attendants will be encouraged.""" ;
