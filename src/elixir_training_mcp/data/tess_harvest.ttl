                    schema1:latitude "-33.86882" ;
                    schema1:longitude "151.209296" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "University of Sydney" ] ;
            schema1:startDate "2016-09-21 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "ABR" ;
    schema1:name "Intro to Unix at USYD Camperdown" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "iAnn" ;
