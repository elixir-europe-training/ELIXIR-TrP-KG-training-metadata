                            schema1:addressCountry "Australia" ;
                            schema1:addressLocality "Darwin" ] ;
                    schema1:latitude "-12.46344" ;
                    schema1:longitude "130.845642" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Charles Darwin University" ] ;
            schema1:startDate "2016-05-12 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "ABR",
        "Bioinformatics",
        "COMBINE",
        "ComputationalBiology" ;
    schema1:name "COMBINE: A Data Carpentry Workshop" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "iAnn" ;
            schema1:url <http://iann.pro> ] ;
    schema1:url <http://combine-australia.github.io/2016-05-12-CharlesDarwinUni/> .

<https://tess.elixir-europe.org/events/combine-de-nbi-tutorial-modelling-and-simulation-tools-in-systems-biology-icsb-2019> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Andreas Weidemann, Martin Golebiewski (HITS gGmbH, Heidelberg, Germany), Frank Bergmann, Jürgen Pahle, Sven Sahle (University of Heidelberg, Germany) (de.NBI-SysBio) in collaboration with educators from UK, New Zealand, Japan, Germany, USA\r
\r
Date:\r
Thursday, October 31st, 2019\r
\r
Links:\r
http://co.mbine.org/events/tutorial2019\r
\r
Location:\r
Okinawa Insitute of Science and Technology Graduate University\r
Okinawa, Japan\r
\r
Contents:\r
This tutorial workshop is a satellite of the 20th International Conference on Systems Biology (ICSB).\r
\r
Participants will learn how to set up computer models of biological systems (e.g. metabolic or signalling networks) using experimental kinetic data and how to simulate them in different systems biology platforms. Hands-on sessions, lectures and software demonstrations will be included, providing attendees with the necessary skills to access experimental kinetics data from available resources, to assemble computer models with these data, and finally to simulate the generated models using simulation tools. Also handling and exchange of biological models based on existing community standards will be demonstrated along with the basic principles of the underlying standard formats and how they\r
support reproducible and FAIR computational modelling.\r
\r
The topics covered will include:\r
- Reproducibility and FAIR (Findable, Accessible, Interoperable and Re-usable) data\r
- Curation services\r
- Model setup using different software tools and systems biology platforms\r
- Using experimental data for setting up quantitative models\r
- Parameter estimation, optimization and model fitting\r
- Simulation, analysis and visualization of biochemical models, and multicellular modelling\r
- Constraint-based and logical modeling of metabolic and signaling networks\r
- Database supported modelling: integrated data management and model databases\r
- Community standards and formats for systems and synthetic biology models\r
- Machine learning for model reduction and image analysis\r
\r
Prerequisites:\r
Laptop\r
\r
Keywords:\r
systems biology, software tools, quantitative models, parameter estimation, model simulation, logical modeling, metabolic networks, model databases, community standards\r
\r
Tools:\r
BioModels, CellDesigner, COPASI, Morpheus, Physiome Model Repository / OpenCOR, SABIO-RK, SEEK/FAIRDOMhub, tellurium, Virtual Cell""" ;
