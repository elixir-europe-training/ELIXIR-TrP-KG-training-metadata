                            schema1:postalCode "EH9 3JN" ;
                            schema1:streetAddress "The King's Buildings, The University of Edinburgh" ] ;
                    schema1:latitude "55.922536" ;
                    schema1:longitude "-3.175467" ] ;
            schema1:startDate "2017-11-23 09:00:00 UTC"^^schema1:Date ] ;
