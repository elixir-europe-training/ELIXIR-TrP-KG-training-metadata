    schema1:teaches """- Deal with netcdf files in ODV
- Visualise ocean variables from Argo glider's data""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/climate/tutorials/ocean-data-view/tutorial.html> ;
    schema1:version "2" .

