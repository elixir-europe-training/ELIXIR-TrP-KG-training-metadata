        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/genome-annotation/tutorials/tnseq/workflows/> ] ;
    schema1:name "Essential genes detection with Transposon insertion sequencing" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Understand the read structure of TnSeq analyses
- Predict Essential genes with Transit
- Compare gene essentiality in control sample and an different experimental condition""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/genome-annotation/tutorials/tnseq/tutorial.html> ;
    schema1:version "12" .

