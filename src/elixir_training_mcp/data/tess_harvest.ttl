<https://tess.elixir-europe.org/events/technological-advances-and-computational-approaches-for-spatially-resolved-transcriptomics> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0203>,
        <http://edamontology.org/topic_3308>,
        <http://edamontology.org/topic_3391> ;
    schema1:description """Spatially-resolved transcriptomics enables high-throughput gene expression profiling within the spatial context of tissues, offering valuable insights into cellular function and tissue organisation. By integrating spatial coordinates with gene expression data, researchers can identify spatially co-localised cell populations and uncover the spatial dynamics of gene expression. 

This webinar will explore the latest technological advances and computational approaches for analysing spatially-resolved transcriptomics data, equipping participants to critically plan their experimental design and analyses.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-09-11 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-09-11 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Advances in spatial omics",
        "Data integration",
        "Spatial transcriptomics",
        "single-cells" ;
    schema1:name "Technological advances and computational approaches for spatially-resolved transcriptomics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
