<https://tess.elixir-europe.org/events/hands-on-workshop-in-marine-metagenomics> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_3174>,
