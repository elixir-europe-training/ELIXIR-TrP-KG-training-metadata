    schema1:name "Tools for Systems biology modeling and data exchange: CellNetAnalyzer, COPASI, SABIO-RK, FAIRDOMHub/SEEK 2023" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "de.NBI" ;
            schema1:url <https://www.denbi.de> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
