                    schema1:addressRegion "Detmold" ;
                    schema1:streetAddress "Bielefeld" ] ;
            schema1:latitude "52.030229" ;
            schema1:longitude "8.532471" ] ;
    schema1:name "Computational Pangenomics Workshop - GCB 2024" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "de.NBI / ELIXIR-DE" ] ;
    schema1:startDate "2024-09-30 09:00:00 UTC"^^schema1:Date ;
