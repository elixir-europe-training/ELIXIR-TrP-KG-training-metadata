<https://tess.elixir-europe.org/events/introduction-to-computational-protein-design-september-2024> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "The 2-days training session will provide an overview of the principles of computational protein design and of the state-of-the-art tools used to design proteins. Day 1 will start with a hands-on exercise to predict the effect of point mutations on protein stability using Rosetta. We will use a few example to demonstrate how to prepare the input PDB structure and how to run computational site saturation mutagenesis to search for mutations stabilizing the protein. In addition to using command line interface (on the VSC VUB clusters), we will introduce and test the PROSS automate server. The afternoon of Day 1 will be dedicated to building protein fusions and chimeras using the DirectSegmentLookup application in Rosetta. In that context, elements of design using symmetric constraints will be introduced. Day 2 is dedicated to de novo protein design. After a brief introduction of the principles and theoretical background, several hands-on exercises will be proposed to learn the basis of protein design with RFDiffusion and ProteinMPNN. To get the most from this training session, the trainees should be able to visualize protein structure (with Chimera or Pymol) and to use AlphaFold2 and ColabFold." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-09-12 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "Vlaams Supercomputer Centrum" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Brussels" ;
                            schema1:postalCode "1050" ;
                            schema1:streetAddress "Brussels - VUB Campus Etterbeek, Pleinlaan 2" ] ;
                    schema1:latitude "51.033713" ;
                    schema1:longitude "4.351697" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-09-11 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "Introduction to Computational Protein Design - September 2024" ;
    schema1:provider [ a schema1:Organization ;
