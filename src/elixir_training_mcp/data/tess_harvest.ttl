<https://tess.elixir-europe.org/events/graphiques-sous-r-avec-ggplot2-graphics-with-r-ggplot2-2023-session> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Graphics with R-ggplot2 (2023)" ;
    schema1:description """Objectifs pédagogiques :\r
À l’issue de la formation, les stagiaires connaîtront les principales fonctionnalités du package R « ggplot2 » et la démarche sous-jacente pour construire un graphique à partir d’un tableau de données. Ils seront capables de réaliser plusieurs types de représentations graphiques, telles que des nuages de points, des courbes, des histogrammes, des diagrammes en bâtons, des boxplots, des heatmaps, etc.  Les stagiaires pourront apporter leur propre tableau de données et pratiquer dessus en fin de formation. \r
\r
Programme :\r
- Principes généraux liés au package ggplot2 \r
- Principales fonctions graphiques pour réaliser des nuages de points, des histogrammes, des boxplots, etc. \r
- Principales fonctions pour jouer sur les coloriages en fonction d’une variable, sur les échelles de couleurs, sur les graduations, sur les représentations multiples, etc.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-05-15 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Jouy-en-Josas" ;
                            schema1:postalCode "78350" ;
                            schema1:streetAddress "Centre INRAE, bâtiment 233" ] ;
                    schema1:latitude "48.76464" ;
                    schema1:longitude "2.168453" ] ;
            schema1:maximumAttendeeCapacity 10 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BioinfOmics (https://www.inrae.fr/infrastructures-recherche-au-sein-dinrae#anchor5_2), MIGALE (https://migale.inrae.fr)" ] ;
            schema1:startDate "2023-05-15 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Graphiques sous R avec ggplot2 / Graphics with R-ggplot2 (2023 session )" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "IFB French Institute of Bioinformatics" ;
            schema1:url <http://www.france-bioinformatique.fr> ] ;
    schema1:url <https://migale.inrae.fr/trainings> .

