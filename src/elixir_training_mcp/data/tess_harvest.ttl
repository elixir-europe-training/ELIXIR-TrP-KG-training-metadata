<https://tess.elixir-europe.org/events/analysis-of-shotgun-metagenomic-data-may-2025> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This training session is organized by the Genotoul bioinfo platform. This course is dedicated to the analysis of prokaryotic shotgun metagenomic data from Illumina and Pacbio HiFi sequencing technology. \r
\r
After an overview of metagenomics and the biases and limitations of analyses, we will look at the main steps involved in analysing metagenomic data and launch independent tools on the genobioinfo cluster.\r
Learners will then test a workflow to automate processing on a test dataset (metagWGS ).\r
On the third day, learners will choose which analysis strategy to start with according to their experimental design and launch the first stage of metagWGS on their own data.\r
By the end of the course, trainees will be familiar with the scope, advantages and limitations of shotgun sequencing data analysis and will have started the analysis on their own data.\r
\r
calendar\r
 \r
\r
This training is focused on practice. It consists of several modules with a large variety of exercises:\r
\r
First Day\r
Start at 09:00 am\r
Tour de table\r
Introduction to metagenomics, Illumina and Pacbio data, analysis stages, analysis limits, etc.\r
Presentation of some key tools for each stage\r
Practical work on the main stages launched independently\r
End at 17:00 pm\r
Second Day\r
Start at 09:00 am\r
Introduction to the advantages and disadvantages of workflows and containers\r
Launch of the data cleansing stage\r
Launch of the rest of the workflow and analysis of the multiQC report\r
End at 17:00 pm\r
Third Day – BYOD\r
Start at 09:00 am\r
Define the analysis strategy and launch the start of the analysis of your own data.\r
End at 17:00 pm maximum""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-05-07 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "castanet-tolosan" ;
                            schema1:postalCode "31326" ;
                            schema1:streetAddress "24 chemin de borderouge CS 52627 – Auzeville" ] ;
                    schema1:latitude "43.517214" ;
                    schema1:longitude "1.49808" ] ;
            schema1:maximumAttendeeCapacity 12 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BioinfOmics (https://www.inrae.fr/infrastructures-recherche-au-sein-dinrae#anchor5_2), Genotoul-bioinfo (http://bioinfo.genotoul.fr/), INRAE (https://www.inrae.fr/), MIAT 0875 ()" ] ;
            schema1:startDate "2025-05-05 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Analysis of shotgun metagenomic data - May 2025" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "IFB French Institute of Bioinformatics" ;
            schema1:url <http://www.france-bioinformatique.fr> ] ;
    schema1:url <https://bioinfo.genotoul.fr/index.php/events/analysis-of-shotgun-metagenomic-data/> .

<https://tess.elixir-europe.org/events/analysis-of-single-cell-atac-seq-data> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This course is an introduction to single-cell Assay for Transposase-Accessible Chromatin using sequencing (scATAC-seq) data. The advantage over bulk ATAC-seq is that scATAC-seq gives cell-type-specific information, but it requires specific tools to analyze this data. ScATAC-seq can be integrated with scRNA-seq to retrieve gene regulatory information." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-06-04 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-06-03 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "advanced bioinformatics",
        "omics" ;
    schema1:name "Analysis of single cell ATAC-seq data" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/analysis-single-cell-atac-seq-data> .

<https://tess.elixir-europe.org/events/analysis-of-single-cell-atac-seq-data-38926f0d-4e14-40e5-82ec-1986fa1df3d9> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This training introduces participants to scATAC-seq (single-cell Assay for Transposase-Accessible Chromatin using sequencing), a technique that reveals chromatin accessibility with cell-type resolution. The course will guide you through the analysis of scATAC-seq data in R, using ArchR, and it will also discuss the results obtained by CellRanger-ATAC. By the end of the training, participants will be able to process their own scATAC-seq datasets, and integrate results with scRNA-seq data to explore mechanisms of gene regulation." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-10-15 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-10-14 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "advanced bioinformatics",
        "omics" ;
    schema1:name "Analysis of single-cell ATAC-seq data" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "Apply ArchR to perform quality control doublet inference clustering, annotation and peak calling of scATAC-seq datasets",
        "Describe the principles and workflow of scATAC-seq technology and scATAC-seq analysis",
        "Integrate scATAC-seq data with scRNA-seq data to infer gene regulatory networks",
        "Interpret output files and quality reports generated by CellRanger-ATAC",
        "Possibility to analyse your own scATAC-seq data under the guidance of experts",
        "Visualize the data in a Genome Browser" ;
    schema1:url <https://training.vib.be/all-trainings/analysis-single-cell-atac-seq-data-0> .

<https://tess.elixir-europe.org/events/analysis-of-single-cell-rna-seq-data-from-10x-genomics-4b226aec-0250-4fcc-9334-d5f91c4da8f6> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Today it is possible to obtain genome-wide transcriptome data from single cells using high-throughput sequencing (scRNA-seq). The main advantage of scRNA-seq is that the cellular resolution and the genome wide scope makes it possible to address issues that are intractable using other methods, e.g. bulk RNA-seq or single-cell RT-qPCR. These scRNA-seq datasets can be used to unravel heterogenous cell populations, for the discovery of new cell types and states, the reconstruction of developmental trajectories and fate decisions, all previously masked in bulk transcriptome analyses. However, to analyze scRNA-seq data, novel methods are required and some of the underlying assumptions for the methods developed for bulk RNA-seq experiments are no longer valid." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-08-30 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Gent" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - iGent, Technologiepark-Zwijnaarde 126" ] ;
                    schema1:latitude "51.012913" ;
                    schema1:longitude "3.707981" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2019-08-29 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "advanced bioinformatics" ;
    schema1:name "Analysis of single cell RNA-Seq data from 10x Genomics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/analysis-single-cell-rna-seq-data-10x-genomics> .

<https://tess.elixir-europe.org/events/analysis-of-single-cell-rna-seq-data-from-10x-genomics-5360606b-8116-48e6-929f-5e3b1bd1de5b> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description "In this course we will discuss some of the advantages and pitfalls of scRNA-Seq and go through the whole scRNA-seq analysis pipeline. We will teach you how to do proper quality control and filtering on gene level and cell level, how to do create tSNE plots, how to get potential markers for a subset of cells ... " ;
    schema1:endDate "2019-08-30 00:00:00 UTC"^^schema1:Date ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Belgium" ;
                    schema1:addressLocality "Gent" ;
                    schema1:postalCode "9052" ;
                    schema1:streetAddress "iGent" ] ;
            schema1:latitude "51.012913" ;
            schema1:longitude "3.707981" ] ;
    schema1:name "Analysis of single cell RNA-Seq data from 10x Genomics" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "VIB Bioinformatics Core" ] ;
    schema1:startDate "2019-08-29 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://training.vib.be/product/116> .

<https://tess.elixir-europe.org/events/analysis-of-single-cell-rnaseq-data> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Today it is possible to obtain genome-wide transcriptome data from single cells using high-throughput sequencing (scRNASeq). The main advantage of scRNASeq is that the cellular resolution and the genome wide scope makes it possible to address issues that are intractable using other methods, e.g. bulk RNASeq or single-cell RT-qPCR. These scRNASeq datasets can be used to unravel heterogenous cell populations, for the discovery of new cell types and states, the reconstruction of developmental trajectories and fate decisions, all previously masked in bulk transcriptome analyses. However, to analyze scRNASeq data, novel methods are required and some of the underlying assumptions for the methods developed for bulk RNASeq experiments are no longer valid." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
