<https://tess.elixir-europe.org/materials/quality-control-in-sequencing-experiments> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3393> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Simon Andrews" ],
        [ a schema1:Person ;
            schema1:name "Boo Virk" ],
        [ a schema1:Person ;
            schema1:name "Laura Biggins" ] ;
    schema1:description """This course looks at the different ways in which sequencing based studies can fail and the options for visualisation and QC which allow you to identify and diagnose these failures at an early stage. It is designed to be of use to anyone who is using sequencing as part of their research, not just those who are running sequencing facilities.\r
\r
**Course Content**\r
\r
* Why QC is important\r
* How sequencing experiments fail\r
* Implementing sequencing QC\r
* Existing QC software\r
\r
**Course Material**\r
\r
* [Course Introduction (pptx)](http://www.bioinformatics.babraham.ac.uk/training/Sequence_QC_Course/Sequencing%20QC%20intro.pptx)\r
* [Course Introduction (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Sequence_QC_Course/Sequencing%20QC%20intro.pdf)\r
* [How sequencing experiments fail (pptx)](http://www.bioinformatics.babraham.ac.uk/training/Sequence_QC_Course/How%20sequencing%20experiments%20fail.pptx)\r
* [How sequencing experiments fail (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Sequence_QC_Course/How%20sequencing%20experiments%20fail.pdf)\r
* [Failures in biological interpretation (pptx)](http://www.bioinformatics.babraham.ac.uk/training/Sequence_QC_Course/sequencing_failures_interpretation.pptx)\r
* [Failures in biological interpretation (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Sequence_QC_Course/sequencing_failures_interpretation.pdf)\r
* [Developing and Implementing QC (pptx)](http://www.bioinformatics.babraham.ac.uk/training/Sequence_QC_Course/Developing%20and%20Implementing%20QC.pptx)\r
* [Developing and Implementing QC (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Sequence_QC_Course/Developing%20and%20Implementing%20QC.pdf)\r
* [Course Data (zip, 9.3MB)](http://www.bioinformatics.babraham.ac.uk/training/Sequence_QC_Course/Sequence_QC_Course_Data.zip)""" ;
    schema1:keywords "Babraham Institute" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Quality Control in Sequencing Experiments" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Bioinformatics and Biomathematics Training Hub" ;
            schema1:url <http://www.earlham.ac.uk/bbsrc-bioinformatics-and-biomathematics-training-hub> ] ;
    schema1:url <http://www.bioinformatics.babraham.ac.uk/training.html#sequenceqc> .

