            schema1:startDate "2024-04-08 11:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Carpentries",
        "R",
        "coding",
        "linux",
        "novice",
        "programming" ;
    schema1:name "UCT Software Carpentry Workshop April 2024" ;
    schema1:provider [ a schema1:Organization ;
