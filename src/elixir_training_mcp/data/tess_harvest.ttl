<https://tess.elixir-europe.org/events/basic-git-training> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "bioinformatician" ],
