<https://tess.elixir-europe.org/events/australian-biocommons-2021-showcase> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_3307>,
        <http://edamontology.org/topic_3574> ;
    schema1:contact "Christina Hall (christina@biocommons.org.au)" ;
    schema1:description """Australian BioCommons projects draw key players together to deliver complex enhancements and new solutions for the digital life sciences. Join us to discover the breadth of our activities, review the impact we’re having and connect over a collaborative vision for the future of Australian bioinformatics and bioscience research infrastructure.\r
\r
We’ll meet online over three afternoons to share achievements, challenges and future directions. We invite existing partners, potential contributors and interested colleagues to learn more about all aspects of the Australian BioCommons, and meet the wide network of peers working hard to make these collaborative projects a success.\r
\r
Join us for any or all of the sessions on Wed 3 Nov 3-6pm AEDT, Thu 4 Nov 2-5pm AEDT or Fri 5 Nov 2-5pm AEDT.\r
\r
**[Click here for program of speakers &amp; registration details](https://www.biocommons.org.au/events/2021-showcase)**""" ;
    schema1:eligibility "first_come_first_served" ;
    schema1:endDate "2021-11-05 17:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
