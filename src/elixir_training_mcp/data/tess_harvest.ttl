<https://tess.elixir-europe.org/events/visualising-integrated-single-cell-and-spatial-transcriptomics-datasets> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3308>,
        <http://edamontology.org/topic_3382>,
        <http://edamontology.org/topic_3391> ;
    schema1:description "Spatial transcriptomics is a cutting-edge field that has revolutionised our understanding of biological systems by integrating spatial information with transcriptomics technologies. WebAtlas is a data pipeline and visualisation platform for integrated single cell and spatial transcriptomic data. This webinar will introduce the WebAtlas platform and its collaboration with the BioImage Archive which is a free public archive for the biological imaging data, particularly showcasing the importance of open FAIR data and cloud compatible scalable open data formats." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-10-09 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-10-09 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Advances in spatial omics",
        "BioImage Archive",
        "Data integration",
        "Single cell" ;
    schema1:name "Visualising integrated single cell and spatial transcriptomics datasets" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
