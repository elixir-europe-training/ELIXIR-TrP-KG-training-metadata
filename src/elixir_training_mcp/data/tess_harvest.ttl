<https://tess.elixir-europe.org/events/time-management> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Do you often say to yourself, ‘I don't have time’? Do you often feel like you ‘didn't do anything’ at the end of the day? Do you feel like everything is urgent? Then this is the training for you! During this training, we will take a closer look at how you can manage your tasks and time more efficiently. You will be given practical tips on how to deal with day-to-day pitfalls in time management and how to prioritize efficiently. This workshop can help you become a ‘strategist’ of your time, with immediate effect!" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-02-11 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.012803" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-02-11 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "personal effectiveness" ;
    schema1:name "Time management" ;
    schema1:provider [ a schema1:Organization ;
