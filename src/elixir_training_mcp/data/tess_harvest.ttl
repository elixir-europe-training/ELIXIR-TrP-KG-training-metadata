    schema1:name "Course: RaukR. Advanced R for Bioinformatics. Summer School" ;
    schema1:startDate "2019-06-10 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.google.com/calendar/event?eid=N2M3c2dlY3RwZjNqNTFhNGc3aWs2NjNjMXQgYmlscy5lbGl4aXJAbQ> .

