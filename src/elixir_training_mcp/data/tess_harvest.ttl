<https://tess.elixir-europe.org/events/neucrest-big-data-workshop> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "This workshop is for a cohort of early-stage researchers working on the EU-funded NEUcrest Innovative Training Network." ] ;
    schema1:description "This course will introduce participants to the concept of \"big data\" in relation to biology, bioinformatics, and life science data. It will explore data resources and bioinformatics tools from the European Bioinformatics Institute and the Wellcome Sanger Institute. The course content will also cover the fundamentals of bulk and single-cell sequencing of RNA samples and provide practical instruction in basic analytical approaches." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
