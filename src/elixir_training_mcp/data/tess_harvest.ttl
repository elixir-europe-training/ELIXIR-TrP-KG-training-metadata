            schema1:url <https://zenodo.org/record/4274812> ] ;
    schema1:name "16S Microbial analysis with Nanopore data" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Use Nanopore data for studying soil metagenomics
- Analyze and preprocess Nanopore reads
- Use Kraken2 to assign a taxonomic labels""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/microbiome/tutorials/nanopore-16S-metagenomics/tutorial.html> ;
    schema1:version "5" .

