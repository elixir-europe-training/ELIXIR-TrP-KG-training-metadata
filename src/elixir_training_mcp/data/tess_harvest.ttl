            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/journey-fair-bioimage-data> .

<https://tess.elixir-europe.org/events/a-new-look-for-bacdive-discover-the-new-design-and-the-upcoming-genome-browser-feature> a schema1:Course ;
