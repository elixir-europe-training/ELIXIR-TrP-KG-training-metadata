        [ a schema1:Thing ;
            schema1:name "fastp" ;
            schema1:url <https://bio.tools/tool/fastp> ] ;
    schema1:name "Quality and contamination control in bacterial isolate using Illumina MiSeq Data" ;
    schema1:provider [ a schema1:Organization ;
