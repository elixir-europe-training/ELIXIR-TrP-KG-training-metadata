<https://tess.elixir-europe.org/events/tech-transfer-essentials> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "From bench to patient/consumer: the journey of your inventionVIB’s Innovation &amp; Business team guides research valorization to create economic value. They have built up a sound expertise in intellectual property management, business development and new ventures over the last 20 years. To create more awareness on technology transfer opportunities and possibilities to valorize scientific results among the VIB researchers, the team organizes this training which opens up the basics of technology transfer and explains the process of valorization, as well as how your research projects may lead to research collaborations, patents and licenses or a spin-off company. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ] ;
