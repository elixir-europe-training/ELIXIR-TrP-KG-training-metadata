            schema1:endDate "2020-11-24 11:30:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2020-11-24 10:00:00 UTC"^^schema1:Date ] ;
    schema1:name "de.NBI Crop Analysis Tool Suite (Part III) training course – Explore barley diversity" ;
    schema1:provider [ a schema1:Organization ;
