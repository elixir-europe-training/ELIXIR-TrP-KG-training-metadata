            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:teaches """By the end of this lesson you will:\r
- Know the benefits of DMPs\r
- Know the sections of a typical DMP\r
- Know tools to assist in writing a DMP\r
- Have experience in writing a DMP using an online tool called Data Stewardship Wizard\r
- Know where to get help in future DMP writing""" ;
    schema1:url <https://nbisweden.github.io/module-dmp-dm-practices/> .

