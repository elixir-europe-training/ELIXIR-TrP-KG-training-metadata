<https://tess.elixir-europe.org/events/a-guide-to-multiomics-pathway-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_2600>,
        <http://edamontology.org/operation_3928> ;
    schema1:description "In this webinar we will discuss how to perform comparative multi-omics pathway analyses using the ReactomeGSA pathway analysis system. We will be comparing independent studies that use different 'omics approaches, as well as different 'omics measurements from the same study. Additionally, we will be looking at simple to use methods to integrate public datasets into one's own analysis. Finally, we will use the ReactomeGSA R package to improve the annotations of single-cell RNAseq data. During the webinar we will use Reactome's web interface as well as the ReactomeGSA Bioconductor R package." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-06-02 00:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 500 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2021-06-02 00:00:00 UTC"^^schema1:Date ] ;
    schema1:name "A guide to multi-omics pathway analysis" ;
    schema1:provider [ a schema1:Organization ;
