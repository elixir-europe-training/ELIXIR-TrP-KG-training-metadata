<https://tess.elixir-europe.org/events/fairplus-innovation-and-sme-forum-86860301-e5de-4eee-8cfb-dc7fc929a4c3> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """The 2nd FAIRplus Innovation and SME Forum is aimed at companies working with life science data or planning to provide FAIRification services, and anyone interested in FAIRification of their data.\r
\r
During the event, we will:\r
\r
\r
	Share our experiences of FAIRifiying datasets from selected IMI projects\r
	Introduce the collaboration with Pistoia Alliance\r
	Explore different business models based on FAIR data expertise\r
""" ;
    schema1:endDate "2021-01-13 00:00:00 UTC"^^schema1:Date ;
    schema1:name "FAIRplus Innovation and SME Forum" ;
