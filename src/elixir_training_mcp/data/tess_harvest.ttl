                            schema1:addressCountry "Italy" ;
                            schema1:addressLocality "Pula" ;
                            schema1:postalCode "09050" ;
                            schema1:streetAddress "Science and Technology Park of Sardinia - Edificio 2, Località Piscinamanna" ] ;
                    schema1:latitude "39.007433" ;
                    schema1:longitude "9.001646" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "CSC - Bioexcel" ] ;
            schema1:startDate "2023-09-10 09:00:00 UTC"^^schema1:Date ] ;
