<https://tess.elixir-europe.org/events/annotating-your-experimental-data-workshop> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:alternateName "supporting data FAIRness in nanosciences" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "mixed audience" ],
        [ a schema1:Audience ;
            schema1:audienceType "nanoscientists" ] ;
    schema1:description """During the full-day online workshop three hackathons w offered and participants learnt to enrich their own (published) data to make it have more impact. Description of experimental data was aligned to community terminology (ontology terms). Experiences were gathered how you can make your research articles findable to other researchers. \r
\r
Participants brought their own published data for the workshop (published is not limited to a journal article, but published in archive).\r
\r
Target audience: Young Scholars (no prior bioinformatics knowledge required), i.e. early-stage and experienced experimentalist researchers\r
Expectation: Willing to learn new things and active participation \r
\r
REGISTER here asap so we can tailor the workshop for your needs: Registration - Hackathon 28th April 2020 """ ;
    schema1:endDate "2020-04-28 16:00:00 UTC"^^schema1:Date ;
    schema1:funder [ a schema1:Organization ;
