<https://tess.elixir-europe.org/materials/workshop-introduction-to-machine-learning-in-r-from-data-to-knowledge> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Psomopoulos, Fotis (orcid: 0000-0002-0222-4273)" ],
        [ a schema1:Person ;
            schema1:name "Winter, Uwe" ],
        [ a schema1:Person ;
