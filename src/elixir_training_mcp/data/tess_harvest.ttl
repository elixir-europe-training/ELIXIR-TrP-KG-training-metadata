<https://tess.elixir-europe.org/events/embo-practical-course-on-integrative-modelling-of-biomolecular-interactions> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Proteins and their interactions are the mainstays of any cellular process. Studying these interactions at atomic detail is invaluable, paving the route to a mechanistic understanding of biological function and providing the first essential step towards the development of new drugs. Because of the costs and challenges associated with experimental techniques, structural biologists often turn to computational methods.\r
\r
This course will present docking-based computational methods and related bioinformatics approaches, aiming at predicting how proteins interact with other biomolecules or ligands. Lectures will provide the theoretical background on state-of-the-art algorithms for sampling and scoring docking models, describe the use of low- and high-resolution information, and conservation- and coevolution-based interface prediction methods. Further, to broaden the scope of the course beyond protein-protein interactions, we will cover protein-peptide docking, data-driven molecular simulations, and other relevant topics in the field, including modeling of large assemblies and membrane proteins. Roughly half of the course wil consist of practical sessions where the students will run computations on interesting biological problems. Finally, to encourage interaction between all participants and stimulate discussions, students will be prompted to present their own research, both in flash presentations and poster sessions, and bring their own research problems to dedicated troubleshooting sessions.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2020-05-15 18:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "Bruker" ],
                [ a schema1:Organization ;
                    schema1:name "EMBO Press" ],
                [ a schema1:Organization ;
                    schema1:name "F1000 Research" ],
                [ a schema1:Organization ;
                    schema1:name "BioExcel" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Turkey" ;
                            schema1:addressLocality "Izmir" ;
                            schema1:addressRegion "Balçova" ;
                            schema1:postalCode "35340" ;
                            schema1:streetAddress """Izmir Biomedicine and Genome Center\r
Dokuz Eylül University Health Campus\r
Mithatpasa St. 58/5 35340\r
Balcova, Izmir/TURKEY""" ] ;
                    schema1:latitude "38.393949" ;
                    schema1:longitude "27.030644" ] ;
            schema1:maximumAttendeeCapacity 24 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Alexandre Bonvin, Ezgi Karaca and João Rodrigues" ] ;
            schema1:startDate "2020-05-11 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Docking",
        "Interactions",
        "Protein-Protein Complex modeling",
        "modelling" ;
    schema1:name "EMBO practical course on Integrative Modelling of Biomolecular Interactions" ;
    schema1:url <http://meetings.embo.org/event/20-biomolecular-interactions> .

