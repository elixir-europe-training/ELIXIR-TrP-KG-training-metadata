                    schema1:streetAddress "Parador de Alcalá de Henares, 8, Calle Colegios" ] ;
            schema1:latitude "40.481364" ;
            schema1:longitude "-3.361658" ] ;
    schema1:name "4th Instruct Biennial Structural Biology Conference" ;
    schema1:startDate "2019-05-22 13:00:00 UTC"^^schema1:Date ;
    schema1:url <https://instruct-eric.eu/biennial2019> .

<https://tess.elixir-europe.org/events/4th-international-conference-on-research-infrastructures-icri-2018> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """ICRI 2018 will be co-organised by the Austrian Federal Ministry of Science, Research and\r
	Economy (BMWFW) and the European Commission. Participants from more than 50 countries are expected to take part in this event. Speakers\r
	representing high-level stakeholders from across the globe and highly profiled institutions will\r
	intervene in the debate.\r
	 \r
	ICRI 2018 aims at:\r
	 \r
	·      providing a forum for strategic discussion on international cooperation for research\r
	infrastructures at global level;\r
	·      highlighting the essential role of research infrastructures in addressing global challenges\r
	and contributing to Sustainable Development Goals;\r
	·      reflecting on the needs, development, and operation of global and national research\r
	infrastructures;\r
	·      building on the outcomes of ICRI 2016, discussing existing and emerging challenges\r
	faced by RI stakeholders and investigating policy options and possible steps forward.\r
	The detailed programme for ICRI 2018 is currently being developed in cooperation with high-\r
	level international experts on research infrastructures.\r
	 Participation in ICRI 2018 will be possible by invitation only. A dedicated webpage for the\r
	conference will be available. You will receive a formal invitation, along with the Conference\r
	Programme and further information, from a dedicated functional mailbox within the coming\r
	months.\r
	 """ ;
