<https://tess.elixir-europe.org/events/workflow4experimenters-2023> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Bring your own data session" ;
    schema1:coursePrerequisites " Metabolomics study data available before the course (NMR or MS)" ;
    schema1:description """**Processing, statistical analysis, and annotation of metabolomics data** is a complex task for experimenters since it involves many steps and requires a good knowledge of both the methodology and software tools. The [Workflow4metabolomics.org (W4M)](Workflow4metabolomics.org) online tool suit provides a user-friendly environment with advanced computational modules for building, running, and sharing **complete workflows for LC-MS, GC-MS, FIA and NMR analysis**. Such features are of major values for teaching computational metabolomics to experimenters, and previous courses using W4M since 2014 have been very successful.\r
For this new session, the proposed format evolves:\r
- From 06 to 10/03: theoretical sessions in videoconference from 10AM to 12PM each day\r
- From 20 to 24/03: practical sessions and tutoring, with the 1st hour of each day dedicated to short reminders and participant questions (following the theoretical session). """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-03-24 12:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "RFMF" ],
                [ a schema1:Organization ;
                    schema1:name "IFB" ],
                [ a schema1:Organization ;
                    schema1:name "MetaboHUB" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Paris" ] ;
                    schema1:latitude "48.85889" ;
                    schema1:longitude "2.320041" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "W4M coreteam" ] ;
            schema1:startDate "2023-03-20 14:00:00 UTC"^^schema1:Date ] ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Workflow4Metabolomics" ;
            schema1:url <https://bio.tools/tool/workflow4metabolomics> ] ;
    schema1:name "Workflow4Experimenters 2023" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR France" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:teaches " During this course, participants will learn how to use the W4M infrastructure to analyze their own dataset. Online sessions will be dedicated to methodology and tools. Face-to-face sessions will be devoted to tutoring. For these practical sessions, the participants will work on their own data (prerequisite for the training is to have a data set)." ;
    schema1:url <https://workflow4metabolomics.org/w4e2023> .

<https://tess.elixir-europe.org/events/workflow4experimenters-2025> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3172> ;
    schema1:alternateName "Analyze your data with Galaxy and the W4M infrastructure!" ;
