        [ a schema1:Thing ;
            schema1:name "iqtree" ;
            schema1:url <https://bio.tools/tool/iqtree> ],
        [ a schema1:Thing ;
            schema1:name "VAPOR" ;
            schema1:url <https://bio.tools/tool/vapor> ],
        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ],
        [ a schema1:Thing ;
            schema1:name "iVar" ;
            schema1:url <https://bio.tools/tool/ivar> ],
        [ a schema1:Thing ;
            schema1:name "SAMtools" ;
            schema1:url <https://bio.tools/tool/samtools> ],
