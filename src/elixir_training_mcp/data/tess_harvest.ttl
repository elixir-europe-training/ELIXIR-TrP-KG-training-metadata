<https://tess.elixir-europe.org/events/prompting-101-a-beginner-39-s-guide-to-communicating-with-llms> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0218>,
        <http://edamontology.org/topic_3474> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Beginner" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:description "This course introduces you to the essentials of interacting with Large Language Models (LLMs). You’ll learn why chatbots are increasingly relevant and how mastering the skill of prompting can significantly reduce work time. Through hands-on exercises, you’ll gain practical experience in crafting precise prompts, ensuring you can leverage LLMs for a variety of tasks." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
