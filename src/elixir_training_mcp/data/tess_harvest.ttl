    schema1:description "Course covers various aspects of genomic medicine, covering and teaching popular tools and methods in the field." ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
