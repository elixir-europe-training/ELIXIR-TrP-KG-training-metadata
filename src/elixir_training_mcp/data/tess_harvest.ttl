                            schema1:streetAddress "Online" ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "CSC - Training" ] ;
            schema1:startDate "2021-12-14 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "TESS" ;
    schema1:name "Train-the-Trainer online course for bioinformatics trainers" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "CSC - IT Center for Science" ;
            schema1:url <https://www.csc.fi> ] ;
    schema1:url <https://ssl.eventilla.com/event/xLrPJ> .

