<https://tess.elixir-europe.org/materials/contributing-to-the-galaxy-training-material-creating-a-new-tutorial-defining-the-technical-infrastructure> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
