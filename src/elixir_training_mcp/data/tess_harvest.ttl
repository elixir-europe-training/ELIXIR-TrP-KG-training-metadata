    schema1:inLanguage "en" ;
    schema1:name "NEOF - Python for bioinformatics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:teaches """At the end of the course learners will be able to:\r
\r
- Create, edit, run, and save python scripts with Jupyter-notebook.\r
- Understand and use fundamental python concepts including operators, annotations, variables, and variable classes.\r
- Utilise a variety of python functions and methods.\r
- Store and manipulate data within lists, sets, and dictionaries.\r
- Produce If and else statements to print out different results based on logical conditions (True or False).\r
- Carry out the same task on multiple items with loops.\r
- Read in and write out fastq files with the biopython library.\r
- Filter sequences from fastq data.\r
- Use logical operators to test multiple conditions at once.""" ;
    schema1:url <https://forms.gle/gp41Dtcrbo4WNf3A9> .

