<https://tess.elixir-europe.org/events/variant-calling-with-galaxy-and-the-genomics-virtual-laboratory-beginners> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_3365> ;
    schema1:description """This tutorial covers the concepts of detecting small variants (SNVs and indels) in human genomic DNA using a small set of reads from chromosome 22. The tutorial is designed to introduce the tools, datatypes and workflow of variant detection. We will align reads to the genome, look for differences between reads and reference genome sequence, and filter the detected genomic variation manually to understand the computational basis of variant calling.
""" ;
