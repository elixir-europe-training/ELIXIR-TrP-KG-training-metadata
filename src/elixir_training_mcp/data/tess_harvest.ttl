<https://tess.elixir-europe.org/events/dna-methylation-data-analysis-workshop> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0080>,
        <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3168> ;
    schema1:alternateName "How to use bisulfite-treated sequencing to study DNA methylation " ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Pathologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Molecular Biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "post-docs" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists, Genomicists, Computer Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ] ;
    schema1:description """Advance your epigenetics research with NGS methods.\r
\r
In a nutshell\r
- Learn how bisulfite sequencing works\r
- Understand how bisulfite-treated reads are mapped to a reference genome\r
- Perform basic analyses (call methylated regions, perform basic downstream analyses)\r
- Use shell scripting to create reusable data pipelines\r
- Visualize results (ready-to-publish)\r
\r
The purpose of this workshop is to get a deeper understanding of the use of bisulfite-treated DNA in order to analyze the epigenetic layer of DNA methylation. Advantages and disadvantages of the so-called 'bisulfite sequencing' and its implications on data analyses will be covered. The participants will be trained to understand bisulfite-treated NGS data, to detect potential problems/errors and finally to implement their own pipelines. After this course they will be able to analyze DNA methylation and create ready-to-publish graphics.\r
\r
By the end of this workshop the participants will:\r
 - be familiar with the sequencing method of Illumina\r
 - understand how bisulfite sequencing works\r
 - be aware of the mapping problem of bisulfite-treated data\r
 - understand how bisulfite-treated reads are mapped to a reference genome\r
 - be familiar with common data formats and standards\r
 - know relevant tools for data processing\r
 - automate tasks with shell scripting to create reusable data pipelines\r
 - perform basic analyses (call methylated regions, perform basic downstream analyses)\r
 - plot and visualize results (ready-to-publish)\r
 - be able to reuse all analyses\r
""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2020-11-05 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
