            schema1:url <https://zenodo.org/records/15601932> ] ;
    schema1:name "Phylodiversity analysis quick tutorial" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Learning how to use the phylodiversity workflow.
- Compute endemism index
- Create a phyloregion map""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/phylodiversity_workflow/tutorial.html> ;
    schema1:version "1" .

