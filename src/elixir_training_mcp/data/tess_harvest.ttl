            schema1:longitude "3.713854" ] ;
    schema1:name "Tech Transfer Course" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "VIB Bioinformatics Core" ] ;
    schema1:startDate "2019-08-26 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://training.vib.be/product/87> .

