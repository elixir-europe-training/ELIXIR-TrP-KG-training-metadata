<https://tess.elixir-europe.org/events/variant-submission-and-accessioning-at-the-european-variation-archive> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Melissa Burke" ;
    schema1:description "The European Variation Archive (EVA) is a primary open repository for archiving, accessioning, and distributing genome variation including single nucleotide variants, short insertions and deletions (indels), and larger structural variants (SVs) in any species. The EVA is in the process of releasing the first dbSNP data release which consists of RS ID-containing VCF files for each non-human species available in dbSNP. This webinar will provide an overview of the European Variation Archive including data ingestion, consumption, and how you can access and utilise dbSNP RS release batch files." ;
    schema1:endDate "2019-09-04 16:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "Variant submission and accessioning at the European Variation Archive" ;
    schema1:startDate "2019-09-04 15:30:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2019/variant-submission-and-accessioning-european-variation-archive> .

<https://tess.elixir-europe.org/events/variant-submission-and-accessioning-at-the-european-variation-archive-1ae1150a-9414-4a44-a191-83baa43b2cc3> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Melissa Burke - webinars@ebi.ac.uk" ;
    schema1:description """The [European Variation Archive](https://www.ebi.ac.uk/eva) (EVA) is a primary open repository for archiving, accessioning, and distributing genome variation including single nucleotide variants, short insertions and deletions (indels), and larger structural variants (SVs) in any species. The EVA is in the process of releasing the first dbSNP data release which consists of RS ID-containing VCF files for each non-human species available in dbSNP. This webinar will provide an overview of the European Variation Archive including data ingestion, consumption, and how you can access and utilise dbSNP RS release batch files.

""" ;
    schema1:endDate "2019-09-04 16:30:00 UTC"^^schema1:Date ;
