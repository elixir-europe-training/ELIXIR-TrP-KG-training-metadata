<https://tess.elixir-europe.org/events/enzyme-portal> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Melissa Burke" ;
    schema1:description "Enzyme Portal is a freely available resource to find and explore enzyme-related information. This webinar will provide a practical overview of the type of information that the Enzyme Portal provides for enzymes. We will show, using various examples, how to search the Portal for specific enzymes according to the reactions they catalyse, the pathways or the diseases they are involved in." ;
    schema1:endDate "2019-05-29 16:30:00 UTC"^^schema1:Date ;
