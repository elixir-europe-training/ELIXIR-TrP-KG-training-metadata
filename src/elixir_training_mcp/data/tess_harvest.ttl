                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3010" ;
                            schema1:streetAddress "Leuven - Park Inn by Radisson, Martelarenlaan 36" ] ;
                    schema1:latitude "50.879202" ;
                    schema1:longitude "4.701168" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2020-02-10 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "How to pursue an academic career" ;
