<https://tess.elixir-europe.org/events/programming-in-python-master-your-first-project> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Learning to program is increasingly essential for researchers and support staff. This course introduces students to the Python programming language from the very basics. No prior programming experience is required.Students will explore core programming concepts through a mix of online sessions, guided practical afternoons, and self-paced exercises. The training emphasises hands-on, practical learning with opportunities to ask plenty of questions in a safe environment. By the end of the course, students will be able to read, modify, and write Python programs and feel confident continuing with more advanced programming topics." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2026-02-04 17:00:00 UTC"^^schema1:Date ;
