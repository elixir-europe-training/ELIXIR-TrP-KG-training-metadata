<https://tess.elixir-europe.org/materials/ader18f-analysis-of-differential-expression-with-rnaseq-first-course-in-2018> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
