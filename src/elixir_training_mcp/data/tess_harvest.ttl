                    schema1:addressCountry "Portugal" ;
                    schema1:addressLocality "Lisbon" ;
                    schema1:streetAddress "José Tribolet Room, Instituto Superior Técnico, Lisboa" ] ;
            schema1:latitude "38.707751" ;
            schema1:longitude "-9.136592" ] ;
    schema1:name "ELIXIR Federated Human Data Community Day" ;
    schema1:startDate "2024-11-19 12:00:00 UTC"^^schema1:Date ;
