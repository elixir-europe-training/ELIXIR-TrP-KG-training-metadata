<https://tess.elixir-europe.org/events/dna-library-preparation-for-short-read-sequencing> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Graduates, postgraduates, PIs and anyone who wants to learn how to prepare DNA libraries for short read sequencing." ] ;
    schema1:coursePrerequisites "This course assumes you have a basic familiarity with molecular biology and common lab techniques (e.g. use of a pipette, calculating volumes/concentrations), however extra support can be provided with advance notification." ;
    schema1:description "Short-read (~100-500bp) DNA sequencing is now a well-established technique for profiling the genome. Library preparation for short-read sequencing is highly optimised, is suitable for almost any sample type including degraded/ancient DNA, and can be completed in only ~2-3 hours. In addition, numerous variations of short-read sequencing have been devised, for example ATAC-Seq or ChIP-Seq, which allow it to answer many biological questions. In this course you will get first-hand experience of DNA library preparation using one of the latest library preparation kits from NEB, NEBNext UltraExpressTM FS DNA, on both a validated control sample and an optional sample supplied by yourself. You will also learn how these libraries are quality-controlled and prepared for sequencing. In addition, you will learn the theory behind the library preparations, and have the opportunity to discuss with NEB and the team at Edinburgh Genomics the various options you have for preparing and sequencing your own samples going forward." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-02-06 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Edinburgh Genomics" ] ;
            schema1:startDate "2025-02-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Library preparation",
        "Sequencing",
        "Short Read" ;
    schema1:name "DNA Library Preparation for Short Read Sequencing" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Edinburgh Genomics" ;
            schema1:url <https://genomics.ed.ac.uk> ] ;
    schema1:teaches "Edinburgh Genomics Lab Tour",
        "Introduction to DNA Sequencing",
        "Library Preparation",
        "Library QC",
        "MiSeq Loading Demo",
        "QC Discussion" ;
    schema1:url <https://genomics.ed.ac.uk/event/dna-library-preparation-for-short-read-sequencing-lab-course/> .

<https://tess.elixir-europe.org/events/dna-methylation-and-methylome-analysis-with-ngs> a schema1:Course ;
