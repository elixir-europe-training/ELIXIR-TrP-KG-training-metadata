                    schema1:latitude "52.275204" ;
                    schema1:longitude "10.532593" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "NFDI4Microbiota / de.NBI" ] ;
            schema1:startDate "2025-04-01 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
