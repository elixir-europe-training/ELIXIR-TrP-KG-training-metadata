    schema1:keywords "comparative sequence analysis",
        "protein structure prediction",
        "sequence alignment" ;
    schema1:name "Introduction to Jalview" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Jalview" ;
            schema1:url <http://www.jalview.org/> ],
        [ a schema1:Organization ;
            schema1:name "University of Dundee" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:teaches """The Wednesday session will cover Jalview's core capabilities: creation, editing, analysis and visualisation of alignments linked with phylogenetic trees.\r
Thursday's session will focus on using Jalview's web services for protein secondary structure and disorder prediction, and visualising 3D structures from EMBL-EBI and AlphaFoldDB.\r
""" ;
    schema1:url <https://www.jalview.org/training/training-courses/2023-Oct-IntroToJalview/> .

<https://tess.elixir-europe.org/events/introduction-to-kinetic-modeling-and-simulation-using-copasi> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Frank T. Bergmann, Ursula Kummer (de.NBI-SysBio)\r
\r
Date:\r
19 – 20 November 2024\r
\r
Location:\r
Online\r
\r
Contents:\r
This two-day virtual workshop, provides an in-depth exploration of kinetic modelling and simulation using COPASI.\r
\r
On day 1, participants will be introduced to the fundamentals of kinetic modelling and learn about simulation and steady state calculations in COPASI.\r
\r
Day 2 focuses on parameter estimation and scripting, equipping attendees with the necessary skills to optimize model parameters and automate tasks using python scripting.\r
\r
Registration: \r
Please register at this link.\r
\r
Learning Goals:\r
\r
Comprehensive understanding of COPASI\r
In-depth exploration of kinetic modelling and simulation with hands on exercises using COPASI\r
Prerequisites:\r
None\r
\r
Keywords:\r
Kinetic modelling\r
\r
Tools:\r
COPASI""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
