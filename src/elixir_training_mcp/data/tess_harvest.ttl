<https://tess.elixir-europe.org/events/analyzing-flow-cytometry-data-using-flowjo-25d4891c-bb4d-4309-83d9-d0983b7c09f5> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Are you a researcher working with flow cytometry data? This introductory FlowJo course is designed to help you get started with one of the most widely used analysis tools in the field. With the release of FlowJo Version 10—now available on Windows, macOS, and Linux—users benefit from a streamlined, intuitive interface that simplifies complex data analysis. This training will guide you through the core functionalities of the software, helping you build confidence in gating strategies, population analysis, and data visualization. By the end of the session, you’ll be equipped to independently analyze your own datasets and integrate FlowJo into your research workflow." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-11-18 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3000" ;
                            schema1:streetAddress "Leuven - Campus Gasthuisberg, Herestraat 49" ] ;
                    schema1:latitude "51.033713" ;
                    schema1:longitude "4.701168" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-11-18 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "software" ;
    schema1:name "Analyzing flow cytometry data using FlowJo" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Apply basic gating strategies to define and analyze cell populations”",
        "“Demonstrate the ability to save export and document analysis results for reporting and collaboration”",
        "“Identify the main components of the FlowJo Version 10 interface and describe their functions”",
        "“Import and organize flow cytometry data files within FlowJo for efficient analysis”",
        "“Interpret graphical outputs such as histograms and dot plots to conclude cytometry data”" ;
    schema1:url <https://training.vib.be/all-trainings/analyzing-flow-cytometry-data-using-flowjo-8> .

