<https://tess.elixir-europe.org/events/elab-journal-introduction-eln-6a7c34e4-ba16-40f1-ab21-95f04e0b3108> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This is an introductory course to eLabJournal, the Electronic Lab Notebook (ELN) used at VIB.  eLabJournal is a tool designed to optimize laboratory workflows. Its intuitive and user-friendly interface helps in organizing and documenting experiments, managing samples, and collaborating with colleagues. By enhancing productivity and ensuring compliance with research standards, eLabJournal serves as a useful resource for effective lab management within VIB.Throughout this training, participants will learn how to navigate eLabJournal, create and organize experiments, input data, attach files and images, manage samples, and collaborate with team membersThis course has a very practical approach, combined with thorough instructions for effective use of the platform.  " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
