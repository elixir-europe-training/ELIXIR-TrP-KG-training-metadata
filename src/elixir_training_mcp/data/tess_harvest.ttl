    schema1:teaches """* Describe the primary resources for data management\r
* List of available resources that assist in writing the DMP\r
* Explain what is needed to write in each section of the DMP""" ;
    schema1:url <https://doi.org/10.5281/zenodo.7707813> ;
    schema1:version "3" .

