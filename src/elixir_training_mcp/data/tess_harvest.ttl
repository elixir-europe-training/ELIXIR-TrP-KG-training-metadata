    schema1:keywords "Galaxy Server administration" ;
    schema1:learningResourceType "e-learning" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Galaxy Database schema" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Learn some of the design concepts of the Galaxy database
- Extract information from the Galaxy database
- Get to know SchemaSpy""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/admin/tutorials/database-schema/tutorial.html> ;
    schema1:version "23" .

