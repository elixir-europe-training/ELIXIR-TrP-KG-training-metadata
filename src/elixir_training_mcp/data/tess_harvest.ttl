<https://tess.elixir-europe.org/events/unix-scripting-for-life-scientists-2d9f0a2e-30d6-4edd-846d-145089c6d2cc> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
