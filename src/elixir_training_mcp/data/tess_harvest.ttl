            schema1:url <https://bio.tools/tool/scanpy> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/single-cell/tutorials/scrna-plant/workflows/> ] ;
    schema1:name "Analysis of plant scRNA-Seq Data with Scanpy" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Perform filtering, dimensionality reduction, and clustering
- Generate a DotPlot emulating the original paper using a different analysis tool
- Determine robust clusters across scRNA-seq pipelines""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/single-cell/tutorials/scrna-plant/tutorial.html> ;
    schema1:version "7" .

