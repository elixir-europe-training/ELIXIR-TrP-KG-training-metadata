                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2023-05-17 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "DNA & RNA (dna-rna)",
        "Infernal software",
        "Rfam",
        "Sequence annotation",
        "non-coding RNA" ;
    schema1:name "Annotating genomes with non-coding RNAs using Rfam and Infernal" ;
    schema1:provider [ a schema1:Organization ;
