<https://tess.elixir-europe.org/events/navigating-conflict-in-a-diverse-team> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Conflict is inevitable in any workplace — especially in diverse, collaborative environments. But when managed well, conflict can drive innovation, strengthen relationships, and build a culture of inclusion.This interactive workshop helps participants understand the dynamics of workplace conflict and equips them with tools to respond constructively. They will deepen their self-awareness of communication and conflict styles, practice strategies for constructive dialogue and mediation, and learn how to foster psychologically safe and inclusive environments.By the end of the training, participants are equipped not only to handle everyday conflicts more effectively, but also to contribute to a more positive, respectful, and inclusive workplace culture." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
