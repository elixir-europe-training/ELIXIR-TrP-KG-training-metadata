<https://tess.elixir-europe.org/materials/plaza-is-a-plant-oriented-online-resource-for-comparative-evolutionary-and-functional-genomics> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0085>,
        <http://edamontology.org/topic_0194>,
        <http://edamontology.org/topic_0625>,
        <http://edamontology.org/topic_0780>,
        <http://edamontology.org/topic_0797>,
        <http://edamontology.org/topic_3299> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "postdoctoral researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "plant researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType " Research Assistants and Research Associates" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD" ],
        [ a schema1:Audience ;
            schema1:audienceType "experimeintal biologist researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Life Science Researchers" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Klaas Vandepoele" ],
        [ a schema1:Person ;
            schema1:name "Emmelien Vancaester" ],
        [ a schema1:Person ;
            schema1:name "Michiel Van Bel" ] ;
    schema1:description """PLAZA is a plant-oriented online resource for comparative, evolutionary and functional genomics. It allows querying and visualising structural and functional annotations, gene families, protein domains, phylogenetic trees, and genome organization. PLAZA 4.0 is the latest iteration of the PLAZA framework. This version provides a large increase in newly available species, and offers access to updated and newly implemented tools and visualisations, helping users with the ever-increasing demands for complex and in-depth analyses.\r
\r
PLAZA was developed at the Ghent University. Core publications and training material can be found [here](ftp://ftp.psb.ugent.be/pub/plaza/workshop/ELIXIR/).""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords " Annotation",
        " Visualisation",
        "Plants bioinformatics",
        "genomics",
        "plants" ;
    schema1:learningResourceType "Training materials" ;
    schema1:license <https://spdx.org/licenses/AFL-3.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "PLAZA monocots" ;
            schema1:url <https://bio.tools/tool/plaza_monocots> ],
        [ a schema1:Thing ;
            schema1:name "PLAZA dicots" ;
            schema1:url <https://bio.tools/tool/plaza_dicots> ] ;
    schema1:name "PLAZA is a plant-oriented online resource for comparative, evolutionary and functional genomics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Belgium" ;
            schema1:url <https://www.elixir-belgium.org/training> ] ;
    schema1:url <https://bioinformatics.psb.ugent.be/plaza/> .

