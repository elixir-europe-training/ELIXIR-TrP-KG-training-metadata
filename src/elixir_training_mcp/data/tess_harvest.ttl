            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Germany" ;
                            schema1:addressLocality "Bonn" ;
                            schema1:postalCode "53115" ;
                            schema1:streetAddress "Kirschallee,  Kirschallee" ] ;
                    schema1:latitude "50.722039" ;
                    schema1:longitude "7.091989" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI & ELIXIR-DE" ] ;
            schema1:startDate "2025-12-08 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Plant Genome Sequence Assembly and Annotation" ;
