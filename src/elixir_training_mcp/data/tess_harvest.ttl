<https://tess.elixir-europe.org/events/functional-plant-bioinformatics-plaza-44a3d3d8-fec5-4580-975c-256c24262a1f> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Using PLAZA to get more out of your plant omics data.

This two-day workshop (21-22 October 2019) will introduce the basic concepts of comparative and functional -omics data analysis in plants through lectures and practical hands-on sessions. Plant biologists and geneticists with an interest in bioinformatics and data analysis are encouraged to attend this training.  After this workshop, you will have a good understanding of the organization of plant genomes, the evolution of plant gene families and the different systems used to describe gene functions. In addition, you will know how to extract relevant biological information from -omics gene sets.

There will be a dinner in the historic centre of Ghent on the first day where you will have the possibility to network. Registrations are free but required by sending an e-mail to tuur.muyldermans@vib.be. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-10-22 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Belgium" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM I, Technologiepark 71" ] ;
                    schema1:latitude "51.010766" ;
                    schema1:longitude "3.705625" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2019-10-21 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "omics" ;
    schema1:name "Functional Plant Bioinformatics (PLAZA)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
