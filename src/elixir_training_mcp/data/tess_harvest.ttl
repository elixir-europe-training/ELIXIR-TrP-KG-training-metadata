<https://tess.elixir-europe.org/events/scrna-seq-workshop> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3168>,
        <http://edamontology.org/topic_3170> ;
    schema1:alternateName "An introduction to single cell RNA-seq data analysis" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "biologists" ] ;
    schema1:description "This course aims to provide participants with theoretical and practical knowledge on how to perform bioinformatic analyses of scRNA-seq data using open-source software solutions. scRNA-seq analyses will be performed using the tools available as part of the Reproducible Bioinformatics Project (rCASC). This course is suitable for biologists who are new to single cell gene expression technology. Knowledge of statistics as well as computing skills are not necessary prior to attending the course." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
