<https://tess.elixir-europe.org/events/wapen-jezelf-tegen-stress-burn-out> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Stress en burn-out worden meer en meer gezien als oorzaken van veel leed en bijgevolg hoog ziekteverzuim in de bedrijven en velen vragen zich af wat deze begrippen betekenen en wat we kunnen doen om dit te vermijden en/of te verminderen. 
 
Om daar antwoorden op te geven wordt deze sessie rond stress en burn-out georganiseerd waarbij een aantal inzichten en tips aangereikt worden waarmee je zelf meer richting kan geven aan je eigen leven zowel op privé als op professioneel vlak. Je krijgt er antwoorden op vragen als: wat is positieve en negatieve stress, hoe herken ik het bij mezelf, mijn collega’s en mijn gezinsleden, wat is burn-out, wie loopt een hoger risico, hoe herken je het? Wat kan je er zelf aan doen en wat kan jouw werkgever doen? 
 """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-05-09 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2023-05-09 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "online" ;
    schema1:name "Wapen jezelf tegen stress & burn-out" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/wapen-jezelf-tegen-stress-burn-out> .

