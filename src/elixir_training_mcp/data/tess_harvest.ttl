<https://tess.elixir-europe.org/events/elixir-webinar-data-validation> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description "The webinar will present the outcomes of the Data Validation Implementation Study which ran from  January to December 2018. The goal of the study was to determine the requirements for validation with ELIXIR partners, to build prototype open validation services for archetype archival databases and knowledge bases." ;
    schema1:endDate "2019-05-15 14:00:00 UTC"^^schema1:Date ;
