        [ a schema1:Audience ;
            schema1:audienceType "Graduate students" ] ;
    schema1:description """This course will be in two parts: a 1-hour online lecture on what you can do in OpenRefine, including transformations, expressions, and extensions for the software, held on the 8th of November at 10:00 in Zoom. The practical workshop on how to transform your previously cleaned data with OpenRefine software will be a video lecture that you can follow in your own time. Additionally, we will hold 2 Q&amp;A sessions in Zoom, where you can talk about any problems you encountered with the OpenRefine software.\r
\r
This is a follow-up workshop for “How to make your messy data usable - PART 1”, where we talked about spreadsheets but also introduced the OpenRefine software. This course will explore the depths of OpenRefine software and see what else it can offer. This will include cleaning the data in bigger batches and unifying the data in one sweep. These include transformations and expressions. Additionally, we will introduce the possibility of downloading additional data from other databases and different extensions OpenRefine software has. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2022-11-08 11:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Estonia" ] ;
            schema1:startDate "2022-11-08 10:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Data management",
        "FAIR",
        "OpenRefine",
        "data cleaning" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "How to make your messy data usable? - PART 2 Course" ;
            schema1:url <https://doi.org/10.5281/zenodo.7304308> ] ;
    schema1:name "How to Make Your Messy Data Usable? - PART 2" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <http://elixir.ut.ee> ],
        [ a schema1:Organization ;
            schema1:name "University of Tartu, Institute of Computer Science" ] ;
    schema1:teaches """Understands what OpenRefine software can do with data\r
Knows what kind of transformations OpenRefine software supports\r
Knows how to write transformations and expressions in OpenRefine software""" ;
    schema1:url <https://elixir.ut.ee/node/456> .

<https://tess.elixir-europe.org/events/how-to-make-your-research-open-with-europe-pmc> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_0305>,
        <http://edamontology.org/topic_3068> ;
    schema1:description """Europe PMC is an open global database of life science publications and preprints hosted by European Bioinformatics Institute (EMBL-EBI). Europe PMC is endorsed and supported by a group of international science funders, including Wellcome, World Health Organisation, European Research Council, and many others, as their repository of choice.

The Europe PMC funders expect research outputs arising from research they support to be made freely and readily available. In this webinar we will explain how researchers can make their research open using Europe PMC and cover the benefits of including publications and preprints in Europe PMC for authors and readers. We will provide guidance on open access policies of Europe PMC funders and demonstrate how to include research publications in Europe PMC and PubMed Central USA.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-11-07 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2023-11-07 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Europe PubMed Central",
        "Literature (literature)",
        "Open access" ;
    schema1:name "How to make your research open with Europe PMC" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/how-make-your-research-open-europe-pmc> .

<https://tess.elixir-europe.org/events/how-to-manage-stress-and-prevent-burnout> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Stress and burnout are the cause of tremendous suffering and come with a very high cost for organizations and companies. To be able to prevent this, we first need to get a clear insight in what these terms mean and what consequences they inflict. 

What is positive and negative stress? How do you recognize it? What’s a burnout and what type of people have a high risk in having a burnout? 
The aim of this session is to provide some answers on how you can tackle stress better in your professional and private life. What you, or your employer do to prevent it? """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-04-26 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2023-04-26 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "How to manage stress and prevent burnout" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/how-manage-stress-and-prevent-burnout> .

