                    schema1:postalCode "64293" ;
                    schema1:streetAddress """Thermo Fisher Scientific GmbH\r
Frankfurter Str. 129 B\r
D-64293 Darmstadt""" ] ] ;
    schema1:maximumAttendeeCapacity 6 ;
    schema1:name "Bioinformatics for Molecular Biologists (4-day course)" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "Thermo Fisher Scientific" ] ;
    schema1:startDate "2017-03-20 13:00:00 UTC"^^schema1:Date ;
