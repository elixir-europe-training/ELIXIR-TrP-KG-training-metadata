            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2021-07-12 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Microscopy data analysis: Machine learning and the BioImage Archive" ;
    schema1:provider [ a schema1:Organization ;
