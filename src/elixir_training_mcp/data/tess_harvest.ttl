<https://tess.elixir-europe.org/events/software-carpentry-introduction-to-programming-with-python-and-use-of-unix-shell-and-git> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3365> ;
    schema1:description """Workshops in bioinformatics and statistics

CBBU, COMBINE, and SCU are organizing a series of introductory bioinformatics and statistics workshops. The workshops are primarily aimed at students, postdocs and early-mid career researchers, but are open to everybody from our College. This workshop is for novices and doesn't require any prior knowledge in Python, Git or Shell. The cost is $90 AUD to cover lunches and teas. It possible to pay with the GLC or bank transfer.

Anybody interested please register no later than 22 May.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2016-06-01 00:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Australia" ;
                            schema1:addressLocality "Canberra" ] ;
                    schema1:latitude "-35.3075" ;
                    schema1:longitude "149.124417" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Australian National University" ] ;
            schema1:startDate "2016-05-30 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "ABR",
        "Bioinformatics",
        "SoftwareCarpentry" ;
    schema1:name "Software carpentry introduction to programming with Python and use of Unix Shell and Git" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "iAnn" ;
            schema1:url <http://iann.pro> ] ;
    schema1:url <http://biology.anu.edu.au/news-events/software-carpentry-introduction-programming-python-and-use-unix-shell-and-git> .

