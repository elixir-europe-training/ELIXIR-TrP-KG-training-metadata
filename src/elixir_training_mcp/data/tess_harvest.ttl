<https://tess.elixir-europe.org/materials/running-the-gtn-website-online-using-github-codespaces> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Instructors" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Saskia Hiltemann" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Helena Rasche" ],
        [ a schema1:Person ;
            schema1:name "Saskia Hiltemann" ],
        [ a schema1:Person ;
            schema1:name "Teresa Müller" ] ;
    schema1:creativeWorkStatus "Active" ;
    schema1:dateModified "2024-12-04"^^schema1:Date ;
    schema1:datePublished "2024-11-11"^^schema1:Date ;
    schema1:description """## Abstract

If you are working on your own training materials and want preview them online without installing anything on your computer, you can do this using GitHub CodeSpaces! Everybody gets 60 free hours of CodeSpaces per month.


## About This Material

This is a Hands-on Tutorial from the GTN which is usable either for individual self-study, or as a teaching material in a classroom.


## Questions this  will address

 - How can I get a preview of the GTN website using GitHub CodeSpaces?


## Learning Objectives

- Preview the GTN website online via CodeSpaces
- Make changes to the GTN website and preview those changes
- Save the changes to your fork of the GTN repo
- Create a pull request (PR) based on your changes""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Contributing to the Galaxy Training Material" ;
    schema1:learningResourceType "e-learning" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Running the GTN website online using GitHub CodeSpaces" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Preview the GTN website online via CodeSpaces
- Make changes to the GTN website and preview those changes
- Save the changes to your fork of the GTN repo
- Create a pull request (PR) based on your changes""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/contributing/tutorials/running-codespaces/tutorial.html> ;
    schema1:version "3" .

