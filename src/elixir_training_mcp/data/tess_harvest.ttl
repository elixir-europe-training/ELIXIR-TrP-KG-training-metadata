<https://tess.elixir-europe.org/events/bioexcel-summer-school-2024-2b65a20f-5a19-4817-bbf8-94be248ae01a> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Post-Doctoral Fellows" ],
        [ a schema1:Audience ;
            schema1:audienceType "Masters students" ] ;
    schema1:coursePrerequisites """1. The BioExcel School is intended primarily for PhD and post-doctoral researchers using or planning to use biomolecular modeling and simulation in their everyday research.\r
2. Familiarity with Linux and basic knowledge of molecular modelling software is a requirement.\r
3. We can only accept participants from EuroHPC Joint Undertaking member institutions.\r
4. We highly encourage applications from industrial entities, women and underrepresented groups.\r
""" ;
    schema1:description """The annual flagship event provides a comprehensive combination of lectures and tutorial sessions on biomolecular modeling and simulations using modern applications and tools. The School has been run very successfully multiple times between 2018 and 2023 and as per tradition it will take place in Sardinia, Italy as an on-site event and will supported by Sardegna Ricerche. \r
\r
Get a feel for what the School has to offer by watching the following video: https://www.youtube.com/watch?v=BTB1J4S_cAU""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-06-21 17:00:00 UTC"^^schema1:Date ;
