                            schema1:addressRegion "Oslo kommune" ;
                            schema1:postalCode "0373" ;
                            schema1:streetAddress "Georg Sverdrups hus, Moltke Moes vei, Oslo, Norway" ] ;
                    schema1:latitude "59.943337" ;
                    schema1:longitude "10.717823" ] ;
            schema1:maximumAttendeeCapacity 20 ;
