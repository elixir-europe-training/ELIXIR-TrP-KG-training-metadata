<https://tess.elixir-europe.org/events/strategic-use-of-generative-ai> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Generative AI is rapidly transforming how we work, communicate, and conduct research. For researchers, support staff, and professionals across disciplines, understanding how to strategically use tools like ChatGPT and other large language models (LLMs) is becoming essential. This introductory training is designed to equip participants with a foundational understanding of generative AI, its practical applications, and its limitations. Whether you're drafting research proposals, automating routine tasks, or exploring new ways to generate content, this course will help you use AI tools more effectively and responsibly.We will cover different aspects of using ChatBots powered with LLMs, including the ethical and ownership aspects, the theoretical background, and several examples of practical application, among which are how to strategically prompt your request for text generation in any context,  how to generate high-quality content for research papers, and grant applications.1/2 DAY TICKET:This morning session introduces the core concepts of generative AI, including ethical considerations, data ownership, and hands-on examples of everyday use. It is ideal for administrative staff, support roles, and anyone curious about integrating AI into their workflow or personal projects.FULL DAY TICKET:Building on the morning session, the afternoon dives deeper into academic and research-specific use cases. Participants will explore how generative AI can support scientific writing, literature reviews, data analysis, and grant writing, with a focus on strategic prompting and critical evaluation of AI-generated content." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-10-15 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Belgium" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3000" ;
                            schema1:streetAddress "Leuven - Campus Gasthuisberg, Herestraat 49" ] ;
                    schema1:latitude "50.879202" ;
                    schema1:longitude "4.701168" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-10-15 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "Artificial Inteligence",
        "generative AI" ;
    schema1:name "Strategic use of generative AI" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "Apply prompt engineering techniques to generate relevant outputs for tasks such as literature reviews, content drafting, and brainstorming.",
        "Demonstrate the use of generative AI tools to support specific academic tasks, including writing, summarizing, and ideation.",
        "Describe the evolution and core principles of generative AI models and their relevance to academic research.",
        "Evaluate the quality, reliability, and ethical implications of AI-generated content in the context of scholarly work.",
        "Identify the features, capabilities, and limitations of various generative AI tools used in research workflows.",
        "Integrate generative AI tools into personal research workflows to enhance productivity while maintaining critical oversight." ;
    schema1:url <https://training.vib.be/all-trainings/strategic-use-generative-ai> .

