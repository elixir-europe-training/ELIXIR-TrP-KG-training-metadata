            schema1:url <https://bio.tools/tool/galaxy> ],
        [ a schema1:Thing ;
            schema1:name "MaxQuant" ;
            schema1:url <https://bio.tools/tool/maxquant> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://doi.org/10.5281/zenodo.10105821> ] ;
    schema1:name "Clinical Metaproteomics 4: Quantitation" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches "- Perform quantitation using MaxQuant and extract microbial and human proteins and peptides." ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/clinical-mp-4-quantitation/tutorial.html> ;
    schema1:version "5" .

<https://tess.elixir-europe.org/materials/clinical-mp-5-data-interpretation> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0121> ;
    schema1:audience [ a schema1:Audience ;
