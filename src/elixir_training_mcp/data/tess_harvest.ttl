<https://tess.elixir-europe.org/events/marie-curie-applications-tips-tricks-6bd70baa-0c1d-486a-8201-41775701fa6f> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Most scientists secure their own funding by applying for grants—a challenging task with low success rates and high time investment. To be competitive in the life sciences, you need to formulate a bold research question, write a clear and structured proposal, develop a strong research plan, and meet tight deadlines. This is where this interactive training comes in.Targeted at final-year PhD students and postdocs planning to submit a funding application within the next 12 months, this course introduces the key principles of successful grant writing through hands-on practice, real-life examples, and expert feedback." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
