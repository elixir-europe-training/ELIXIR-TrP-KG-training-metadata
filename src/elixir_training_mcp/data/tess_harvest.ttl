            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/guide-multi-omics-pathway-analysis> .

<https://tess.elixir-europe.org/events/a-guide-to-organising-data-associated-to-a-publication-using-biostudies> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_2091>,
        <http://edamontology.org/topic_3068>,
        <http://edamontology.org/topic_3071> ;
    schema1:description """The goal of the BioStudies database is to facilitate transparency and reproducibility of research by aggregating all the outputs of a study (a ‘data package’) in a single place. A data package may include links to parts of data deposited into specialised community databases at EMBL-EBI and elsewhere, as well as data that have no other natural home such as supplemental data.

In this webinar we will look at a range of examples for data submission and access, including large image datasets.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-05-05 17:00:00 UTC"^^schema1:Date ;
