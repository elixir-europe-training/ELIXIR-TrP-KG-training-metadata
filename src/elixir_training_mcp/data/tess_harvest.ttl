            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/marine_omics_bgc/workflows/> ] ;
    schema1:name "Marine Omics identifying biosynthetic gene clusters" ;
