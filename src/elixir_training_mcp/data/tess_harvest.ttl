<https://tess.elixir-europe.org/events/open-repositories-conference-2017> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description "The annual Open Repositories Conference brings together users and developers of open digital repository platforms from higher education, government, galleries, libraries, archives and museums. The Conference provides an interactive forum for delegates from around the world to come together and explore the global challenges and opportunities facing libraries and the broader scholarly information landscape." ;
