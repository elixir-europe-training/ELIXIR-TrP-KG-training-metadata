<https://tess.elixir-europe.org/events/ensembl-browser-workshop-e929ac62-0d56-443f-8ad8-c76d0ed77973> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_3208> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "wet-lab researchers and bioinformaticians" ] ;
    schema1:description """The Ensembl project at [www.ensembl.org](http://www.ensembl.org/) provides a comprehensive and integrated source of annotation of mainly vertebrate genome sequences. This 1-day workshop offers participants the possibility of gaining hands-on experience in the use of the Ensembl genome browser but also provides them with the necessary background information. Our sister project at [www.ensemblgenomes.org](http://www.ensemblgenomes.org/) can also be covered if participants are working with bacteria, plants, fungi, protists or (invertebrate) metazoa.  
  
 The workshop is primarily targeted at wetlab researchers, and we customise the course for species of interest and to include total beginners to our browser up through frequent users. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-10-15 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressRegion "Cambridge" ;
                            schema1:postalCode "CB10 1SD" ;
                            schema1:streetAddress "European Bioinformatics Institute, Hinxton" ] ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-10-15 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Ensembl" ;
    schema1:name "Ensembl browser workshop" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute" ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/ensembl-browser-workshop> .

