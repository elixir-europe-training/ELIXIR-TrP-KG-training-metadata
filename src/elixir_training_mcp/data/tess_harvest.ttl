<https://tess.elixir-europe.org/materials/elixir-s-impact-toolkit-to-support-performance-and-impact-evaluation-in-a-distributed-data-research-infrastructure-for-the-life-sciences> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
