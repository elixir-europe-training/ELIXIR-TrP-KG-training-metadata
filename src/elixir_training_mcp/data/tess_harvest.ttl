            schema1:url <https://youtube.com/watch?v=hiaUE9Z0seY&feature=share&utm_source=EKLEiJECCKjOmKnC5IiRIQ> ],
        [ a schema1:Thing ;
            schema1:name "VEIS webinar: The essentials of DUO codes | Presentation" ;
            schema1:url <https://veis.bsc.es/files/ega_essentials_of_duo_codes.pdf> ] ;
    schema1:name "The essentials of DUO codes" ;
