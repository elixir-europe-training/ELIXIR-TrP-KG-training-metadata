    schema1:url <https://www.ebi.ac.uk/training/online/courses/finding-using-public-data> .

<https://tess.elixir-europe.org/materials/finding-and-using-publicly-available-data-q-a-session> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0219>,
        <http://edamontology.org/topic_3263>,
        <http://edamontology.org/topic_3489> ;
    schema1:description """This Q&amp;A (question and answer) webinar will provide an opportunity for anyone who has completed ‘Finding and using publicly available data: A curated set of online courses’ to join some of EMBL-EBI's experts and ask their own questions. This session will focus on biocuration, open data, and accessing publicly available data.\r
\r
The questions covered during the Q&amp;A webinar will depend on those asked by attendees, however we will likely cover topics such as:\r
\r
\r
	Data sharing and submission\r
	Restricted access to genetic, phenotypic, and clinical data\r
	Data management of biological data and open data\r
	Finding the right EMBL-EBI resource for accessing data""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
