<https://tess.elixir-europe.org/events/explore-gene-expression-across-species-with-expression-atlas> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Melissa Burke" ;
    schema1:description "Expression Atlas is an open resource that incorporates high quality gene expression data from ArrayExpress as well as other data archives and sources. The webinar will introduce key features of the Expression Atlas and show you how it can be used to  help answer questions such as \"where is my favourite gene expressed?\" or \"how does expression of my favourite gene change in response to disease?\"." ;
    schema1:endDate "2019-06-26 15:30:00 UTC"^^schema1:Date ;
