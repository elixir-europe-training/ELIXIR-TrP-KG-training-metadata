            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Learn about metadata and findability
- Learn how to support system and content curation""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/fair/tutorials/fair-gtn/tutorial.html> ;
    schema1:version "5" .

<https://tess.elixir-europe.org/materials/fair-in-a-nutshell> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_4012> ;
    schema1:creativeWorkStatus "active" ;
    schema1:description """The FAIR (Findable, Accessible, Interoperable, Reusable) principles emphasize machine-actionability. The main objective of FAIR is to increase data reuse by researchers. The core concepts of the FAIR principles are based on good scientific practice and intuitively grounded.\r
\r
This tutorial is a short introduction to the FAIR principles and their origin. You can find out more at the FAIR Pointers online course""" ;
    schema1:identifier "https://training.galaxyproject.org/training-material/topics/fair/tutorials/fair-intro/tutorial.html" ;
    schema1:keywords "FAIR" ;
    schema1:learningResourceType "hands-on tutorial" ;
