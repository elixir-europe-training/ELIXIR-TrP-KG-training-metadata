            schema1:url <https://training.galaxyproject.org/training-material/topics/statistics/tutorials/dome/statistics-dome.ipynb> ] ;
    schema1:name "Regulations/standards for AI using DOME" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Explain the importance of data provenance and dataset splits in ensuring the integrity and reproducibility of AI research.
- Develop a comprehensive plan for documenting and sharing AI model configurations, datasets, and evaluation results to enhance transparency and reproducibility in their research.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/statistics/tutorials/dome/tutorial.html> ;
    schema1:version "3" .

