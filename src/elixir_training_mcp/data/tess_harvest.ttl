<https://tess.elixir-europe.org/events/elixir-norway-workshop-in-data-management-for-life-science-projects> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3572> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Associate Professors" ],
        [ a schema1:Audience ;
            schema1:audienceType "Professors" ],
        [ a schema1:Audience ;
            schema1:audienceType "data managers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Post-Doctoral Fellows" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD candidates" ] ;
    schema1:description """The topic of the workshop is how to generate a data management plan for a research project that will meet the requirements of the funding organisations. The intended audience are researchers (PhD candidates, post-doctoral fellows, researchers, associate professors, professors) who are planning to submit a grant application for a research project. You will set up a data management plan for your project using the \r
**ELIXIR Norway Data Steward Wizard (DSW) tool**. DSW is more flexible and provides more domain specific templates than the easyDMP offered by Uninett/Sigma2.\r
\r
**Course content:**\r
-Requirements from the funding bodies and legal requirements\r
-Licensing of data, biological material and software\r
-Information on national and local storage infrastructures\r
-Relevant deposition repositories (data archives)\r
-Hands on training and assistance to generate a data management plan\r
\r
**Requirements:**\r
-Bring your laptop\r
-Optionally you can also bring your research project (if you have one)\r
\r
**Teachers:**\r
-Korbinian Bösl\r
-Erik Hjerde\r
-Nils Peder Willassen""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2020-02-21 15:30:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Norway" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Norway" ;
                            schema1:addressLocality "Tromsø" ;
                            schema1:postalCode "9019" ;
                            schema1:streetAddress "University of Tromsø" ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Norway" ] ;
            schema1:startDate "2020-02-21 09:00:00 UTC"^^schema1:Date ] ;
