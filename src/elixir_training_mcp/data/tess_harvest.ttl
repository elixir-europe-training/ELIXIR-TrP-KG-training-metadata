<https://tess.elixir-europe.org/materials/mathematics-boot-camp-introduction-to-complex-systems-tools> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
