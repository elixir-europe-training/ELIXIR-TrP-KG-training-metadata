<https://tess.elixir-europe.org/materials/workshop-introduction-to-metabarcoding-using-qiime2> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Makunin, Igor" ],
