<https://tess.elixir-europe.org/events/cool-tools-for-science> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:alternateName "User innovation Workshop" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType " Researchers in Life Sciences" ] ;
    schema1:contact "info@biodata.pt" ;
    schema1:description """Dear Researcher in Life Sciences,\r
\r
Have you created a customized solution for your research? A software? A gadget? A life-changing protocol?\r
\r
Your creation might be useful for someone else! Come and share it at the first "Cool Tools for Science" meeting, a great chance to show and exchange a new dimension of your work: user innovation.\r
\r
Tell us about your inventions and how they improved your research performance, exhibit them to your colleagues and see what they have come up with too. Try to win the prize for the best innovation!""" ;
    schema1:eligibility "registration_of_interest" ;
    schema1:endDate "2019-05-29 17:00:00 UTC"^^schema1:Date ;
    schema1:event_types "awards_and_prizegivings" ;
