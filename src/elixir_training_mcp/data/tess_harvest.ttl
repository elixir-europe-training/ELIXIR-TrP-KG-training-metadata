<https://tess.elixir-europe.org/events/annotating-genomes-with-non-coding-rnas-using-rfam-and-infernal> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_0226>,
        <http://edamontology.org/operation_0362> ;
    schema1:description """Rfam is a database of RNA families that currently contains over 4,000 families. Together with the Infernal software, Rfam is commonly used to annotate non-coding RNAs in newly sequenced genomes.

In this webinar, we will give an overview of the data available in Rfam and give a live demo of annotating a genome with non-coding RNAs using Rfam and the Infernal software. We will also discuss recent efforts to synchronise Rfam and miRBase.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-05-17 17:00:00 UTC"^^schema1:Date ;
