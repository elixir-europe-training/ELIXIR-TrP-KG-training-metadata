                            schema1:addressCountry "Italy" ;
                            schema1:addressRegion "Pavia" ;
                            schema1:postalCode "27100" ;
                            schema1:streetAddress "Università di Pavia, via Ferrata 1" ] ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-02-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "EMBL-EBI workshop: Resources and tools for genomics, protein interactions and structural applications" ;
