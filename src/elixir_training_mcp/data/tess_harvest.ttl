        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ] ;
    schema1:name "Analyse HeLa fluorescence siRNA screen" ;
    schema1:provider [ a schema1:Organization ;
