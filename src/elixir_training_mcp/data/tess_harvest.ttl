<https://tess.elixir-europe.org/events/impactful-communication-from-clarity-to-connection> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "The general aim of effective communication is creating visibility for your messages. This is often felt to be a challenge, in communication in hierarchical contexts as well as in conversations amongst peers. Giving yourself the mandate to create this visibility, feeling yourself able to do it, and daring to actually start such conversations are core elements in communicating with impact. Please note that this training is the same as 'Communication skills: Establishing connective clarity' that we had previously in our offer." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-04-01 17:00:00 UTC"^^schema1:Date ;
