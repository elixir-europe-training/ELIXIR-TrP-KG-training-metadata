<https://tess.elixir-europe.org/events/planes-de-gestion-de-datos-teoria-y-practica> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_4012> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "project manager" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:description """Course objective: Familiarize participants with the requirements of data management plans, and the most common obstacles and doubts that researchers experience when drafting them.\r
\r
Methodology: The course will combine a theoretical part with a practical part. Throughout the course, participants will be encouraged to interact with others in group tasks, to discuss together, and to put into practice the concepts explained.\r
\r
**Course program**\r
Theoretical part (02.02.21, 2h)\r
Welcome and presentation\r
Data management policies\r
Fundamental elements of a data management plan\r
\r
Practical part (04.02.21, 2h)\r
Introduction to practical activity\r
Analysis of a data management plan\r
Review of a data management plan""" ;
