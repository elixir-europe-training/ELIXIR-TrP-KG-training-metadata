<https://tess.elixir-europe.org/events/image-processing-with-python-2023> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:alternateName "This Image Processing carpentry workshop uses Python and skimage to allow researchers to do fundamental image processing as part of their analyses. A working knowledge of Python and some previous exposure to the Bash shell is required." ;
    schema1:contact "training@earlham.ac.uk" ;
    schema1:description """This two-day, in-person workshop gives researchers a thorough grounding in using Python to process and analyse image data.\r
\r
Participants will learn the fundamentals of image processing using the skimage library to analyse many different properties of an image, primarily focused on morphometrics, but which are widely applicable to a range of image analysis problems. \r
\r
Starting with how images are represented in digital format, the pros and cons of different image file formats, metadata and how images are stored in arrays, we will move through various lessons to explore image data, implementing bitwise operations, masks, filtering and thresholding to optimise your analysis.\r
\r
The workshop will culminate in a hands-on exercise that provides participants with the opportunity to combine the approaches learned throughout all of the previous lessons.""" ;
    schema1:endDate "2023-06-15 17:00:00 UTC"^^schema1:Date ;
    schema1:hostInstitution "Earlham Institute" ;
    schema1:keywords "Python" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "United Kingdom" ;
                    schema1:addressLocality "Norwich" ;
                    schema1:addressRegion "Norfolk" ;
                    schema1:postalCode "NR4 7UZ" ;
                    schema1:streetAddress "Earlham Institute (EI),  Colney Lane" ] ;
            schema1:latitude "52.621792" ;
            schema1:longitude "1.219034" ] ;
    schema1:name "Image Processing with Python 2023" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "Earlham Institute" ] ;
    schema1:startDate "2023-06-14 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.earlham.ac.uk/events/image-processing-python-2023> .

<https://tess.elixir-europe.org/events/image-processing-with-python-2024> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "This two-day, in-person workshop gives researchers a thorough grounding in using Python to process and analyse image data." ;
    schema1:coursePrerequisites """These requirements can be fulfilled by: \r
\r
completing a Software Carpentry Python workshop or \r
completing a Data Carpentry Ecology workshop (with Python) and a Data Carpentry Genomics workshop or \r
independent exposure to both Python and the Bash shell.\r
If you’re unsure whether you have enough experience to participate in this workshop, please read over this detailed list, which gives all of the functions, operators, and other concepts you will need to be familiar with.\r
\r
Before joining the workshop, please complete the data and software setup described in Further Information. \r
\r
Please ensure this is done well in advance of the course start date, as we will not have time to troubleshoot software issues that arise in the morning.""" ;
    schema1:description "This Image Processing carpentry workshop uses Python and skimage to allow researchers to do fundamental image processing as part of their analyses. A working knowledge of Python and some previous exposure to the Bash shell is required." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
