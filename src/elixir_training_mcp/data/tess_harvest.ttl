<https://tess.elixir-europe.org/events/investigating-microbial-ecology-in-extreme-habitats> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3301>,
        <http://edamontology.org/topic_3697>,
        <http://edamontology.org/topic_3837> ;
    schema1:description """Understanding the mechanisms by which microorganisms have adapted over geological time is crucial in anticipating how they will evolve in the future, in the light of climate change and global warming. Changes in climatic conditions may drive ecosystems which are currently characterised by average levels of main environmental parameters into the extreme which may, in turn, lead to higher abundances of extremophilic microbes. The advent of high-throughput-sequencing has allowed researchers to (further) explore microbiomes in extreme habitats and investigate the mechanisms that they employ to overcome such “hostile” conditions. 

This webinar will discuss publicly available shotgun metagenomics data from various extreme habitats. It will also showcase how data processing with state-of-the-art tools can provide valuable insights regarding the genomic potential of the microorganisms who inhabit such habitats. 

You may either watch the entire presentation from the introduction or navigate directly to a specific section by clicking the links provided below:

- [Introduction](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=bf5c904d-25fb-49a5-b77a-b11601189f57)

- [What is EMBRC](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=bf5c904d-25fb-49a5-b77a-b11601189f57&amp;start=38.178999)

- [Extreme habitats and extremophiles](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=bf5c904d-25fb-49a5-b77a-b11601189f57&amp;start=119.178999)

- [Methods and challenges to study extremophiles](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=bf5c904d-25fb-49a5-b77a-b11601189f57&amp;start=527.179)

- [metaGOflow](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=bf5c904d-25fb-49a5-b77a-b11601189f57&amp;start=1061.178999)

- [Climate change and thermophiles](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=bf5c904d-25fb-49a5-b77a-b11601189f57&amp;start=1517.178999)

- [Q&amp;A](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=bf5c904d-25fb-49a5-b77a-b11601189f57&amp;start=1907.178999)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-02-14 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-02-14 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Microbial ecosystems webinar" ;
    schema1:name "Investigating microbial ecology in extreme habitats" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
