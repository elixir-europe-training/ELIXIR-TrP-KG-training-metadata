    schema1:inLanguage "en" ;
    schema1:name "NEOF - Python for bioinformatics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:teaches """At the end of the course learners will be able to:\r
\r
- Create, edit, run, and save python scripts with Jupyter-notebook.\r
- Understand and use fundamental python concepts including operators, annotations, variables, and variable classes.\r
- Utilise a variety of python functions and methods.\r
- Store and manipulate data within lists, sets, and dictionaries.\r
- Produce If and else statements to print out different results based on logical conditions (True or False).\r
- Carry out the same task on multiple items with loops.\r
- Read in and write out fastq files with the biopython library.\r
- Filter sequences from fastq data.\r
- Use logical operators to test multiple conditions at once.""" ;
    schema1:url <https://docs.google.com/forms/d/e/1FAIpQLSfU86dYK_8-UsZJX7RViPeEU-ce6mO8hyd5Xvu_qA07z9B97w/viewform> .

<https://tess.elixir-europe.org/events/neof-python-for-bioinformatics-9a0745d4-0443-428c-beaa-5ff6a2ad51d8> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Sequencing of the 16S rRNA gene is a well established method of determining the bacterial taxonomic composition of microbiomes. This has\r
 been used for human and animal body sites, soil, sewage, clouds, deserts, permafrost and many other environments. This course will give \r
you the ability to describe the advantages and disadvantages of 16S rRNA sequencing, and analyse 16S rRNA datasets with the QIIME2 \r
bioinformatics platform.\r
\r
Places are restricted to UK-based researchers and only 30 places are available so please only register if you intend on attending.\r
\r
The workshop will be held over two days on Tuesday 11th and Thursday 13th February 2025, 10am-4pm, with registration opening 9.30am on Tuesday.\r
\r
The deadline to register is Monday 27/1/25 noon, 2 weeks before the course. You will hear later that week whether you have been invited and will need to confirm your attendance.\r
\r
Register to NEOF mailing list to hear first about future NEOF free bioinformatics courses: https://neof.org.uk/news/""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2025-02-13 16:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "NERC" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressLocality "Online" ] ;
                    schema1:latitude "43.590472" ;
                    schema1:longitude "3.859513" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "NEOF" ] ;
            schema1:startDate "2025-02-11 09:30:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "NEOF - Bacterial 16S metabarcoding" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:teaches """At the end of the course learners will be able to:\r
\r
- Utilise and understand the use of QIIME2 with 16S rRNA data.\r
- Import sequencing data and metadata into QIIME2 artifacts.\r
- Cluster and denoise 16S sequences with DADA2.\r
- Assign taxonomies to ASVs and produce a phylogenetic tree.\r
- Evaluate and normalise sequencing depth across their samples.\r
- Produce alpha and beta diversity metrics and statistics.\r
- Carry out differential abundance analysis.""" ;
    schema1:url <https://forms.gle/cbRUZSurfdQPcR2H8> .

<https://tess.elixir-europe.org/events/neof-python-for-bioinformatics-f4927244-c808-42b8-9c29-c9975ea18912> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Python is one of the most popular programming languages for bioinformatics and data analysis in general. It is a very flexible language with countless applications in the manipulation and processing of data files. This course is aimed at Python beginners and will give you transferable skills to manipulate your own data and experience in Python modules tailored specifically for bioinformatics and genomics analyses.\r
\r
Places are restricted to UK-based researchers and only 30 places are available so please only register if you intend on attending.\r
\r
The workshop will be held over two days on Tuesday 14th and Thursday 16th January 2025, 10am-4pm, with registration opening 9.30am on Tuesday.\r
\r
The deadline to register is Monday 16th December 2024. You will hear later that week whether you have been invited and will need to confirm your attendance.\r
\r
Register to NEOF mailing list to hear first about future NEOF free bioinformatics courses: https://neof.org.uk/news/""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
