<https://tess.elixir-europe.org/events/introduction-to-genome-wide-association-studies-gwas-2019> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
David Ellinghaus (Associated partner - CAU)\r
\r
Date:\r
September 18, 2019 Time: 08:30 - 16:30\r
\r
Location:\r
Kiel, Am Botanischen Garten 1-9, Room E49\r
This course is designed for 15 participants. If we receive (a lot) more applications, we will choose participants based on the relevance of their application and/or a first-come-first-serve basis.\r
\r
Contents:\r
Over the past decade, genetic epidemiology studies have progressed from studying single genetic variants in candidate genes to investigating millions of common genetic variants in genome-wide association studies (GWAS). Nowadays GWAS studies are moving forward to genome-wide rare variant association studies, gene-gene (GxG) and gene-environment (GxE) interaction studies as well as cross-phenotype studies including several 10k and sometimes even &gt;100k genetic samples.\r
\r
Learning goals:\r
In this one day course we will give guidance for planning of SNP array genotyping and will provide best-practices for large-scale quality control, variant annotation and association analysis of GWAS data. In the practical part of the course will work on real-world data sets and show how to automatically and manually analyze large case-control sample sets and how to annotate phenotype-associated genomic regions.\r
\r
Prerequisites:\r
None\r
\r
Keywords:\r
genome-wide association studies (GWAS); SNP genotype quality control; association testing""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-09-18 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Germany" ;
                            schema1:addressLocality "Kiel" ;
                            schema1:streetAddress "Kiel" ] ;
                    schema1:latitude "54.323293" ;
                    schema1:longitude "10.122765" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2019-09-18 08:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Introduction to genome-wide association studies (GWAS) 2019 " ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
