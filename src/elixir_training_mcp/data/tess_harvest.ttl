            schema1:endDate "2024-06-27 00:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Edinburgh Genomics" ] ;
            schema1:startDate "2024-06-24 00:00:00 UTC"^^schema1:Date ] ;
