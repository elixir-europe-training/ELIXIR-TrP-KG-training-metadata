        [ a schema1:Audience ;
            schema1:audienceType "Researcher" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "David Dolan" ],
        [ a schema1:Person ;
            schema1:name "Nazeefa Fatima" ],
        [ a schema1:Person ;
            schema1:name "Espen Åberg" ],
        [ a schema1:Person ;
            schema1:name "Arturo Vera Ponce de Leon" ],
        [ a schema1:Person ;
            schema1:name "Korbinian Bösl" ],
        [ a schema1:Person ;
            schema1:name "Erik Hjerde" ],
        [ a schema1:Person ;
            schema1:name "Federico Bianchini" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:datePublished "2024-07-17"^^schema1:Date ;
    schema1:description "Material from the Life Sciences 2024 RDM planning workshop at NMBU." ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.14793904" ;
    schema1:learningResourceType "Slides" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "European Nucleotide Archive (ENA)" ;
            schema1:url <https://bio.tools/tool/ena> ],
        [ a schema1:Thing ;
            schema1:name "Data Stewardship Wizard" ;
            schema1:url <https://bio.tools/tool/Data_Stewardship_Wizard> ],
        [ a schema1:Thing ;
            schema1:name "European Nucleotide Archive" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.dj8nt8> ],
        [ a schema1:Thing ;
            schema1:name "SEEK" ;
            schema1:url <https://bio.tools/tool/seek> ],
        [ a schema1:Thing ;
            schema1:name "FAIRsharing" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.2abjs5> ],
        [ a schema1:Thing ;
            schema1:name "RDMkit" ;
            schema1:url <https://bio.tools/tool/rdmkit> ] ;
    schema1:name "Life Science Data Management: Planning Workshop" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ;
            schema1:url <http://elixir-norway.org> ] ;
    schema1:teaches """Workshop participants will:\r
\r
* Understand data management requirements from the Research Council of Norway and the universities\r
* Be aware of the various national offerings for storage and understand which one is preferable\r
* Understand the importance of using (meta)data standards and the role of persistent identifiers in this context.\r
* Understand the key ethical and legal requirements related to their research\r
* Be aware of the various options for publishing their data and the role of licenses\r
* Create a data management plan using the Data Stewardship Wizard\r
""" ;
    schema1:url <https://doi.org/10.5281/zenodo.14793904> ;
    schema1:version "2024-11-20" .

