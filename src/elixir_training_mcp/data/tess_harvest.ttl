<https://tess.elixir-europe.org/events/molecular-building-blocks-of-life> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Life emerges from the complex interaction of different molecules, through mechanisms and ways that are often still unknown. Understanding how life behaves at different scales and in its different forms requires pulling together these building blocks, and deciphering how they fit and interact with each other. Bioinformatics and computational biology play a key role in this, as the challenge requires the collection, integration, and analysis of large amounts of data. By curating and storing these datasets, annotating genomes and molecules, and capturing interaction and structural data, as well as predictions, data resources are central hubs in the process.

In this webinar series, we will provide a tour through EMBL-EBI data resources relevant to genomics, transcriptomics, proteomics, and metabolomics. Each webinar focuses on one class of biomolecule and introduces bioinformatics tools and data resources that support their study.

All the webinars in the series have been recorded, and individual recordings are accessible through the list below. Each webinar can be accessed as standalone content; however, the content has also been curated and repurposed in the learning pathway [Molecular Building Blocks of Life](https://www.ebi.ac.uk/training/online/courses/molecular-building-blocks-life/), available on-demand for flexible and self-paced learning.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-11-29 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2023-09-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "AlphaFold Database",
        "Complex Portal",
        "Ensembl",
        "European Nucleotide Archive",
        "Human Cell Atlas Data Coordination Platform",
        "InterPro",
        "MetaboLights: Metabolomics repository and reference database",
        "Protein Data Bank in Europe – Knowledge Base",
        "RNAcentral",
        "UniProt: The Universal Protein Resource" ;
    schema1:name "Molecular building blocks of life" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
