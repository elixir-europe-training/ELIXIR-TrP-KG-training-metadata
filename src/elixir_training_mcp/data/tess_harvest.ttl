            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ] ;
    schema1:name "Champs blocs indicators" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Calculate IVR (Visual Rollover Indicator)
- Compute dissimilarity indice
- Vizualize some diversity indices""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/champs-blocs/tutorial.html> ;
    schema1:version "11" .

