<https://tess.elixir-europe.org/events/rnaseq-analysis-with-galaxy-adbebcc2-b71a-483c-8094-ed247fc107e0> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "R - DataViz - 2024" ;
    schema1:description """Objectifs\r
- Importer, structurer, transformer et exporter un tableau de données avec R\r
- Générer des figures de qualité pour, par exemple, une publication scientifique\r
\r
Programme\r
- Introduction au tidyverse (metapackage pour manipuler, visualiser et analyser des données)\r
- Import et export de tableaux de données (csv, excel, google sheet, etc.)\r
- Manipulation de tableaux de données avec dplyr et tidyr (filtre, aggregation, jointure)\r
- Manipulation de chaînes de caractères et de dates avec stringr et lubridate\r
- Introduction aux concepts de visualisation de données\r
- Apprendre à utiliser ggplot2 grâce à esquisse\r
- Partager ses résultats avec Quarto""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
