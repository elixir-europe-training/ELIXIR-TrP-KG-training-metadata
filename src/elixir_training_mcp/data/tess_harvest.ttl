<https://tess.elixir-europe.org/events/mass-spectrometry-data-processing-510f0379-0d6e-4f42-bf52-ee6ea58066be> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """\r
	Obtain a good understanding of the origins and properties of mass spec data\r
	Obtain an understanding of the processing of mass spec data, aimed at identifying and quantifying peptides and proteins\r
	Gain sufficient understanding of the software tools and database used, and of the issues and caveats involved, to critically analyse and assess results from mass spectrometry based proteomics experiments\r
""" ;
