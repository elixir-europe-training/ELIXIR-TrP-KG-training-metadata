<https://tess.elixir-europe.org/materials/fairification-of-an-rnaseq-dataset> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Robert Andrews" ],
        [ a schema1:Person ;
            schema1:name "Sara Morsy" ],
        [ a schema1:Person ;
            schema1:name "Krzysztof Poterlowicz" ],
        [ a schema1:Person ;
            schema1:name "Branka Franicevic" ],
        [ a schema1:Person ;
            schema1:name "Philippe Rocca-Serra" ],
        [ a schema1:Person ;
            schema1:name "Khaled Jum'ah" ],
        [ a schema1:Person ;
            schema1:name "Katarzyna Kamieniecka" ],
        [ a schema1:Person ;
            schema1:name "Andrew Mason" ],
        [ a schema1:Person ;
            schema1:name "Xenia Perez Sitja" ] ;
    schema1:competencyRequired "Access",
        "Data Registration",
        "FAIR and its Origins",
        "Metadata",
        "Persistent Identifiers" ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Khaled Jum'ah" ],
        [ a schema1:Person ;
            schema1:name "Helena Rasche" ] ;
    schema1:creativeWorkStatus "Active" ;
    schema1:dateCreated "2024-05-26"^^schema1:Date ;
    schema1:dateModified "2024-03-27"^^schema1:Date ;
    schema1:datePublished "2024-03-27"^^schema1:Date ;
    schema1:description """## Abstract

[RNA sequencing](https://en.wikipedia.org/wiki/RNA-Seq) is chosen here as an example of how to FAIRify data for a popular assay in the Life Sciences. RNAseq data can be shared and curated in designated public repositories using established ontologies (and controlled vocabularies) for describing protocols and biological material (metadata).


## About This Material

This is a Hands-on Tutorial from the GTN which is usable either for individual self-study, or as a teaching material in a classroom.


## Questions this  will address

 - How can an RNAseq dataset be made FAIR?
 - How are the FAIR principles put into practice with a data-type used commonly in the Life Sciences?


## Learning Objectives

- To be able to map each of the FAIR principles to a dataset in the public domain""" ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "https://gxy.io/GTN:T00435" ;
    schema1:keywords "FAIR Data, Workflows, and Research",
        "data stewardship",
        "dmp",
        "fair" ;
    schema1:learningResourceType "e-learning" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "FAIRification of an RNAseq dataset" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches "- To be able to map each of the FAIR principles to a dataset in the public domain" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/fair/tutorials/fair-rna/tutorial.html> ;
    schema1:version "1" .

