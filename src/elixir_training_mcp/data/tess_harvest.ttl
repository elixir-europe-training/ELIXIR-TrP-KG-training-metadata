    schema1:provider <https://ror.org/002n09z45> ;
    schema1:url <https://github.com/sib-swiss/llm-biodata-training> .

<https://tess.elixir-europe.org/materials/using-opencloning-an-open-source-web-application-to-plan-and-document-cloning-and-genome-engineering> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3047>,
        <http://edamontology.org/topic_3053>,
        <http://edamontology.org/topic_3895>,
        <http://edamontology.org/topic_3912>,
        <http://edamontology.org/topic_3939> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Biotechnology Companies" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Manuel Lera-Ramirez" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2025-04-11"^^schema1:Date ;
    schema1:description """A playlist of videos showing how to use OpenCloning. It contains a general introduction to the tool and short videos showing how to use it for particular tasks (e.g. designing primers for Gateway Cloning).\r
\r
OpenCloning is an Open-Source web application to plan and document cloning. Users can:\r
\r
* 📡 Import plasmid sequences from AddGene and gene sequences from NCBI.\r
* 📁 Load their own sequence files.\r
* 🧬 Plan cloning and design primers using common techniques (Gibson, golden gate, gateway, etc.).\r
* 🦠 Plan strain and cell line engineering via CRISPR and homologous recombination, with use-cases not supported by SnapGene or Benchling.\r
* 🤖 Automate repetitive cloning and primer design using scripts or web forms.\r
* 💾 Download final constructs as GenBank or FASTA files.\r
* 📜 Archive the entire cloning history in an Open format and load it later.\r
* 🛠️ Create reusable cloning templates for cloning kits.\r
\r
Supports several techniques:\r
\r
- PCR\r
- Restriction digestion\r
- Ligation\r
- Homologous recombination\r
- Gibson assembly\r
- Golden gate assembly\r
- Gateway Cloning""" ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.14882672" ;
    schema1:keywords "Genetic Engineering",
        "Genetics",
        "Molecular biology",
        "genome engineering",
        "web application" ;
    schema1:learningResourceType "Video",
        "Webinar",
        "e-learning" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "OpenCloning" ;
            schema1:url <https://opencloning.org/> ] ;
    schema1:name "Using OpenCloning, an Open-Source web application to plan and document cloning and genome engineering" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR" ;
            schema1:url <https://www.elixir-europe.org/> ] ;
    schema1:teaches """* Learn basics of OpenCloning - loading sequences, simulating cloning, designing primers, saving files- (introductory video)\r
* Learn specific features (shorter more specific videos)""" ;
    schema1:url <https://youtube.com/playlist?list=PLpv3x-ensLZkJToD2E6ejefADmHcUPYSJ&si=IHFhVxijNucOfNjB> .

