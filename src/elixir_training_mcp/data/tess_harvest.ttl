    schema1:description "The EIP RIR selection call for application opens from 1 June 2018 to 16 July 2018. This webinar aims to walk the candidate applicants through the web portal for how to fill out the submission form." ;
    schema1:endDate "2018-06-11 15:00:00 UTC"^^schema1:Date ;
