        [ a schema1:Thing ;
            schema1:name "Clustal 2 (Clustal W, Clustal X)" ;
            schema1:url <https://bio.tools/tool/clustal2> ],
        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ],
        [ a schema1:Thing ;
            schema1:name "BEDTools" ;
            schema1:url <https://bio.tools/tool/bedtools> ],
        [ a schema1:Thing ;
            schema1:name "fastp" ;
            schema1:url <https://bio.tools/tool/fastp> ],
        [ a schema1:Thing ;
            schema1:name "MLST" ;
            schema1:url <https://bio.tools/tool/mlst> ],
        [ a schema1:Thing ;
            schema1:name "kraken2" ;
            schema1:url <https://bio.tools/tool/kraken2> ],
        [ a schema1:Thing ;
