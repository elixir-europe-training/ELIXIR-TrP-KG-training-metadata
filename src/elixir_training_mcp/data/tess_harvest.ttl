            schema1:name "Didier Debroas" ],
        [ a schema1:Person ;
            schema1:name "Nadia Goué" ],
        [ a schema1:Person ;
            schema1:name "Bérénice Batut" ] ;
    schema1:competencyRequired "Introduction to Galaxy Analyses" ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Björn Grüning" ],
