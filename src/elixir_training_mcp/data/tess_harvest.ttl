            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/data-driven-modelling-intercellular-interactions-tumour-microenvironment> .

<https://tess.elixir-europe.org/events/data-exploration-with-python-2022> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "This workshop is ideal for researchers and technical workers with a background in biology and a basic knowledge of Python, to work with large, complex datasets, mine them for biological insights, and create visualizations to display the results." ;
    schema1:description """Much of the popularity of Python stems from the availability of high quality libraries of existing code that we can use for our own projects. Libraries ("packages", in Python terminology) are even more useful when they are designed to work together.\r
\r
For scientific programming, we are lucky to have a collection of mature packages which work together to form a stack:\r
\r
numpy for numerical processing\r
pandas for reading, cleaning and processing tabular data files\r
matplotlib as a low-level charting library\r
seaborn as a high-level charting library for rapid dataset exploration through visualization\r
In this course we will learn how to use these packages together to quickly explore large biological datasets, find meaningful patterns in the data, and present our results clearly. We will focus on the high level packages - pandas and seaborn - as this will allow us to do the most work with the smallest amount of code. By concentrating on just two packages for an entire course, we will be able to cover a large part of what these tools can do.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2022-12-02 12:30:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressRegion "Norfolk" ;
                            schema1:streetAddress "Earlham Institute (EI), Colney Lane" ] ;
                    schema1:latitude "52.621792" ;
                    schema1:longitude "1.219034" ] ;
            schema1:startDate "2022-11-21 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Data exploration with Python 2022" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Earlham Institute" ;
            schema1:url <https://www.earlham.ac.uk/> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:url <https://www.earlham.ac.uk/events/data-exploration-python-2022> .

<https://tess.elixir-europe.org/events/data-exploration-with-python-2023> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:alternateName "This workshop is ideal for researchers and technical workers with a background in biology and a basic knowledge of Python, to work with large, complex datasets, mine them for biological insights, and create visualizations to display the results." ;
    schema1:contact "training@earlham.ac.uk" ;
    schema1:description """\r
Much of the popularity of Python stems from the availability of high quality libraries of existing code that we can use for our own projects. Libraries ("packages", in Python terminology) are even more useful when they are designed to work together.\r
\r
For scientific programming, we are lucky to have a collection of mature packages which work together to form a stack:\r
\r
numpy for numerical processing\r
pandas for reading, cleaning and processing tabular data files\r
matplotlib as a low-level charting library\r
seaborn as a high-level charting library for rapid dataset exploration through visualization\r
In this course, we will learn how to use these packages together to quickly explore large biological datasets, find meaningful patterns in the data, and present our results clearly.\r
\r
We will focus on the high-level packages - pandas and seaborn - as this will allow us to do the most work with the smallest amount of code. By concentrating on just two packages for an entire course, we will be able to cover a large part of what these tools can do.\r
\r
This event will be delivered virtually via Zoom &amp; Slack, see more details on the further information tab. \r
Please see here for a detailed syllabus of the course. """ ;
    schema1:endDate "2023-12-01 12:30:00 UTC"^^schema1:Date ;
    schema1:hostInstitution "Earlham Institute" ;
    schema1:keywords "Python" ;
    schema1:name "Data exploration with Python 2023" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "Earlham Institute" ] ;
    schema1:startDate "2023-11-20 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.earlham.ac.uk/events/data-exploration-python-2023> .

<https://tess.elixir-europe.org/events/data-exploration-with-python-the-young-researcher-s-toolkit> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Dirk Winkelhardt, Maike Weber (BioInfra.Prot)\r
\r
Date:\r
9 September 2024\r
\r
Location:\r
Bochum, Universitätsstraße 105\r
\r
Contents:\r
This practical course by Core Unit CUBiMed.RUB, BioInfra.Prot and de.NBI is tailored for young researchers who are new to Python and want to learn the foundational skills necessary for data exploration and analysis in world of Proteomics. Course highlights include:\r
\r
Introduction to Python and Its Data Analysis Libraries: Familiarize yourself with Python basics and powerful libraries like Pandas, NumPy, and Matplotlib, essential for effective data analysis.\r
\r
Basic Data Manipulation and Visualization Techniques: Learn to clean, organize, and visualize your data to draw meaningful insights and present your findings effectively, like Plotly.\r
\r
Hands-On Exercises: Through practical examples and exercises, build your confidence in using Python for your research projects.\r
\r
Learning goals:\r
By the end of this course, you'll have a solid understanding of how to use Python for Proteomics data exploration and be well-prepared to tackle more advanced Proteomics data analysis tasks. Whether you're compiling data for a research paper or looking to enhance your technical skills, this course will provide the tools you need to succeed.\r
\r
Prerequisites:\r
Bring your own Laptop\r
\r
Keywords:\r
Python\r
\r
Tools:\r
Python""" ;
