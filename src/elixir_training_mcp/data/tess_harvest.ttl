<https://tess.elixir-europe.org/events/rnaseq-and-single-cell-rnaseq-course> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3168>,
        <http://edamontology.org/topic_3170> ;
    schema1:description "This course aims to provide participants with theoretical and practical knowledge on how to perform bioinformatic analyses of RNA-seq data using Bioconductor and other open-source software tools. A specific module will briefly describe the single-cell RNA-seq workflow, highlighting differences existing between bulk RNA-seq and single-cell sequencing. The course is suitable for life science researchers who are new to NGS technology, and no statistics prerequisites or computing experience are necessary for attending the course." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
