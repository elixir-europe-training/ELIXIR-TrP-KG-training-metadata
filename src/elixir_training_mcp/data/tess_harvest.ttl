<https://tess.elixir-europe.org/materials/hands-on-for-virtual-screening-of-the-sars-cov-2-main-protease-with-rxdock-and-pose-scoring-tutorial> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3332> ;
    schema1:audience [ a schema1:Audience ;
