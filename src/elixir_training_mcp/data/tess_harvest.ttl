<https://tess.elixir-europe.org/events/11th-repeatexplorer-workshop-on-the-application-of-next-generation-sequencing-to-repetitive-dna-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0622> ;
    schema1:description """Biology Centre of the Czech Academy of Sciences, České Budějovice, is organizing another workshop dedicated to RepeatExplorer, a computational pipeline designed to identify and characterize repetitive DNA elements in next-generation sequencing data from plant and animal genomes.\r
\r
This time, the workshop will address theoretical and practical aspects of using next generation sequencing data to analyze the repeat composition of plant and animal genomes. Special emphasis will be placed on the methods implemented in the RepeatExplorer pipeline, including hands-on exercises in using the pipeline. Participants are also invited to give short presentations of their research on the workshop topic.\r
\r
Visit RepeatExplorer web site for more information.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-05-25 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressLocality "České Budějovice" ;
                            schema1:streetAddress "The workshop will take place at the Institute of Plant Molecular Biology building at the Academy of Sciences and University campus in České Budějovice, Branisovska 31, Czech Republic (http://goo.gl/maps/G74MI)." ] ;
                    schema1:latitude "48.974736" ;
                    schema1:longitude "14.474285" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Biology Centre CAS" ] ;
            schema1:startDate "2023-05-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "11th RepeatExplorer Workshop on the Application of Next Generation Sequencing to Repetitive DNA Analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Czech Republic" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
