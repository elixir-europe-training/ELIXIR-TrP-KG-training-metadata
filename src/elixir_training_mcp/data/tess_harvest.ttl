<https://tess.elixir-europe.org/events/bioinformatics-sequence-analysis-web-services-with-job-dispatcher> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Andrew Cowley" ;
    schema1:description "Several core bioinformatics tools and related data can be accessed for free using the EMBL-EBI Job Dispatcher framework. This webinar discusses how to access these tools and data using the Web Interface and RESTful API and explores how we can leverage common workflow language (CWL) to run analysis workflows." ;
    schema1:endDate "2018-11-07 16:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "Bioinformatics Sequence Analysis Web Services with Job Dispatcher" ;
    schema1:startDate "2018-11-07 15:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2018/bioinformatics-sequence-analysis-web-services-job-dispatcher> .

<https://tess.elixir-europe.org/events/bioinformatics-sequence-analysis-web-services-with-job-dispatcher-1964796c-0a9c-47e5-9d40-ee1c9f426c16> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Melissa Burke - webinars@ebi.ac.uk" ;
    schema1:description """The EMBL-EBI Job Dispatcher framework (https://www.ebi.ac.uk/services) provides free access to several core Bioinformatics tools and related data, via the web or programmatically via Web Services APIs. In this webinar, we will give an overview of the Web Interface and RESTful API. We will then explore how to use our Sample Clients to perform various bioinformatics analysis, and how we can leverage CWL to run analysis workflows.

""" ;
    schema1:endDate "2018-11-07 16:00:00 UTC"^^schema1:Date ;
    schema1:hostInstitution "EMBL-EBI" ;
    schema1:keywords "Cross domain (cross-domain)",
        "Web Services (173893)" ;
    schema1:maximumAttendeeCapacity 200 ;
    schema1:name "Bioinformatics sequence analysis web services with Job Dispatcher" ;
    schema1:startDate "2018-11-07 15:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.ebi.ac.uk/training/events/bioinformatics-sequence-analysis-web-services-job-dispatcher> .

<https://tess.elixir-europe.org/events/bioinformatics-summer-school-2019> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This one-week intensive summer school in bioinformatics will focus on data analysis and high throughput biology, with a special focus on R/Bioconductor and its application to a wide range of topics across bioinformatics and computational biology. The course is intended for researchers who are familiar with omics experimental technologies and their applications in biology, have had some exposure with R, and who want to learn or expand their bioinformatics skills.\r
\r
The course will cover underlying theory and practical hands-on exercises. At the end of the course, participants should be able to run analysis workflows on their own omics data, adapt and combine different tools and make informed choices about bioinformatics data analysis strategies.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
