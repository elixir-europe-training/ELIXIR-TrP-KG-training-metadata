            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-07-15 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Bioinformatics for immunologists" ;
