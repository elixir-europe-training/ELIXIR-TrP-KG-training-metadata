            schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/maxquant-label-free/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/3774452> ],
        [ a schema1:Thing ;
            schema1:name "MaxQuant" ;
            schema1:url <https://bio.tools/tool/maxquant> ] ;
    schema1:name "Label-free data analysis using MaxQuant" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
