<https://tess.elixir-europe.org/events/icri-2018-4th-international-conference-on-research-infrastructures> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """ELIXIR will be attending ICRI, and on Thursday 13 September give a talk in Parallel Session 4 about 'Enhancing the societal value of Research Infrastructures'. \r
	\r
	ICRI 2018 is co-organised by the Austrian Federal Ministry of Science, Research and Economy (BMWFW) and the European Commission. Participants from more than 50 countries are expected to take part in this event. Speakers representing high-level stakeholders from across the globe and highly profiled institutions will\r
	intervene in the debate.\r
\r
For full details about the ELIXIR session as well as details on how to register, visit the ICRI website.\r
	 """ ;
    schema1:endDate "2018-09-14 00:00:00 UTC"^^schema1:Date ;
