    schema1:description """## Abstract

Loosely building on, this tutorial compares two editions of the poem "The Sorrows of Yamba".[^1]


## About This Material

This is a Hands-on Tutorial from the GTN which is usable either for individual self-study, or as a teaching material in a classroom.


## Questions this  will address

 - How to get started in Galaxy for text-related tasks?


## Learning Objectives

- Log in to Galaxy
- Upload files to the platform
- Use tools within Galaxy
- Clean and prepare text data
- Compare two texts
- Visualize your results""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Digital Humanities",
        "text mining" ;
    schema1:learningResourceType "e-learning" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://doi.org/10.5281/zenodo.17053220> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/digital-humanities/tutorials/introduction_to_dh/workflows/> ] ;
    schema1:name "Introduction to Digital Humanities in Galaxy" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Log in to Galaxy
- Upload files to the platform
- Use tools within Galaxy
- Clean and prepare text data
- Compare two texts
- Visualize your results""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/digital-humanities/tutorials/introduction_to_dh/tutorial.html> ;
    schema1:version "3" .

