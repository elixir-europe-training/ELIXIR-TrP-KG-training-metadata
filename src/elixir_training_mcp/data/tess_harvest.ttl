                    schema1:latitude "59.858613" ;
                    schema1:longitude "17.638744" ] ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:startDate "2023-11-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "Population genomics in practice" ;
