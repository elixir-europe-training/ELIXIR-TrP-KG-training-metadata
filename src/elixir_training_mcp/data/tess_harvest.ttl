<https://tess.elixir-europe.org/events/responsible-innovation-for-research> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Ensure your research is responsible and ethical" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD Students" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD candidates" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:description """This fully online, CPD Certified, short course in Responsible Innovation, provides an introduction to the AREA Framework for approaching innovation responsibly and use real-world historical and philosophical case studies to teach you how to think about your work reflectively.\r
\r
Responsible innovation is a way of organising research and innovation so it is as ethical and aligned with positive societal impact as it possibly can be. It emerged over the past few decades following increasing concerns about the impact of scientific research, both good and bad. \r
\r
It aims to recognise that although science can have wonderful and amazing impacts across fields such as healthcare, pharmaceuticals, manufacturing, industry, it also has the capacity to do a huge amount of harm. \r
""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2022-11-25 18:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity -50 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "UCL Science and Technology Studies" ] ;
            schema1:startDate "2022-10-10 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "AI",
        "Artificial Intelligence",
        "Ethics",
        "Genomic data",
        "Innovation",
        "Research",
        "Responsible Innovation",
        "data-science",
        "health-informatics",
        "life-sciences",
        "pharmaceutical",
        "physical-science-and-engineering" ;
    schema1:name "Responsible Innovation for Research | University College London" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University College London" ],
