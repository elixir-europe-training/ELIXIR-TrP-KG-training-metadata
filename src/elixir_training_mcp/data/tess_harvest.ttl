<https://tess.elixir-europe.org/events/webinar-open-data-requirements-for-life-science-projects> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "All postgraduates" ] ;
    schema1:description """This webinar on the 31th of January (13.00 CET) from [ELIXIR Norway](https://elixir.no/) will provide you with information on Open Data and Data Management requirements for research applications to the Research Council of Norway (RCN) call for proposals with deadline February 8th.\r
\r
For projects funded by RCN [open science is now one of the assessment criteria](https://www.forskningsradet.no/en/processing-grant-applications/processing-applications/assessment-open-science/) and all funded projects must assess the need for a Data Management Plan. In this webinar we will highlight the RCN requirements for Open Data and Data Management from a Life Science perspective and provide a short introduction to the Data Management Planning tool "Data Stewardship Wizard" by ELIXIR Norway.\r
\r
This 45 minutes webinar will be presented by Korbinian Bösl (ELIXIR Norway, BioMedData &amp; Centre for Digital Life Norway)\r
\r
[Please register for the event on Zoom](https://uib.zoom.us/meeting/register/u5cpdu-sqT8oG9MMwsj0KaIn0oAx_9H0wv_1).""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-01-31 14:00:00 UTC"^^schema1:Date ;
            schema1:startDate "2023-01-31 13:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Webinar: Open Data requirements for Life Science Projects" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ;
            schema1:url <http://elixir-norway.org> ] ;
    schema1:url <https://elixir.no/news/99/63/Webinar-Open-Data-requirements-for-Life-Science-Projects> .

