<https://tess.elixir-europe.org/materials/data-organisation-practices> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_4012> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researcher in life sciences" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD candidates" ],
        [ a schema1:Audience ;
            schema1:audienceType "Scientists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Stephan Nylinder" ],
        [ a schema1:Person ;
            schema1:name "Niclas Jareborg" ] ;
    schema1:competencyRequired "None" ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Elin Kronander" ],
        [ a schema1:Person ;
            schema1:name "Mattias Strömberg" ],
        [ a schema1:Person ;
            schema1:name "Yvonne Kallberg" ],
        [ a schema1:Person ;
            schema1:name "Markus Englund" ],
        [ a schema1:Person ;
            schema1:name "Erik Hedman" ],
        [ a schema1:Person ;
            schema1:name "Wolmar Nyberg Åkerström" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:description """Good data organisation is the foundation of any research project. It not only sets you up well for an analysis, but it also makes it easier to come back to the project later and share with collaborators, including your most important collaborator – the future you.\r
\r
Much of the information of a project is digital, and we need to keep track of our digital records in the same way we have a lab notebook and sample freezer. In this lesson, we’ll go through the project organisation and documentation that will make an efficient research workflow possible. Not only will this make you a more effective researcher, it also prepares your data and project for publication. Grant agencies and publishers increasingly require this information.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "CONVERGE",
        "Data management",
        "FAIR",
        "data organisation" ;
    schema1:learningResourceType "e-learning",
        "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "The Carpentries" ;
            schema1:url <https://carpentries.org/learn/> ] ;
    schema1:name "Introduction to Data Management Practices - Data organisation practices" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "NBIS" ;
            schema1:url <http://nbis.se> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Sweden" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:teaches """This lesson is divided into five episodes where you will learn:\r
- The recipients of data organisation and how and why they should be considered\r
- How to organise files and documentation to support your workflows\r
- How to structure and store your metadata, tabular data and information about experiments""" ;
    schema1:url <https://nbisweden.github.io/module-organising-data-dm-practices/> .

<https://tess.elixir-europe.org/materials/data-processing-with-r-tidyverse> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Eric Koncina" ],
        [ a schema1:Person ;
            schema1:name "Roland Krause" ],
        [ a schema1:Person ;
            schema1:name "Aurélien Ginolhac" ] ;
    schema1:description """The four day course provides a complete introduction to data science in R with the `tidyverse`. The course will not go deep into statistics but rather getting data ready, some exploratory analysis, visualization and handling models.\r
\r
Preparing data takes up to 90% of the time spent in analysis — speeding this up is the mission of this course.""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords " R-programming" ;
    schema1:learningResourceType "course materials" ;
