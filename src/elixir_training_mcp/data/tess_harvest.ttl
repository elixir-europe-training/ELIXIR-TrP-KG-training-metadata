<https://tess.elixir-europe.org/materials/variant-submission-and-accessioning-at-the-european-variation-archive> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description "The European Variation Archive (EVA) is a primary open repository for archiving, accessioning, and distributing genome variation including single nucleotide variants, short insertions and deletions (indels), and larger structural variants (SVs) in any species. The EVA is in the process of releasing the first dbSNP data release which consists of RS ID-containing VCF files for each non-human species available in dbSNP. This webinar will provide an overview of the European Variation Archive including data ingestion, consumption, and how you can access and utilise dbSNP RS release batch files." ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Variant submission and accessioning at the European Variation Archive" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/variant-submission-and-accessioning-european-variation-archive> .

