<https://tess.elixir-europe.org/materials/investigating-antimicrobial-resistance-with-embl-ebi-resources-a-practical-introduction> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3301>,
