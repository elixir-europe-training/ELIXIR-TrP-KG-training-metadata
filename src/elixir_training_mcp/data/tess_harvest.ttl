<https://tess.elixir-europe.org/events/apply-mutationexplorer-to-study-mutation-of-proteins-and-visualise-their-energetic-impact> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "The possible effects of mutations on stability and function of a protein can only be understood in the context of protein 3D structure. The MUTATIONEXPLORER webserver maps variants onto protein structures and allows users to study variation by inputting sequence changes. As the user enters variants, the 3D model evolves, and estimated changes in energy are highlighted. In addition to a basic per-residue input format, MUTATIONEXPLORER can also upload an entire replacement sequence. Previously the purview of desktop applications, such an upload can back-mutate PDB structures to wildtype sequence in a single step. Structures are flexibly colorable, not only by energetic differences, but also by hydrophobicity, or sequence conservation, or other biochemical profiling. Another mutation source can be human single nucelotide polymorphisms (SNPs), genomic coordinates input in VCF format. MUTATIONEXPLORER strives for efficiency in user experience. For example, 45,000 PDB depositions for instant retrieval and initial display have been prepared. All modeling steps are performed by Rosetta." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-03-06 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3010" ;
                            schema1:streetAddress "Leuven - Provinciehuis Vlaams-Brabant, Provincieplein 1" ] ;
                    schema1:latitude "50.879202" ;
                    schema1:longitude "4.701168" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-03-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "Apply MutationExplorer to study mutation of proteins and visualise their energetic impact" ;
    schema1:provider [ a schema1:Organization ;
