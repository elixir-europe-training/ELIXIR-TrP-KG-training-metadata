<https://tess.elixir-europe.org/events/computational-approaches-to-the-study-of-protein-interactions-and-rational-drug-design> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0128>,
        <http://edamontology.org/topic_0147>,
        <http://edamontology.org/topic_0148>,
        <http://edamontology.org/topic_0209>,
        <http://edamontology.org/topic_3514>,
        <http://edamontology.org/topic_3526> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Structural biologists" ] ;
    schema1:description """In this workshop, participants will familiarise with docking approaches to the study of protein-protein interactions (PPIs) and protein-small molecule interactions. Irreversible binders design using molecular docking and computational methods to rational drug design will be also described, as well as the functional role of the intrinsically disordered proteins. The Plenary lectures of N. Davey (10.02.2017), A. Bonvin, S. Forli and S. Moro (11.02.2017) will be open and free to everyone but require application. \r
Practical sessions are limited to 30 participants. On the afternoon of day 3, participants can bring their own data (e.g. proteins they want to study interactions for). They will be split in groups based on the type of system they want to study (i.e protein-protein, protein-small ligand interactions or virtual screening) and will analyse it assisted by A. Bonvin and S. Forli.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2017-04-14 13:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Italy" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Italy" ;
                            schema1:addressLocality "Padova" ;
                            schema1:addressRegion "Provincia di Padova" ;
                            schema1:streetAddress "Campus di Biologia e Biomedicina “Fiore di Botta”, University of Padova, Via del Pescarotto, 8" ] ;
                    schema1:latitude "45.412607" ;
                    schema1:longitude "11.89706" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Allegra Via, Lisanna Paladin, Marco Carraro" ] ;
            schema1:startDate "2017-04-10 14:00:00 UTC"^^schema1:Date ] ;
