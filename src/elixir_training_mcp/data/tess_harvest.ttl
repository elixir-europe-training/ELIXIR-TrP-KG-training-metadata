                            schema1:addressLocality "Clermont-Ferrand" ;
                            schema1:postalCode "63178" ;
                            schema1:streetAddress "7, avenue Blaise Pascal" ] ;
                    schema1:latitude "45.777455" ;
                    schema1:longitude "3.081943" ] ;
            schema1:maximumAttendeeCapacity 15 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "AuBi (https://mesocentre.uca.fr/projets-associes/plateforme-aubi), AuBi (https://mesocentre.uca.fr/projets-associes/plateforme-aubi/), Université Clermont Auvergne (https://www.uca.fr/)" ] ;
            schema1:startDate "2023-07-10 09:00:00 UTC"^^schema1:Date ] ;
