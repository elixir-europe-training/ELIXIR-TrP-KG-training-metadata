        "hands-on",
        "research data management" ;
    schema1:name "Research Data Management (RDM) in life sciences: essentials" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Apply appropriate metadata standards to describe datasets effectively”",
        "“Appraise and select repositories to deposit research data”",
        "“Define key concepts such as Research Data Management (RDM) FAIR data Open data and Personal and Sensitive Data”",
        "“Distinguish between general and discipline-specific repositories for data sharing”",
        "“Evaluate the components of the Data Management Plan and justify its relevance to research projects”",
        "“Explain the role of data documentation in enhancing publication quality and reproducibility”",
        "“Identify reliable sources and institutional resources that support RDM practices”",
        "“Organize research data and documentation in a structured and standardized format”",
        "“Recognize the ethical and legal implications of data handling under GDPR”" ;
    schema1:url <https://training.vib.be/all-trainings/research-data-management-rdm-life-sciences-essentials-0> .

<https://tess.elixir-europe.org/events/research-data-management-workshop> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0219>,
        <http://edamontology.org/topic_3071> ;
    schema1:alternateName "Free hands-on introductions to research data management and publication." ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD candidates" ] ;
    schema1:coursePrerequisites """Participants should bring a laptop with a Mac or Windows operating system (not a tablet, Chromebook, etc.) and administrative privileges. Please install the following programs beforehand:\r
\r
    a text editor (such as atom or notepad++)\r
    a spreadsheet editor (excel or libreoffice)\r
    RStudio (open source desktop edition)\r
    GitHub Desktop""" ;
    schema1:description """LifeWatch and Elixir Belgium invite you to a hands-on workshop to manage and publish research data. The workshop is organized in the context of the Empowering Biodiversity Research conference and will cover data management plans, data cleaning and GitHub. If this is jargon you always wanted to know about (but were afraid to ask), then this workshop is for you!\r
Who\r
\r
This workshop is aimed at environmental and life scientists that manage research data, from PhD students to senior scientists. It is an introductory workshop to data management, data cleaning and data publishing. We recommend participants to have a basic understanding of R and its data types. We can send resources for people who need an introduction to R before this workshop. The level of this workshop is from beginner to intermediate, we will not cover advanced materials.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2022-09-27 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Bruxelles" ;
                            schema1:postalCode "1000" ;
                            schema1:streetAddress "Av. du Port 88, 88 Avenue du Port" ] ;
                    schema1:latitude "50.866169" ;
                    schema1:longitude "4.350166" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "LifeWatch and ELIXIR Belgium" ] ;
            schema1:startDate "2022-09-27 09:30:00 UTC"^^schema1:Date ] ;
    schema1:name "Research data management workshop" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "INBO" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Belgium" ;
            schema1:url <https://www.elixir-belgium.org/training> ] ;
    schema1:url <https://oscibio.inbo.be/blog/rdm-workshop/> .

