<https://tess.elixir-europe.org/events/mining-pdbe-and-pdbe-kb-using-a-graph-database> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Meredith Willmott" ;
    schema1:description "This workshop covers the use of the PDBe graph database to extract data for solving complex structural biology queries." ;
    schema1:endDate "2020-02-20 14:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "United Kingdom" ;
                    schema1:addressLocality "Cambridge" ;
                    schema1:postalCode "CB10 1SD" ;
                    schema1:streetAddress "European Bioinformatics Institute (EMBL-EBI) - Training Room 1, Wellcome Genome Campus" ] ;
            schema1:latitude "52.078533" ;
            schema1:longitude "0.186135" ] ;
    schema1:name "Mining PDBe and PDBe-KB Using a Graph Database" ;
    schema1:startDate "2020-02-18 12:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2020/mining-pdbe-and-pdbe-kb-using-graph-database> .

<https://tess.elixir-europe.org/events/mining-pdbe-and-pdbe-kb-using-a-graph-database-a258d91d-1805-4a70-8951-1e56a288b90e> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_1317> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType """This workshop is aimed at bioinformaticians with experience of analysing data from the PDB, either by processing archive files or via API access. We encourage applications from individuals with specific questions relating to PDB data that are difficult to solve using existing data queries. Programming experience is required, with a preference for those familiar with Python, although &nbsp;this is not an absolute requirement.\r
\r
An example use case might involve research into a specific drug molecule, where protein structure is relevant to drug specificity. The graph database would allow the analysis of all common interaction sites in PDB at the residue level, with the potential to expand this search across ligands containing similar fragments. Additional searches could analyse the protein-protein interaction sites between different isoforms of the same protein, and cross-reference them to sequence conservation data and predicted functional annotations.\r
\r
Researchers should submit a 200-word abstract when they apply that describes their work and potential queries related to PDB data. This should include details on how PDB data has been accessed previously and the types of questions trying to be answered.""" ] ;
    schema1:description """This workshop covers the use of the PDBe [graph database](https://www.ebi.ac.uk/pdbe/pdbe-kb/schema) to extract data for solving complex structural biology queries. It will introduce the PDBe graph database and how to write Cypher queries to retrieve data of interest. Workshop participants will be able to use the graph database to explore data relevant to their own research with support and guidance from the development team at PDBe.

The graph database integrates annotations provided by PDBe-KB partners and is implemented in Neo4J. In this graph each PDB entry is represented as a tree, with the root being the PDB entry, connected to chains and entities, which are then connected to residues. Each of the PDB residues (\\&gt;150 million) are linked to available annotations (e.g. is the residue part of a catalytic site?, or is it on a macromolecular interaction interface?) and are also directly connected to their corresponding UniProt residues. Storing PDBe-KB data as a graph offers great benefits in particular by allowing straightforward transfer of annotations between PDB entries which map to the same UniProt accession, as well as to highly identical UniProt accession.

Read the database schema [here](https://www.ebi.ac.uk/pdbe/pdbe-kb/schema).""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2020-02-20 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressRegion "Cambridge" ;
                            schema1:postalCode "CB10 1SD" ;
                            schema1:streetAddress "European Bioinformatics Institute, Hinxton" ] ] ;
            schema1:maximumAttendeeCapacity 10 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-02-18 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Proteins (proteins)",
        "Structures (structures)" ;
    schema1:name "Mining PDBe and PDBe-KB using a graph database" ;
    schema1:provider [ a schema1:Organization ;
