<https://tess.elixir-europe.org/events/sparkle-impact-green-impact-assessment-and-environmental-sustainability-workshop> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """The Impact &amp; Green workshop scheduled to take place online on Monday, September 30th, is organised by the Portuguese node, in collaboration with ELIXIR Hub and the Italian and Norwegian ELIXIR Nodes. This workshop will focus on impact assessment and environmental sustainability and will build up on the knowledge gathered on the first workshop of this kind in Bari earlier this year.\r
\r
Workshop Topics:\r
\r
\r
	Assessing the impact of research activities;\r
	Learning how impact assessment is conducted in research infrastructures;\r
	Greening Research (Operations, computing, etc);\r
	Understanding ELIXIR's initiatives on environmental sustainability.\r
\r
\r
This workshop is primarily organised as part of the ELIXIR Staff Exchange project entitled “Developing impact assessment tools at the node level and kickstarting environmental efforts within ELIXIR and ELIXIR Nodes” (SPARKLE).\r
\r
Anyone in ELIXIR and the broader community interested in impact evaluation and environmental sustainability should attend.\r
\r
Date: 30 the September (10am-5pm CEST time)\r
\r
Location: Online\r
\r
Link for event page: https://events.biodata.pt/event/2/overview\r
\r
Link for registration: https://events.biodata.pt/event/2/registrations/3/""" ;
    schema1:endDate "2024-09-30 10:00:00 UTC"^^schema1:Date ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Portugal" ] ;
            schema1:latitude "39.662165" ;
            schema1:longitude "-8.135352" ] ;
    schema1:name "SPARKLE Impact & Green - Impact assessment and environmental sustainability workshop" ;
    schema1:startDate "2024-09-30 10:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/sparkle-impact-green-impact-assessment-and-environmental-sustainability-workshop> .

