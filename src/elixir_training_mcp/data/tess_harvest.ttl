        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/microbiome/tutorials/mgnify-amplicon/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "PRINSEQ" ;
            schema1:url <https://bio.tools/tool/prinseq> ] ;
    schema1:name "MGnify v5.0 Amplicon Pipeline" ;
    schema1:provider [ a schema1:Organization ;
