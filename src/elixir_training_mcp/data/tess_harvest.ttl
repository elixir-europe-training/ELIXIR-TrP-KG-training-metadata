    schema1:name "Galaxy community kickoff meeting and Galaxy User Conference" ;
    schema1:startDate "2018-03-14 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/galaxy-community-kickoff-meeting-and-galaxy-user-conference> .

