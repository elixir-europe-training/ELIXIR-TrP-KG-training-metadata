                    schema1:latitude "51.053829" ;
                    schema1:longitude "3.725012" ] ;
            schema1:startDate "2024-01-19 00:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "omics" ;
    schema1:name "Spatial data analysis user meeting" ;
