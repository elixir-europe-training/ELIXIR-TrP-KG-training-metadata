<https://tess.elixir-europe.org/events/online-sparql-access-to-wikipathways-and-aop-wiki-webinar> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "...for everyone who wants to learn how to use linked data resources such as WikiPathways and AOP-Wiki, and no preparations are necessary" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "mixed audience" ] ;
    schema1:description """Linked data is basically structured data which is interlinked with other data so it becomes more useful through semantic queries. One way of doing this is through the integration of databases through RDF (Resource Description Framework, the standard model for data interchange) using the newly developed User Interfaces for WikiPathways and AOP-Wiki, providing a variety of useful features to facilitate exploring the databases and linking their data with other resources. The new features include a flexible, auto-populated query panel, SPARQL syntax highlighting, permalinks for SPARQL queries, and full-screen mode. The webinar will focus on the usability of the interface by walking through the various functionalities, and showing a variety of example queries against the WikiPathways and AOP-Wiki data. Furthermore, federated queries across resources will be executed to illustrate the strength of linked data. The webinar is for everyone who wants to learn how to use linked data resources such as WikiPathways and AOP-Wiki, and no preparations are necessary.\r
\r
The expected duration is 45 minutes with time for discussion and support with queries afterwards.\r
""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-03-23 16:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "EU H2020" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress """register for online participation: \r
https://attendee.gotowebinar.com/register/1429123637065255181""" ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "www.nanocommons.eu" ] ;
            schema1:startDate "2021-03-23 15:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "SNORQL user interface",
        "adverse outcome pathway",
