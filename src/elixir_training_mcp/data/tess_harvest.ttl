<https://tess.elixir-europe.org/events/qupath-quantitative-pathology-bioimage-analysis-software> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This one-day workshop is aimed to use QuPath, an open-source software for bioimage processing and analysis of slide scanner images.

A dedicated time will be used to analyze some of the participants dataset, so please contact the organizers if you would like to bring your own data to process/analyze.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
