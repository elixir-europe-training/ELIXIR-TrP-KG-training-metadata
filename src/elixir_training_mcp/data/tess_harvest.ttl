                            schema1:addressCountry "Italy" ;
                            schema1:addressLocality "Pula" ;
                            schema1:addressRegion "Metropolitan City of Cagliari" ;
                            schema1:postalCode "09010" ;
                            schema1:streetAddress "Science and Technology Park of Sardinia, Pula, Italy" ] ;
                    schema1:latitude "39.012189" ;
                    schema1:longitude "9.001101" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BioExcel" ] ;
            schema1:startDate "2024-06-16 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "BioBB",
        "BioExcel",
        "GROMACS",
        "HADDOCK",
        "PMX",
        "Summer School" ;
    schema1:name "BioExcel Summer School 2024" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "BioExcel" ;
            schema1:url <http://bioexcel.eu/> ],
        [ a schema1:Organization ;
            schema1:name "BioExcel CoE" ] ;
    schema1:teaches """1. Theoretical knowledge of the biophysical concepts underlying molecular modelling and simulations.\r
2. Working knowledge of BioExcel core applications: GROMACS, HADDOCK, PMX, BioBB.\r
3. Working knowledge of advanced biophysical topics: Free energy calculation, Advanced sampling methods, Machine learning etc.""" ;
    schema1:url <https://bioexcel.eu/events/summer-school-on-biomolecular-simulations-2024/> .

