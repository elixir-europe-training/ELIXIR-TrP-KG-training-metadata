    schema1:url <https://www.ebi.ac.uk/training/events/data-visualisation-biology-2025> .

<https://tess.elixir-europe.org/events/data-visualisation-i-figures> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Graduate students" ] ;
    schema1:description """All researchers will be handling some data at some point in their careers. However, the data, in its regular shape (tables), is quite hard to grasp for most people. Especially if there is a lot of it, this is where data visualization comes to help. The idea is to bring forth the essential aspects of the data - to tell a story. However, just putting data into a graph or figure might do more harm than good. Not only could it give wrong conclusions, but it also might be misleading. This is one of the main reasons why the exact way how you visualize the data is fundamental. \r
\r
This lecture is part of a series of lectures and workshops called “Data visualisation.” The first lecture will discuss why data visualization is important and what we should consider when designing it. This means what chart type to pick, how much information to include, what (and how) to highlight, and so on. This lecture will be followed up by a workshop in May. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-04-04 12:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Estonia" ] ;
            schema1:startDate "2023-04-04 10:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Data management",
        "Data visualisation" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Data Visualisation I - Figures" ;
            schema1:url <https://doi.org/10.5281/zenodo.7819287> ] ;
    schema1:name "Data Visualisation I - Figures" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <http://elixir.ut.ee> ],
        [ a schema1:Organization ;
            schema1:name "University of Tartu, Institute of Computer Science" ] ;
    schema1:teaches """* Understand how to tell a story through data visualization\r
* Know what chart type to pick for different kinds of data\r
* Know what to pay attention to while designing a figure""" ;
    schema1:url <https://elixir.ut.ee/node/480> .

