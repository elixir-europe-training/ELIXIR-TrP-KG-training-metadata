    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """	An ELIXIR BrAPI BYOD/hackathon, organized by ELIXIR Belgium and ELIXIR NL will take place in Ghent, Belgium, May 30 - June 1. \r
