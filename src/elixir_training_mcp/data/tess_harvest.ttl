<https://tess.elixir-europe.org/events/computational-biology-training-in-hematology-2024-module-1> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Computational Biology Training in Hematology (CBTH) provides early-career researchers aiming to specialize in computational and quantitative biology aspects of hematology with a unique, year-long training and mentoring experience by top-tier faculty.

CBTH is a joint effort of the European Hematology Association (EHA) and the European Molecular Biology Laboratory-European Bioinformatics Institute (EMBL-EBI) that aims to support the development of quantitative skills for hematology researchers through training and mentoring in computational biology.

The CBTH program will be organized with two multi-day workshops in a city in Europe and a follow up session at the [EHA Congress](https://ehaweb.org/congress/eha2024-hybrid-congress/).""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-04-20 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressRegion "Cambridge" ;
                            schema1:postalCode "CB10 1SD" ;
                            schema1:streetAddress "European Bioinformatics Institute, Hinxton" ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-04-16 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Computational Biology Training in Hematology 2024, Module 1" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/computational-biology-training-hematology-2024-module-1> .

