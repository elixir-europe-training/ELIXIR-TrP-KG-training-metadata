    schema1:name "Panel Discussion: Improve visibility of research software for career advancement" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "Australian BioCommons" ] ;
    schema1:startDate "2022-02-24 13:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.biocommons.org.au/events/bioinfo-software> .

<https://tess.elixir-europe.org/events/pangaea-community-workshop-2023-fair-data-publications-with-pangaea> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Dr. Daniela Ransby (AWI),\r
Dr. Flavia Höring (Universität Bremen, MARUM),\r
Dr. Judith Engel (GfBio e.V / NFDI4Biodiversity),\r
Dr. Kathrin Riemann-Campe (AWI),\r
Dr. Stefanie Schumacher (AWI),\r
Dr. Malik Naumann (Universität Bremen, MARUM), and\r
Dr. Lars Möller (Universität Bremen, MARUM)\r
\r
Date:\r
16.11.2023 10:30 – 12:30\r
17.11.2023 10:30 – 12:30\r
\r
Location:\r
Online\r
\r
Contents:\r
This two-day, four-hour workshop focuses on preparing and submitting data to PANGAEA in accordance to requirements for FAIR and sustainable data publishing. In a combination of theoretical units and hands-on exercises, this workshop is dedicated to best practices in data management, recommended steps to prepare your data to support a smooth publication process, and a behind-the-scenes look at related PANGAEA workflows and services.\r
\r
Learning goals:\r
Be able to follow best practices in data management, and all recommended steps for preparing and submitting scientific results of earth, biodiversity, and environmental research to a FAIR data repository like PANGAEA.\r
\r
Prerequisites:\r
non\r
\r
Keywords:\r
PANGAEA, FAIR-Data Publication\r
\r
Tools:\r
PANGAEA Submission Form\r
\r
Contact:\r
PANGAEA CWS Team (training@pangaea.de)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-11-17 12:00:00 UTC"^^schema1:Date ;
            schema1:startDate "2023-11-16 10:30:00 UTC"^^schema1:Date ] ;
    schema1:name "PANGAEA Community Workshop 2023: \"FAIR data publications with PANGAEA\"" ;
