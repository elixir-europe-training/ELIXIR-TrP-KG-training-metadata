<https://tess.elixir-europe.org/events/initiation-a-l-utilisation-de-la-plateforme-de-bio-analyse-galaxy> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """L’objectif de cette formation est de se familiariser avec l’interface utilisateur de Galaxy. Nous proposons au personnel non-bioinformaticien de les accompagner dans la prise en main de l’interface Galaxy. Vous découvrirez comment importer des données, faire une analyse simple, gérer un historique et construire un workflow.\r
\r
Cette formation se base sur le contenu du Galaxy Training Network (GTN). Plus de 300 tutoriels sont mis à disposition sur le web (https://training.galaxyproject.org/) organisés autour de différentes thématiques biologiques. Nous aborderons ici les bases du fonctionnement de la plateforme Galaxy.\r
\r
\r
Les inscriptions se font via le formulaire suivant avant le 28 Février 2024 : https://framaforms.org/cycle-de-formations-mensuelles-a-lanalyse-de-donnees-sur-galaxy-1707229580\r
Dans ce formulaire, vous pouvez sélectionner les sessions qui vous intéressent. Nous sélectionnerons les participants sur la base du "premier arrivé, premier servi" et nous transmettrons la liste par session au service de formation continue de l'UCA qui vous enverra ensuite une convocation.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-03-13 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Clermont-Ferrand" ;
                            schema1:postalCode "63178" ;
                            schema1:streetAddress "7 avenue Blaise Pascal" ] ;
                    schema1:latitude "45.777455" ;
                    schema1:longitude "3.081943" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "AuBi (https://mesocentre.uca.fr/projets-associes/plateforme-aubi), AuBi (https://mesocentre.uca.fr/projets-associes/plateforme-aubi/), Mésocentre Clermont-Auvergne (https://mesocentre.uca.fr/)" ] ;
            schema1:startDate "2024-03-13 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Initiation à l’utilisation de la plateforme de bio-analyse Galaxy" ;
    schema1:provider [ a schema1:Organization ;
