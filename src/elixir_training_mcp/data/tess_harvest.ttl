<https://tess.elixir-europe.org/events/metagenomics-and-metabarcoding> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_3174> ;
    schema1:description "This course focuses on the computational methods used to analyse the wealth of data produced by shotgun metagenomics and metabarcoding (Amplicon targeted metagenomics) studies.This course will provide you the insights to the DNA metabarcoding analyses from preprocessing and quality control of the raw data to the construction of OTU/ASV tables, taxon assignment, diversity analysis and differential abundance analysis using QIIME2. Further, you will also learn about methods to generate the reference-based profile to generate microbial community features like taxonomic abundances or functional profile and how to identify the ones characterizing differences between two biological conditions.You will then be introduced to methods used for assembly from metagenomics samples. Attendees will use tools to assemble metagenome assembled genomes (MAGs) from short read and long read data. We will discuss the different approaches and tools available for these assemblies and the benefits and limitations of each options." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-08-30 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Edinburgh" ;
                            schema1:postalCode "EH9 3JN" ;
                            schema1:streetAddress "The King's Buildings, The University of Edinburgh, West Mains Road" ] ;
                    schema1:latitude "55.922946" ;
                    schema1:longitude "-3.174749" ] ;
            schema1:startDate "2019-08-28 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "HDRUK" ;
    schema1:name "Metagenomics and Metabarcoding" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Edinburgh Genomics" ;
            schema1:url <https://genomics.ed.ac.uk> ] ;
    schema1:url <https://genomics.ed.ac.uk/services/introduction-metagenomic-data-analysis> .

<https://tess.elixir-europe.org/events/metagenomics-and-metatranscriptomics-initiation-2025-session> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Metagenomics 2025" ;
    schema1:description """Présentation de la formation\r
A la demande du laboratoire d'Ecologie Microbienne de Lyon, l'équipe Formation de l'IFB organise une session de formation de deux jours sous Galaxy pour l'analyse de données de métagénomique et métatranscriptomique.\r
\r
Objectifs pédagogiques\r
A la fin de cette formation, les participants auront \r
\r
- acquis des connaissances théoriques et pratiques sur les méthodes et objectifs d'une analyse en métagénomique et métatranscriptomique\r
\r
 - réalisé une analyse de données de données métataxonomique, métagénomique shotgun et métatranscriptomique sous l'environnement Galaxy et sur des données fournies par l'équipe pédagogique\r
\r
- choisi et initié une analyse sur un jeu de données de leur choix en bénéficiant de l'encadrement de l'équipe pédagogique (Bring Your Own Data sessions)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-06-18 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Villeurbanne" ;
                            schema1:postalCode "69100" ;
                            schema1:streetAddress "Université Claude Bernard-Lyon 1 - salle de réunion du 5ème étage du bâtiment MENDEL - 16 rue Raphaël DUBOIS" ] ;
                    schema1:latitude "45.773357" ;
                    schema1:longitude "4.886845" ] ;
            schema1:maximumAttendeeCapacity 12 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "IFB Core (https://www.france-bioinformatique.fr/)" ] ;
            schema1:startDate "2025-06-17 09:00:00 UTC"^^schema1:Date ] ;
