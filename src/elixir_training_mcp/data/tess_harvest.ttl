<https://tess.elixir-europe.org/events/software-carpentry-workshop-10c78dfc-992c-446a-8685-5a7b483353a0> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description """This workshop will be taught by some of COMBINE’s internationally certified Software Carpentry instructors and cover an introduction to the UNIX shell, version control using Git and Github, and reproducible analysis in R.\r
\r
We are offering a two-day workshop — Software Carpentry workshop in Melbourne, on the 26th of April and the 3rd of May.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2018-05-03 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Australia" ;
                            schema1:addressLocality "Parkville" ;
                            schema1:addressRegion "Melbourne " ;
                            schema1:streetAddress """Seminar Room 1, WEHI\r
1G Royal Parade""" ] ;
                    schema1:latitude "-37.796897" ;
                    schema1:longitude "144.957442" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "COMBINE Australia" ] ;
            schema1:startDate "2018-04-26 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords " R-programming",
        "Git",
        "SoftwareCarpentry",
        "Unix" ;
    schema1:name "Software Carpentry Workshop" ;
