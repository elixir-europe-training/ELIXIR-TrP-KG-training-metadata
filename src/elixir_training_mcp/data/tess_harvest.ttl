            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2021-08-24 14:00:00 UTC"^^schema1:Date ] ;
    schema1:name "The Linux Command Line: From Basic Commands to Shell Scripting 2-2021 " ;
