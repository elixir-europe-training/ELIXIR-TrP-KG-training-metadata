<https://tess.elixir-europe.org/materials/chip-seq-data-analysis-identification-of-the-binding-sites-of-the-estrogen-receptor> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "fidelram" ],
        [ a schema1:Person ;
            schema1:name "vivekbhr" ],
        [ a schema1:Person ;
            schema1:name "bebatut" ],
        [ a schema1:Person ;
            schema1:name "erxleben" ],
        [ a schema1:Person ;
            schema1:name "friedue" ] ;
    schema1:description """ChIP-sequencing is a method used to analyze protein interactions with DNA.

Questions of the tutorial:

- How is raw ChIP-seq data processed and analyzed?
- What are the binding sites of the Estrogen receptor?


Objectives of the tutorial:

- Inspect read quality with FastQC
- Map reads with Bowtie2
- Assess the quality of an ChIP-seq experiments
- Extract coverage files
- Call enriched regions or peaks""" ;
    schema1:learningResourceType "Tutorial" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "ChIP-Seq data analysis dataset" ;
            schema1:url <https://doi.org/10.5281/zenodo.892432> ],
        [ a schema1:Thing ;
            schema1:name "Input datasets" ;
            schema1:url <https://doi.org/10.5281/zenodo.892432> ] ;
    schema1:name "ChIP-Seq data analysis - Identification of the binding sites of the Estrogen receptor" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:url <http://galaxyproject.github.io/training-material/topics/chip-seq/tutorials/estrogen-receptor-binding-site-identification/tutorial.html> .

<https://tess.elixir-europe.org/materials/chip-seq-data-analysis-identification-of-the-binding-sites-of-the-t-cell-acute-lymphocytic-leukemia-protein-1-tal1> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "malloryfreeberg" ],
        [ a schema1:Person ;
            schema1:name "erxleben" ],
        [ a schema1:Person ;
            schema1:name "joachimwolff" ],
        [ a schema1:Person ;
            schema1:name "vivekbhr" ],
        [ a schema1:Person ;
            schema1:name "moheydarian" ] ;
    schema1:description """ChIP-sequencing is a method used to analyze protein interactions with DNA.

Questions of the tutorial:

- How is raw ChIP-seq data processed and analyzed?
- What are the binding sites of Tal1?
- Which genes are regulated by Tal1?


Objectives of the tutorial:

- Inspect read quality with FastQC
- Perform read trimming with Trimmomatic
- Align trimmed reads with BWA
- Assess quality and reproducibility of experiments
- Identify Tal1 binding sites with MACS2
- Determine unique/common Tal1 binding sites from G1E and Megakaryocytes
- Identify unique/common Tal1 peaks occupying gene promoters
- Visually inspect Tal1 peaks with Trackster""" ;
    schema1:learningResourceType "Tutorial" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "ChIP-Seq data analysis dataset" ;
            schema1:url <https://doi.org/10.5281/zenodo.197100> ],
        [ a schema1:Thing ;
            schema1:name "Input datasets" ;
            schema1:url <https://doi.org/10.5281/zenodo.197100> ] ;
    schema1:name "ChIP-Seq data analysis - Identification of the binding sites of the T-cell acute lymphocytic leukemia protein 1 (TAL1)" ;
