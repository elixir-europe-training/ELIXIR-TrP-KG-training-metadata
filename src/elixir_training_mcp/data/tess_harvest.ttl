    schema1:teaches "- Learn how to use MaxQuant and MSstats for the analysis of label-free shotgun (DDA) data" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/maxquant-msstats-dda-lfq/tutorial.html> ;
    schema1:version "19" .

