            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BioExcel, NCC Portugal, University of Coimbra" ] ;
            schema1:startDate "2024-11-26 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "BioBB",
        "BioExcel",
        "GROMACS",
        "HADDOCK",
        "PMX",
        "Workshop" ;
    schema1:name "BioExcel software tools for intermediate to advanced users" ;
