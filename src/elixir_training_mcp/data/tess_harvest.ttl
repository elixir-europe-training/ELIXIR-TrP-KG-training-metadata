<https://tess.elixir-europe.org/events/python-for-spatial-data-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This course aims to prepare people who have no experience with Jupyter notebooks, conda environments, Pandas DataFrames, Numpy arrays, or plotting images for courses that make use of these Python packages, like the spatial data analysis course. Pandas DataFrames are typically used to store data tables for analysis (similar to R data frames), whereas Numpy arrays are often used to store image data. Matplotlib is a popular Python package for creating visualizations like images but also plots of your data. All these components are heavily used in the spatial data analysis pipelines (but also in other omics pipelines). The course will give you enough background knowledge to understand the Python scripts that are used in the spatial data analysis course and to adjust them according to your needs. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-06-13 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-06-13 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "programming" ;
    schema1:name "Python for spatial data analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Create retrieve and analyze Pandas DataFrames”",
        "“Create retrieve of NumPy arrays and their use to the store images”",
        "“Plotting images (and very briefly: data) with matplotlib”",
        "“Set up a conda environment and using conda to install packages (as it is used in the spatial data analysis trainings)”",
        "“Use Jupyter notebooks (as they are used in the spatial data analysis trainings)”" ;
    schema1:url <https://training.vib.be/all-trainings/python-spatial-data-analysis> .

<https://tess.elixir-europe.org/events/python-for-spatial-data-analysis-4d0310eb-1178-4cf6-b0fe-bce25ff109ef> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This course is designed for scientists who have basic Python programming skills and want to follow our spatial data analysis courses. If you're familiar with Python syntax but new to working with Jupyter notebooks, conda environments, Pandas DataFrames, NumPy arrays, and Matplotlib visualizations, this training will help you bridge that gap. The course provides the background knowledge you’ll need to understand the Python scripts that are used in the spatial data analysis courses and to adjust them according to your needs. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2026-06-12 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2026-06-05 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "programming" ;
    schema1:name "Python for spatial data analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Construct and manipulate Pandas DataFrames to manage and analyze tabular data”",
        "“Create a conda environment and install relevant Python packages”",
        "“Create visual representations of image data using Matplotlib”",
        "“Generate NumPy arrays to store and access image data”",
        "“Run Jupyter notebooks to write run and document Python code”" ;
    schema1:url <https://training.vib.be/all-trainings/python-spatial-data-analysis-0> .

<https://tess.elixir-europe.org/events/python-introduction-light-course> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This course aims to prepare people with no experience with Python for courses that make use of Python, like the spatial data analysis course or the machine learning introduction. It will not  teach you how to write Python scripts from scratch, but it will give you enough background knowledge to understand the Python scripts that are used in the advanced courses and to adjust them according to your needs. If you want to thoroughly learn Python so that you can write scripts from scratch you should follow our extended Python introduction course." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
