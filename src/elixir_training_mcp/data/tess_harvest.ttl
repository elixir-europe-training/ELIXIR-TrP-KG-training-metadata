                            schema1:addressCountry "Portugal" ;
                            schema1:addressRegion "Porto" ;
                            schema1:postalCode "4169-007" ;
                            schema1:streetAddress "Faculty of Sciences, University of Porto, Rua do Campo Alegre 1021/1055" ] ;
                    schema1:latitude "41.162216" ;
                    schema1:longitude "-8.625179" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-05-07 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "EMBL-EBI workshop: Genomics, transcriptomics and metagenomics tools and resources for biology research" ;
