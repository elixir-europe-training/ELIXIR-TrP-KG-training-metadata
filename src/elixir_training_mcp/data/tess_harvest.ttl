<https://tess.elixir-europe.org/materials/neoantigen-3-database-merge-and-fragpipe-discovery> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
