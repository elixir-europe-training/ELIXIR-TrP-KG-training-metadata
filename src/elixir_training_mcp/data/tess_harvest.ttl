                            schema1:addressRegion "Cambridge" ;
                            schema1:postalCode "CB10 1SD" ;
                            schema1:streetAddress "European Bioinformatics Institute, Hinxton" ] ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-02-19 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "European Genome-phenome Archive",
        "Human ecosystems",
        "NHGRI-EBI GWAS Catalog",
        "environmental readouts",
        "ethics",
        "genes and environment interactions",
        "human phenotypes" ;
    schema1:name "Exploring gene and environmental exposure interactions to understand human health and disease" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute" ] ;
