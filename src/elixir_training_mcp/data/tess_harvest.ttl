        [ a schema1:Thing ;
            schema1:name "RNA-seq reads to counts" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/transcriptomics/tutorials/rna-seq-counts-to-genes/tutorial.html> ] ;
    schema1:name "RNA-seq: from reads to differentially expressed genes" ;
