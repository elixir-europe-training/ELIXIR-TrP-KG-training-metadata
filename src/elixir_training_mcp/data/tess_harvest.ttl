<https://tess.elixir-europe.org/events/bioexcel-workflow-training-for-computational-biomolecular-research-3ab3cc23-6baa-4ae1-a081-e36a492fb7f4> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Charlotte Pearton" ;
    schema1:description "Complex scientific studies require elaborate software pipelines necessitating interconnection of different tools and sources of data. In some cases, the complexity of the pipeline forces the definition of process dependencies, especially when those processes can be launched asynchronously in High Performance Computing (HPC) systems. Workflow managers such as Galaxy, Apache Taverna, PyCOMPSs, KNIME or Copernicus can be used to tackle this particular issue." ;
    schema1:endDate "2016-10-21 18:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Spain" ;
                    schema1:addressLocality "Barcelona" ;
                    schema1:postalCode "08034" ;
                    schema1:streetAddress "Barcelona Supercomputing Center, Computer Architechture Dept at Universitat Politecnica de Catalunya" ] ;
            schema1:latitude "41.394382" ;
            schema1:longitude "2.113115" ] ;
    schema1:name "BioExcel: Workflow Training for Computational Biomolecular Research" ;
    schema1:startDate "2016-10-20 09:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2016/bioexcel-workflow-training-computational-biomolecular-research> .

