                            schema1:addressCountry "Italy" ;
                            schema1:addressLocality "Milano" ;
                            schema1:addressRegion "Città Metropolitana di Milano" ;
                            schema1:postalCode "20126" ;
                            schema1:streetAddress "Via Bicocca degli Arcimboldi, 8, Lab. 715, U7 Building" ] ;
                    schema1:latitude "45.517431" ;
                    schema1:longitude "9.212474" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Gianluca Della Vedova (Department of Computer Science, University of Milano-Bicocca, IT), Loredana Le Pera (ELIXIR-IIB Training Coordinator Deputy, IBIOM-CNR, IT), Allegra Via (ELIXIR-IIB Training Coordinator, IBPM-CNR, IT)" ] ;
            schema1:startDate "2018-09-26 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Containers",
        "Docker",
        "Virtual machine" ;
    schema1:name "Docker Advanced Course" ;
