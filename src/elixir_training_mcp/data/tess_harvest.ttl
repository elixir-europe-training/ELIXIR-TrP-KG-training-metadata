<https://tess.elixir-europe.org/events/elixir-webinar-the-elixir-recommended-interoperability-resources-application-process-second-round> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """This internal webinar is primarily intended for data resource managers submitting their resources to the second round of ELIXIR Recommended Interoperability Resources (RIRs) selection. This webinar will walk the applicants through the online form they need to fill out to submit their application.\r
\r
You will find more information about ELIXIR Recommended Interoperability Resources at: https://elixir-europe.org/platforms/interoperability/rirs""" ;
    schema1:endDate "2019-12-16 12:00:00 UTC"^^schema1:Date ;
