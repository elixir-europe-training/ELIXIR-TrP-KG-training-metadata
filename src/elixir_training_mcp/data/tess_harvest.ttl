<https://tess.elixir-europe.org/events/single-cell-transcriptomics-streamed-c2d548ec-b82d-450b-b1ab-8441f2769dcd> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
