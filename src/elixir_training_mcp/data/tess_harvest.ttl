                            schema1:postalCode "CH-4001" ;
                            schema1:streetAddress """University of Basel\r
Kollegienhaus\r
Petersplatz 1\r
CH-4001 Basel""" ] ;
                    schema1:latitude "47.558528" ;
                    schema1:longitude "7.583869" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR-GR, H3ABioNet" ] ;
            schema1:startDate "2019-09-09 09:00:00 UTC"^^schema1:Date ] ;
