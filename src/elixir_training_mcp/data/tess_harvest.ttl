<https://tess.elixir-europe.org/materials/querying-a-beacon-database-for-copy-number-variants-cnvs> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0199> ;
    schema1:audience [ a schema1:Audience ;
