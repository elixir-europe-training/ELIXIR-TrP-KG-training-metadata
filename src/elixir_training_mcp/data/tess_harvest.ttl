        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/DIA_lib_OSW/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/4293493> ],
        [ a schema1:Thing ;
            schema1:name "diaPASEF" ;
            schema1:url <https://bio.tools/tool/diapasef> ] ;
    schema1:name "Library Generation for DIA Analysis" ;
    schema1:provider [ a schema1:Organization ;
