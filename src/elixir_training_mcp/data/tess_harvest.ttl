<https://tess.elixir-europe.org/materials/laboratory-documentation-with-markdown> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0607> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Beginner" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Heleri Inno" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2024-10-30"^^schema1:Date ;
    schema1:dateModified "2024-10-30"^^schema1:Date ;
    schema1:datePublished "2024-11-01"^^schema1:Date ;
    schema1:description "This course introduces the basics of Markdown, a lightweight markup language used to format plain text in documents. Markdown plays a crucial role in scientific research by enabling the efficient writing of reports, code documentation, and creating well-organised research notebooks. Students will learn essential Markdown syntax throughout the course, including formatting text, adding links, images, tables, math equations, and code blocks. By integrating Markdown with Jupyter Notebook, participants can build dynamic laboratory notebooks that streamline the documentation, analysis, and sharing of research findings." ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.14016131" ;
    schema1:keywords "Data Management",
        "Jupyter Notebook",
        "Markdown" ;
    schema1:learningResourceType "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Laboratory documentation with Markdown" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <https://elixir.ut.ee> ] ;
    schema1:teaches """* Understand and utilise Markdown's basic (text, lists) and advanced (images, tables, codes, mathematical expressions) syntax\r
* Create a functional digital laboratory notebook that can be adapted for various research projects\r
* Recognise other use cases for Markdown in the scientific workflow (e.g., GitHub, R Markdown, Colab)""" ;
    schema1:url <https://doi.org/10.5281/zenodo.14016131> ;
    schema1:version "1.0" .

