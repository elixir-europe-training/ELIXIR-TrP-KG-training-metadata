<https://tess.elixir-europe.org/materials/confidence-intervals> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description """We all have confidence intervals ("I'm the king of the world!!!!") and non-confidence intervals ("No one loves me").  That is not what this tutorial is about.

This tutorial takes what you already know about the central limit theorem, sampling distributions, and z-scores and uses these tools to dive into the world of inferential statistics.  It may seem magical at first, but from our sample, we can now make inferences about the probability of our population mean actually being in an interval.""" ;
    schema1:keywords "Inferential statistics" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Confidence intervals" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Khan Academy Statistics" ;
            schema1:url <https://www.khanacademy.org/math/probability> ] ;
    schema1:url <https://www.khanacademy.org/math/probability/statistics-inferential/confidence-intervals> .

