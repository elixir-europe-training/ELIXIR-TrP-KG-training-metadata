<https://tess.elixir-europe.org/materials/standard-vocabularies> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "VLIZ" ],
        [ a schema1:Person ;
            schema1:name "UGent" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2022-11-01"^^schema1:Date ;
    schema1:dateModified "2023-05-01"^^schema1:Date ;
    schema1:datePublished "2023-05-01"^^schema1:Date ;
    schema1:description """The need to share data and research products is essential to enable research collaboration and promote wide access to data and data products. However, this can only be achieved if a common ‘language’ is used. In this short course, we provide a short overview of what data standards are, where to find common (data) vocabularies and the importance of metadata. \r
\r
This is a self-paced course (no facilitators support available). Since there is no evaluation, a certificate will not be issued.""" ;
    schema1:keywords "FAIR principles",
        "interperable" ;
    schema1:learningResourceType "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Standard Vocabularies" ;
    schema1:teaches """At the end of this course, the learner should be able to:\r
\r
    Explain what data standards and why they are needed\r
    Apply data standards and make use of common vocabularies\r
    Select the adequate vocabularies for own data / dataset(s)\r
    Explain what metadata is and apply it to its own data""" ;
    schema1:url <https://oceantraining.eu/moodle/course/view.php?id=83> .

