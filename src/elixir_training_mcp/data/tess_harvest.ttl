<https://tess.elixir-europe.org/events/data-visualisation-101-a-practical-introduction-to-designing-scientific-figures-7e3c8b3d-3e3c-40b4-87e6-f6c900c3c6b3> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_0337> ;
    schema1:description """In this webinar we will go through the basic principles of designing scientific figures to communicate our research findings. We will focus on how we can utilise colour effectively and help our audience make accurate quantitative judgements by taking advantage of fundamental principles of human perception. We will also discuss strategies for visualising complex datasets.

The webinar is based on [the articles in data visualisation which were published in the Points of View column in Nature Methods](http://blogs.nature.com/methagora/2013/07/data-visualization-points-of-view.html) with additional material from publications by [Edward Tufte](https://www.edwardtufte.com/tufte/books_vdqi), [Tamara Munzner](http://www.cs.ubc.ca/~tmm/vadbook/) and other leading researchers on data visualisation.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2018-09-26 00:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 200 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2018-09-26 00:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Data visualisation 101: A practical introduction to designing scientific figures" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/data-visualisation-101-practical-introduction-designing-scientific-figures> .

