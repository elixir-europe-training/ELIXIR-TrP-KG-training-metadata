<https://tess.elixir-europe.org/materials/pdbe-tools-in-github> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3372> ;
    schema1:description """This webinar will show you how to access some of the software packages created at PDBe, used to generate the data displayed on our website. This will include a walkthrough of our github repositories, highlighting the types of packages available, how to access them and some examples of how they can be used.\r
\r
This webinar is part of a 6-part PDBe API webinar series, introducing different levels of programmatic access at PDBe.The series will range from basic data retrieval and search using the PDBe API to more advanced features, including access and reuse of PDBe data visualisation components.""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "PDBe tools in GitHub" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/pdbe-tools-github> .

