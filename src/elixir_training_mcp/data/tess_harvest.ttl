- Write programs that create flat lists, index them, slice them, and modify them through assignment and method calls.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/data-science/tutorials/python-iterables/tutorial.html> ;
    schema1:version "6" .

