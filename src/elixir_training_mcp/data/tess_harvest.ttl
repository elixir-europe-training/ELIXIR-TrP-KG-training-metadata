<https://tess.elixir-europe.org/events/leadership-workshop-situational-leadership> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This leadership workshop focusses on one specific topic, situational leadership. The idea behind situational leadership is that there exists no single \"best\" style of leadership. Effective leadership is flexible, meaning that leaders adapt their leadership style to the ability (skills) and willingness (motivation) of the individual or group they want to lead or influence. Effective leadership depends not only on the person or group, but also varies with the task that needs to be accomplished." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2020-03-10 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
