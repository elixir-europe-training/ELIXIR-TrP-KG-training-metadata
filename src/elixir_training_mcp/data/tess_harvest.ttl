<https://tess.elixir-europe.org/materials/ready-for-biodata-management-intensive-course> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD candidates" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researcher in life sciences" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Jorge Oliveira" ],
        [ a schema1:Person ;
            schema1:name "Daniel Faria" ],
        [ a schema1:Person ;
            schema1:name "Gil Poiares-Oliveira" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2024-02-01"^^schema1:Date ;
    schema1:dateModified "2025-04-23"^^schema1:Date ;
    schema1:datePublished "2024-01-30"^^schema1:Date ;
    schema1:description """This is a two-day, entry-level, hands-on course aimed at Life Sciences researchers (with at least PhD frequency level) and lab managers.\r
\r
It provides a comprehensive overview of the data life cycle, discussing the main research data management challenges that arise at each stage as well as suggestion solutions to tackle those challenges.\r
\r
The ultimate goal is to empower researcher to produce FAIR data by design, and improve the reproducibility and reusability of their research.""" ;
    schema1:keywords "Data Stewardship Wizard",
        "FAIR",
        "RDM",
        "RDMkit",
        "data stewardship" ;
    schema1:learningResourceType "presentation" ;
    schema1:license <https://spdx.org/licenses/CC-BY-NC-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "elabFTW" ;
            schema1:url <https://www.elabftw.net/> ],
        [ a schema1:Thing ;
            schema1:name "DMPortal" ;
            schema1:url <https://dmportal.biodata.pt> ],
        [ a schema1:Thing ;
            schema1:name "RDMkit" ;
            schema1:url <https://bio.tools/tool/rdmkit> ],
        [ a schema1:Thing ;
            schema1:name "The FAIR Principles" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.WWI10U> ],
        [ a schema1:Thing ;
            schema1:name "Data Stewardship Wizard" ;
            schema1:url <https://bio.tools/tool/Data_Stewardship_Wizard> ],
        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ] ;
    schema1:name "Ready for BioData Management? Intensive slide deck" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Portugal" ;
            schema1:url <https://elixir-portugal.org> ],
        [ a schema1:Organization ;
            schema1:name "BioData.pt" ;
            schema1:url <https://biodata.pt> ] ;
    schema1:teaches """- Sensitive researchers to the need for good data management practices\r
- Overview the stages of the data lifecycle and the chalenges that arise at each stage\r
- Capacitate researchers in addressing key challenges""" ;
    schema1:url <https://github.com/BioData-PT/Ready4BioDataManagement/tree/master/Intensive%20Course> ;
    schema1:version "1" .

<https://tess.elixir-europe.org/materials/ready-for-biodata-management-training-data-stewards-for-life-sciences> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Life Science Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "The course is aimed at research scientists with a minimum of a degree in a biological discipline, including laboratory and clinical staff, as well as specialists in related fields." ],
        [ a schema1:Audience ;
            schema1:audienceType "This workshop is aimed at PhD students within the PhD programme \"Genetics, Molecular and Cellular Biology\" (University of Pavia) and the PhD programmme \"Biomolecular Sciences and Biotechnology\" (IUSS, University School for Advanced Studies Pavia." ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Daniel Faria" ],
        [ a schema1:Person ;
            schema1:name "Ana M.P. Melo" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2022-12-29"^^schema1:Date ;
    schema1:dateModified "2022-12-29"^^schema1:Date ;
    schema1:datePublished "2022-12-29"^^schema1:Date ;
    schema1:description """BioData.pt | ELIXIR Portugal, in collaboration with several other organizations has designed a program to train the first generation of Data Stewards for the life sciences, to support the implementation of data management, open science and FAIR data principles in Portuguese R&amp;I organizations. It will unfold from February to November 2022, allowing trainees to get some practice and consolidate the acquired knowledge. It will comprise an introductory module covering the basic concepts of Data Stewardship followed by two assignments and end with a hands-on course for knowledge consolidation.\r
After this program, trainees will be able to make significant contribution in:\r
- Writing data management plans in support to grant applications\r
- Ensuring continuity and sharing of data over projects\r
- Ensuring data quality\r
- Supporting the elaboration of institutional data management guidelines\r
- Supporting compliance with institution data management policy\r
- Contributing to knowledge exchange with regard to data management\r
Although this program was tailored to the needs of Portuguese R&amp;I organizations, applications from other countries are very welcome.\r
Training materials can be consulted in this folder, videos of different modules are available @BioData.pt Youtube Channel\r
Training Materials in Zenodo:\r
Intro Course\r
DS Lab 1\r
DS Lab 2\r
Consolidation Course""" ;
    schema1:identifier "10.5281/zenodo.7492723" ;
    schema1:keywords "Data Steward",
        "Data management",
        "FAIR",
        "FAIR Research",
        "Open data",
        "Open science",
        "RDM",
        "Training (Training)",
        "research data management" ;
    schema1:learningResourceType "Course materials",
        "Training materials" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "\"Ready for BioData Management?\"  Training Data Stewards for Life Sciences" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Portugal" ;
            schema1:url <https://elixir-portugal.org> ],
        [ a schema1:Organization ;
            schema1:name "BioData.pt" ;
            schema1:url <https://biodata.pt> ] ;
    schema1:teaches """- Writing data management plans in support to grant applications\r
- Ensuring continuity and sharing of data over projects\r
- Ensuring data quality\r
- Supporting the elaboration of institutional data management guidelines\r
- Supporting compliance with institution data management policy\r
- Contributing to knowledge exchange with regard to data management""" ;
    schema1:url <http://ready4biodatamanagement.biodata.pt/courses.html#dataStewards> ;
    schema1:version "1" .

