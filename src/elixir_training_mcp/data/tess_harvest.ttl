            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "INB/ELIXIR-ES and Barcelona Supercomputing Center (BSC)" ] ;
            schema1:startDate "2021-11-23 13:30:00 UTC"^^schema1:Date ] ;
