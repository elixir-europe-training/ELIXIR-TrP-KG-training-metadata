<https://tess.elixir-europe.org/events/introduction-to-cbioportal> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:coursePrerequisites """Access to a computer or tablet with internet access\r
If you wish to follow along with the cBioPortal API section (last section), you will need R/RStudio\r
""" ;
    schema1:description """The cancer bioportal (cBioPortal) is a huge, browser-based and highly interactive database for working with cancer datasets, including sequencing and clinical data. This is a highly useful resource for wet lab and bioinformatic cancer scientists alike, providing broader relevance for lab results, pan-cancer data for large cost-cutting analyses, and extensive fodder for undergraduate research projects. \r
\r
This session will start with an overview of cBioPortal, including a website walkthrough. You will then go through some guided and structured problem-solving examples combining omics data and clinical information from different cancer types. We’ll finish with how you can extend beyond the browser by downloading and accessing the underlying data yourselves.\r
\r
This session is evenly split between presentations/walkthroughs and problem-solving tasks.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-03-21 14:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "This course is funded as part of the UKRI Innovation Scholars. Data Science Training in Health and Bioscience call (DaSH). (MR/V038966/1)" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR-UK DaSH" ] ;
            schema1:startDate "2024-03-21 12:30:00 UTC"^^schema1:Date ] ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "cBioPortal" ;
            schema1:url <https://www.cbioportal.org/> ] ;
    schema1:name "Introduction to cBioPortal" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ],
        [ a schema1:Organization ;
            schema1:name "ELXIR-UK DaSH" ;
            schema1:url <https://elixiruknode.org/projects/elixir-uk-dash/> ] ;
    schema1:url <https://elixiruknode.org/event/introduction-to-cbioportal/> .

<https://tess.elixir-europe.org/events/introduction-to-chip-seq-data-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0622> ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2015-07-24 01:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Edinburgh" ] ;
                    schema1:latitude "55.953252" ;
                    schema1:longitude "-3.188267" ] ;
            schema1:startDate "2015-07-23 01:00:00 UTC"^^schema1:Date ] ;
    schema1:name "INTRODUCTION TO CHIP-SEQ DATA ANALYSIS" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "iAnn" ;
            schema1:url <http://iann.pro> ] ;
    schema1:url <https://genomics.ed.ac.uk/introduction-chip-seq-data-analysis> .

<https://tess.elixir-europe.org/events/introduction-to-chip-seq-data-analysis-and-visualisation-using-ensembl> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3169> ;
    schema1:description """ChIP-seq (Chromatin ImmunoPrecipitation followed by Sequencing) is a popular high-throughput sequencing assay to identify binding sites of DNA-associated proteins and histone modifications. Determining how proteins interact with DNA and the epigenetic landscape is essential for elucidating the regulation of gene expression. The aim of this workshop is to familiarise the participants with the primary analysis of ChIP-seq data sets by providing a balanced set of lectures and practicals on analysis methodologies. Practicals include publicly available ChIP-seq datasets, processed using widely used and open-source software programs (e.g. FASTQC, BWA, samtools, bedtools, wiggletools, MACS2, MEME, TOMTOM, ngsplot) and visualised on the Ensembl genome browser.
""" ;
