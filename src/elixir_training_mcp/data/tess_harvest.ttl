            schema1:url <https://training.galaxyproject.org/training-material/topics/statistics/tutorials/classification_regression/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "scikit-learn" ;
            schema1:url <https://bio.tools/tool/scikit-learn> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/2579649> ] ;
    schema1:name "Machine learning: classification and regression" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Explain the types of supervised machine learning - classification and regression.
- Learn how to make predictions using the training and test dataset.
- Visualize the predictions.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/statistics/tutorials/classification_regression/tutorial.html> ;
    schema1:version "13" .

<https://tess.elixir-europe.org/materials/hands-on-for-machine-learning-modeling-of-anticancer-peptides-tutorial> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0121> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Daniel Blankenberg" ],
        [ a schema1:Person ;
            schema1:name "Jayadev Joshi" ] ;
