<https://tess.elixir-europe.org/events/biostudies-database-aggregating-all-outputs-of-a-life-sciences-study> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Anna Swan" ;
    schema1:description "The goal of the BioStudies database is to facilitate transparency and reproducibility of research by aggregating all the outputs of a study (a ‘data package’) in a single place." ;
    schema1:endDate "2019-07-17 16:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "BioStudies database - aggregating all outputs of a life sciences study" ;
    schema1:startDate "2019-07-17 15:30:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2019/biostudies-database-aggregating-all-outputs-life-sciences-study> .

<https://tess.elixir-europe.org/events/biostudies-database-aggregating-all-outputs-of-a-life-sciences-study-f0af3d46-258d-4e91-ad41-de19173fb4f1> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_2422>,
        <http://edamontology.org/topic_3068>,
        <http://edamontology.org/topic_3678> ;
    schema1:description """The goal of the BioStudies database is to facilitate transparency and reproducibility of research by aggregating all the outputs of a study (a ‘data package’) in a single place. A data package consists of the overall biological study description (metadata), links to data generated in this study in key community databases at EMBL-EBI and elsewhere, as well as “orphan data” such as supplemental data. The database can accept a wide range of types of studies described via a simple format and does not impose minimum requirements outside those agreed by the respective community.  
  
 In this webinar we will introduce the basic principles of BioStudies, explore data access and data deposition interfaces, as well as briefly consider some more advanced topics such as use of BioStudies for data sharing in an ongoing project.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2019-07-17 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 200 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-07-17 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "BioStudies Database",
        "Biological studies",
        "Cross domain (cross-domain)",
        "Data sharing" ;
    schema1:name "BioStudies database: aggregating all outputs of a life sciences study" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/biostudies-database-aggregating-all-outputs-life-sciences-study> .

