<https://tess.elixir-europe.org/events/introduction-to-the-complex-portal> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Ajay Mishra" ;
    schema1:description "This webinar will introduce the Complex Portal, an encyclopaedic database for information on macromolecular complexes." ;
    schema1:endDate "2020-12-02 16:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "Introduction to the Complex Portal" ;
    schema1:startDate "2020-12-02 15:30:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2020/introduction-complex-portal> .

<https://tess.elixir-europe.org/events/introduction-to-the-complex-portal-7f356f7b-1bd1-49fe-9a89-c52f5c9fb0d0> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3047> ;
    schema1:description "This webinar will introduce the Complex Portal, an encyclopaedic database for information on macromolecular complexes. In this webinar we will explain the coverage and curation priorities of the Complex Portal, show how to search for complexes using a variety of accession numbers, keywords and how to use the organism search. We will also demonstrate examples of complex details pages that include visualisation tools and link-outs to related database." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2020-12-02 00:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 500 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-12-02 00:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Introduction to the Complex Portal" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/introduction-complex-portal> .

<https://tess.elixir-europe.org/events/introduction-to-the-embl-ebi-bioinformatics-tools-framework> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_0857> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType """This course is suitable for anyone interested in learning about running sequence alignment programs and detecting homologous sequences. It is also aimed at those wanting to learn about the EMBL-EBI Tools and how to access the services via user-friendly command-line clients.&nbsp;\r
\r
For attending Session 1, no previous bioinformatics experience is required but familiarity with the EMBL-EBI resources and applications would be advantageous. An undergraduate-level knowledge of biology would also be recommended.&nbsp;\r
\r
For attending Session 2, some familiarity with using the command-line, general bioinformatics and/or programming experience would be advantageous.&nbsp;\r
\r
As part of the application process, applicants will need to provide their attendance preferences for attending Session 1, Session 2 or both.&nbsp;\r
\r
&nbsp;""" ] ;
    schema1:description """The EMBL-EBI provides free access to a wide range of core bioinformatics sequence analysis applications via the web and via programmatic access.

This course is split into two main sessions running over two days. The first session focuses on learning about the bioinformatics applications provided and how to use them in conjunction with a range of biological databases. There will be a focus on sequence alignment (e.g. Clustal Omega and MAFFT) and sequence similarity search (NCBI BLAST+ and FASTA) tools.

The second session focuses on alternative approaches to accessing the tools beyond the website. We will explore the Tools APIs and various examples of how the tools can be accessed on the command-line and integrated into workflows.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-10-21 17:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 50 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2021-10-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Web Services" ;
    schema1:name "Introduction to the EMBL-EBI bioinformatics tools framework" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/introduction-embl-ebi-bioinformatics-tools-framework> .

<https://tess.elixir-europe.org/events/introduction-to-the-ensembl-bacteria-genome-browser> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """[Ensembl Bacteria](https://bacteria.ensembl.org/index.html) is a browser for bacterial and archaeal genomes. 

In this webinar, we will explore Ensembl Bacteria to learn more about the latest data and where it came from, view annotation of molecular interactions involving bacterial genes and comparative genomics data involving key bacterial species. 

You may either watch the entire presentation from the introduction or navigate directly to a specific section by clicking the links provided below:

- [Introduction](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=81b65897-703d-49cb-9a0b-b15c010519ca&amp;start=11.565362)
- [Why do we need genome browsers?](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=81b65897-703d-49cb-9a0b-b15c010519ca&amp;start=223.298999)
- [Ensembl Bacteria features](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=81b65897-703d-49cb-9a0b-b15c010519ca&amp;start=452.514514)
- [Tools in Ensembl Bacteria](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=81b65897-703d-49cb-9a0b-b15c010519ca&amp;start=634.839476)
- [Finding a bacterial species](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=81b65897-703d-49cb-9a0b-b15c010519ca&amp;start=1385.064278)
- [Help and documentation](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=81b65897-703d-49cb-9a0b-b15c010519ca&amp;start=2905.740104)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-04-24 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-04-24 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Ensembl" ;
    schema1:name "Introduction to the Ensembl Bacteria genome browser" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
