<https://tess.elixir-europe.org/events/advanced-python-for-biologists-2020> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:alternateName "This Advanced level workshop is ideal for researchers and technical workers with a background in biology and a basic knowledge of Python, to develop bigger or more complicated programs and increase skills and knowledge about the language, including object-oriented approaches to programming." ;
    schema1:contact "training@earlham.ac.uk" ;
    schema1:description """Python is a dynamic, readable language that is a popular platform for all types of bioinformatics work, from simple one-off scripts to large, complex software projects. This workshop is aimed at people who already have a basic knowledge of Python and are interested in using the language to tackle larger problems. In it, we will look in detail at the parts of the language which are particularly useful in scientific programming, and at the tools Python offers for making development faster and easier. The workshop will use examples and exercises drawn from various aspects of bioinformatics work.\r
\r
After completing the workshop, students should be in a position to;\r
\r
(1) take advantage of the advanced language features in their own programs, and;\r
\r
(2) use appropriate tools when developing software programs.\r
\r
\r
This event will be delivered virtually, in the following format:\r
\r
The programme will be delivered over ten days, from Monday 5 - Friday 16 October 2020, weekdays only.\r
On each day there will be 3.5 hours of live input (via Zoom) from the trainer (9:00-12:30 UK/GMT+1, including breaks).\r
Morning sessions will comprise:\r
Lectures/input\r
Practical exercises, with the trainer on hand to assist and offer 1-1 support.\r
Slack will be used to share important updates and for asking questions.\r
Lectures/input will be recorded and made available to participants as soon as possible that day for anyone who needs to catch up.""" ;
    schema1:endDate "2020-10-16 17:00:00 UTC"^^schema1:Date ;
    schema1:hostInstitution "Earlham Institute" ;
    schema1:keywords "Python",
        "Python for Biologists" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "United Kingdom" ;
                    schema1:addressRegion "Norfolk" ;
                    schema1:streetAddress "Earlham Institute (EI), Colney Lane" ] ;
            schema1:latitude "52.621741" ;
            schema1:longitude "1.218987" ] ;
    schema1:name "Advanced Python for Biologists 2020" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "Earlham Institute" ] ;
    schema1:startDate "2020-10-05 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.earlham.ac.uk/advanced-python-biologists-2020> .

