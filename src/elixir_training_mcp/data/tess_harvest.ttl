<https://tess.elixir-europe.org/events/zidas-2021> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "switZerland's Image and Data Analysis School 2021" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Life Science Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ] ;
    schema1:description """# ZIDAS 2021: switZerland’s Image and Data Analysis School\r
\r
- When: 27th September-1st October 2021\r
- Where: Online event\r
- **Application deadline: 2021-07-01 (23:59 CET)**\r
- Website: [https://2021.zidas.org](https://2021.zidas.org)\r
\r
## About the school:\r
This one-week school provides a hands-on introduction to image processing and analysis, with an emphasis on biologically relevant examples.\r
\r
## Lectures on\r
- Image Formation\r
- Denoising\r
- Segmentation\r
- Reproducibility &amp; Ethics\r
\r
## Hands-ons with\r
- ImageJ/Fiji Macros\r
- GoogleColab for Python notebooks\r
- ZeroCostDL4Mic\r
- Ilastik\r
\r
## Further tools and topics\r
- Each day will feature 3 parallel sessions with demos of the awesome tools developed by the BioImage Analysis community such as #QuPath, #CLIJ, #CellProfiler, #TrackMate, #FigureJ, #StarDist and more!\r
- This year will have a strong "work on your own project" component, so you can take advantage of all our great trainers to help you work with your own data!\r
\r
**_Find us at [https://2021.zidas.org](https://2021.zidas.org)_**""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-10-01 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "Center for Experimental and Clinical Imaging Technologies Zurich (EXCITE Zurich)" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ETHZ, EPFL" ] ;
            schema1:startDate "2021-09-27 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "bioinformatics",
        "image processing" ;
    schema1:name "ZIDAS 2021" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Switzerland" ;
            schema1:url <http://www.sib.swiss/training/> ],
        [ a schema1:Organization ;
            schema1:name "ETH Zurich" ],
        [ a schema1:Organization ;
            schema1:name "EPFL" ] ;
    schema1:url <https://2021.zidas.org/> .

<https://tess.elixir-europe.org/materials/01-introduction-to-r-and-bioconductor> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Martin Morgan" ] ;
    schema1:description """Bioconductor provides tools for the analysis and comprehension of high-throughput genomic data.
                    Bioconductor uses the R statistical programming language, and is open source and open development. 
                    It has two releases each year, 1560 software packages, and an active user community. 
                    Bioconductor is also available as an AMI (Amazon Machine Image) and a series of Docker images.""" ;
    schema1:keywords "Intro" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Bioconductor" ;
            schema1:url <https://bio.tools/bioconductor> ] ;
    schema1:name "01: Introduction to R and Bioconductor" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Bioconductor" ;
            schema1:url <https://www.bioconductor.org/help/course-materials/> ] ;
    schema1:url <https://bioconductor.org/help/course-materials/2019/BSS2019/01_IntroToRAndBioconductor.html> .

