<https://tess.elixir-europe.org/events/electronic-lab-notebook-introduction-9fa488c0-e5ad-4a8f-a754-ee14885c9e56> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This sessions will be online using Microsoft Teams. The instructions will be send by mail the day before the training.

This training is an introduction to the Electronic Lab Notebook (ELN) implemented at VIB. This training is intended for all new VIB coworkers (except administrative personnel) and will teach you the basic knowledge required to successfully document experiments in E-Notebook.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2022-03-30 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2022-03-30 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "Electronic Lab Notebook Introduction" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/electronic-lab-notebook-introduction-2> .

