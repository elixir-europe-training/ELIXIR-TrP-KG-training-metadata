<https://tess.elixir-europe.org/events/joint-de-nbi-nfdi4microbiota-training-course-on-metagenome-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Sebastian Jünemann, Nils Kleinboelting, Alexander Sczyrba (BiGi) Liren Huang, Kassian Kobert, Zhi-Luo Deng (NFDI4Microbiota)\r
\r
Date:\r
November the 7th to 9th, 2023\r
\r
Location:\r
Bielefeld University\r
\r
Contents:\r
The aim of this 3-day workshop will be to give students a brief overview of the tools and bioinformatics techniques available for the analysis of next generation sequence (NGS) data from microbial communities. The format will comprise a mixture of lectures and hands-on tutorials where students will process example data sets in real-time in the de.NBI cloud environment. A compact introduction into the Linux operating system and the usage of the command line interface will be given upstream to the introducing part to guarantee a consistent baseline for the following lectures. After covering general aspects of sequence based analysis (e.g. pre-processing, quality measurements, error handling) advantages and disadvantages of whole metagenome sequencing will be illustrated. As WGS metagenomics has the potential to address the full spectrum of genome-based issues, the focus here will be on assembly, binning and taxonomic and functional analysis with the aid of different bioinformatic tools. In the last part, nextflow workflows will be introduced to make use of nf-core workflows for automated and reproducible metagenomic analysis. \r
\r
Prerequisites:\r
This is a course for beginners. There are no prerequisites for the participants except some basic knowledge in microbiology, NGS data and NGS-based analysis.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-02-08 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Germany" ;
                            schema1:addressLocality "Bielefeld" ;
                            schema1:addressRegion "Detmold" ;
                            schema1:postalCode "33615" ;
                            schema1:streetAddress "Universität Bielefeld, 25 Universitätsstraße" ] ;
                    schema1:latitude "52.036724" ;
                    schema1:longitude "8.495241" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2024-02-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Joint de.NBI & NFDI4Microbiota Training Course on Metagenome Analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "de.NBI" ;
            schema1:url <https://www.denbi.de> ] ;
