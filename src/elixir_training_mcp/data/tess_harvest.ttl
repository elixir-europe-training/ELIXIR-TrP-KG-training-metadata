            schema1:latitude "52.078961" ;
            schema1:longitude "0.18684" ] ;
    schema1:name "Does it pay off to organise your data? How entrepreneurs leverage life science infrastructures and organise data to capture value." ;
    schema1:startDate "2019-11-05 15:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/data-impact-Nov19> .

