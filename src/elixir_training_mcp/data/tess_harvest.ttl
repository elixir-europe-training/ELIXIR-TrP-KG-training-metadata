<https://tess.elixir-europe.org/events/open-resources-for-sharing-integrating-and-benchmarking-software-tools-for-modelling-the-interactome-in-3d> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """ \r
\r
Programme\r
\r
\r
	Shoshana Wodak (VIB-VUB, ELIXIR-BE) :  A community-wide effort to improve annotations and organize information on macromolecular assemblies in the PDB.\r
	Emmanuel Levy (Weizmann Institute, ELIXIR-IL) &amp; Roland Dunbrack (FCCC, USA): Benchmark datasets of physiological and non-physiological protein assemblies, derived using the QSBio and ProtCID resources for structural information on protein assemblies.\r
	Hugo Schweke (Weizmann Institute, ELIXIR-IL) : Performance of classifiers &amp; scoring methods in discriminating between physiological and non-physiological protein interfaces: work in progress.\r
\r
\r
Each presentation will last around 15 minutes followed by questions. There will be an opportunity for a wider discussion at the end. \r
\r
This is the second of a series of 10 webinars organised by the ELIXIR 3D-BioInfo Community. The series will present the five major aims of the Community around protein structural annotations, protein complexes, protein ligand interactions, protein nucleic acid interactions and protein engineering. See the webinar series page for details.""" ;
    schema1:endDate "2021-09-21 16:00:00 UTC"^^schema1:Date ;
    schema1:name "Open resources for sharing, integrating and benchmarking software tools for modelling the Interactome in 3D" ;
    schema1:startDate "2021-09-21 15:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/open-resources-sharing-integrating-and-benchmarking-software-tools-modelling-interactome-3d> .

<https://tess.elixir-europe.org/events/open-science-and-dmp-in-estonia-qa-by-grant-office> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:description """On the 21st of February 2023, ELIXIR-Estonia will be organising an online data management course in English: Open Science and DMP in Estonia, which will be followed by a short QA by Estonian Research Council and Grant Office. This lecture is part of a bigger data management course package aimed at DMP writers and grant applicants.\r
\r
In the first part of the course, data librarian Tiiu Tarkpea will give an overview of the Open Science movement in Estonia. The objective of Open Science is to make research open, global, creative and cooperation-based by using modern e-infrastructures.  In the second part, Tiiu will introduce the DMPonline tool to create your Data Management Plan. DMPonline helps you to create, review, and share data management plans that meet institutional and funder requirements. In the third part, Grant Office will go over frequent problems when applying for grants and will answer some questions. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-02-21 16:30:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Estonia" ] ;
            schema1:startDate "2023-02-21 14:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "CONVERGE",
        "DMP",
        "Data management",
        "ELIXIR-CONVERGE",
        "Open science" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Open Science and DMP in Estonia + QA by Grant Office" ;
            schema1:url <https://doi.org/10.5281/zenodo.7684492> ] ;
    schema1:name "Open Science and DMP in Estonia + QA by Grant Office" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University of Tartu, Institute of Computer Science" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <http://elixir.ut.ee> ] ;
    schema1:teaches """* Understands what is Open Science\r
* Knows Open Science principles and why they are important\r
* Knows how to use DMPonline\r
* Knows where to get more information about the grant application process\r
""" ;
    schema1:url <https://elixir.ut.ee/node/468> .

