            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Learn to use Panoply in Galaxy to visuallize EBV cube netCDF geo-referenced data
- Learn how Panoply plots are exported to Galaxy""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/panoply_ebv/tutorial.html> ;
    schema1:version "9" .

