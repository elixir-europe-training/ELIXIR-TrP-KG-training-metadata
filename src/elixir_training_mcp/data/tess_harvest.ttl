<https://tess.elixir-europe.org/events/ready-for-biodata-management-introduction-to-data-management-plans-online-0874a4c4-e65e-403b-9fd3-2617954125aa> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Master students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Life Science Researchers" ],
        [ a schema1:Audience ;
