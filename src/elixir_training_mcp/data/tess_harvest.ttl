            schema1:endDate "2025-03-05 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2025-03-05 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "AI",
        "AI in bioinformatics" ;
    schema1:name "Developing a dataset for LLM projects" ;
