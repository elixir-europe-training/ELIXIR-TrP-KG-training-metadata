<https://tess.elixir-europe.org/events/impact-of-alphafold-on-training-and-research-in-life-sciences> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0082>,
        <http://edamontology.org/topic_2814> ;
    schema1:description """AlphaFold is an AI system developed by DeepMind that predicts protein 3D structure from its amino-acid sequence. It’s been a year since the AlphaFold software and ‘AlphaFold Protein Structure Database’ were made publicly available for users to explore and investigate their protein of interest.

We are running a webinar series to mark this occasion by highlighting the impact of AlphaFold on training and research in life sciences. The webinars making up this series are listed below. Follow the links to find out more about each webinar. You will need to register for each webinar you would like to attend. Recordings will be made openly available of all webinars on their individual pages.  """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2022-06-28 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2022-06-14 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "AI",
        "Artificial intelligence",
        "Proteins (proteins)" ;
    schema1:name "Impact of AlphaFold on training and research in life sciences" ;
    schema1:provider [ a schema1:Organization ;
