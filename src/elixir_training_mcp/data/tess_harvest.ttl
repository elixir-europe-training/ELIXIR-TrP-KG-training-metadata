            schema1:name "VIB Bioinformatics Core" ] ;
    schema1:startDate "2020-02-17 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://training.vib.be/product/129> .

<https://tess.elixir-europe.org/events/hands-on-introduction-to-chip-seq-and-atac-seq-analysis-159e854e-a8d9-4dcf-b734-8e2fe07147c6> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This training gives an introduction to ChIP-seq and ATAC-seq data analysis, covering the processing steps starting from the reads to the peaks. Among all possible downstream analyses, the practical aspect will focus on motif analyses. A particular emphasis will be put on deciding which downstream analyses to perform depending on the biological question." ;
