<https://tess.elixir-europe.org/events/clinic-managing-your-agenda> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "An online clinic-training session, spanning two hours, is designed to enhance personal time management skills using agenda and various planning systems. The session focuses on practical strategies for effective scheduling, prioritizing tasks, and maintaining a balance between professional and personal life. Participants will learn to utilize their agenda more efficiently, explore different personal planning systems, and adapt these tools to their individual needs. Interactive exercises will help attendees apply these concepts in real-time. This clinic is ideal for individuals looking to improve their time management skills to boost productivity and achieve a better work-life balance." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-03-20 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-03-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "personal effectiveness",
        "time management" ;
    schema1:name "Clinic Managing Your Agenda" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/clinic-managing-your-agenda> .

