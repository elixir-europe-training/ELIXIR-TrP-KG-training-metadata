<https://tess.elixir-europe.org/events/crispr-cas9-tool-from-gene-function> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description "Today´s powerful new tools enable researchers to construct novel experiments in a wide range of fields—from basic biomedical research to biotechnology and medicine—allowing them to edit genomes at sites of their choosing.  Using most recent technologies in genome engineering, it is now possible to create knock-in, knock-outs and mutations of any gene in any cell line or organism with high efficiency. This approach allows the perturbation of biological systems at the genomic as well as the proteomic level. In silico analysis provides a good approximation of molecular structure in relation to function, and is always used to predict and enhance the success of genome editing technologies. The combination of these approaches is often used in gene therapy as well as in synthetic biology applications." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2016-06-27 00:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Spain" ;
                            schema1:addressLocality "Barcelona" ;
                            schema1:streetAddress "Centre for Genomic Regulation" ] ;
                    schema1:latitude "41.385064" ;
                    schema1:longitude "2.173404" ] ;
            schema1:startDate "2016-06-27 00:00:00 UTC"^^schema1:Date ] ;
    schema1:name "CRISPR-CAS9 TOOL:From Gene Function" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "iAnn" ;
            schema1:url <http://iann.pro> ] ;
    schema1:url <http://www.crg.eu/en/event/coursescrg-crispr-cas9-tool-gene-function> .

<https://tess.elixir-europe.org/events/crispr-in-action-practice-and-theory-of-genome-engineering> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This intensive 5-day course provides a comprehensive introduction to CRISPR, covering both theoretical foundations and wet-lab experimental techniques. At the same time, you will have the unique opportunity to participate in lab sessions, where you'll receive practical guidance on experimental procedures, tips, and tricks. In addition, you'll have ample opportunities to learn and discuss the theory behind CRISPR technology. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-08-22 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3001" ;
                            schema1:streetAddress "Heverlee - Landbouwinstituut, Kasteelpark Arenberg 20" ] ;
                    schema1:latitude "50.879202" ;
                    schema1:longitude "4.701168" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-08-18 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "hands-on",
        "omics" ;
    schema1:name "CRISPR in action: practice and theory of genome engineering" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Compose and clone strategies for CRISPR vector construction”",
        "“Design principles efficiency predictions indel outcome analysis and off-target assessments in gRNA design”",
        "“Edite genome and analyze genotyping using Sanger sequencing and global editing efficacy assessments”",
        "“Evaluate editing efficiency and survival concerning gRNA design parameters data analysis in R”",
        "“Optimize templates for precise edits in HDR donor design “" ;
    schema1:url <https://training.vib.be/all-trainings/crispr-action-practice-and-theory-genome-engineering> .

<https://tess.elixir-europe.org/events/cross-cultural-effectiveness> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """After an introduction on explicit culture, the workshop focuses on the importance of meaning behind cultural behavior and norms using a model of different cultural dilemmas. These are the universal social dilemmas that cultures around the world have solved in different ways and consequently result in many different cultural values. This workshop is an introduction to cultural differences in a business environment.

 """ ;
