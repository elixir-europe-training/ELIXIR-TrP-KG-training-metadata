                            schema1:postalCode "9000" ;
                            schema1:streetAddress "Ghent - Communicatiecampus - MeetingCenteR4, Sint-Denijslaan 487" ] ;
                    schema1:latitude "51.009698" ;
                    schema1:longitude "3.701324" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2020-03-10 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "Leadership workshop: Situational leadership" ;
    schema1:provider [ a schema1:Organization ;
