            schema1:endDate "2020-06-05 17:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-06-01 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Starting single cell RNA-seq analysis" ;
