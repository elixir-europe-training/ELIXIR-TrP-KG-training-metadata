<https://tess.elixir-europe.org/materials/quantification-of-electrophoresis-gel-bands-using-qupath-and-galaxy-imaging-tools> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3382> ;
