<https://tess.elixir-europe.org/events/train-the-trainer-f41d2c9f-dae6-4896-abf4-b4a9b6de7c8e> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This training equips early-career educators and researchers — particularly those in bioinformatics and life sciences — with essential skills to design and deliver practical, engaging training sessions. Aimed at first-time trainers, postdocs, and academic staff involved in teaching, the course introduces evidence-based learning principles andpractical strategies for planning, facilitating, and evaluating training. Participants will explore how to foster learner engagement, structure content for clarity, and provide meaningful feedback. Rooted in the ELIXIR-GOBLET Train-the-Trainer framework, the course also addresses common challenges in academic teaching environments, offering real-world examples and peer discussion. While developed for bioinformatics, the training is broadly applicable across disciplines in higher education." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-09-04 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Belgium" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-09-03 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "Didactics",
        "ELIXIR",
        "Train-the-trainer",
        "career development" ;
    schema1:name "Train the trainer" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "Define and write learning outcomes for a training session",
        "Describe at least three training techniques drawing on learning principles",
        "Develop assessment questionnaires",
        "Discuss the impact of learning about learning principles as a trainer",
        "Draft a training syllabus and lesson plan",
        "List and describe key features of learning principles",
        "List based on the training plan what types of material are needed for each part of a training session" ;
    schema1:url <https://training.vib.be/all-trainings/train-trainer-0> .

<https://tess.elixir-europe.org/events/train-the-trainer-integration-of-the-sex-and-gender-dimension-in-life-sciences-research> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Training Coordinators" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training Organisers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training Designers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Trainers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training instructors" ] ;
    schema1:coursePrerequisites "No prerequisites" ;
    schema1:description """The inclusion of the sex and gender dimension in life sciences is increasingly promoted by the European Union to rethink standards and reference models for sex and gender representation in research projects. Thus, training biomedical researchers in this topic will increase their capacity to integrate the sex and gender dimension into their work, leading to more inclusive and impactful science.\r
\r
**This train-the-trainers course aims at developing participants’ skills on how to introduce the sex and gender dimension into their training related to the life sciences.**\r
\r
To guide participants in this endeavour, a set of methodological tools and case studies  created by a group of experts in the field will be provided to illustrate a successful sex and gender integration into key Research and Innovation areas.\r
\r
This training is delivered by experts on the matter:\r
- Davide Cirillo, Principal Investigator, Life Sciences Department, Machine Learning for Biomedical Research, BSC\r
- Mónica Cano Abadía, Senior Scientist, ELSI Services and Research, BBMRI-ERIC\r
- Àtia Cortés, Recognised Researcher, Life Sciences Department, Social Link Analytics, BSC\r
\r
**Audience and number of participants**\r
The course targets training coordinators, training organisers and trainers willing to introduce the sex and gender dimension in their training portfolio, and researchers with an interest in the topic and prospects of organising training about the topic.\r
Due to limited space, the course can accommodate a maximum of 15 participants.\r
\r
**Schedule**\r
The training takes place on the afternoon of Wednesday, June 28, 2023 from 14h to 18h and Thursday, June 29, 2023 from 9h to 13h. Coffee breaks and the course dinner will be catered by the course organisers.\r
\r
Training material and details will be shared with participants in advance.\r
\r
A follow-up online session will be organised 3 months after the training to get continuous feedback and provide updates on individual training progress on the topic of the inclusion of the sex and gender dimension in research. \r
\r
**Registration**\r
Registration is on a first-come, first-served basis. Due to the limited space, organisers reserve their right to oversee the number of participants from the same RI/institution to ensure that as many RI/institutions as possible can benefit from the training and leverage the training materials within their institutions and beyond.\r
\r
A waiting list will be set once the capacity limit has been reached. If you registered and can not finally attend, please contact the organisers to free your seat.\r
\r
**Logistics**\r
The course is free of charge. Participants are expected to cover their own accommodation and travel expenses.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-06-29 13:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "EOSC-Life" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Spain" ;
                            schema1:addressLocality "Barcelona" ;
                            schema1:streetAddress "Barcelona Supercomputing Center (BSC)" ] ] ;
            schema1:maximumAttendeeCapacity 15 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name " Bioinfo4Women programme of the Life Sciences Department at the Barcelona Supercomputing Center (BSC), BBMRI-ERIC, INB/ELIXIR-ES, EATRIS." ] ;
            schema1:startDate "2023-06-28 14:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "EDI",
        "design research",
        "dimension",
        "equity",
        "gender",
        "inclusion",
        "sex",
        "train-the-trainer" ;
    schema1:name "Train-the-Trainer | Integration of the sex and gender dimension in life sciences research" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Bioinfo4Women" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Spain" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "Barcelona Supercomputing Center (BSC)" ;
            schema1:url <http://www.bsc.es> ],
        [ a schema1:Organization ;
            schema1:name "INB/ELIXIR-ES" ] ;
    schema1:teaches """- LO1: Understand the appropriate applications of the terms “sex” and “gender” in biomedical research in training actions\r
- LO2: Identify, understand, and think critically about different perspectives on the complexity of sex and gender dimension in biomedical research and how to communicate them in training activities. \r
- LO3: Identify how the categories of sex and gender affect the life sciences and training in this domain, in particular regarding the generation, collection and utilisation of data in research. \r
- LO4: Select, compile, and synthesise information on the inclusion of the sex and gender dimension in research and integrate it into their training portfolio. """ ;
    schema1:url <https://www.eosc-life.eu/news/how-to-integrate-the-sex-and-gender-dimension-in-life-sciences-research/> .

<https://tess.elixir-europe.org/events/train-the-trainer-online-course-for-bioinformatics-trainers> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Would you like to become a bioinformatics trainer or a better one? If so, this ELIXIR / GOBLET online course is for you! The course takes place 14.-17.12.2021 at 8:00-11:30 CET every day (9:00-12:30 Helsinki time).The course is organized around four sessions, covering:Learning principles and how they apply to training and teachingLesson, course, and materials designTeaching techniques that can be used to enhance learner engagement and participationAssessment and feedback in training and teachingExamples and discussions will also focus on the challenges presented by academic teaching.If you have questions like the following ones, this course may be very helpful to you.How learning works?How can I use learning principles to improve my teaching?How can I make my teaching more engaging and effective?How should I adjust my teaching to different types of learners?How can I help slow learners?How can I assess whether my students are actually understanding my lessons? Are they actually learning?What is the best balance between theory and practice?How can I best assess whether learning is occurring and/or has occurred?What works in a classroom and what doesn’t?This course is taught byPatricia Palagi (SIB, ELIXIR Switzerland)Jessica Lindvall (NBIS, ELIXIR Sweden)Allegra Via (IBPM, ELIXIR Italy)Fotis E. Psomopoulos (CERTH, ELIXIR Greece)Ana Melo (BioData.pt, ELIXIR Portugal)" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
