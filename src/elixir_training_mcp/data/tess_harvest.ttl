<https://tess.elixir-europe.org/events/study-intercellular-communication-with-nichenet> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Today it is possible to obtain genome-wide transcriptome data from single cells using high-throughput sequencing (scRNA-seq). These scRNA-seq datasets can provide information about which cell types are present within a tissue, and about how they may potentially interact with each other.  However, deciphering cell-cell communication from these datasets requires dedicated computational methods, such as NicheNet." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
