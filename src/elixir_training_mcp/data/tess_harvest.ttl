<https://tess.elixir-europe.org/events/basic-statistics-in-graphpad-prism-9> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """The following topics will be covered:\r
\r
\r
	How to use Prism 9 for simple statistical analyses: t tests, one-way ANOVA and non-parametric counterparts\r
	How to use Prism 9 for more advanced statistical analyses: two-way ANOVA \r
	How to use Prism 9 to create graphs\r
	Regression in Prism 9\r
	Survival analysis in Prism 9\r
\r
\r
Additional topics will be added depending on the needs of the participants. Participants can analyze their own data on the training.""" ;
    schema1:endDate "2021-06-28 00:00:00 UTC"^^schema1:Date ;
    schema1:name "Basic statistics in GraphPad Prism 9" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "VIB Bioinformatics Core" ] ;
    schema1:startDate "2021-06-21 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://training.vib.be/product/343> .

<https://tess.elixir-europe.org/events/basic-statistics-in-graphpad-prism-9-61583052-0200-4150-b110-007ee4a9f6fc> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This course consists of videos, 1 live session and 1 Q&amp;A session. 

___________________________________________________________________________________________________________________________________________

The course will consist of:


	a theoretical session to explain the statistics behind Prism 9
	videos and a live demo session to show you how to do statistics in Prism 9
	two Q&amp;A sessions where your questions will be answered and where you apply this knowledge on your own data or on real-life example data""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2021-06-28 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2021-06-21 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "software",
        "statistics" ;
    schema1:name "Basic statistics in GraphPad Prism 9" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/basic-statistics-graphpad-prism-9> .

