<https://tess.elixir-europe.org/materials/federated-ega-introductory-videos> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "researchers" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Francesca Morello" ],
        [ a schema1:Person ;
            schema1:name "Siiri Fuchs" ],
        [ a schema1:Person ;
            schema1:name "Heikki Lehväslaiho" ],
        [ a schema1:Person ;
            schema1:name "Laura Kalliokoski" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Tiitu Peltola" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2023-05-25"^^schema1:Date ;
    schema1:datePublished "2023-05-25"^^schema1:Date ;
    schema1:description """This tutorial video series includes three short videos about Federated EGA metadata and phenotypic data as well as one interview.\r
\r
The titles of the videos are the following:\r
\r
1. FEGA - Introduction to metadata\r
2. FEGA - Introduction to phenotypic data\r
3. Phenotypic metadata: the COVID-19 example\r
4. Building a metadata model for COVID-19: Interview with Anna Bernasconi\r
\r
The first video introduces metadata in the Federated European Genome-phenome Archive (FEGA). And it also discusses metadata standards, schemas, and data dictionaries.\r
The second video introduces what phenotype data is and explains common challenges in collecting and using phenotype data.\r
The third video discusses the importance of standardized metadata. It also presents a phenotype data model based on the COVID-19 Host Genetics Initiative (HGI) project.\r
The last video is an interview with data management expert Anna Bernasconi about the challenges of creating a metadata model for COVID-19.\r
\r
CSC Federated EGA User Guide: https://docs.csc.fi/data/sensitive-data/federatedega/﻿""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "ELIXIR-CONVERGE",
        "FEGA",
        "Federated EGA",
        "Phenotype",
        "SARS-CoV-2",
        "metadata" ;
    schema1:learningResourceType " Series of videos",
        "Tutorial",
        "Video" ;
    schema1:license <https://spdx.org/licenses/CC-BY-ND-4.0.html> ;
    schema1:name "Federated EGA: Introductory videos" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "CSC - IT Center for Science" ;
            schema1:url <https://www.csc.fi> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Finland" ;
            schema1:url <https://www.csc.fi/web/training> ] ;
    schema1:url <https://video.csc.fi/playlist/details/0_ip0b3jbh> ;
    schema1:version "1" .

<https://tess.elixir-europe.org/materials/fega-metadata-technical-deep-dive> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Marcos Casado Barbero (0000-0002-7747-6256)" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2025-03-04"^^schema1:Date ;
    schema1:datePublished "2025-03-04"^^schema1:Date ;
    schema1:description "This technical deep-dive workshop introduces participants to the Federated European Genome-Phenome Archive (FEGA) metadata model, focusing on hands-on exercises in metadata validation and JSON-LD transformations. Attendees learn how to set up and use Biovalidator to ensure the structural and semantic correctness of metadata, explore the design of FEGA’s JSON Schemas, and practice transforming JSON-LD into different formats. These sessions are intended for bioinformaticians, curators, and developers who want to improve metadata quality and interoperability in genomic data sharing." ;
    schema1:educationalLevel "intermediate" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.14968151" ;
    schema1:keywords "Biovalidator",
        "EGA",
        "FAIR principles",
        "FEGA",
        "Federated EGA",
        "GitHub",
        "JSON Schemas",
        "JSON-LD",
        "Metadata",
        "Metadata validation",
        "json",
        "linked data" ;
    schema1:learningResourceType "Presentation",
        "Workshop",
        "hands-on tutorial" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "biovalidator" ;
            schema1:url <https://bio.tools/tool/biovalidator> ],
        [ a schema1:Thing ;
            schema1:name "The European Genome-phenome Archive" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.mya1ff> ] ;
    schema1:name "FEGA Metadata Technical Deep Dive" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:teaches "Learn to: (1) install and use Biovalidator; (2) handle JSON Schemas; (3) JSON-LD transformations" ;
    schema1:url <https://doi.org/10.5281/zenodo.14968151> .

