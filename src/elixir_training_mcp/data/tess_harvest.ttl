<https://tess.elixir-europe.org/events/a-guide-to-accessing-chembl-and-unichem-through-an-api> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_0846>,
        <http://edamontology.org/format_2030> ;
    schema1:description """ChEMBL is a database of bioactivity data that links drug-like compounds to their biological targets. UniChem is a database that produces cross-references between chemical structure identifiers from different databases. Both ChEMBL and UniChem can be accessed through an interactive interface as well as programmatically via web services. 

This webinar will provide an overview of programmatic strategies that can be used to extract data from ChEMBL and UniChem alongside examples to illustrate the applications.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
