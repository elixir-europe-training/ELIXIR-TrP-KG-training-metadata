<https://tess.elixir-europe.org/events/gentle-hands-on-introduction-to-python-programming-cd7086cc-b252-4895-a579-19f77c24e8cf> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This is a self-paced course that gently introduces programming to new programmers over a 6 week period. There are plenty of opportunities to practice what you learn and ask questions in a safe place. Furthermore, surprise yourself by building a substantial project.

Each week there are some OPTIONAL online interactive “lab” sessions for Q&amp;A and problem solving. The 5 lab sessions will be live, but more may be scheduled with our trainers at different times or in-person depending on your needs.

Contact Bruna Piereck or James Collier if you have any questions regarding the course, see e-mails below.
 


 

You will receive an email before the course opens, this email will contain all the information you need to begin the course.

Important: You are required to follow at least 75% of this self-paced course in order to receive your certificate of successful completion.

 


 

08/May release to 12/Jun (online meetings)

 


 """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-06-19 17:00:00 UTC"^^schema1:Date ;
