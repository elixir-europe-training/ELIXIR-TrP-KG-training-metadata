- Join a training""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/admin/tutorials/tiaas/tutorial.html> ;
    schema1:version "40" .

<https://tess.elixir-europe.org/materials/hands-on-for-training-infrastructure-as-a-service-tutorial> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Instructors" ] ;
