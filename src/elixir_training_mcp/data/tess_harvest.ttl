<https://tess.elixir-europe.org/events/strain-resolved-approaches-for-human-microbiome-studies> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3174>,
        <http://edamontology.org/topic_3301>,
        <http://edamontology.org/topic_3697>,
        <http://edamontology.org/topic_3837> ;
    schema1:description """In the last few years, the human microbiome has received great attention by the community due to its fundamental role in health and disease. Advancements in the field have also been possible due to technological improvements in (shotgun) metagenomics, including the development and application of computational approaches.

This webinar will introduce metagenomics for characterisation of the human microbiome with focus on computational tools to achieve strain-level resolution. This will comprise pipelines for generation of profiles as well as extraction of draft genomes. It will also present some recent analyses aiming at conducting large-scale scenario investigations, including the use of machine learning approaches and the integration of human microbiomes with other sources.

You may either watch the entire presentation from the introduction or navigate directly to a specific section by clicking the links provided below:

- [Introduction](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=7d579426-f8d5-430c-be80-b132011b125e&amp;start=11.832159)

- [How can we study the microbiome?](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=7d579426-f8d5-430c-be80-b132011b125e&amp;start=210.876999)

- [The shotgun metagenomics workflow](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=7d579426-f8d5-430c-be80-b132011b125e&amp;start=345.877)

- [Microbiome and colorectal cancer (CRC)](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=7d579426-f8d5-430c-be80-b132011b125e&amp;start=789.877)

- [Strain-resolved metagenomics](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=7d579426-f8d5-430c-be80-b132011b125e&amp;start=1338.877)

- [Toward full mappability of the human microbiome](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=7d579426-f8d5-430c-be80-b132011b125e&amp;start=1866.877)

- [The curated Food Metagenomic Data resource](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=7d579426-f8d5-430c-be80-b132011b125e&amp;start=2177)

- [Q&amp;A](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=7d579426-f8d5-430c-be80-b132011b125e&amp;start=2246.45978)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-03-13 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-03-13 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Microbial ecosystems webinar" ;
    schema1:name "Strain-resolved approaches for human microbiome studies" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/strain-resolved-approaches-human-microbiome-studies> .

