<https://tess.elixir-europe.org/events/elixir-excelerate-goblet-workshop-on-e-learning> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This joint EXCELERATE -GOBLET workshop will focus on the design and production of the e-learning materials. The workshop aimes at participants interested in learning more about modern methods and technologies in e-learning. Both beginners and more advanced users are invited to participate.\r
\r
The event will start by introducing general concepts and then continue to a step-by-step description of all major components of an e-learning course. There will be a mix of lectures and practical exercises. At the end of the workshop, participants will have learnt best e-learning practices  and will be able to create an e-learning course on their own.\r
\r
The Workshop is taking place as a satellite event to the GOBLET AGM meeting on 22-24 November 2017 in Oeiras, Portugal, and is organised jointly by ELIXIR Slovenia and ELIXIR Portugal.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2017-11-21 09:30:00 UTC"^^schema1:Date ;
