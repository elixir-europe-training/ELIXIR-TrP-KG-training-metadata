<https://tess.elixir-europe.org/events/embo-practical-course-research-to-service-planning-and-running-a-bioinformatics-core-facility> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Ezgi Karaca" ;
    schema1:description "This EMBO Practical Course will provide an opportunity for aspiring new managers of core facilities, especially those with one foot in the research camp, to learn from experienced core facilities managers how to build a framework for the future development, resourcing, operation and impact assessment of their core services." ;
    schema1:endDate "2019-04-12 13:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Turkey" ;
                    schema1:addressLocality "Balcova" ;
                    schema1:postalCode "35340" ;
                    schema1:streetAddress "Izmir Biomedicine and Genome Center (IBG), Dokuz Eylul University Health Campus" ] ] ;
    schema1:name "EMBO Practical Course: Research to service - Planning and running a bioinformatics core facility" ;
    schema1:startDate "2019-04-08 12:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2019/embo-practical-course-research-service-planning-and-running-bioinformatics-core-facility> .

<https://tess.elixir-europe.org/events/embo-practical-course-research-to-service-planning-and-running-a-bioinformatics-core-facility-62ea6744-3a2b-4478-886d-69be519d5e25> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Core Facility Managers" ] ;
    schema1:description """Computational core facilities play a vital role in enabling molecular life science, and the number of such facilities has grown considerably. There are many relatively inexperienced managers of core facilities, who often have to juggle their own research projects with the development and operation of services. This can be exceptionally challenging, not least because scientific impact tends only to be recognised and rewarded for research.\r
\r
The "EMBO Practical Course | Research to Service: Planning and Running a Bioinformatics Core Facility" is aimed at newly appointed managers of bioinformatics core facilities, especially those with one foot in the research camp, or those managers willing to stabilize and grow their services. The training set will provide an opportunity to learn from experienced core facilities managers on how to build a framework for the future development, resourcing, operation and impact assessment of your core services.\r
\r
By the end of the course, participants will have learned how to:\r
*Identify the strengths and limitations of their core facility and prioritise areas for improvement\r
*Design bioinformatics services and training using a user-centred approach and assuring best practices\r
*Estimate the computing and human resources required to operate their facility effectively\r
*Support users to manage their data, including sensitive data""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-10-08 14:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Barcelona Supercomputing Center (BSC), EMBL-European Bioinformatics Institute (EMBL-EBI), Izmir Biomedicine and Genome Center (IBG), INCLIVA Health Research Institute, Spanish National Bioinformatics Institute (INB/ELIXIR-ES)" ] ;
            schema1:startDate "2021-10-04 12:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "computing resources",
        "data management",
        "managing skills",
        "service design",
        "storage needs",
        "sustainability" ;
    schema1:name " EMBO Practical Course - Research to service: Planning and running a bioinformatics core facility" ;
    schema1:provider [ a schema1:Organization ;
