                    schema1:name "Genotoul-bioinfo (http://bioinfo.genotoul.fr/), Genotoul-biostat (https://perso.math.univ-toulouse.fr/biostat/), MIAT (https://miat.inrae.fr/site/Accueil)" ] ;
            schema1:startDate "2024-05-14 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "RNASEQ ALIGNMENT, QUANTIFICATION AND TRANSCRIPT DISCOVERY WITH STATISTICS - session 14 - 17 /05/2024" ;
