<https://tess.elixir-europe.org/events/4th-czech-national-conference-enbik2018> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_2258> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
