                            schema1:streetAddress "Faculty of Pharmacy, Complutense University of Madrid, Spain" ] ;
                    schema1:latitude "40.416705" ;
                    schema1:longitude "-3.703583" ] ;
            schema1:maximumAttendeeCapacity 20 ;
