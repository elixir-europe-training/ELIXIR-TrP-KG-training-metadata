                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Netherlands" ;
                            schema1:addressLocality "Utrecht" ;
                            schema1:addressRegion "Utrecht" ;
                            schema1:streetAddress "The Hyve, 650, Arthur van Schendelstraat" ] ;
                    schema1:latitude "52.08234" ;
                    schema1:longitude "5.117529" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Postoia Alliance" ] ;
            schema1:startDate "2018-06-05 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "FAIR" ;
