- Understand the role of HLA genotyping in predicting personalized immune responses.
- Use specific tools for processing sequence data to predict HLA-binding peptides.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/neoantigen-predicting-hla-binding/tutorial.html> ;
    schema1:version "2" .

<https://tess.elixir-europe.org/materials/neoantigen-7-iedb-binding-pepquery-validated-neopeptides> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0121> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:author [ a schema1:Person ;
