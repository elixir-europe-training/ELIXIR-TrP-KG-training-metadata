                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Roscoff" ] ;
                    schema1:latitude "48.725582" ;
                    schema1:longitude "-3.982898" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "IFB (https://www.france-bioinformatique.fr/)" ] ;
            schema1:startDate "2022-01-09 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "4th Workshop Single-Cell / SincellTE 2022 / Single-Cell : Transcriptomics, Spatial and Multi-Omics" ;
    schema1:provider [ a schema1:Organization ;
