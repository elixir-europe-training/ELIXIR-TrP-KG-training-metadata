<https://tess.elixir-europe.org/events/python-algajatele> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0605> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Beginner" ] ;
    schema1:description """“Python algajatele” kursus tutvustab Pythoni programmeerimist, mis on mõeldud neile, kellel on vähe või puudub varasem kogemus. Kursuse lõpus on õpilastel kindel arusaam Pythoni põhitõdedest ja saavad alustada oma teekonda Pythoni programmeerimises.\r
\r
Python on üldotstarbeline programmeerimiskeel. Pythoni peamised eelised:\r
* Avatud lähtekoodiga tarkvara, mida toetab Python Software Foundation\r
* Saadaval kõigil peamistel platvormidel (Windows, macOS, Linux).\r
* See keel on suurepärane valik algajatele programmeerijatele, tänu oma lihtsale ja objektorienteeritud stiilile.\r
* Selle hästi struktureeritud olemus aitab kaasa koodi paremale loetavusele.\r
* See programmeerimiskeel on laiendatav ehk modifitseeritav ning selle kasutamist toetab suur kogukond, mis pakub laia valikut kolmandate osapoolte poolt loodud pakette.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-02-23 13:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Estonia" ;
                            schema1:addressLocality "Tallinn" ;
                            schema1:postalCode "10120" ;
                            schema1:streetAddress "Tallinn University, 25 Narva maantee" ] ;
                    schema1:latitude "59.438732" ;
                    schema1:longitude "24.771384" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Estonia" ] ;
            schema1:startDate "2024-02-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Programming",
        "Python",
        "Workshop" ;
    schema1:name "Python algajatele" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <http://elixir.ut.ee> ],
        [ a schema1:Organization ;
            schema1:name "University of Tartu, Institute of Computer Science" ] ;
    schema1:teaches """* Mõista Pythoni muutujaid, põhilisi andmetüüpe ja operaatoreid.\r
* Õppida Pythonis programmide voo juhtimist kasutades tsükleid, tingimusi ja funktsioone.\r
* Õppida tundma ja manipuleerima Pythoni sisseehitatud andmestruktuure nagu järjendid, ennikud, hulgad ja sõnastikud.\r
* Mõista, kuidas Pythonis lugeda, kirjutada ja manipuleerida faile, käsitleda erandeid ning õppida objektorienteeritud programmeerimise põhimõtteid.""" ;
    schema1:url <https://elixir.ut.ee/news/2024/02/01/Python_algajatele/> .

