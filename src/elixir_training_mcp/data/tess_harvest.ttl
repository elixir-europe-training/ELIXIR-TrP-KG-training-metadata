    schema1:name "Python introduction light course" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Make comparisons in Python and conditional statements”",
        "“Python data types: tuples lists dictionaries”",
        "“Set up a conda environment and using conda to install packages (as is done in the spatial data analysis courses)”",
        "“Use Jupyter notebooks (as is done in the advanced courses)”",
