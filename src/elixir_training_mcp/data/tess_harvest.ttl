            schema1:startDate "2019-08-29 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Training (Training)" ;
    schema1:name "CABANA Train the Trainer in Belém, Brazil" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
