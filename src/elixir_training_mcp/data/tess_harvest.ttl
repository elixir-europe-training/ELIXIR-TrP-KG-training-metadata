    schema1:keywords "ChatGPT",
        "Claude",
        "Gemini",
        "LLM",
        "NotebookLM",
        "Perplexity",
        "prompt engineering",
        "prompting" ;
    schema1:learningResourceType "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Prompting 101 - A Beginner's Guide to Communicating with LLMs" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <http://elixir.ut.ee> ] ;
    schema1:teaches """* Write clear and concise prompts\r
* Give context within prompts to improve response accuracy\r
* Apply meta-prompting\r
* Give examples of LLM use cases in every day life\r
* Explain limitations and pitfalls of chatbots""" ;
