<https://tess.elixir-europe.org/events/unu-biolac-and-cabana-latin-american-workshop-in-structural-bioinformatics-of-proteins> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Rodrigo Ochoa" ;
    schema1:description "This workshop will provide training on well-established resources to analyze protein structures using computational tools." ;
    schema1:endDate "2019-09-27 17:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Colombia" ;
                    schema1:addressLocality "Medellin" ;
                    schema1:streetAddress "University EAFIT, Carrera 49, número 7 sur 50" ] ;
            schema1:latitude "6.244338" ;
            schema1:longitude "-75.573553" ] ;
    schema1:name "UNU-BIOLAC and CABANA: Latin American Workshop in Structural Bioinformatics of Proteins" ;
    schema1:startDate "2019-09-23 09:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2019/unu-biolac-and-cabana-latin-american-workshop-structural-bioinformatics-proteins> .

<https://tess.elixir-europe.org/events/unu-biolac-and-cabana-latin-american-workshop-in-structural-bioinformatics-of-proteins-efe22124-d585-4d64-adc7-21574ce76461> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_1317> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType """This workshop is suitable for academics of Latin American and Caribbean countries. Early career researchers, including graduate students, postdocs and professors working, or planning to start working in Structural Bioinformatics, are warmly encouraged to apply. Knowledge about molecular biology is required, as well as familiarity with basic bioinformatics concepts and undergraduate-level knowledge of protein structures. We expect to have around 20-25 participants from Colombia and other Latin American and Caribbean countries.&nbsp;\r
&nbsp;\r
\r
Please note this workshop will be delivered in English, however some of our trainers are fluent Spanish speakers and can offer support where needed.""" ] ;
    schema1:description "This workshop will provide training on well-established resources to analyze protein structures using computational tools. The topics will involve the use of bioinformatics tools and databases, as well as background information on simulations using protein structures. The workshop will be instructed by trainers from the Protein Data Bank in Europe (PDBe), from CINVESTAV Unit for Advanced Genomics (LANGEBIO) in Mexico, as well as local expert researchers from the Max Planck Tandem Group of Biophysics of Tropical Diseases in Colombia working on protein simulations. [Some of the examples used during the sessions will fall under the UN's sustainable development goal of communicable diseases prevention and treatment](https://www.who.int/topics/sustainable-development-goals/targets/en/)." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-09-27 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Colombia" ;
                            schema1:addressRegion "Medellin" ;
                            schema1:streetAddress "University EAFIT, Carrera 49, número 7 sur 50" ] ;
                    schema1:latitude "6.244338" ;
                    schema1:longitude "-75.573553" ] ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-09-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Proteins (proteins)",
        "Structures (structures)" ;
    schema1:name "UNU-BIOLAC and CABANA: Latin American Workshop in Structural Bioinformatics of Proteins" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University EAFIT" ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/unu-biolac-and-cabana-latin-american-workshop-structural-bioinformatics-proteins> .

<https://tess.elixir-europe.org/events/upskilling-young-professionals-in-data-analysis-and-data-stewardship> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Are you a professional working in training and capacity building in institutes, research projects or companies? Are you a policymaker or funder? Then join this virtual event 15 March 2021, 13.00 -17.00 CET. In the context of the Helis Academy, and…
