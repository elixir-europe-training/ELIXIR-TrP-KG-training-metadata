<https://tess.elixir-europe.org/events/introduction-to-high-performance-computing-hpc-structure-and-practice> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This course is part of a micro-credential track, which offers the added value of being akin to a mini-diploma. When following the full track, you will be able to improve the reproducibility of your research. Check this opportunity: Reproducible Data Analysis: an Essential Capability in Modern Science.In this half-day introduction, you will have the opportunity to know a bit more about the structure of the HPC (tiers), what resources you have available, and most importantly, how to use and navigate the HPC. In this course, you will learn the differences and similarities betweenVSC (Vlaams Supercomputer Centrum) instances in Gent and LeuvenVIB Data CoreAnd a glimpse of what you could find beyond.Our goal is to help you easily adapt to any HPC system you encounter in your professional life." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-10-17 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Belgium" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-10-17 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "ELIXIR",
        "advanced bioinformatics",
        "programming",
        "research data management" ;
    schema1:name "Introduction to High Performance Computing (HPC): structure and practice" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Access existing HPC infrastructures in Flanders such as VSC and VIB Data Core”",
        "“Check information about submitted jobs”",
        "“Describe differences and similarities among HPC Tiers and usage”",
        "“Querying and using modules and their versions in the HPC”",
        "“Submit jobs to use software and scripts on the cluster”",
        "“Use the different environments in the HPC (storage analysis and debug)”" ;
    schema1:url <https://training.vib.be/all-trainings/introduction-high-performance-computing-hpc-structure-and-practice> .

<https://tess.elixir-europe.org/events/introduction-to-high-performance-computing-scicore-cluster> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
