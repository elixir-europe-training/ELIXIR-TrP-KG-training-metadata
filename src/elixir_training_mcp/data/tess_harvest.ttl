<https://tess.elixir-europe.org/events/introduction-to-statistics-with-r-69272bbc-d280-46e7-a533-e5d0d409f4f7> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_2269> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Beginner" ],
        [ a schema1:Audience ;
