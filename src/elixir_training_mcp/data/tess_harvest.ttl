<https://tess.elixir-europe.org/materials/galaxy-usage-on-surf-research-cloud> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0605>,
        <http://edamontology.org/topic_3071> ;
    schema1:audience [ a schema1:Audience ;
