<https://tess.elixir-europe.org/events/the-4th-international-trp-meeting-hybrid-edition> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "info@trp2021.org" ;
    schema1:description """TRP2021 is a five yearly international meeting focusing on ion channels of the TRP superfamily. In this fourth edition, world leaders in the field will address various aspects of TRP channel biology, from molecular studies and cell biology to TRP channel pathologies and drug development. \r
\r
Topics that will be covered include:\r
- Structural biology of TRP channels\r
- TRP channels in thermosensation and thermoregulation\r
- TRP channels in pain and itch\r
- TRP channels in the cardiovascular system\r
- TRP channels and reproduction\r
- TRP channels in polycystic kidney disease\r
- Lysosomal TRP channels\r
- Drug development for TRP channel-related diseases\r
\r
TRP2021 aims at academic researchers, clinicians and industry.\r
\r
**Format of the conference**\r
\r
Due to the ongoing COVID-19 pandemic, this conference will have a hybrid format offering speakers and participants the possibility to attend live or on line. The live meeting will be held in the Faculty Club in Leuven. Lectures will be live streamed, followed by interactive Q&amp;A sessions. Participants can submit an abstract for a digital poster presentation. Those following the event online will receive a personal activation link after subscription, allowing access to the digital conference environment.\r
\r
**Information for abstract submissions**\r
\r
The deadline for abstract submissions is 16 August. Poster presenters have a chance to win the TRP2021 Poster Prize.""" ;
    schema1:endDate "2021-09-17 18:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:funder [ a schema1:Organization ;
            schema1:name "FWO" ],
        [ a schema1:Organization ;
            schema1:name "KU Leuven" ],
        [ a schema1:Organization ;
            schema1:name "VWR" ],
        [ a schema1:Organization ;
            schema1:name "DSI" ],
        [ a schema1:Organization ;
            schema1:name "Merck" ],
        [ a schema1:Organization ;
            schema1:name "CalibrationLab" ] ;
    schema1:hostInstitution "KU Leuven",
        "VIB" ;
    schema1:keywords "TRP",
        "TRP Channels",
        "drug development",
        "transient receptor potential" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Belgium" ;
                    schema1:addressLocality "Leuven" ;
                    schema1:addressRegion "Vlaams-Brabant" ;
                    schema1:postalCode "3000" ;
                    schema1:streetAddress "Faculty Club" ] ] ;
    schema1:maximumAttendeeCapacity 300 ;
    schema1:name "The 4th International TRP Meeting (Hybrid edition)" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "TRP2021" ] ;
