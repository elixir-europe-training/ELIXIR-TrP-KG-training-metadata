                    schema1:latitude "43.590472" ;
                    schema1:longitude "3.859513" ] ;
            schema1:maximumAttendeeCapacity 8 ;
            schema1:startDate "2025-01-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Interactive Online Companionship - R formation Session 2025" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "IFB French Institute of Bioinformatics" ;
            schema1:url <http://www.france-bioinformatique.fr> ] ;
    schema1:url <https://inforbio.github.io/ioc_info.html> .

