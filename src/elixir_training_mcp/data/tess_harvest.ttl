<https://tess.elixir-europe.org/events/introduction-to-linux-command-line-and-guidance-for-new-hpc-users> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:coursePrerequisites " University of Bradford staff and students" ;
    schema1:description """Day 1 - Introduction to Linux Command line - HPC\r
For anyone who would like to use the UoB HPC Service but has little or no Linux command line experience. After the module, the attendee will be able to:\r
• Orient themselves on a Linux system\r
• Create/delete folders and files, edit text files\r
• Get files on and off the HPC\r
• Manage their storage usage, compress files for efficient storage\r
• Use a selection of essential command line tools""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
