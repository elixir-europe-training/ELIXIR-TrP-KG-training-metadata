<https://tess.elixir-europe.org/events/kew-tree-of-life-project-discovering-the-phylogeny-of-all-flowering-plants> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_0872>,
        <http://edamontology.org/topic_3168>,
        <http://edamontology.org/topic_3673> ;
    schema1:description """High throughput sequencing has transformed approaches to phylogenetic analysis, allowing the construction of trees based on multiple loci and consideration of incongruence between nuclear and plastid data. This webinar will highlight how the Hyb-Seq method enriches whole-genome sequence data for target genes and can be used on preserved specimens, enabling a cost-effective and practicable strategy for the rigorous investigation of plant evolutionary relationships over a broad taxonomic scope. 

The Royal Botanic Gardens, Kew, has already generated a phylogeny covering over half of all flowering plant genera and aims to complete the tree (at the generic level) by 2025.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2023-04-19 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2023-04-19 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Flowering plants",
        "Hyb-Seq method",
        "Plant webinar series" ;
    schema1:name "Kew tree of life project: discovering the phylogeny of all flowering plants" ;
    schema1:provider [ a schema1:Organization ;
