                    schema1:latitude "53.380663" ;
                    schema1:longitude "-1.470228" ] ;
            schema1:startDate "2018-12-17 09:30:00 UTC"^^schema1:Date ] ;
    schema1:keywords "NGS",
        "RNA-seq",
        "bioinformatics",
        "galaxy" ;
    schema1:name "Introduction to RNA-seq" ;
