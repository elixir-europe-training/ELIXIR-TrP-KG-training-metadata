<https://tess.elixir-europe.org/materials/ern-rnd-webinars-ec014ea5-fa57-4211-9160-1da47d7ce06f> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3325> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Neurological" ],
        [ a schema1:Audience ;
            schema1:audienceType " health professionals" ],
        [ a schema1:Audience ;
            schema1:audienceType "healthcare professionals" ],
        [ a schema1:Audience ;
            schema1:audienceType "Paediatricians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Fellows and Residents" ] ;
    schema1:description """ERN-RND (European Reference Network for Rare Neurological Diseases (ERN- RND)) provides educational webinars on rare neurological and neuromuscular diseases - in collaboration with the European Reference Network for Rare Neuromuscular Diseases (EURO-NMD) and the European Academy of Neurology (EAN). \r
The goal is to share knowledge on rare neurological, movement and neuromuscular disorders via a series of webinars presented by expert members of both networks. The webinars will treat topics related to the disease groups covered by the two networks and alternate between adult and paediatric contents.\r
Various aspects from more general  clinical features, examination, disease diagnosis, medical interventions and disease management to more specific ones as use of scales or imaging will be discussed.\r
The webinars are for clinical specialists (neurologists and pediatric neurologists), residents and other paramedical staff involved in the care of neurological patients.""" ;
    schema1:educationalLevel "advanced" ;
    schema1:keywords "Rare Diseases & Research" ;
    schema1:learningResourceType "Webinar",
        "e-learning" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Webinars on rare neurological diseases (ERN-RND)" ;
    schema1:url <http://www.ern-rnd.eu/education-training/webinars/> .

<https://tess.elixir-europe.org/materials/essential-steps-of-the-fairification-process> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "data librarians" ],
        [ a schema1:Audience ;
            schema1:audienceType "software developers, bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Support Staff" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Annika Jacobsen" ],
        [ a schema1:Person ;
            schema1:name "Mascha Jansen" ],
        [ a schema1:Person ;
            schema1:name "Kristina Hettne" ],
        [ a schema1:Person ;
            schema1:name "Bert Meerman" ],
        [ a schema1:Person ;
            schema1:name "Rob Hooft" ],
        [ a schema1:Person ;
            schema1:name "Mark Thompson" ],
        [ a schema1:Person ;
            schema1:name "Mateusz Kuzak" ],
        [ a schema1:Person ;
            schema1:name "Erik Schultes" ] ;
    schema1:description """Since 2014, a number of FAIR Stakeholders have developed tools and methods around the FAIRifcation of typical datasets. In the last 5 years, these efforts were field tested in a series of "Bring Your Own Data" Workshops" (https://www.dtls.nl/fair-data/byod/).\r
\r
This document records the accumulated practical &amp; teaching experiences from BYODS as well as more high-level FAIR awareness trainings. This document was formerly known as the "Big Book of FAIRification".\r
\r
The original intention of behind this document was to preserve the thousands of hours of valuable experience gained in hands-on FAIRification, and now to reuse as much as possible in the design and deployment of the next generation of methods and associated training materials (see the GO TRAN Pillar https://osf.io/za96b/).\r
\r
This document is under Creative Commons Attribution 4.0 International Public License.""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords "FAIR",
        "data stewardship",
        "linked data",
        "metadata" ;
    schema1:learningResourceType "Training materials" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Essential Steps of the FAIRification Process" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Netherlands" ;
            schema1:url <http://www.dtls.nl/courses/> ],
        [ a schema1:Organization ;
            schema1:name "DTLS - Dutch Techcentre For Life Sciences" ;
            schema1:url <http://www.dtls.nl> ] ;
    schema1:url <https://osf.io/avrys/> .

