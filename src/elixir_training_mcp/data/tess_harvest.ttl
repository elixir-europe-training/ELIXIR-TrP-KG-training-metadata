            schema1:endDate "2020-11-19 11:30:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2020-11-19 10:00:00 UTC"^^schema1:Date ] ;
    schema1:name "de.NBI – e!DAL-PGP training course – Sharing and Publishing Comprehensive Plant Research Data " ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
