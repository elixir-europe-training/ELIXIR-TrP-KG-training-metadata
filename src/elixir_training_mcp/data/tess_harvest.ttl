    schema1:teaches """- Discover Galaxy's communities
- Learn how to set up a subdomain for you community
- Learn how to customize you tool panel
- Improve the looks and feel of your subdomain main page""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/admin/tutorials/subdomain/tutorial.html> ;
    schema1:version "2" .

<https://tess.elixir-europe.org/materials/create-and-a-handle-data-management-plan> a schema1:LearningResource ;
