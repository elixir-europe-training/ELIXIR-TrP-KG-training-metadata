<https://tess.elixir-europe.org/events/workshop-on-high-content-imaging-and-data-science-for-virtual-screening-and-drug-discovery> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_3336> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Business Entrepreneurs" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Pharmaceutical Industry" ],
        [ a schema1:Audience ;
            schema1:audienceType "Graduate students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biotechnology Companies" ] ;
    schema1:description """High-throughput phenotypic screening, based on high-content imaging, \r
is increasingly often used as a tool for drug discovery. \r
Compound screens are used to find hits that produce the desired phenotypes \r
in relevant cellular assays. Genomic screens are used to elucidate \r
the underlying molecular pathways and identify suitable drug targets. \r
Since high-content screening produces a lot of data, \r
data science approaches such as statistics, machine learning and neural networks \r
can help interpret the collected data. Just as virtual screening can be performed \r
in chemoinformatics (learning predictive models for QSAR - quantitative structure-activity relations) \r
from data obtained through compound screens, \r
similar approaches can be taken in the context of high-throughput phenotypic screening.\r
\r
This will be the first event of its kind in the region of Slovenia and Friuli-Venezia-Giulia. \r
The event will bring together a group of experts covering different topics \r
in the fields of high-content screening, image analysis, \r
chemoinformatics and machine learning. This will allow graduate students and researchers \r
from both academia and industry to familiarize themselves with these cutting-edge topics. \r
The workshop will have an impact on both the academic and industrial sector in the region \r
(e.g. biotech companies of all sizes). The workshop is part of the \r
INTERREG V-A Italy-Slovenia 2014-2020 project TRAIN \r
(Big Data and Disease Models: A Cross- border Platform for Validated Biotech Industry Kits), \r
which brings together experts on the topic from academia and industry.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-05-17 18:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "INTERREG V-A Italy-Slovenia 2014-2020 project TRAIN" ],
                [ a schema1:Organization ;
                    schema1:name "European Union" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Slovenia" ;
                            schema1:addressLocality "Bled" ;
                            schema1:addressRegion "Gorenjska" ;
                            schema1:postalCode "SI-4260" ;
                            schema1:streetAddress "Rikli Balance Hotel, Cankarjeva cesta 4, SI-4260 Bled, Slovenia" ] ;
                    schema1:latitude "46.365684" ;
                    schema1:longitude "14.109356" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Jozef Stefan Institute, Ljubljana, Slovenia" ] ;
            schema1:startDate "2019-05-13 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Data analysis",
        "High-content imaging",
        "INTERREG",
        "Phenotypic screening",
        "Virtual Screening" ;
    schema1:name "Workshop on High-Content Imaging and Data Science for Virtual Screening and Drug Discovery" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Rikli Balance Hotel" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Slovenia" ;
            schema1:url <https://elixir.mf.uni-lj.si> ] ;
    schema1:url <http://highcontent.ijs.si> .

<https://tess.elixir-europe.org/events/workshop-on-high-throughput-sequencing-data-analysis-with-galaxy> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0080>,
        <http://edamontology.org/topic_0196>,
        <http://edamontology.org/topic_0634>,
        <http://edamontology.org/topic_0637>,
        <http://edamontology.org/topic_3174>,
        <http://edamontology.org/topic_3305> ;
    schema1:description "This course introduces scientists to the data analysis platform Galaxy. The course is a beginner course; no programming skills are required." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-07-26 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Germany" ;
                            schema1:addressLocality "Freiburg" ;
                            schema1:streetAddress "University Freiburg" ] ;
                    schema1:latitude "47.99609" ;
                    schema1:longitude "7.849401" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Anika Erxleben (https://orcid.org/0000-0002-7427-6478)" ] ;
            schema1:startDate "2024-07-22 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "epigenetics",
        "introduction",
        "microbiome",
        "sequence-analysis",
        "transcriptomics",
        "variant-analysis" ;
    schema1:name "Workshop on high-throughput sequencing data analysis with Galaxy" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches "Analyze the DESeq2 output to identify, annotate and visualize differentially expressed genes",
        "Assess long reads FASTQ quality using Nanoplot and PycoQC",
        "Assess short reads FASTQ quality using FASTQE 🧬😎 and FastQC",
        "Assess the quality of a ChIP-seq experiment",
        "Call enriched regions or peaks",
        "Check a sequence quality report generated by Falco/MultiQC for RNA-Seq data",
        "Check quality reports generated by FastQC and NanoPlot for metagenomics Nanopore data",
        "Construct and run a differential gene expression analysis",
        "Describe the process to estimate the library strandness",
        "Estimate the number of reads per genes",
        "Evaluate the quality of mapping results",
        "Explain the count normalization to perform before sample comparison",
        "Explain the principle and specificity of mapping of RNA-Seq data to an eukaryotic reference genome",
        "Extract coverage files",
        "Familiarize yourself with the basics of Galaxy",
        "Identify pathogens based on the found virulence factor gene products via assembly, identify strains and indicate all antimicrobial resistance genes in samples",
        "Identify pathogens via SNP calling and build the consensus gemone of the samples",
        "Inspect the read quality",
        "Jointly call variants and genotypes for a family trio from whole-exome sequencing data",
        "Learn how histories work",
        "Learn how to create a workflow",
        "Learn how to obtain data from external sources",
        "Learn how to run tools",
        "Learn how to share your work",
        "Map reads on a reference genome",
        "Perform a gene ontology enrichment analysis",
        "Perform and visualize an enrichment analysis for KEGG pathways",
        "Perform quality correction with Cutadapt (short reads)",
        "Perform taxonomy profiling indicating and visualizing up to species level in the samples",
        "Preprocess the sequencing data to remove adapters, poor quality base content and host/contaminating reads",
        "Process single-end and paired-end data",
        "Relate all samples' pathogenic genes for tracking pathogens via phylogenetic trees and heatmaps",
        "Select and run a state of the art mapping tool for RNA-Seq data",
        "Summarise quality metrics MultiQC",
        "Trim low quality bases",
        "Use variant annotation and the observed inheritance pattern of a phenotype to identify candidate causative variants and to prioritize them" ;
    schema1:url <https://training.galaxyproject.org/training-material/events/2024-07-22-freiburg-july.html> .

