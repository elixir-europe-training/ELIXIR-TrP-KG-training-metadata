            schema1:url <https://bio.tools/tool/chipster> ] ;
    schema1:name "Single cell RNA-seq data analysis with Chipster" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "CSC - IT Center for Science" ;
            schema1:url <https://www.csc.fi> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Finland" ;
            schema1:url <https://www.csc.fi/web/training> ] ;
    schema1:url <https://chipster.csc.fi/manual/courses.html#single-cell> .

<https://tess.elixir-europe.org/materials/single-cell-rna-seq-data-analysis-with-r> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3170> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Heli Pessa" ],
        [ a schema1:Person ;
            schema1:name "Bishwa Ghimire" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Eija Korpelainen" ] ;
    schema1:description """This hands-on course introduces the participants to single cell RNA-seq data analysis concepts and popular R packages. It covers the preprocessing steps from raw sequence reads to expression matrix as well as clustering, cell type identification, differential expression analysis and pseudotime analysis. In addition to understanding of the basic principles of single cell RNA-seq experiments, participants need to have basic skills in R and Unix.\r
\r
Course material is available in [GitHub](https://version.helsinki.fi/csc-courses/scrnaseq-with-r-2022) and it includes:\r
\r
  * slides\r
  * exercises including the R code\r
\r
Detailed description of the course content:\r
\r
1. overview of preprocessing: from raw sequence reads to expression matrix\r
2. overview of popular tools and R packages for scRNAseq data analysis\r
3. scRNAseq data quality control\r
4. cluster analysis\r
   * removal of undesired sources of variation\r
   * variable gene detection\r
   * dimensionality reduction\r
   * clustering\r
5. cell type identification\r
   * using known markers\r
   * using automatic classification algorithms\r
6. differential gene expression analysis\r
7. pseudotime analysis\r
8. CCA in Seurat""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords "RNA-Seq",
        "Single Cell technologies",
        "scRNA-seq" ;
    schema1:learningResourceType "course materials" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Single-cell RNA-seq data analysis with R" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Finland" ;
            schema1:url <https://www.csc.fi/web/training> ],
        [ a schema1:Organization ;
            schema1:name "CSC - IT Center for Science" ;
            schema1:url <https://www.csc.fi> ] ;
    schema1:url <https://ssl.eventilla.com/single-cell_r_2022> .

