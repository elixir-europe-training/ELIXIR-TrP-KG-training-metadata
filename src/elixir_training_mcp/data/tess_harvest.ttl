<https://tess.elixir-europe.org/events/linux-introduction-88e35601-7e20-4a65-8451-ad4baff0ed63> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This course will give a short practical summary of the basic things one needs when using mainly the command line in Linux:\r
\r
Overview and distributions\r
How to start working with Linux\r
Short introduction to Graphical User Interface\r
Command line basics: getting help, useful commands\r
Linux File System: navigating, file paths, file manipulation, disk space, archiving\r
Text editing\r
Groups, users, security: access rights\r
Process control\r
This course provides several hands-on sessions""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-10-03 13:00:00 UTC"^^schema1:Date ;
