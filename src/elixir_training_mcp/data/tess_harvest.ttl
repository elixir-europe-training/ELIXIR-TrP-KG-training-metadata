    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ;
            schema1:url <http://elixir-norway.org> ] ;
    schema1:teaches """* Understanding how an organisation or research group can adopt DSW to users within a certain domain\r
* Starting a new DMP on DSW, from scratch or from a set of pre-filled recommendations\r
* Sharing and working collaboratively on the DMP\r
* Assessing the FAIRness of your dataset based on the DMP\r
* Export a DMP according to funders' templates, including the Science Europe template (adopted by the Research Council of Norway) and Horizon Europe\r
* Creating customised questionnaires and adapting existing ones; making these questionnaires public""" ;
    schema1:url <https://zenodo.org/records/14697229> ;
    schema1:version "v3" .

