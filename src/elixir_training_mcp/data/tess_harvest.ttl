<https://tess.elixir-europe.org/events/12eme-ecole-de-bioinformatique-aviesan-ifb-inserm-ebaii-2023> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0199>,
        <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_3168>,
        <http://edamontology.org/topic_3169>,
        <http://edamontology.org/topic_3170>,
        <http://edamontology.org/topic_3673> ;
    schema1:alternateName "Initiation au traitement des données de génomique obtenues par séquençage à haut débit" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Cette formation est destinée aux biologistes (ingénieurs, doctorants, chercheurs, enseignants-chercheurs, praticiens…) confrontés à l’analyse de données NGS, et qui ne disposent pas des compétences bioinformatiques suffisantes." ] ;
    schema1:coursePrerequisites "Aucune connaissance préalable des environnements Linux ou R n’est requise, mais il sera demandé aux participants de suivre une autoformation en ligne en amont, pour faciliter la prise en main de ces langages. La formation approfondira progressivement l’usage de ces environnements au fil des sessions thématiques." ;
    schema1:description """Initiation au traitement des données de génomique obtenues par séquençage à haut débit\r
Bulk RNA-seq, ChIP-seq/ATAC-seq, variants DNA-seq, single-cell RNA-Seq, niveau 1.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-11-10 14:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "INSERM" ],
                [ a schema1:Organization ;
                    schema1:name "IFB" ],
                [ a schema1:Organization ;
                    schema1:name "Aviesan ITMO GGB" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Roscoff" ;
                            schema1:addressRegion "Finistère" ;
                            schema1:postalCode "29680" ;
                            schema1:streetAddress "Station Biologique De Roscoff" ] ;
                    schema1:latitude "48.726635" ;
                    schema1:longitude "-3.987479" ] ;
            schema1:maximumAttendeeCapacity 40 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Aviesan ITMO GGB, Inserm, IFB" ] ;
            schema1:startDate "2023-11-04 18:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "ChIP-seq",
        "RNA-seq",
        "Single Cell Genomics",
        "Variant detection",
        "bioinformatics",
        "next-generation sequencing" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "FastQC" ;
            schema1:url <https://bio.tools/tool/fastqc> ],
        [ a schema1:Thing ;
            schema1:name "DESeq2" ;
            schema1:url <https://bio.tools/tool/deseq2> ],
        [ a schema1:Thing ;
            schema1:name "R" ;
            schema1:url <https://bio.tools/tool/r> ],
        [ a schema1:Thing ;
            schema1:name "Bowtie 2" ;
            schema1:url <https://bio.tools/tool/bowtie2> ],
        [ a schema1:Thing ;
            schema1:name "edgeR" ;
            schema1:url <https://bio.tools/tool/edger> ],
        [ a schema1:Thing ;
            schema1:name "BWA" ;
            schema1:url <https://bio.tools/tool/bwa> ],
        [ a schema1:Thing ;
            schema1:name "RStudio" ;
            schema1:url <https://bio.tools/tool/rstudio> ] ;
    schema1:name "12ème école de bioinformatique AVIESAN - IFB - INSERM (EBAII 2023)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "French Institute of Bioinformatics (IFB)" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR France" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "IFB French Institute of Bioinformatics" ;
            schema1:url <http://www.france-bioinformatique.fr> ],
        [ a schema1:Organization ;
            schema1:name "Station Biologique de Roscoff" ],
        [ a schema1:Organization ;
            schema1:name "Sorbonne Université" ],
        [ a schema1:Organization ;
            schema1:name "CNRS" ] ;
    schema1:teaches """La formation s’adresse à des biologistes directement impliqués dans des projets “Next Generation Sequencing” (NGS). Cette édition de l’école aborde les nouveaux enjeux technologiques: elle s’articulera autour de trois ateliers thématiques en session parallèle (bulk RNA-seq, ChIP-seq/ATAC-seq, variants DNA-seq), auxquelles nous ajoutons une nouvelle session: single-cell RNA-Seq, et inclura une introduction aux technologies “long reads”. \r
L’école vise à introduire les concepts, à manipuler les outils informatiques et à en interpréter les résultats. Elle est basée sur une alternance de courtes sessions théoriques et d’ateliers pratiques. Les participants bénéficieront d’un tutorat personnalisé pour élaborer leur plan d’analyse, et effectuer les premières étapes de traitement de leurs propres données ou de celles de leur équipe. \r
""" ;
    schema1:url <https://ifb-elixirfr.github.io/EBAII/2023/ebaiin1/> .

