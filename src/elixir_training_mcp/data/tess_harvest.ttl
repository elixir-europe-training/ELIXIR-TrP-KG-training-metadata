<https://tess.elixir-europe.org/events/admin-training-gcc-2022-online-training-day> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0605>,
        <http://edamontology.org/topic_3071>,
