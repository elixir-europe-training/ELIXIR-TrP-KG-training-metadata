<https://tess.elixir-europe.org/events/genome-assembly-and-annotation-course-5> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0622> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "life scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:description """A **genome assembly and annotation course** will take place on **July 1-5, 2019** in **Milan, Italy**, \r
hosted by the Italian ELIXIR Node in cooperation with other ELIXIR nodes that are involved \r
in the ELIXIR-EXCELERATE task 10.3 “Capacity Building in Genome Assembly and Annotation”.\r
Some of the most experienced assembly and annotation experts in Europe will be \r
teaching at the course.\r
\r
The course is aimed at researchers interested in learning more about genome assembly \r
and annotation. It will include information useful for both the beginner and the more \r
advanced user. We will start by introducing general concepts and then continue with a \r
step-by-step description of all major components of a genome assembly and \r
annotation workflow, from raw data all the way to a final assembled and annotated genome.\r
There will be a mix of lectures and hands-on practical exercises using Unix/Linux \r
command line.\r
\r
After the course, the participants will have knowledge of commonly used assembly practices \r
and tools. They will be able to run assembly and annotation projects on their own.\r
\r
**Prerequisites:**\r
- **Working knowledge of Unix/Linux command line**\r
- **As part of the course agenda, course participants will prepare a short presentation about their own projects.**\r
Optionally, they may also bring their own data.\r
\r
**Instructions how to register for the course are available on the [ELIXIR-SI eLearning Platform (EELP)](https://elixir.mf.uni-lj.si/course/view.php?id=45).** \r
You will be able to access the course after you register and your registration is approved by \r
the course organizers.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-07-05 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "National Research Council of Italy" ],
                [ a schema1:Organization ;
                    schema1:name "INRA" ],
                [ a schema1:Organization ;
                    schema1:name "NBIS - National Bioinformatics Infrastructure Sweden" ],
                [ a schema1:Organization ;
                    schema1:name "ELIXIR EXCELERATE" ] ;
            schema1:location [ a schema1:Place ;
