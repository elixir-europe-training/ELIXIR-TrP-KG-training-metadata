            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Understand the utility of annotating types on one's code
- Understand the limits of type annotations in python""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/data-science/tutorials/python-typing/tutorial.html> ;
    schema1:version "2" .

