<https://tess.elixir-europe.org/events/use-infrastructure-to-boost-your-research> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Meet ten national infrastructures that support medical life sciences in Norway" ;
    schema1:description """This webinar will give you the chance to learn about the activities of ten Norwegian national research infrastructures, all having in common that they provide services in medicine and life sciences.\r
\r
Some are centered around a specific technique or instrument, others provide education, networking opportunities, access to excellent biobank material, help with research proposals, data management or clinical trials.\r
\r
Program: \r
14:00: Jens Petter Berg, Pro-Dean for research: Welcome\r
\r
14:05: Leonardo Meza-Zepeda, Norseq: Sequencing\r
\r
14:15: Tuula Nyman, Joseph Robertson, NAPI: Proteomics\r
\r
14:25: Kristian Hveem, Oddgeir Holmen, Biobank Norway: Biobank data\r
\r
14:35: Olav Haraldseth, NORMOLIM: MRI/molecular imaging\r
\r
14:45: Harald Stenmark, Oddmund Bakke, Nalmin: Microscopy (light imaging)\r
\r
14:55: Rajeev Kumar, Mosergruppen: Viral vector tools for neuroscience and biomedicine\r
\r
15:05: Coffee break\r
\r
15:10: Johannes Landskron, Nor-Openscreen: Chemical biology, high throughput screening, bioprospecting\r
\r
15:20: Christine Stansberg, ELIXIR Norway: Life science data and tools\r
\r
15:30: Anita Kavlie, EATRIS Norway: Translational research, EU funding application support\r
\r
15:40: Sigrun Sæther, NorCRIN: Clinical trials\r
\r
15:50: Janna Saarela, NCMM: Conclusions""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2021-06-23 16:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Faculty of Medicine, University of Oslo" ] ;
            schema1:startDate "2021-06-23 14:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Use infrastructure to boost your research" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ;
            schema1:url <http://elixir-norway.org> ] ;
    schema1:url <https://www.med.uio.no/english/about/news-and-events/news/2021/use-infrastructure-to-boost-your-research.html> .

