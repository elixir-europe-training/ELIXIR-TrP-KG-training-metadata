<https://tess.elixir-europe.org/events/exploring-non-coding-rnas-in-rnacentral> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Anna Swan" ;
    schema1:description "RNAcentral is a database of non-coding RNA sequences that provides a unified view of &gt;40 specialised databases. This webinar will give an overview of the data found in RNAcentral as well as the RNAcentral website." ;
    schema1:endDate "2021-02-10 16:30:00 UTC"^^schema1:Date ;
