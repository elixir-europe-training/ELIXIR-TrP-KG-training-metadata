    schema1:name "NSF INCLUDES Conference on Multi-Scale Evaluation in STEM Education" ;
    schema1:startDate "2016-10-24 09:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.nimbios.org/IncludesConf/> .

