<https://tess.elixir-europe.org/materials/intermine-user-manual> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Life Science Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bioinformaticians" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Gos Micklem" ],
        [ a schema1:Person ;
            schema1:name "Rachel Lyne" ],
        [ a schema1:Person ;
            schema1:name "Justin Clark-Casey" ],
        [ a schema1:Person ;
            schema1:name "Yo Yehudi" ],
        [ a schema1:Person ;
            schema1:name "Julie Sullivan" ],
        [ a schema1:Person ;
            schema1:name "Daniela Butano" ],
        [ a schema1:Person ;
            schema1:name "Kevin Herald Reierskog" ],
        [ a schema1:Person ;
            schema1:name "Sergio Contrino" ] ;
    schema1:description """InterMine integrates biological data sources, making it easy to query and analyse data.  It is a downloadable platform that operators can install and integrate with their own systems.\r
\r
InterMine is a generic model-based platform that is used to provide data to end users in many different life science domains, such as synthetic biology and biomedical research.  It is particularly popular with model organism projects.  \r
\r
This documentation is for users of an InterMine installation.  Among other things, it describes how they can search for biological entities (gene, protein, pathway, etc.), run sophisticated queries over integrated data, analyze query results and gene lists (gene ontology enrichment analysis, for example) and download or interact with data programmatically (e.g. by scripts written in Python, R and other languages).\r
\r
This documentation is related to the new user interface BlueGenes.\r
\r
For documentation for operators of InterMine installations please see http://intermine.org/im-docs""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Data download",
        "Data querying",
        "FAIR",
        "data visualization" ;
    schema1:learningResourceType "Documentation" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "InterMineR" ;
            schema1:url <https://bio.tools/tool/InterMineR> ],
        [ a schema1:Thing ;
            schema1:name "InterMine" ;
            schema1:url <https://bio.tools/tool/intermine> ] ;
    schema1:name "InterMine user manual" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "InterMine" ;
            schema1:url <http://intermine.org> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:url <http://intermine.org/intermine-user-docs> .

<https://tess.elixir-europe.org/materials/intermine-user-tutorial> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
