                    schema1:addressLocality "Barcelona" ;
                    schema1:streetAddress "Barcelona Science Park" ] ;
            schema1:latitude "41.382894" ;
            schema1:longitude "2.177432" ] ;
    schema1:name "ELIXIR Microbiome Community F2F/hybrid meeting" ;
    schema1:startDate "2025-04-09 12:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/elixir-microbiome-community-f2fhybrid-meeting> .

