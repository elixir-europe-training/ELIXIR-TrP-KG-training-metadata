            schema1:url <https://bio.tools/tool/compute_sequence_length> ],
        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ] ;
    schema1:name "Multi-sample batch correction with Harmony and SnapATAC2" ;
