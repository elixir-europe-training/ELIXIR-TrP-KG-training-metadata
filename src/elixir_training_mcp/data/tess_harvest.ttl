<https://tess.elixir-europe.org/events/protein-rna-cross-linking-with-rnpxl-openms-ssp2019> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """Educators:\r
Timo Sachsenberg, Alexander Wulf (CIBI)\r
\r
Date:\r
03.11.2019\r
\r
Location:\r
Workshop 9th Symposium on Structural Proteomics\r
Göttingen, Germany\r
\r
Contents:\r
Proteins and RNA form major classes of biomolecules. Protein-RNA complexes are essential for cellular processes like translation or splicing. In Kramer, Sachsenberg et. al, (Nat Methods, 2014) we demonstrated how protein-RNA interactions can be detected and localized at the level of single amino acids with our tool RNPxl. In this training event, we describe our experimental and computational approach to protein-RNA analysis from UV-induced cross-linking experiments.\r
\r
Software Requirements:\r
none\r
\r
Keywords:\r
LC-MS based proteomics, OpenMS, workflows, cross-linking, data analysis\r
\r
Tools:\r
OpenMS\r
""" ;
    schema1:endDate "2019-11-03 17:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Germany" ;
                    schema1:addressLocality "Göttingen" ;
                    schema1:streetAddress "Göttingen" ] ;
            schema1:latitude "51.54128" ;
            schema1:longitude "9.915804" ] ;
    schema1:name "Protein-RNA cross-linking with RNPxl/OpenMS - SSP2019" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "de.NBI" ] ;
    schema1:startDate "2019-11-03 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.denbi.de/training/697-protein-rna-cross-linking-with-rnpxl-openms> .

