<https://tess.elixir-europe.org/events/apbc2017> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:alternateName "The Fifteenth Asia Pacific Bioinformatics Conference " ;
    schema1:description "The Fifteenth Asia Pacific Bioinformatics Conference will be held in Shenzhen, China. The aim of this conference is to bring together researchers, academics, and industrial practitioners. APBC2017 invites high quality original full papers on any topic related to Bioinformatics and Computational Biology. The submitted papers must have not been published or under the consideration for publication in any other journal or conference with formal proceedings. All accepted papers will have to be presented by one of the authors at the conference. Accepted papers will be invited to be published in IEEE/ACM TCCB, BMC Bioinformatics, BMC Genomics, BMC Systems Biology, and Computational Biology and Chemistry following each journal's publication policy" ;
    schema1:endDate "2017-01-18 00:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
