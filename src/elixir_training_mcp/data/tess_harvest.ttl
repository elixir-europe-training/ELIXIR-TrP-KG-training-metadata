                            schema1:postalCode "29680" ] ;
                    schema1:latitude "48.725582" ;
                    schema1:longitude "-3.982898" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "IFB (https://www.france-bioinformatique.fr/), Institut Pasteur (http://www.pasteur.fr/en)" ] ;
            schema1:startDate "2024-10-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "5th workshop Single-Cell : Transcriptomics, Spatial and Long reads" ;
    schema1:provider [ a schema1:Organization ;
