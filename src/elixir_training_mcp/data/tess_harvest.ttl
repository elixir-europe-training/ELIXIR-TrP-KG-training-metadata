<https://tess.elixir-europe.org/events/introduction-to-metabolomics-data-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """National course open for PhD students, postdocs, researchers and other employees in all Swedish universities, in need of metabolomics data analysis skills. 

We will go through study design, familiarize ourselves with principles of LCMS, GCMS and NMR experiments, pre-process the raw data acquired from analytical instruments and perform downstream data analysis and interpretation using multivariate methods such as PCA, (O)PLS and (O)PLS-DA. The course will include lectures and hands-on exercises.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2026-03-25 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressLocality "Umeå" ] ;
                    schema1:latitude "63.825657" ;
                    schema1:longitude "20.263075" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:startDate "2026-03-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "Introduction to Metabolomics Data Analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "NBIS" ;
            schema1:url <http://nbis.se> ] ;
    schema1:url <https://uppsala.instructure.com/courses/116668> .

<https://tess.elixir-europe.org/events/introduction-to-metabolomics-for-the-clinical-scientist> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description "The 1-day course in partnership with the Phenome Centre Birmingham will provide clinicians with an overview of the metabolomics pipeline highlighting the benefits of this technique to the medical field and an introduction to the Phenome Centre Birmingham and the MRC-NIHR National Phenome Centre. The course will provide a suitable introduction to metabolomics prior to taking additional training courses at either the Birmingham Metabolomics Training Centre or the Imperial International Phenome Training Centre." ;
    schema1:endDate "2019-03-11 00:00:00 UTC"^^schema1:Date ;
    schema1:location [ a schema1:Place ;
