<https://tess.elixir-europe.org/events/structural-bioinformatics-0612d9e1-aa73-4a2e-abc3-d818ad4df910> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_1317> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "This course is for biological researchers who want to learn more about the application of structural information in their work and how to use some of the key bioinformatics resources that are available. No previous experience in the field of structural bioinformatics is required, however a basic knowledge of protein structure would be of benefit. Participants should be familiar with basic Linux operations -&nbsp;http://www.ee.surrey.ac.uk/Teaching/Unix/&nbsp;- and have some experience of bioinformatics tools and databases." ] ;
    schema1:description """Structural biology, determining the three-dimensional shapes of biomacromolecules and their complexes, can tell us a lot about how these molecules function and the roles they play within a cell. Bioinformatics data derived from structure determination experiments enables life-science researchers to address a wide variety of questions. For example, it aids the understanding of how mutations in a gene might alter a protein’s shape, disrupt a catalytic site, or alter the binding affinity of a pharmaceutical compound.

This course explores bioinformatics data resources and tools for the interpretation and exploitation of biomacromolecular structures. It will focus on how best to analyse available structural data to gain useful information given specific research contexts. The course content will investigate the impact of genetic variation on structure, predicting protein structure and function, and exploring interactions with other macromolecules as well as with low-MW compounds. Participants will also have an opportunity to explore protein docking using HADDOCK.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-09-20 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressRegion "Cambridge" ;
                            schema1:postalCode "CB10 1SD" ;
                            schema1:streetAddress "European Bioinformatics Institute, Hinxton" ] ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-09-16 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Structural bioinformatics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute" ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/structural-bioinformatics> .

<https://tess.elixir-europe.org/events/structural-bioinformatics-0b2060c8-0ccf-46b9-ad27-fffc2f882c53> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
