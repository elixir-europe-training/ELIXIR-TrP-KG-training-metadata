                            schema1:addressRegion "Provincia di Salerno" ;
                            schema1:postalCode "84084" ;
                            schema1:streetAddress "Campus di Fisciano, Università di Salerno" ] ;
                    schema1:latitude "40.774409" ;
                    schema1:longitude "14.789744" ] ;
            schema1:maximumAttendeeCapacity 15 ;
