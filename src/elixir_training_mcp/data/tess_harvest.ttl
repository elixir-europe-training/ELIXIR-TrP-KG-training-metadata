            schema1:name "JBrowse" ;
            schema1:url <https://bio.tools/tool/jbrowse> ],
        [ a schema1:Thing ;
            schema1:name "Integron Finder" ;
            schema1:url <https://bio.tools/tool/integron_finder> ],
        [ a schema1:Thing ;
            schema1:name "tbl2gff3" ;
            schema1:url <https://bio.tools/tool/tbl2gff3> ],
        [ a schema1:Thing ;
            schema1:name "ISEScan" ;
            schema1:url <https://bio.tools/tool/ISEScan> ],
        [ a schema1:Thing ;
            schema1:name "PlasmidFinder" ;
            schema1:url <https://bio.tools/tool/PlasmidFinder> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/10572227> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/genome-annotation/tutorials/bacterial-genome-annotation/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "Bakta" ;
            schema1:url <https://bio.tools/tool/bakta> ] ;
    schema1:name "Bacterial Genome Annotation" ;
    schema1:provider [ a schema1:Organization ;
