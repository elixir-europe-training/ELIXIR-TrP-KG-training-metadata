<https://tess.elixir-europe.org/events/online-course-a-practical-introduction-to-ngs-data-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0080>,
        <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3168> ;
    schema1:alternateName "Quality Control, Read Mapping, Visualization and DNA Variant Analysis " ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Molecular Biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "post-docs" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD Students" ],
        [ a schema1:Audience ;
            schema1:audienceType "bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Pathologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists, Genomicists, Computer Scientists" ] ;
    schema1:description """\r
Advance your research. Understand NGS and analyze sequenced data yourself.\r
In a nutshell\r
\r
- Learn the essential computing skills for NGS bioinformatics\r
- Understand NGS technology, algorithms and data formats\r
- Use bioinformatics tools for handling sequencing data\r
- Perform first downstream analyses for studying genetic variation\r
\r
The purpose of this workshop is to get a deeper understanding in Next-Generation Sequencing (NGS) with a special focus on bioinformatics issues. Advantages and disadvantages of current sequencing technologies and their implications on data analysis will be discovered. The participants will be trained on understanding their own NGS data, finding potential problems/errors therein and finally perform their first downstream analysis (variant calling). In the course we will use a real-life NGS dataset from the current market leader illumina.\r
\r
All workshop attendees will be enabled to perform important first tasks of NGS data analysis themselves. The course layout has been adapted to the needs of beginners in the field of NGS bioinformatics and allows scientists with no or little background in computer science to get a first hands-on experience in this fast evolving research topic.\r
\r
The online course will make use of a web conferencing system. Hands-on NGS analysis will be performed in an interactive browser-based platform. Before the course, you will get a printed manuscript and a USB key by mail.\r
\r
""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2020-10-16 17:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 15 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ecSeq Bioinformatics GmbH" ] ;
            schema1:startDate "2020-10-14 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "DNA-seq",
        "NGS",
        "NGS bioinformatics",
        "Variant calling" ;
    schema1:name "Online Course - A Practical Introduction to NGS Data Analysis " ;
    schema1:url <https://www.ecseq.com/workshops/workshop_2020-05-A-Practical-Introduction-to-NGS-Data-Analysis-Online-Course.html> .

