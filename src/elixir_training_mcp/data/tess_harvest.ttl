<https://tess.elixir-europe.org/events/iitm-ebi-modelling-workshop> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "IBSE Workshop Team" ;
    schema1:description "This week-long workshop will train researchers from life science and mathematics to communicate and work together to learn to build and analyse computer models using user-friendly open-source software. The workshop is jointly organised by EBI and Indian Institute of Technology Madras." ;
