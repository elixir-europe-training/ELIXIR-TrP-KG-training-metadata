<https://tess.elixir-europe.org/materials/a-network-biology-workflow-to-study-transcriptomics-data-of-the-diabetic-liver> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Martina Kutmon" ],
        [ a schema1:Person ;
            schema1:name "Chris Evelo" ],
        [ a schema1:Person ;
            schema1:name "Susan Coort" ] ;
    schema1:description "The described network biology workflow uses state-of-the-art pathway and network analysis methods to study the rewiring of the diabetic liver. The integration of experimental data and knowledge on disease-affected biological pathways, including regulatory elements like transcription factors or drugs, leads to improved insights and a clearer illustration of the overall process. It also provides a resource for building new hypotheses for further follow-up studies. The approach is highly generic and can be applied in different research fields." ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "10.1186/1471-2164-15-971" ;
    schema1:keywords "Biological networks",
        "Network Visualization" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "A network biology workflow to study transcriptomics data of the diabetic liver" ;
