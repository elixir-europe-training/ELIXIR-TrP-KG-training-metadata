<https://tess.elixir-europe.org/materials/hello-nextflow> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Data scientists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Geraldine Van der Auwera" ],
        [ a schema1:Person ;
            schema1:name "Marcel Ribeiro-Dantas" ],
        [ a schema1:Person ;
            schema1:name "Jonathan Manning" ] ;
    schema1:competencyRequired """- A GitHub account OR a local installation as described here.\r
- Experience with command line and basic scripting""" ;
    schema1:creativeWorkStatus "active" ;
    schema1:datePublished "2025-10-27"^^schema1:Date ;
    schema1:description """The rise of big data has made it increasingly necessary to be able to analyze and perform experiments on large datasets in a portable and reproducible manner. Parallelization and distributed computing are the best ways to tackle this challenge, but the tools commonly available to computational scientists often lack good support for these techniques, or they provide a model that fits poorly with the needs of computational scientists. Nextflow was particularly created to address these challenges.\r
\r
During this training, you will be introduced to Nextflow in a series of complementary hands-on workshops.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Nextflow",
        "pipeline development",
        "workflow management" ;
    schema1:learningResourceType "Coding",
        "Computational Biology",
        "Course materials",
        "Video" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Hello Nextflow" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Seqera" ;
            schema1:url <http://www.seqera.io> ] ;
    schema1:teaches """- Describe and utilize core Nextflow components sufficient to build a simple multi-step workflow\r
- Describe next-step concepts such as operators and channel factories\r
- Launch a Nextflow workflow locally\r
- Find and interpret outputs (results) and log files generated by Nextflow\r
- Troubleshoot basic issues""" ;
    schema1:url <https://training.nextflow.io/latest/hello_nextflow/> ;
    schema1:version "2.7" .

<https://tess.elixir-europe.org/materials/help-for-bioconductor> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description """Bioconductor provides tools for the analysis and comprehension of high-throughput genomic data. Bioconductor uses the R statistical programming language, and is open source and open development. It has two releases each year, 1383 software packages, and an active user community. Bioconductor is also available as an AMI (Amazon Machine Image) and a series of Docker images.\r
\r
If you have problems with Bioconductor, take a look at the help pages (https://bioconductor.org/help/). The help pages include course material, workflows, videos etc. For further questions, you can contact the developers:\r
\r
Wolfgang Huber (wolfgang.huber@embl.de)\r
Mike Smith (mike.smith@embl.de)""" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Help for Bioconductor" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "de.NBI" ;
            schema1:url <https://www.denbi.de> ] ;
    schema1:url <https://www.denbi.de/online-training-media-library/402-help-for-bioconductor> .

