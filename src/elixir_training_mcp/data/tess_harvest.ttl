                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2023-01-25 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Complex portal",
        "IMEx",
        "IntAct Molecular Interaction Database",
        "PSICQUIC" ;
    schema1:name "Accessing fine-grained Molecular Interactions data with IntAct" ;
    schema1:provider [ a schema1:Organization ;
