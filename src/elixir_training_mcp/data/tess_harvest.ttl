                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Paris" ] ;
                    schema1:latitude "48.85889" ;
                    schema1:longitude "2.320041" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "I2BC (http://www.i2bc.paris-saclay.fr/?lang=en), IFB-core ()" ] ;
            schema1:startDate "2021-06-28 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Principes FAIR dans un projet de bioinformatique - Session 2021" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "IFB French Institute of Bioinformatics" ;
            schema1:url <http://www.france-bioinformatique.fr> ] ;
