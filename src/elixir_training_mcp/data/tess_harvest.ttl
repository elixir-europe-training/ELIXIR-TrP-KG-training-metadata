<https://tess.elixir-europe.org/events/workshop-on-data-management-and-data-deposition-for-biological-images> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Experts in data management of bioimaging data" ] ;
    schema1:description """This workshop highlights current challenges of data management
and deposition in the bioimaging community in Flanders. In addition, we raised
awareness about existing initiatives and solutions for data management, deposition and
infrastructures available to the Flemish researcher or Core facilities. We discussed how to
improve good practices for data deposition and management in bioimaging.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
