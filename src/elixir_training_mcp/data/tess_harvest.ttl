            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/5887339> ] ;
    schema1:name "Using the VGP workflows to assemble a vertebrate genome with HiFi and Hi-C data" ;
    schema1:provider [ a schema1:Organization ;
