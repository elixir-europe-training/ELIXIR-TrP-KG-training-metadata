        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://doi.org/10.5281/zenodo.5805953> ],
        [ a schema1:Thing ;
            schema1:name "Jupyter Notebook (with Solutions)" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/climate/tutorials/pangeo-notebook/climate-pangeo-notebook.ipynb> ],
        [ a schema1:Thing ;
