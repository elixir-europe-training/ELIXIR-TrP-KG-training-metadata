<https://tess.elixir-europe.org/events/science-communication-public-engagement> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "The ability to communicate with a wide variety of stakeholders is an important skill for today’s scientists. Audiences can range from funding agencies and peer reviewers, to colleagues, policy makers, media and the public at large. With this in mind, VIB offers a communication workshop designed for scientists interested in public outreach. This training provides practical tips and inspiring examples from (former) journalists, internal and external communication experts and colleague researchers. They will share some best practices on how to tailor your message to a specific audience and how to turn your often complex scientific results into a story that will impress the public." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-05-07 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3000" ;
                            schema1:streetAddress "Leuven - 3 Hoog, Mechelsevest 90" ] ;
                    schema1:latitude "50.887452" ;
                    schema1:longitude "4.690183" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2019-05-07 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "Science Communication & Public Engagement" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/science-communication-public-engagement> .

<https://tess.elixir-europe.org/events/science-figured-out> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Did you know that, along with you, nearly 10.000 junior researchers are conducting a doctoral or postdoctoral study in Flanders at the moment? While these researches find their way to colleagues in the academia through scientific publications and conferences, only a small amount is brought under the attention of the general public.


Enter the “Science figured out”-project. Through this project Scriptie vzw, organiser of the yearly PhD Cup, wants to teach you how to get non-experts excited about your research ànd help you to convey insights of the doctoral research you are (or have been) working on for years to the general public! Not through an academic lecture, but told as a compelling and comprehensible story for non-peers. A daylong workshop on presentation techniques will help you rise up to the challenge: explain the core of your PhD research in a clear and convincing 3-minute pitch. Each participant will receive a copy of the book “The Floor is Yours”.


And that’s not all: 8 of the participants will have their “PhD pitch” recorded and published online. Video recordings will take place ca. three weeks after the workshop, allowing the selected researchers to develop and tweak their presentation.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-07-01 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "Science Figured Out" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3010" ;
                            schema1:streetAddress "Leuven - Park Inn by Radisson, Martelarenlaan 36" ] ;
                    schema1:latitude "50.881367" ;
                    schema1:longitude "4.717319" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2019-06-11 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "Science Figured Out" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/science-figured-out> .

<https://tess.elixir-europe.org/events/science-figured-out-c28ac8a2-784e-431c-b1ab-a5ed5ae33f59> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Did you know that, along with you, nearly 10.000 junior researchers are conducting a doctoral or postdoctoral study in Flanders at the moment? While these researches find their way to colleagues in the academia through scientific publications and conferences, only a small amount is brought under the attention of the general public.


Enter the “Science figured out”-project. Through this project SciMingo, organiser of the yearly PhD Cup, wants to teach you how to get non-experts excited about your research ànd help you to convey insights of the doctoral research you are (or have been) working on for years to the general public! Not through an academic lecture, but told as a compelling and comprehensible story for non-peers. A daylong workshop on presentation techniques will help you rise up to the challenge: explain the core of your PhD research in a clear and convincing 3-minute pitch. Each participant will receive a copy of the book “The Floor is Yours”.


And that’s not all: 4 of the participants will have their “PhD pitch” recorded and published online. Video recordings will take place ca. three weeks after the workshop, allowing the selected researchers to develop and tweak their presentation.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
