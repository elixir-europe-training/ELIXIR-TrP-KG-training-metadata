    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2022-09-11"^^schema1:Date ;
    schema1:dateModified "2022-09-20"^^schema1:Date ;
    schema1:datePublished "2022-09-21"^^schema1:Date ;
    schema1:description """This course covered the generation and application of large-scale holo-omic data sets, such as those produced within the HoloFood project. This course was run in September 2022, in-person in Bilbao, as part of the 1st Applied Hologenomics Conference. These course notes include the lecture slides that were presented, as well as the instructions for the practical sessions participants followed.\r
\r
# Course content\r
\r
During this course you will learn about: \r
\r
- Omic data repositories: MGnify, European Nucleotide Archive, MetaboLights, BioSamples\r
- Available HoloFood datasets: Genomic, Metagenomic, Metatranscriptomic, Metabolomic, Microbial Genome Catalogues\r
- Analysis techniques: Metagenome assembly, recovery of genomes, functional annotation of genomes, environmental metabolomic analysis\r
- Integration: Approaches and tools for further holo-omic analysis: e.g. integration of metabolomic data with (meta-)genomic data""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords "MGnify",
        "Metabolomics",
        "Workshop",
        "hologenomics",
        "metagenomics" ;
    schema1:learningResourceType "Slides",
        "course materials",
        "hands-on tutorial" ;
    schema1:license <https://spdx.org/licenses/CC-BY-NC-SA-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "ENA" ;
            schema1:url <https://www.ebi.ac.uk/ena/> ],
        [ a schema1:Thing ;
            schema1:name "MGnify" ;
            schema1:url <https://www.ebi.ac.uk/metagenomics> ],
        [ a schema1:Thing ;
            schema1:name "HoloFood Project" ;
            schema1:url <https://www.holofood.eu> ],
        [ a schema1:Thing ;
            schema1:name "MetaboLights" ;
            schema1:url <https://www.ebi.ac.uk/metabolights> ] ;
    schema1:name "Organisation and utilisation of hologenomic datasets – course notes" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:teaches """After the course you should be able to: \r
- Describe the HoloFood data that is available and how it was generated\r
- Access a range of data types from leading public repositories\r
- Illustrate how the data sets relate to each other\r
- Use the data to support your own analysis  \r
 \r
""" ;
    schema1:url <https://holofood-course.readthedocs.io/en/latest/> .

