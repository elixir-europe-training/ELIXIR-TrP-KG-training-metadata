<https://tess.elixir-europe.org/events/data-visualization-for-biology-a-practical-workshop-on-design-techniques-and-tools> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Maria Bacadare Goitia" ;
    schema1:description "In this 5-day workshop, we will dive into the topic of biological data visualization and how it can be used to gain insight in and get a \"feel\" for a dataset, so that targeted analyses can be defined." ;
