                    schema1:postalCode "NW1 2BE" ;
                    schema1:streetAddress "Wellcome Collection" ] ;
            schema1:latitude "51.52555" ;
            schema1:longitude "-0.134873" ] ;
    schema1:name "ELIXIR Compute Platform face-to-face Meeting May 2019" ;
    schema1:startDate "2019-05-08 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/elixir-compute-platform-face-face-meeting-may-2019> .

