<https://tess.elixir-europe.org/materials/granulomatosis-with-polyangiitis-resources> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3325> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "General Physicians" ] ;
    schema1:description "Granulomatosis with polyangiitis (GPA - formerly known as Wegener’s granulomatosis) is a rare vasculitis which commonly presents with symptoms related to the respiratory tract. This ‘Five minutes to change your practice’ screencast discusses the presentation of GPA, when to consider it as a diagnosis and what investigations to do in primary care. It also touches on the secondary care management and longer term prognosis." ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords "Rare Diseases & Research" ;
    schema1:learningResourceType "Video",
        "e-learning" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Granulomatosis with polyangiitis screencast" ;
    schema1:url <https://elearning.rcgp.org.uk/course/search.php?search=Granulomatosis+with+polyangiitis+%28GPA%29> .

