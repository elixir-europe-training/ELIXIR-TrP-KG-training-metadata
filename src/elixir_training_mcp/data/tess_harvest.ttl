            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches "- Create community reviewed resources for Galaxy tools within a specific scientific domain" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/community/tutorials/community-tool-table/tutorial.html> ;
    schema1:version "5" .

