        [ a schema1:Thing ;
            schema1:name "BCFtools" ;
            schema1:url <https://bio.tools/tool/bcftools> ] ;
    schema1:name "Automating Galaxy workflows using the command line" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
