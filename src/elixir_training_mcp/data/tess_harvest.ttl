<https://tess.elixir-europe.org/events/i-made-my-code-open-now-what-steps-to-a-thriving-open-software-project> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3474>,
        <http://edamontology.org/topic_4010>,
        <http://edamontology.org/topic_4012>,
        <http://edamontology.org/topic_4047> ;
    schema1:description "Sharing your code is a good first step towards building open source software, but it is not enough to ensure its success. This webinar focuses on practical issues to increase impact of open software projects, including maintenance, community building, discoverability, project management, documentation, licensing, and user needs.  Our speakers will share their experience working with the open source code as part of the CAPITAL project - open source tool that uses machine learning to identify biological concepts from text and link them to relevant ontologies. They will discuss the challenges they have encountered and potential solutions to address these." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-10-23 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-10-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "CAPITAL project",
        "ChEMBL: Bioactive data for drug discovery",
        "Europe PubMed Central",
        "Literature (literature)",
        "Open source code",
        "Open source tool",
        "Protein Data Bank in Europe" ;
    schema1:name "I made my code open - now what? Steps to a thriving open software project" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/i-made-my-code-open-now-what-steps-thriving-open-software-project> .

<https://tess.elixir-europe.org/events/i-made-my-code-open-now-what-steps-to-a-thriving-open-software-project-7b7f4957-9531-4dc2-bea9-e72609acbad9> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "helpdesk@europepmc.org" ;
    schema1:description """Sharing your code is a good first step towards building open source software, but it is not enough to ensure its success. This webinar focuses on practical issues to increase impact of open software projects, including maintenance, community building, discoverability, project management, documentation, licensing, and user needs.  \r
\r
Our speakers from Europe PMC, PDBe, and ChEMBL will share their experience working with the open source code as part of the CAPITAL project - open source tool that uses machine learning to identify biological concepts from text and link them to relevant ontologies. They will discuss the challenges they have encountered and potential solutions to address these.""" ;
    schema1:endDate "2024-10-23 16:30:00 UTC"^^schema1:Date ;
    schema1:hostInstitution "EMBL-EBI" ;
    schema1:keywords "ChEMBL",
        "Europe PMC",
        "Life Science",
        "Open Source Software",
        "Open access",
        "Open source code",
        "PDBe",
        "Project management",
        "open source" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "United Kingdom" ;
                    schema1:addressLocality "Zoom" ;
                    schema1:streetAddress "Zoom" ] ] ;
    schema1:name "I made my code open - now what? Steps to a thriving open software project" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "Europe PMC" ] ;
    schema1:startDate "2024-10-23 15:30:00 UTC"^^schema1:Date ;
    schema1:url <https://www.ebi.ac.uk/training/events/i-made-my-code-open-now-what-steps-thriving-open-software-project/> .

