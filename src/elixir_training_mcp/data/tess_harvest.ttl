            schema1:url <https://bio.tools/tool/workflow4metabolomics> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/metabolomics/tutorials/gc_ms_with_xcms/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "xcms" ;
            schema1:url <https://bio.tools/tool/xcms> ],
        [ a schema1:Thing ;
            schema1:name "Matchms" ;
            schema1:url <https://bio.tools/tool/matchms> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/7890956> ],
        [ a schema1:Thing ;
            schema1:name "msConvert" ;
            schema1:url <https://bio.tools/tool/msconvert> ] ;
    schema1:name "Mass spectrometry: GC-MS data processing (with XCMS, RAMClustR, RIAssigner, and matchms)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- To learn about the key steps in the preprocessing and analysis of untargeted GC-MS metabolomics data.
- To explore what open-source alternative tools can be used in the analysis of GC-MS data, learn about their possible parametrisations.
- To analyse authentic data samples and compare them with a data library of human metabolome, composed from a collection of mostly endogenous compounds.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/metabolomics/tutorials/gc_ms_with_xcms/tutorial.html> ;
    schema1:version "5" .

<https://tess.elixir-europe.org/materials/hands-on-for-mass-spectrometry-imaging-examining-the-spatial-distribution-of-analytes-tutorial> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3172> ;
    schema1:audience [ a schema1:Audience ;
