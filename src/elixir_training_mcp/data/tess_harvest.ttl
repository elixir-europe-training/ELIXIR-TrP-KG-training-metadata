<https://tess.elixir-europe.org/events/analysing-non-coding-rna-with-rnacentral-and-rfam> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Rebecca Nicholl" ;
    schema1:description "This workshop, organised in conjunction with the RNA Informatics conference, provides an overview of RNAcentral and Rfam, two databases for non-coding RNA analysis." ;
    schema1:endDate "2019-09-12 13:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "United Kingdom" ;
