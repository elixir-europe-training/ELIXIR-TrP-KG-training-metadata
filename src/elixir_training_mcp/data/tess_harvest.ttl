<https://tess.elixir-europe.org/materials/introduction-to-statistics-with-r-4a26d875-7287-4e35-84c2-bfbc2819f05e> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_2269> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Beginners in statistics" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Marilin Moor" ] ;
    schema1:competencyRequired "R Basics" ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2025-04-28"^^schema1:Date ;
    schema1:dateModified "2025-05-15"^^schema1:Date ;
    schema1:datePublished "2025-05-16"^^schema1:Date ;
    schema1:description """This is a 2-day workshop for biologists needing to perform statistical analyses using R.\r
\r
This course is designed to provide researchers in biomedical sciences with experience in the application of basic statistical analysis techniques to a variety of biological problems. The course will combine lectures on statistics and practical exercises, during which the participants will learn how to work with the widely used “R” language and environment for statistical computing and graphics.\r
\r
Course focuses on key statistical methods in R, equipping attendees with essential tools for biological data analysis. Topics covered will include hypothesis testing for numerical and categorical data, linear models, correlation and regression.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "R",
        "Statistical tests",
        "Statistics" ;
    schema1:learningResourceType "lessons" ;
    schema1:license <https://spdx.org/licenses/MIT.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Slides for Introduction to statistics with R " ;
            schema1:url <https://doi.org/10.5281/zenodo.15301106> ] ;
    schema1:name "Introduction to statistics with R" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <https://elixir.ut.ee> ] ;
    schema1:teaches """* have experience in the application of basic statistics techniques in R;\r
* summarize data with numerical and graphical summaries - plot data;\r
* do hypothesis testing and multiple testing correction;\r
* learn about linear models, correlation and regression, principal component analysis and other topics\r
""" ;
    schema1:url <https://github.com/ELIXIREstonia/2025-04-28-R-basic-stat> .

