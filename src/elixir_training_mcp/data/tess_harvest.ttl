        "data management",
        "data publication",
        "data repositories",
        "data sharing",
        "data stewardship" ;
    schema1:learningResourceType "Slides",
        "Training materials" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "FAIR Data Stewardship - Data sharing, archiving and publishing" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Netherlands" ;
            schema1:url <http://www.dtls.nl/courses/> ],
        [ a schema1:Organization ;
            schema1:name "DTLS - Dutch Techcentre For Life Sciences" ;
            schema1:url <http://www.dtls.nl> ] ;
    schema1:url <https://doi.org/10.5281/zenodo.3066870> .

<https://tess.elixir-europe.org/materials/fair-for-busy-biologists> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Technicians" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD Students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Postdocs and Staff members" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:description """The “FAIR for Busy Biologists” course caters to researchers in biological and biomedical fields (PhD students, postdocs, technicians and even PIs) interested in Open Science and data management.\r
\r
This course provides a concise introduction to the FAIR (Findable, Accessible, Interoperable, Reusable) data principles. Participants will learn how to implement FAIR practices throughout their research projects, fostering data reuse and collaboration.\r
Derived from the comprehensive “FAIR in Bio Practice” program, it focuses on core topics, featuring concise content and targeted exercises to deliver essential knowledge in a shorter timeframe.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "FAIR",
        "Metadata",
        "Open Science",
        "Repositories",
        "Reproducibility",
        "Tidy data" ;
    schema1:learningResourceType "Training materials",
        "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "FAIR for busy biologists" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University of Edinburgh" ;
            schema1:url <https://www.ed.ac.uk/biology/research/facilities/edinburgh-genomics/training> ] ;
    schema1:teaches """After following this lesson, learners will be able to:\r
-explain elements of the Open Science movement\r
-explain FAIR principles and understand their importance\r
-plan their own data management strategy\r
-prepare their data for re-use\r
-apply approaches and tools into a FAIR-ready research data lifecycle\r
-find suitable resources for delivering Open Science and FAIR data""" ;
    schema1:url <https://carpentries-incubator.github.io/fair-for-busy-biologists/> .

<https://tess.elixir-europe.org/materials/fair-for-leaders> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
