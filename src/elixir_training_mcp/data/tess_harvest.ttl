                            schema1:addressRegion "San Jose" ;
                            schema1:streetAddress "University of Costa Rica (UCR), Ciudad universitaria Rodrigo Facio Brenes" ] ;
                    schema1:latitude "9.932543" ;
                    schema1:longitude "-84.079578" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-08-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "CABANA Workshop: Genotyping by Sequencing Applied to Plant Breeding" ;
    schema1:provider [ a schema1:Organization ;
