            schema1:latitude "52.080033" ;
            schema1:longitude "0.186338" ] ;
    schema1:name "Analysing non-coding RNA with RNAcentral and Rfam" ;
    schema1:startDate "2019-09-11 14:00:00 UTC"^^schema1:Date ;
