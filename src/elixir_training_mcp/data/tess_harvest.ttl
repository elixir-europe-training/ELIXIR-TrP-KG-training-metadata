<https://tess.elixir-europe.org/materials/bioinformatics-for-principal-investigators-a-curated-collection-of-embl-ebi-on-demand-training> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Clinicians" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ] ;
    schema1:description "Principal investigators (PIs) working in the life sciences need to gain an overview of how they and their group can handle the biological data they generate. This collection provides an introduction to bioinformatics, discussion around making the most of your groups data, suggestions of tools and resources to use, and guidance around the bioinformatics-related competencies your team may need. " ;
    schema1:keywords "Bioinformaticians",
        "Bioinformatics",
        "Competencies",
        "Data management",
        "Principal investigators" ;
    schema1:learningResourceType "e-learning" ;
