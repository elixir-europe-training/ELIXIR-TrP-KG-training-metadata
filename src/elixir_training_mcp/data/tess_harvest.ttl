<https://tess.elixir-europe.org/events/version-control-with-git-c5cc6401-d8a1-419a-bf76-8981eedeeae9> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
