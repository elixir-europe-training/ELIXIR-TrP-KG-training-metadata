<https://tess.elixir-europe.org/events/nris-hpc-on-boarding-user-course> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "students" ],
        [ a schema1:Audience ;
            schema1:audienceType "researchers" ] ;
    schema1:description """Are you planning to use our e-infrastructure services in the near future? Have you been using these services already, but would like to get trained? Then this NRIS HPC On-boarding course is intended for you! \r
Who can join? \r
\r
The course is aimed at students, researchers, and employees of any background. So, don't hesitate to register. We assume no prior knowledge of what HPC is or how to use it. \r
\r
For those who have little experience with UNIX-like operating systems such as Linux, or who have never worked on the command line of a terminal, NRIS offers a hands-on pre-course about UNIX a day before the HPC course.\r
\r
Registration closes on 25th April""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2022-05-05 12:30:00 UTC"^^schema1:Date ;
            schema1:startDate "2022-05-03 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "HPC",
        "UNIX" ;
    schema1:name "NRIS HPC On-boarding User Course" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "NRIS" ;
            schema1:url <https://www.sigma2.no/nris> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ;
            schema1:url <https://elixir.no/> ] ;
    schema1:url <https://documentation.sigma2.no/training/events/2022-05-hpc-on-boarding.html> .

<https://tess.elixir-europe.org/events/nsf-includes-conference-on-multi-scale-evaluation-in-stem-education> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description "NIMBioS and NISER are co-hosting an NSF INCLUDES Conference on Multi-Scale Evaluation in STEM Education. Effective program evaluation is an essential component of STEM education and workforce development. The conference and associated events will enhance participants' abilities to develop an evaluation plan that meets the needs of an INCLUDES Alliance Project. Participants will include individuals involved in current INCLUDES projects, those considering collaborating in such projects and STEM educators considering inclusion of formal evaluation in their projects. Examples of program evaluation developed by the program organizers are available at http://www.nimbios.org/NISER." ;
    schema1:endDate "2016-10-24 00:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:location [ a schema1:Place ;
