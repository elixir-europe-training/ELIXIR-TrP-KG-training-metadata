<https://tess.elixir-europe.org/materials/plant-phenotyping-data-managment-webinar-miappe> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0219>,
        <http://edamontology.org/topic_0780>,
        <http://edamontology.org/topic_3298>,
        <http://edamontology.org/topic_3572> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists, Genomicists, Computer Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "software developers, bioinformaticians" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Cyril Pommier" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Célia Michotey" ],
        [ a schema1:Person ;
            schema1:name "Anne-Françoise Adam-Blondon" ],
        [ a schema1:Person ;
            schema1:name "Cyril Pommier" ] ;
    schema1:description """The Minimal Information About Plant Phenotyping Experiment, MIAPPE (www.miappe.org), has been designed by ELIXIR, EMPHASIS and Bioversity international, to guide plant scientist in the management of experimental data. Furthermore, since genetic studies relies on the integration and the linking between phenotype and genotype datasets, relevant section of MIAPPE are beginning to be used for genotyping standards. This Webinar will give an overview of the current practices and methods for plant phenotyping data standardization, and how to deal with the variability and heterogeneity inherent to research and breeding data sets. Data management approaches at some of the major research organizations will be given as examples. \r
\r
The recording is available [here](https://youtu.be/4FOQPAWl6_M) and the slides are [here](https://drive.google.com/file/d/1FORlCX662T9dxiG4uzQwVXDXnq-sP0FP/view?usp=sharing)""" ;
    schema1:educationalLevel "beginner" ;
    schema1:learningResourceType "Slides",
        "Video" ;
    schema1:license <https://spdx.org/licenses/CC-BY-NC-ND-4.0.html> ;
