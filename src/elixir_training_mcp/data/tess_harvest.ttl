<https://tess.elixir-europe.org/events/bigomics-genomique-comparative-biopolis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Ce module vise à fournir une expérience d’analyse de données de génomique.\r
Les technologies Next Generation Sequencing (NGS) ont conduit à une production massive de\r
données « Omiques » pour les plantes cultivées majeures, ce qui demande de nouvelles\r
approches d’analyses haut débit. La connaissance de ces approches et des outils qui en\r
découlent pour analyser la séquence et la structure des génomes, les annoter et caractériser\r
leur diversité et leurs profils d’expression permet d’aborder des questions de recherche\r
biologique avancée sur la diversité et l’adaptation des plantes. Les espèces prises en\r
considération sont des espèces phares des instituts de recherche agronomique de Montpellier\r
et font partie des cultures les plus importantes pour l’agriculture mondiale. Des plateformes\r
d’outils bioinformatiques récents reposant sur des centres de calcul et de stockage haute\r
capacité, sont en place pour analyser des jeux de données originales permettant de mieux\r
comprendre comment les génomes de plantes évoluent et s’expriment. L’ensemble de ces\r
connaissances Findable, Accessible, Interoperable, Reusable car intégré dans des systèmes\r
d’information peut soutenir l'identification de gènes responsables de caractères adaptatifs ou\r
de production. La mobilisation de jeunes chercheurs sur ces sujets est primordiale tant la\r
demande est importante.\r
Le module est structuré sous la forme de cours et de travaux tutorés avec la rencontre de\r
généticiens et de bioinformaticiens permettant d’appréhender les formes variées des progrès\r
en bioanalyse génomique. Il permet d’acquérir les lignes directrices pour l’accès, l'utilisation\r
et l'analyse de différents types de données omique (e.g. (épi)génomique, transcriptomique,\r
protéique, métabolique) en vue d’accélérer les recherches en génomique fonctionnelle et\r
biotechnologie des plantes.\r
L’évaluation sera faite sur la base de la participation et de la qualité du projet proposé par\r
l’étudiant en fin de module, individuellement ou en binôme, suivant les consignes détaillées en\r
début de module""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-03-08 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Montpellier" ;
                            schema1:streetAddress "Salle 159 Batiment 3 CIRAD Lavalette, Avenue Agropolis" ] ;
                    schema1:latitude "43.611242" ;
                    schema1:longitude "3.876734" ] ;
            schema1:maximumAttendeeCapacity 50 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "CIRAD (http://www.cirad.fr/en/home-page), INRAE (https://www.inrae.fr/), IRD (https://www.ird.fr), South Green (http://www.southgreen.fr)" ] ;
            schema1:startDate "2024-03-04 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "BIGomics, Génomique Comparative Biopolis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "IFB French Institute of Bioinformatics" ;
            schema1:url <http://www.france-bioinformatique.fr> ] ;
    schema1:url <https://elearning.cirad.fr/mod/resource/view.php?id=2339> .

<https://tess.elixir-europe.org/events/biigle-user-meeting-2025> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Tim W. Nattkemper, Martin Zurowietz (BiGi)\r
\r
Date:\r
September 30th, 2025 (14:00-17:00 CEST)\r
\r
Location:\r
Online\r
\r
Contents:\r
The meeting targets existing users of the BIIGLE image and video annotation software (https://biigle.de) and anyone who wants to connect with the BIIGLE community. In the meeting, we will hear reports about annotation workflows, new BIIGLE features and have an extensive Q&amp;A session with the developers.\r
\r
Prerequisites:\r
Participants will join remotely using their personal devices. We will use the conferencing solution Zoom.\r
\r
Keywords:\r
image annotation, video annotation\r
\r
Tools:\r
BIIGLE""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2025-09-30 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Germany" ;
                            schema1:addressLocality "Online" ] ;
                    schema1:latitude "50.56912" ;
                    schema1:longitude "10.449144" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI & ELIXIR-DE" ] ;
            schema1:startDate "2025-09-30 14:00:00 UTC"^^schema1:Date ] ;
    schema1:name "BIIGLE User Meeting 2025" ;
