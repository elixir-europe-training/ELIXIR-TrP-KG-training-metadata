        [ a schema1:Thing ;
            schema1:name "kraken2" ;
            schema1:url <https://bio.tools/tool/kraken2> ],
        [ a schema1:Thing ;
            schema1:name "Falco" ;
            schema1:url <https://bio.tools/tool/falco> ],
