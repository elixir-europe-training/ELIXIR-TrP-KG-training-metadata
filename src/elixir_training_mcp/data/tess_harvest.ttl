<https://tess.elixir-europe.org/events/elixir-europe-conference-core-resources-for-a-data-economy> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """ELIXIR Core Data Resources are a set of data resources that are of fundamental importance to the broad life science community and the long-term preservation of biological data. Their impact is becoming increasingly apparent as greater volumes of complex data are being generated from national and EC-funded research projects. One of the core missions of ELIXIR is to provide stable and sustainable access to these resources. \r
	\r
	The high-level conference will address several aspects of these topics, from the perspective of funders, infrastructure operators and users across industry and academia. The event will include an outline of the process that has been established to define the first set of ELIXIR Core Data Resources and panel discussions on the subjects of impact and sustainability. Representatives of the European Commission will give keynote talks on 'Building the European Data Economy' and 'Research Infrastructures for Open Science'. \r
\r
Full programme in pdf\r
Register here""" ;
    schema1:endDate "2017-05-11 17:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Belgium" ;
                    schema1:addressLocality "Brussels" ;
                    schema1:streetAddress "THON HOTEL EU" ] ;
            schema1:latitude "50.843972" ;
            schema1:longitude "4.375321" ] ;
    schema1:name "ELIXIR Europe conference: Core Resources for a Data Economy" ;
    schema1:startDate "2017-05-11 09:30:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/elixir-europe-conference-core-resources-data-economy> .

<https://tess.elixir-europe.org/events/elixir-excelerate-all-hands-meeting-2019> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description "The fifth ELIXIR All Hands meeting will take place 17 -20 June 2019 in Lisbon. The meeting brings together members of the ELIXIR community from across the ELIXIR Nodes, and collaborators from partner organisations, in order to review ELIXIR’s achievements and activities so far and discuss plans for the future. The All Hands meeting is also the venue for the ELIXIR-EXCELERATE Annual General Assembly Meeting." ;
