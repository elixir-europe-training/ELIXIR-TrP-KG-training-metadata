                    schema1:postalCode "CB10 1SD" ;
                    schema1:streetAddress "European Bioinformatics Institute (EMBL-EBI) - Training Room 2, Wellcome Genome Campus" ] ;
            schema1:latitude "52.078533" ;
            schema1:longitude "0.186135" ] ;
    schema1:name "Managing a Bioinformatics Core Facility" ;
    schema1:startDate "2019-06-04 09:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2019/managing-bioinformatics-core-facility> .

<https://tess.elixir-europe.org/events/managing-a-bioinformatics-core-facility-4e196803-106a-4bfc-ad25-b3b967796e70> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description """This knowledge exchange workshop is an opportunity for managers of bioinformatics core facilities to learn from each other and EMBL-EBI’s service teams. These facilities play an essential role in enabling research in the life sciences. The landscape is constantly evolving as new research tools emerge, as experiments become increasingly data-intensive, and as their users – experimental researchers – become more exposed to the power of data-driven biology.  
This course will allow participants to share experiences, discuss challenges and solutions that they face, and plan ways to cope with the ever-changing demands raised by the molecular life science field. There will be sessions to learn from bioinformatics service providers, hear how others have tackled common problems, and work together to design core services, resource them, and measure their impact.  
A limited number of travel bursaries are available. Please see the ‘Additional information’ tab for conditions.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-12-10 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressRegion "Cambridge" ;
                            schema1:postalCode "CB10 1SD" ;
                            schema1:streetAddress "European Bioinformatics Institute, Hinxton" ] ] ;
            schema1:maximumAttendeeCapacity 15 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2025-12-08 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Budgeting",
        "Core facility services",
        "Principal investigators",
        "Project management",
        "Team building" ;
    schema1:name "Managing a bioinformatics core facility" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/managing-bioinformatics-core-facility-2025> .

