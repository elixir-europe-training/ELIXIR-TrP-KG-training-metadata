<https://tess.elixir-europe.org/events/elixir-excelerate-train-the-trainer-bbfaa553-5eee-47d5-81d3-381e607a71c9> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """ELIXIR-IIB, in cooperation with the ELIXIR-EXCELERATE Train-The-Trainer programme, will hold a Train the Trainer (TtT) event in connection with a course on “Best Practices for RNA-Seq analysis”.\r
\r
The course is made up of four sessions, covering:\r
\r
\r
	Learning principles and how they apply to training and teaching\r
	Teaching techniques that can be used to enhance learner engagement and participation\r
	Assessment and feedback in training and teaching\r
	Lesson, course, and materials design\r
""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2017-09-29 16:00:00 UTC"^^schema1:Date ;
