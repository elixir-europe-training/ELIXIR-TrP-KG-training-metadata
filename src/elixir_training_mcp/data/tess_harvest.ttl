<https://tess.elixir-europe.org/events/alphamissense-predictions-for-human-genetic-variation-research> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_0331>,
        <http://edamontology.org/operation_1777>,
        <http://edamontology.org/operation_3197>,
        <http://edamontology.org/operation_3225>,
        <http://edamontology.org/operation_3227>,
        <http://edamontology.org/topic_0082> ;
    schema1:description "This webinar will explore AlphaMissense, a model based on AlphaFold. AlphaMissense is designed to analyse missense variants, which are individual amino acid changes in proteins. Classifying these variants is crucial for understanding which ones might contribute to disease development.Our guest speaker from Google DeepMind will introduce AlphaMissense. You will gain insights into its underlying technology, how it analyses variants, and what the generated scores represent. Importantly, all predictions from AlphaMissense are freely available to the scientific community.The webinar will then showcase how EMBL-EBI resources integrate AlphaMissense data. This includes details on how the data is stored, displayed, and accessed by researchers studying human genetic variations.We will conclude by a question and answer session with all the presenters." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-06-07 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-06-07 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "AlphaFold Database",
        "DNA & RNA (dna-rna)",
        "Ensembl",
        "Protein Data Bank in Europe",
        "Proteins (proteins)",
        "UniProt: The Universal Protein Resource",
        "Variant prediction" ;
    schema1:name "AlphaMissense predictions for human genetic variation research" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/alphamissense-predictions-human-genetic-variation-research> .

