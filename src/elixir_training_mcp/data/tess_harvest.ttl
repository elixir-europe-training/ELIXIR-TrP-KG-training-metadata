<https://tess.elixir-europe.org/events/all-of-the-genes-none-of-the-code> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_4012> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:description """This workshop presents a gentile introduction to analysing omics data without the need to write any code.\r
\r
Participants will learn the basics of omics data analysis and the FAIR principles (Findable, Accessible, Interoperable, Reusable).\r
\r
They will then apply that knowledge to build a simple omics pipeline using Galaxy, a free and open source software that allows the use of bioinformatics tools and assembly of pipelines without the need to write any code.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
