<https://tess.elixir-europe.org/events/train-the-trainer-course-for-data-managers-and-data-management-trainers> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "data stewards" ],
        [ a schema1:Audience ;
            schema1:audienceType "trainers" ],
        [ a schema1:Audience ;
            schema1:audienceType "data managers" ] ;
    schema1:description """The ELIXIR Train the Trainer program (TtT) aims to build a network of trainers to allow them to benefit from reciprocal support and discussion. ELIXIR TtT courses aim to give new instructors tools and tips for providing an enriching learning experience to trainees, irrespective of the topic, and to include best-practice guidance on course and training material development. At the end of each session, targeted discussions about DM/DMP/DS training challenges will be addressed.\r
\r
Content of the course:\r
-    Review of learning principles and how they apply to training and teaching\r
-    Session, course, and material design\r
-    Training techniques that can be used to enhance learner engagement and participation\r
-    Assessment and feedback in training\r
\r
Learning Objectives:\r
-    To get acquainted with Learning principles and how they apply them to training\r
-    To be able to select and utilize training techniques that can be used to enhance learner engagement and participation\r
-   To learn how to use assessment and feedback in training\r
-    To learn about session, course, and materials design\r
""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
