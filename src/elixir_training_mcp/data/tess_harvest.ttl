<https://tess.elixir-europe.org/events/sharing-bioinformatics-training-and-building-a-region-wide-programme> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "High-throughput genomic data analysis is now a defining skill in the life sciences. There is already a shortage of researchers who can bridge the gap between computational approaches to data and biological insights, and this demand is only getting stronger. Bioinformatics training is under-provisioned in the North of England, with many small Bioinformatics teams at different institutes lacking the resources to deliver a full Bioinformatics training programme." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
