<https://tess.elixir-europe.org/events/rstudio-algajale> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0605> ;
    schema1:audience [ a schema1:Audience ;
