<https://tess.elixir-europe.org/events/cabana-workshop-genomic-analysis-of-crop-biodiversity-using-r> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Derrin Crawte" ;
    schema1:description "This course will provide training on using R in genomics applications for crop biodiversity." ;
    schema1:endDate "2019-06-28 17:45:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
