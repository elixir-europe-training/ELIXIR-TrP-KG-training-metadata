<https://tess.elixir-europe.org/events/modelling-covid-19-epidemics> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description "This six half-days practical course (30 Nov - 2 Dec &amp; 7- 9 Dec) is aimed to learn how to use and tailor the Westerhoff &amp; Kolodkin (NPJ, [Systems Biology and Applications (June 2020)](https://doi.org/10.1038/s41540-020-0138-8) COVID-19’s model as a tool to analyse late phases of the COVID-19 pandemic, to collect and analyse data, and to use these data for model-driven predictions that identify the best strategies for dealing with the second wave of this pandemic and with future epidemics of this type." ;
    schema1:endDate "2020-11-30 00:00:00 UTC"^^schema1:Date ;
