            schema1:url <https://bio.tools/tool/tb-profiler> ],
        [ a schema1:Thing ;
            schema1:name "Trimmomatic" ;
            schema1:url <https://bio.tools/tool/trimmomatic> ],
        [ a schema1:Thing ;
            schema1:name "COMBAT-TB Workbench" ;
            schema1:url <https://bio.tools/tool/combat-tb_workbench> ],
