<https://tess.elixir-europe.org/events/fuel-sessions> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "1:1 Coaching for VIB Group Leaders &amp; ManagersBeing a group leader or manager at VIB comes with many challenges — balancing scientific excellence with team leadership, strategic priorities and personal wellbeing. To support you in this role, VIB offers Leadership dialogues: short, individual coaching sessions (90 minutes) where you can reflect, recharge and gain new insights to tackle your leadership challenges.These sessions are safe, confidential conversations with experienced coaches who know the academic and research context. They act as your sounding board, helping you prepare for key conversations, strengthen your leadership approach, or clarify your next career steps.Examples of topics:Handling conflict or tension within your teamFinding balance between priorities, expectations and personal aspirationsDelegating and motivating your team effectivelyPreparing for a difficult conversation or decisionOrganising a team event or retreat that truly makes an impactDeveloping your group’s strategy and long-term directionReflecting on your career path and next stepsAll sessions are strictly confidential. If, after one or several Fuel sessions, no structural solution can be found for the challenge discussed, we encourage participants to reach out to their HR representative for further guidance and support. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "career development",
        "leadership & management" ;
    schema1:name "Fuel sessions" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/fuel-sessions> .

