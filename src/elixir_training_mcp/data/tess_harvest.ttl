<https://tess.elixir-europe.org/events/rna-seq-data-analysis-with-galaxy-for-clinical-applications> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Markus Wolfien, Andrea Bagnacani, Olaf Wolkenhauer" ;
    schema1:endDate "2018-09-07 00:00:00 UTC"^^schema1:Date ;
    schema1:name "RNA-Seq data analysis with Galaxy for clinical applications" ;
    schema1:startDate "2018-09-02 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://gmds.de/fileadmin/user_upload/GMDS2018/Tagungsprogramm_GMDS_2018_v18.pdf#page=60> .

<https://tess.elixir-europe.org/events/rna-seq-data-analysis-with-galaxy-for-clinical-applications-gmds-2019> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """\r
\r
Educators:\r
Andrea Bagnacani, Markus Wolfien (RBC / de.STAIR)\r
\r
Location:\r
Emil-Figge-Straße 44, 44227 Dortmund\r
\r
Date:\r
08.09.2019, 10:00 - 18:00\r
\r
Contents:\r
In this workshop, we provide a summary of the applications  of Next Generation Sequencing (NGS) technologies in the clinical context. These are presented through a hands-on session on RNA-Seq data analysis, following a use case to tudy a clinical NGS dataset. Leveraging on the Galaxy environment, we guide the participants through all relevant steps for carrying out the analysis, as well as linking the obtained results with current gene-disease-related databases, or other relevant resources to highlight the clinical impact of the technology. Finally, we discuss our audience's NGS experiments, and provide advice on their NGS data analysis approaches.\r
\r
Learning goals:\r
Get familiar with the Galaxy framework (https://usegalaxy.eu) for carrying out scientific data analyses, learn methods for data exploration and quality control of NGS datasets, and get familiar with the concepts underlying genome  alignment and data visualization of subsequent results.\r
\r
Prerequisites:\r
This workshop is intended for MSc/PhD students, postdocs, and researchers with a background in Life Science research.\r
\r
Keywords:\r
Galaxy, Reproducibility, Workflow development, RNA-Seq data analysis, Visualization\r
\r
Tools:\r
Galaxy (https://usegalaxy.eu), Galaxy Training material  (https://galaxyproject.github.io/training-material/)\r
\r
Contact:\r
info@gmds.de\r
\r
Registration:\r
https://gmds.de\r
""" ;
    schema1:endDate "2019-09-08 17:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Germany" ;
                    schema1:addressLocality "Dortmund" ;
                    schema1:addressRegion "Arnsberg" ;
                    schema1:streetAddress "Dortmund" ] ;
            schema1:latitude "51.513587" ;
            schema1:longitude "7.465298" ] ;
    schema1:name "RNA-Seq data analysis with Galaxy for clinical applications - GMDS 2019 " ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "de.NBI" ] ;
    schema1:startDate "2019-09-08 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.denbi.de/training/662-rna-seq-data-analysis-with-galaxy-for-clinical-applications-gmds-2019> .

<https://tess.elixir-europe.org/events/rna-seq-data-analysis-workshop-28ebaa59-8138-4d5b-887f-289b6a27f990> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0080>,
        <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3168> ;
    schema1:alternateName "Quality Control, Read Mapping, Visualization and Downstream Analyses" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Pathologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists, Genomicists, Computer Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "postdoc" ],
        [ a schema1:Audience ;
            schema1:audienceType "Molecular Biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ] ;
    schema1:description """Advance your research. Understand RNA-Seq analyses challenges and solve them yourself.\r
\r
In a nutshell\r
- Learn the essential computing skills for NGS bioinformatics\r
- Understand NGS analysis algorithms (e.g. read alignment) and data formats\r
- Use bioinformatics tools for handling RNA-Seq data\r
- Create diagnostic graphics and statistics\r
- Compare different approaches for differential expression analysis\r
\r
The purpose of this workshop is to get a deeper understanding in Next-Generation Sequencing (NGS) with a special focus on bioinformatics issues. Advantages and disadvantages of current sequencing technologies and their implications on data analysis will be discovered. You will be trained on understanding NGS data formats and handling potential problems/errors therein. In the course we will use a real-life RNA-seq dataset from the current market leader illumina.\r
\r
All workshop attendees will be enabled to perform important first tasks of NGS data analysis themselves. The course layout has been adapted to the needs of beginners in the field of NGS bioinformatics and allows scientists with no or little background in computer science to get a first hands-on experience in this new and fast evolving research topic.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2020-09-24 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Germany" ;
                            schema1:addressLocality "Leipzig" ;
                            schema1:addressRegion "Leipzig" ;
                            schema1:streetAddress "iad Pc-Pool" ] ;
                    schema1:latitude "51.34523" ;
                    schema1:longitude "12.39099" ] ;
            schema1:maximumAttendeeCapacity 12 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ecseq Bioinformatics GmbH" ] ;
            schema1:startDate "2020-09-21 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords " RNA-Seq",
        "NGS bioinformatics",
        "transcriptomics" ;
    schema1:name "RNA-Seq Data Analysis Workshop" ;
    schema1:url <https://www.ecseq.com/workshops/workshop_2020-04-RNA-Seq-data-analysis> .

