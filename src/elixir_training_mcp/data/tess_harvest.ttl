<https://tess.elixir-europe.org/events/elixir-norway-hands-on-bioinformatics-nels-workshop> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "life scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "data managers" ] ;
    schema1:description "We are pleased to announce the second hands-on bioinformatics NeLS workshop organised in Tromsø by [ELIXIR Norway](https://www.elixir-norway.org/). The topic is on how you can use the Norwegian e-Infrastructure for Life Sciences - [NeLS](nels.bioinfo.no) to store and share data, and to run analyses via customisable analysis workflows in Galaxy. More specifically, we will go through how you can store data in NeLS and upload it directly into Galaxy. We will also construct and run a complete sequence analysis workflow for taxonomic profiling on a metagenomic sample. There are no requirements for programming skills or experience using the command line, as Galaxy provides a web interface for running analysis." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-11-26 15:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Norway" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Norway" ;
                            schema1:addressLocality "Tromsø" ;
                            schema1:addressRegion "Tromsø" ;
                            schema1:postalCode "9019" ;
                            schema1:streetAddress "University of Tromsø, Medisin og helsefagbygget (MH øst): Datarom (U7.110)" ] ;
                    schema1:latitude "69.683397" ;
                    schema1:longitude "18.977134" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Norway" ] ;
            schema1:startDate "2019-11-26 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "EeLP",
        "Galaxy",
        "NeLS",
        "bioinformatics",
        "eLearning" ;
    schema1:name "ELIXIR Norway: Hands-on bioinformatics NeLS workshop" ;
    schema1:provider [ a schema1:Organization ;
