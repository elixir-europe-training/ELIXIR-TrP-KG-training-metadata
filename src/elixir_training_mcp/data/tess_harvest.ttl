<https://tess.elixir-europe.org/materials/ten-simple-rules-for-making-training-materials-fair> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_4012> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Post Docs" ],
        [ a schema1:Audience ;
            schema1:audienceType "Undergraduate students" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ] ;
    schema1:description """Sharing, reusing and reproducing data, software and other digital objects are the basis for open science practices, and to ease this the scientific community has developed the Findable, Accessible, Interoperable and Reusable (FAIR) principles. FAIR principles are however not so simple to understand and adopt, and may be quite convoluted for some.\r
\r
The ELIXIR Training Platform in cooperation with other associated partner ZB MED has put together a Ten Simple Rules for Making Training Materials FAIR which simplify the FAIR principles by breaking them down into very practical steps. This webinar introduced these ten rules and discussed the challenges and ideas to put them into practice.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "ELIXIR-CONVERGE",
        "FAIR",
        "FAIR data" ;
    schema1:learningResourceType "Video" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Ten simple rules for making training materials FAIR" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "de.NBI" ;
            schema1:url <https://www.denbi.de> ] ;
    schema1:url <https://www.denbi.de/online-training-media-library/1015-ten-simple-rules-for-making-training-materials-fair> .

