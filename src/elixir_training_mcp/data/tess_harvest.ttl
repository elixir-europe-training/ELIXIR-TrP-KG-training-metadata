<https://tess.elixir-europe.org/events/elaboracion-de-un-plan-de-gestion-de-datos-dmp> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_4012> ;
    schema1:alternateName "Preparation of a Data Management Plan (DMP)" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "IT support" ],
        [ a schema1:Audience ;
            schema1:audienceType "policy officer" ],
        [ a schema1:Audience ;
            schema1:audienceType "project manager" ],
        [ a schema1:Audience ;
            schema1:audienceType "operational manager" ],
        [ a schema1:Audience ;
            schema1:audienceType "data manager" ] ;
    schema1:description "Research Data Management is an activity that can transform a project into a great executed project, but it needs different skills beyond the specific scientific discipline, like IT or administration. This workshop will consist of two parts, in which we will discuss together the activity of Data Management under different perspectives. The first part will be oriented to the work of Project Managers and Administrators, creating or following a certain Data Management Policy, and dealing with the European and National calls asking to provide a Data Management Plan. The second part will be an interactive workshop for researchers and research technicians who work within a scientific project and have to actively interact with a Data Management Plan, read, follow and contribute to it." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-04-16 12:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "FEUGA" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "FEUGA" ] ;
            schema1:startDate "2021-04-16 10:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "DMP",
        "DMP evaluation",
        "DMP templates",
        "DMP tools",
        "ELIXIR-CONVERGE",
        "FAIR principles",
        "Spanish",
        "competency",
        "data management plan",
        "e-learning",
        "evaluation",
        "online",
        "research data management",
        "template",
        "tool" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Data Stewardship Wizard" ;
            schema1:url <https://bio.tools/tool/Data_Stewardship_Wizard> ] ;
    schema1:name "Elaboración de un Plan de Gestión de Datos (DMP)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Spain" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "Barcelona Supercomputing Center (BSC)" ;
            schema1:url <http://www.bsc.es> ],
        [ a schema1:Organization ;
            schema1:name "FEUGA" ] ;
    schema1:url <https://gesci.es/en/gosci/> .

