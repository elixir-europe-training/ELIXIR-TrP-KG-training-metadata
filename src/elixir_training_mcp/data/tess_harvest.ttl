<https://tess.elixir-europe.org/materials/an-introduction-to-unix> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Simon Andrews" ] ;
    schema1:description """Increasing amounts of bioinformatics work is done in a command line unix environment. Most large scale processing applications are written for unix and most large scale compute environments are also based on this.\r
\r
This course provides an introduction to the concepts of unix and provides a practical introduction to working in this environment. Internally we link this course to a more specific course illustrating the use of our internal cluster environment and this part of the course could be adapted for other sites with different compute infrastructure.\r
\r
**Course Content**\r
\r
* Unix commands\r
* Files and Directories\r
* Viewing, Creating, Copying, Moving and Deleting\r
* Permissions\r
* Pipes\r
\r
**Course Material**\r
\r
* [Course Manual (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Introduction%20to%20unix.pdf)\r
* [Course Manual (doc)](http://www.bioinformatics.babraham.ac.uk/training/Introduction%20to%20unix.docx)\r
* [Unix cheat sheet (pdf)](http://sites.tufts.edu/cbi/files/2013/01/linux_cheat_sheet.pdf) (External content from Tufts University)""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Babraham Institute",
        "Unix" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/other-nc> ;
    schema1:name "An Introduction to Unix" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Bioinformatics and Biomathematics Training Hub" ;
            schema1:url <http://www.earlham.ac.uk/bbsrc-bioinformatics-and-biomathematics-training-hub> ] ;
    schema1:url <http://www.bioinformatics.babraham.ac.uk/training.html#unix> .

