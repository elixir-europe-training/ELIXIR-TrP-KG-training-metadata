<https://tess.elixir-europe.org/events/bioexcel-summer-school-on-biomolecular-simulations> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Charlotte Pearton" ;
    schema1:description """The summer school will include lectures and hands-on sessions on the following topics:\r
\r
Molecular Dynamics simulations\r
Biomolecular Docking\r
QM/MM\r
Free energy calculations\r
Advanced sampling methods (metadynamics)\r
During the hands-on computer practicals you will work on a use case integrating the various topics above making use, among others, of the BioExcel flagship software (Gromacs, HADDOCK, PMX, CPMD).""" ;
    schema1:endDate "2018-06-22 12:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "BioExcel Summer School on Biomolecular Simulations" ;
    schema1:startDate "2018-06-17 18:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2018/bioexcel-summer-school-biomolecular-simulations> .

