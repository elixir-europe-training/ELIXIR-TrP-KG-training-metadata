            schema1:endDate "2023-09-20 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2023-09-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "DNA & RNA (dna-rna)",
        "Molecular building blocks of life",
        "Non-coding RNA",
        "RNAcentral",
        "ncRNA" ;
    schema1:name "Using RNAcentral to explore and investigate non-coding RNA sequences" ;
    schema1:provider [ a schema1:Organization ;
