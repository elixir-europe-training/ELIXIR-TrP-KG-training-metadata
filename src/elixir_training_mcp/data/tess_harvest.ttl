<https://tess.elixir-europe.org/materials/python-for-beginners> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3316> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Beginner" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD Students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researcher" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Priit Adler" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2025-02-11"^^schema1:Date ;
    schema1:dateModified "2025-05-11"^^schema1:Date ;
    schema1:datePublished "2025-05-15"^^schema1:Date ;
    schema1:description """The “Python for Beginners” course introduces Python programming, designed for those with little to no prior experience. Upon completion, students will have a firm grasp of Python fundamentals and be equipped with the skills to start their journey in Python programming.\r
\r
Python is a general-purpose programming language. It is an interpreted language, which makes it suitable for rapid development and prototyping of programming segments or complete small programs.\r
\r
Python’s main advantages:\r
\r
* Open source software, supported by Python Software Foundation\r
* Available on all major platforms (Windows, macOS, Linux)\r
* It is a good language for new programmers to learn due to its straightforward, object-oriented style.\r
* It is well-structured, which aids readability.\r
* It is extensible (i.e. modifiable) and is supported by a large community that provides a comprehensive range of 3rd party packages.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Python" ;
    schema1:learningResourceType "lessons" ;
    schema1:license <https://spdx.org/licenses/MIT.html> ;
    schema1:name "Python for beginners" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <https://elixir.ut.ee> ] ;
    schema1:teaches """* Understand Python variables, basic data types, and operators.\r
* Learn to control the flow of programs using loops, conditionals, and functions in Python.\r
* Learn about and manipulate Python's built-in data structures like lists, tuples, sets, and dictionaries.\r
* Understand how to read, write, and manipulate files in Python, handle exceptions, and learn the principles of object-oriented programming.""" ;
    schema1:url <https://github.com/ELIXIREstonia/2025-02-11-Python> .

