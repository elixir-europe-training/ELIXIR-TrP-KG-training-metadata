<https://tess.elixir-europe.org/materials/applied-metagenomics-am21-november-1-5-2021> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3174>,
        <http://edamontology.org/topic_3837> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researcher in life sciences" ],
        [ a schema1:Audience ;
            schema1:audienceType "Genomics data science PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers and bioinformaticians in other projects interested in depositiong data at the EGA" ],
        [ a schema1:Audience ;
            schema1:audienceType "genomics researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD Scholars, Graduates and Post Graduates, Professors, Associate Professors, Assistant Professors, Bio instruments Professionals, Bio-informatics Professionals, Directors, CEO’s of Organizations, Supply Chain companies, Manufacturing Companies, Software development companies, Research Institutes and members" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD candidates" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Espen Mikal Robertsen" ],
        [ a schema1:Person ;
            schema1:name "Erik Hjerde" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2021-11-01"^^schema1:Date ;
    schema1:datePublished "2025-05-07"^^schema1:Date ;
    schema1:description """This course will give a comprehensive introduction to the research field of metagenomics. It will cover the basic concepts of microbiome analysis of shotgun metagenomic data using state of the art bioinformatics (amplicon sequencing will not be covered).\r
\r
The analysis methods that are being introduced are generic for all types of microbiomes, but we will be using data from the human microbiome as showcases.\r
\r
The course will start with the main preprocessing steps of raw sequence data, before various downstream analysis will be covered separately. These include taxonomic analysis, assembly, binning, and finally functional analysis with focus on antibiotic resistance genes. The theoretical part for each topic will be introduced via lectures, followed by practical hands-on exercises.\r
\r
**Target Audience**\r
The course is intended for researchers and students that are, or are planning to work with data analysis of metagenomic data.\r
\r
**Software and Data**\r
All software and databases together with the exercise data will be pre-installed on the course machines you will be using during the practical exercises of the course.\r
\r
All data can be downloaded locally through [data](https://gtpb.github.io/AM21/assets/data.zip) (Zipped file).""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords "Genome Assembly",
        "Genome analysis",
        "Genome assembly",
        "Genomic data",
        "Genomic sequences",
        "Metagenomics",
        "Taxonomic concepts",
        "genomics",
        "metagenomics" ;
    schema1:learningResourceType "Course materials" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Applied Metagenomics - AM21 (November 1-5, 2021)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Portugal" ;
            schema1:url <https://elixir-portugal.org> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ;
            schema1:url <http://elixir-norway.org> ] ;
    schema1:teaches """On exit from this training course, the participant will have acquired a theoretical basis and practical experience to understand the basic concepts of metagenomic analysis in order to conduct academic studies related to microbiome samples. This includes:\r
\r
- performing advanced downstream analysis on both taxonomic functional profiles\r
- performing quality control, assembly and binning of metagenomic sequence data\r
- performing functional analysis and resistome analysis of metagenomes""" ;
    schema1:url <https://gtpb.github.io/AM21/> .

