    schema1:name "CABANA Train the Trainer Workshop for ISCB-Latin America 2020" ;
    schema1:startDate "2020-10-22 09:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2020/cabana-train-trainer-workshop-iscb-latin-america-2020> .

<https://tess.elixir-europe.org/events/cabana-train-the-trainer-workshop-for-iscb-latin-america-2020-70e91460-bf53-4efa-ab9a-d50f220f6629> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType """This&nbsp;is a highly interactive virtual workshop which will be delivered simultaneously in&nbsp;Spanish. Applications are open for researchers based in Latin America.\r
\r
Selection criteria:\r
There are a number of criteria upon which selection of participants for this workshop will be made. Candidates should be able to demonstrate:\r
\r
\r
	They are at late-stage PhD level&nbsp;OR have equivalent years of research experience\r
	They are working in a Latin American institution and are likely to remain in the institution for the next year or more\r
	They are actively involved in a research project and actively using bioinformatics tools / methods\r
	They have a strong interest in training and have been involved in some training prior to joining the course\r
	They have identified a need / gap where training could be provided, and have thought about potential training they would like to deliver\r
\r
\r
The ideal candidate will have 3+ years of research experience which includes a bioinformatics component, and a strong interest in developing or delivering bioinformatics training. You do NOT have to be a bioinformatician to apply.\r
\r
Early-stage researchers and researchers from underrepresented ethnic groups are especially encouraged to apply.""" ] ;
    schema1:description """This virtual workshop takes place within the [ISCB-LA SoIBio BioNetMX 2020 symposium](https://www.iscb.org/iscb-latinamerica2020). It will provide new trainers with knowledge, skills, guidance and tips for developing and delivering training. Participants will explore a range of methods to enable and encourage learning, examine the requirements for a successful course and acquire appropriate feedback. 

The workshop will:

- provide guidance on general training techniques and appropriate use of methods based on learner needs, including some general 'DO's' and 'DO NOTs' for successful training
- provide a framework for successful curriculum design and further development, to enable trainers to build a course appropriate to their learners' needs

The workshop will take place virtually via [Zoom](https://www.ebi.ac.uk/zoom.us). """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2020-10-23 17:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-10-22 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Training (Training)" ;
    schema1:name "CABANA train the trainer workshop for ISCB-Latin America 2020" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/cabana-train-trainer-workshop-iscb-latin-america-2020> .

