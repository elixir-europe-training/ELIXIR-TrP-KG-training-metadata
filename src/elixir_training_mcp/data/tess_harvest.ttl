<https://tess.elixir-europe.org/materials/cineca-discovery-service-catalog> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Jordi Rambla" ],
        [ a schema1:Person ;
            schema1:name "Frédéric Haziza" ],
        [ a schema1:Person ;
            schema1:name "Jonathan Dursi" ] ;
    schema1:description """This series of three videos describes and demonstrates the CINECA service catalog:\r
\r
The first video introduces the Service Catalog, a searchable listing of query services available atop CINECA cohort data, and explains where it fits into CINECA’s set of interactive queries and data federation.\r
\r
The second video demonstrates how a standalone service registry operates, and our extensions to the service info and service registry standards to include cohort-level metadata.\r
\r
The third video demonstrates how a service registry can operate with additional functionality when integrated more closely with the services providing queries (here, Beacon queries).""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords " Beacon queries",
        "Cohort data",
        "Standards",
        "federated data analysis" ;
    schema1:learningResourceType " Series of videos" ;
    schema1:license <https://spdx.org/licenses/CC-BY-NC-SA-4.0.html> ;
    schema1:name "CINECA discovery service catalog" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "CINECA PROJECT" ;
            schema1:url <https://www.cineca-project.eu/> ] ;
    schema1:url <https://www.youtube.com/playlist?list=PLD6bAdANKoMX5ntDRlNHAWKrnPdshLVgT> .

<https://tess.elixir-europe.org/materials/citizen-science-toolkit-for-biodiversity-scientists> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description "The Citizen Science Toolkit is aimed at researchers and scientists working in the fields of biodiversity or environmental sciences who are involved or have an interest in involving citizens in their research projects. The objective of this toolkit is to inform about the potential benefits of citizen science, and to highlight rationales for doing citizen science, current best practices, and useful resources in the field.   The toolkit is structured as follows: PART I: INTRODUCTION PART II: BENEFITS &amp; CHALLENGES PART IV: KEY PRINCIPLES &amp; RECOMMENDATIONS FOR SUCCESSFUL CITIZEN SCIENCE PART V: CONCLUSION BIBLIOGRAPHY &amp; RESOURCES" ;
    schema1:keywords "Citizen Science" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Citizen Science Toolkit for biodiversity scientists" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ERGA Knowledge Hub" ;
            schema1:url <https://knowledge.erga-biodiversity.eu/> ] ;
    schema1:url <https://zenodo.org/records/3979343> .

