<https://tess.elixir-europe.org/events/qupath-quantitative-pathology-bioimage-analysis-software-1181eee0-0ead-486f-912d-0e204a38be88> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This introductory QuPath course is designed for early-stage researchers—particularly 1st-year PhD students, postdocs, and research support staff—who are new to digital pathology and image analysis. As high-throughput imaging becomes increasingly central to biomedical research, the ability to efficiently analyze whole slide images is essential. This training provides a hands-on introduction to QuPath, a powerful open-source platform for bioimage analysis. Participants will learn how to navigate the software, perform cell segmentation, classify pixels and objects, and extract quantitative features. The course also introduces basic scripting for batch processing, enabling scalable workflows. By the end of the session, attendees will be equipped to independently analyze their own histological data and integrate image analysis into their research pipelines." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2026-01-23 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3000" ;
                            schema1:streetAddress "Leuven - Campus Gasthuisberg, Herestraat 49" ] ;
                    schema1:latitude "50.879202" ;
                    schema1:longitude "4.701168" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2026-01-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "hands-on",
        "imaging",
        "software" ;
    schema1:name "QuPath: quantitative pathology & bioimage analysis software" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Basics of scripting in QuPath to batch process”",
        "“Cell Segmentation”",
        "“Feature extractions”",
        "“Object classification”",
        "“Overview of QuPath: manage images annotations general concepts”",
        "“Pixel classification”" ;
    schema1:url <https://training.vib.be/all-trainings/qupath-quantitative-pathology-bioimage-analysis-software-10> .

