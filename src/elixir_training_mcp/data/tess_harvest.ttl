<https://tess.elixir-europe.org/events/introduction-to-multiomics-data-integration-and-visualisation> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Meredith Willmott" ;
