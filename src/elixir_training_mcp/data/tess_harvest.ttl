<https://tess.elixir-europe.org/events/managing-stress-and-burnout-essentials> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "In this introductory session, participants will gain a good understanding of the effect of stress, what function stress has and when positive stress becomes negative. Many people are not aware of the possible stress signals. As a result, they ignore these signals for too long, making the problem worse and worse. Understanding stress in yourself and others can prevent a lot of suffering.A major cause of stress is lack of recuperation. The second part of this session, therefore, aims to teach a method that ensures that the autonomic nervous system returns to balance by learning to build in moments of recuperation (this is not just relaxing). This will give you more energy day after day, and stress ailments will disappear. Chronic stress keeps our nervous system stuck in action mode. As a result, one no longer comes to rest naturally. Because there is a chronic lack of recovery and recuperation, one loses more energy day after day, and more and more stress complaints arise. Through this exercise we ensure that the relaxing part of our nervous system is activated again so that we restore our natural balance." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2026-01-27 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3000" ;
                            schema1:streetAddress "Leuven - Campus Gasthuisberg, Herestraat 49" ] ;
                    schema1:latitude "50.879202" ;
                    schema1:longitude "4.701168" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2026-01-27 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "wellbeing" ;
    schema1:name "Managing stress and burnout - essentials" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/managing-stress-and-burnout-essentials-0> .

<https://tess.elixir-europe.org/events/managing-stress-and-burnout-essentials-f929ef19-ce86-4693-bbdd-6eb6e9366a1f> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "In this introductory session, participants will gain a good understanding of the effect of stress, what function stress has and when positive stress becomes negative. Many people are not aware of the possible stress signals. As a result, they ignore these signals for too long, making the problem worse and worse. Understanding stress in yourself and others can prevent a lot of suffering.A major cause of stress is lack of recuperation. The second part of this session, therefore, aims to teach a method that ensures that the autonomic nervous system returns to balance by learning to build in moments of recuperation (this is not just relaxing). This will give you more energy day after day, and stress ailments will disappear. Chronic stress keeps our nervous system stuck in action mode. As a result, one no longer comes to rest naturally. Because there is a chronic lack of recovery and recuperation, one loses more energy day after day, and more and more stress complaints arise. Through this exercise we ensure that the relaxing part of our nervous system is activated again so that we restore our natural balance." ;
