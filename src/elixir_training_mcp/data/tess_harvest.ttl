<https://tess.elixir-europe.org/materials/introduction-to-federated-ega-a-resource-for-discovery-and-access-of-human-data-across-national-borders> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description """Discovery and access to sensitive data across national boundaries is vital for improving human health, enabling more powerful and efficient research by increasing the volume and diversity of data available for analysis. However, data generated in a clinical context are subject to stricter governance than research data and must follow national data protection legislation.\r
\r
In 2022, Federated EGA was launched as a resource for discovery and access to human omics data through a network of national data archives, while also respecting jurisdictional data protection regulations.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "ELIXIR Converge",
        "FEGA",
