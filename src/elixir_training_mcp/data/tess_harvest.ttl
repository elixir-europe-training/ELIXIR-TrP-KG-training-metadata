            schema1:audienceType "PhD students" ] ;
    schema1:description """The sixth in a series of hands-on bioinformatics workshops organized in Oslo by ELIXIR.\r
The topic is on how you can use the Norwegian e-Infrastructure for Life Sciences (NeLS) (nels.bioinfo.no) to store and share data, and to run analyses via customizable genomics pipelines (Galaxy). Together, we will go through a complete RNA sequencing analysis pipeline.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
