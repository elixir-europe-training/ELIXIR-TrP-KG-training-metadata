        [ a schema1:Audience ;
            schema1:audienceType "PhD students and young researchers in the life science and computational biology" ] ;
    schema1:description "The goal of this second Summer School on Biophysics in Greece is to introduce advanced undergraduates, Master's and PhD students with backgrounds in Physics, Biology, Materials Science, Mathematics, CS to the interdisciplinary field of Biophysics and expand the toolset and horizons of those already working on Biophysics. The school aims to show how Biophysics is using all the above sciences to advance, making it an exciting and scientifically inclusive field. Student-instrutor interaction will be maximized via lectures on theory and experiments, workshops on computational and experimental data analysis tools, and plenty of opportunities for discussions." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
