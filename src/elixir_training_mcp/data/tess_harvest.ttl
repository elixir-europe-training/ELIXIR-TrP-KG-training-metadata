<https://tess.elixir-europe.org/events/bioexcel-summer-school-on-biomolecular-simulations-2022> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_2476>,
