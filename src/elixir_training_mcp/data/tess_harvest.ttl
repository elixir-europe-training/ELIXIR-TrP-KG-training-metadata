<https://tess.elixir-europe.org/events/restoring-balance-in-a-connected-world> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Unplugging for greater productivity, focus, and job satisfaction!Being always connected can have a major impact on both our concentration (during work) and the ability to mentally disconnect from work. That, in turn, impacts your concentration and productivity, and the negative spiral is set off. The consequences of always being on can weigh on our well-being as well as our productivity.That is why, during this training, you will gain insight into your own disconnection profile, and we will provide tools to deal with various forms of hyperconnectivity. You will go home with hands-on techniques to deal with the 3 forms of disconnection (digital, psychological, and emotional) into practice. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2026-03-16 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2026-03-16 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "wellbeing" ;
    schema1:name "Restoring balance in a connected world" ;
    schema1:provider [ a schema1:Organization ;
