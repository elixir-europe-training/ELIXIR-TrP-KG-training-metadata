<https://tess.elixir-europe.org/events/introduction-to-protein-structure-analysis-autumn-session> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """\r
	Get to know the data generated from protein structure determination experiments (high-resolution NMR spectroscopy, X-ray crystallography, electron microscopy, ...) and where to get it.\r
	Display protein structure data and compare structures, through the use of Yasara.\r
	Create high-quality graphical representations of the structures.\r
	Calculate the effect of mutations on the stability of your protein.\r
""" ;
