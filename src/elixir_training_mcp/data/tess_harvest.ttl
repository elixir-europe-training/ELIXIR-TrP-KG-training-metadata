                            schema1:addressLocality "Ghent" ;
                            schema1:postalCode "9000" ;
                            schema1:streetAddress "Ghent - Clemenspoort, Overwale 3" ] ;
                    schema1:latitude "50.881367" ;
                    schema1:longitude "3.725012" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2020-09-10 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
