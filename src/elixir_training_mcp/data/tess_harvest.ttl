<https://tess.elixir-europe.org/events/geomine-proteinsplus-versatile-tools-for-structural-investigations> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Dr. Katrin Schöning-Stierand, Dr. Christiane Ehrt (BioData)\r
\r
Date:\r
May 20th, 2021, 4 - 7 pm\r
\r
Location:\r
Online\r
\r
Contents:\r
- Introduction to GeoMine\r
- Demo and Hands-On Sessions to Generate GeoMine Queries for Interaction Profiling\r
- Selectivity Analyses and Off-Target Identification\r
\r
Learning goals:\r
Learning to construct and run GeoMine queries on the ProteinsPlus server to examine binding sites with a focus on structure-based design\r
\r
Prerequisites:\r
Basic Knowledge of Protein Structures, Interest in Binding Sites\r
\r
Keywords:\r
geometric data mining, protein-ligand complexes, structure-based design, medicinal chemistry""" ;
