    schema1:teaches """- Explain the definition and importance of using identifiers.
- Illustrate what are the persistent identifiers.
- Give examples of the structure of persistent identifiers.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/fair/tutorials/fair-persistent-identifiers/tutorial.html> ;
    schema1:version "2" .

