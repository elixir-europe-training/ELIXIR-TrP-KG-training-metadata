<https://tess.elixir-europe.org/materials/eatris-transmed-academy> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3325> ;
    schema1:audience [ a schema1:Audience ;
