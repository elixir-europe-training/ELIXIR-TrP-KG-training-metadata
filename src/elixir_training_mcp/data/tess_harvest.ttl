    schema1:description """## Abstract

# What is a recurrent neural network (RNN)?


## Questions this  will address

 - What is a recurrent neural network (RNN)?
 - What are some applications of RNN?


## Learning Objectives

- Understand the difference between feedforward neural networks (FNN) and RNN
- Learn various RNN types and architectures
- Learn how to create a neural network using Galaxy’s deep learning tools
- Solve a sentiment analysis problem on IMDB movie review dataset using RNN in Galaxy""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Statistics and machine learning" ;
    schema1:learningResourceType "slides" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/4477881> ],
        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/statistics/tutorials/RNN/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "scikit-learn" ;
            schema1:url <https://bio.tools/tool/scikit-learn> ] ;
    schema1:name """Recurrent neural networks (RNN) 
 Deep Learning - Part 2""" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Understand the difference between feedforward neural networks (FNN) and RNN
- Learn various RNN types and architectures
- Learn how to create a neural network using Galaxy’s deep learning tools
- Solve a sentiment analysis problem on IMDB movie review dataset using RNN in Galaxy""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/statistics/tutorials/RNN/slides.html> ;
    schema1:version "1" .

