                    schema1:longitude "134.755" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Australian BioCommons" ] ;
            schema1:startDate "2020-11-04 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Galaxy Australia: enabling online data analysis for the research community" ;
    schema1:provider [ a schema1:Organization ;
