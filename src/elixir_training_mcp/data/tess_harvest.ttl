            schema1:name "bx-python" ;
            schema1:url <https://bio.tools/tool/bx-python> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/introduction/tutorials/galaxy-intro-peaks2genes/workflows/> ] ;
    schema1:name "From peaks to genes" ;
    schema1:provider [ a schema1:Organization ;
