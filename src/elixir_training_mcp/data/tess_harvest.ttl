            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Apply prompt engineering techniques to generate relevant outputs for tasks such as literature reviews content drafting and brainstorming”",
        "“Demonstrate the use of generative AI tools to support specific academic tasks including writing summarizing and ideation”",
        "“Describe the evolution and core principles of generative AI models and their relevance to academic research”",
        "“Evaluate the quality reliability and ethical implications of AI-generated content in the context of scholarly work”",
        "“Identify the features capabilities and limitations of various generative AI tools used in research workflows”",
        "“Integrate generative AI tools into personal research workflows to enhance productivity while maintaining critical oversight”" ;
    schema1:url <https://training.vib.be/all-trainings/strategic-use-generative-ai-2> .

<https://tess.elixir-europe.org/events/strategic-use-of-generative-ai-brussels> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Over the last few months, the rapid establishment of generative AI and Large Language Models (LLM) has opened new frontiers in various domains.This hands-on class aims to provide you with the necessary skills to effectively use this cutting-edge technology in an interdisciplinary way.With two formats of participation possible, we wish to offer opportunities for everyone to build enough knowledge for a variety of applications.1/2 DAY TICKET:In the morning, you will follow an introduction on ethics, ownership, and general hands-on application of generative AI that can be used holistically. This is meant for anyone, including admin, support, and others, to use for their work or personal interests.FULL DAY TICKET:After a general view, we will navigate deeper into the use of generative AI for research; from scientific writing to analysis, we will introduce how genAI can support this process.We will cover different aspects of using ChatBots powered with LLMs, including the ethical and ownership aspects, the theoretical background, and several examples of practical applications, among which are how to strategically prompt your request for text generation in any context,  how to generate high-quality content for research papers and grant applications. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-03-12 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Belgium" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Brussels" ;
                            schema1:postalCode "1050" ;
                            schema1:streetAddress "Brussels - VUB Campus Etterbeek, Pleinlaan 2" ] ;
                    schema1:latitude "50.846557" ;
                    schema1:longitude "4.351697" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-03-12 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "Artificial Inteligence",
        "generative AI" ;
    schema1:name "Strategic use of generative AI - Brussels" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Analysing prompt engineering techniques for different purposes”",
        "“Critically evaluating the AI generated outcomes”",
        "“Exploring several applications of genAI in academic research (afternoon session)”",
        "“Providing a background of the evolution of generative AI models”",
        "“Providing an overview of the features and capabilities of genAI”",
        "“Providing hands-on experience with using different genAI tools for work and research purposes”" ;
    schema1:url <https://training.vib.be/all-trainings/strategic-use-generative-ai-brussels> .

