                            schema1:addressCountry "Italy" ;
                            schema1:addressLocality "Procida" ;
                            schema1:addressRegion "Città Metropolitana di Napoli" ;
                            schema1:postalCode "80079" ;
                            schema1:streetAddress "Via Principessa Margherita, 46" ] ;
                    schema1:latitude "40.764005" ;
                    schema1:longitude "14.035116" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "EMBO" ] ;
            schema1:startDate "2021-03-19 14:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "GWAS",
        "Genetic Diversity",
        "Population Genomics",
        "Population genetics",
        "genetic clustering" ;
    schema1:name "Population genomics: Background, tools and programming" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Italy" ;
