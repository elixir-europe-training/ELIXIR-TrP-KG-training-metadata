<https://tess.elixir-europe.org/materials/how-to-publish-fair-data-with-pangaea> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description "PANGAEA as Data Publisher for Earth &amp; Environmental Science is a globally leading information system, long term archive and data publisher for geoscientific, biological and environmental data. Data published by PANGAEA origins from a broad range of subdisciplines of the Biological Sciences, Chemistry, Physics with a special focus an Earth Sciences and Environmental Sciences. Essential services supplied by PANGAEA are data curation, long-term data archiving and data publication. Data curation includes quality control of metadata and the development of ontologies as well as vocabularies according to international protocols and standards. Metadata are extensive and each dataset can be cited using a universally unique Digital Object Identifier (DOI)." ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "How to publish FAIR Data with PANGAEA" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "de.NBI" ;
            schema1:url <https://www.denbi.de> ] ;
    schema1:url <https://www.denbi.de/online-training-media-library/723-how-to-publish-fair-data-with-pangaea> .

