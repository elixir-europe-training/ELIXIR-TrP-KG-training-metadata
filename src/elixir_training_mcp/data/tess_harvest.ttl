<https://tess.elixir-europe.org/events/uniprot-and-alzheimer-s-disease-linking-molecular-defects-to-disease-phenotype> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Anna Swan" ;
    schema1:description "This webinar will cover ongoing curation project at UniProt on proteins involved in Alzheimer's Disease." ;
    schema1:endDate "2019-05-14 15:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "UniProt and Alzheimer's Disease: Linking molecular defects to disease phenotype" ;
    schema1:startDate "2019-05-14 14:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2019/uniprot-and-alzheimers-disease-linking-molecular-defects-disease-phenotype> .

<https://tess.elixir-europe.org/events/uniprot-and-alzheimer-s-disease-linking-molecular-defects-to-disease-phenotype-d8120d6e-243d-4607-af14-196ad3fed08b> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_3668>,
        <http://edamontology.org/operation_0306>,
        <http://edamontology.org/topic_0078>,
        <http://edamontology.org/topic_0219> ;
    schema1:description """This webinar will cover ongoing curation project at UniProt on proteins involved in Alzheimer's Disease.

We have identified more than 300 proteins, by text mining and from input by experts in the field, to be associated with AD. Using manual curation, information from peer-reviewed literature has been annotated on molecular function and involvement in disease, including disease-associated variant positions and variant characterisation.

By focusing our curation efforts on proteins involved in AD, we hope to shed light on the mechanisms leading to this devastating disease. We focus on a thorough review of available information on sequence variants and associated AD information, as well as normal protein function of proteins associated with the disease. The information on variants together with variant functional description, protein molecular function, structural data and protein-protein interaction should help researchers in the field of neurodegeneration, clinicians and biomedical researchers to gain a global view on the relation between variant and disease and help elucidating disease mechanism.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2019-05-14 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 200 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-05-14 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Alzheimer's Disease",
        "Proteins (proteins)",
        "UniProt: The Universal Protein Resource",
        "Variant and disease" ;
    schema1:name "UniProt and Alzheimer's Disease: Linking molecular defects to disease phenotype" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/uniprot-and-alzheimers-disease-linking-molecular-defects-disease-phenotype> .

