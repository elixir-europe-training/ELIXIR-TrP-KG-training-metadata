    schema1:url <https://www.ebi.ac.uk/training/events/digital-twins-drug-repurposing-integrating-mathematical-modeling-and-machine-learning-bridging-gap> .

<https://tess.elixir-europe.org/events/dignity-at-work-workshop> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "VIB is committed to fostering a diverse, safe and inclusive workplace for all the collaborators. This process includes adopting new policies (like the Bullying and Harassment policy), implementing different initiatives and also training. A lot of what we experience as workplace culture or climate is mitigated by behaviour and interpersonal interactions.  In 2024 VIB is adopting a new Code of Conduct to set the clear standards of behaviours for all collaborators of our institute. The Code covers a number of specific phenomena and behaviours that may contribute to a toxic working environment, such as microaggressions, harassment, bulling and sexual harassment.  It also contains the behaviours we ask all collaborators to adhere to, as well as the reporting mechanisms and channels in case of transgressions or misconduct. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
