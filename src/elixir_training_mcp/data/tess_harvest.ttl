<https://tess.elixir-europe.org/events/introduction-to-research-data-management-getting-started-with-data-management-and-data-stewardship> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Getting started with Data Management and Data Stewardship" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD students" ] ;
    schema1:description """This introductory course is aimed at starting PhD candidates, researchers and data stewards in the biomedical sciences who wish to acquire fundamental skills on data management. In addition to lectures, our workshop includes several hands-on practicals, all following one example research data management scenario.\r
The course touches upon all stages of data research lifecycle with emphasis on data management planning, data protection and GDPR compliance, research analyses and reproducibility, FAIR principles and data publication.\r
\r
Please register via ELIXIR Luxembourg website: https://elixir-luxembourg.org/events/2022_06_27_research_data_management""" ;
