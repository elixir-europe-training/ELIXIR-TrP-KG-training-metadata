<https://tess.elixir-europe.org/materials/genome3d-annotations-in-interpro> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0166>,
        <http://edamontology.org/topic_2814> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Clinicians" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ] ;
    schema1:description """Genome3D provides consensus structural annotations and 3D models for sequences from ten model organisms, including human. These data are generated by several UK-based resources that together form the Genome3D consortium: SCOP, CATH, SUPERFAMILY, Gene3D, FUGUE, pDomTHREADER and PHYRE. InterPro, meanwhile, provides functional analysis of proteins by classifying them into homologous superfamilies and families, and by predicting domains, repeats and important sites, based on data from 14 member databases.\r
\r
This webinar presents the new InterPro entry type, Homologous superfamily, as well as describing domain and structure predictions from Genome3D annotations, and how they are integrated in InterPro.""" ;
    schema1:keywords "Genome annotations",
        "Genome3D",
        "Protein domain prediction" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Genome3D annotations in InterPro" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/genome3d-annotations-interpro> .

