                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2022-04-13 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Europe PubMed Central",
        "Literature (literature)" ;
    schema1:name "SciELO Preprints in Europe PMC" ;
