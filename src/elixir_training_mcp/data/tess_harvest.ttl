<https://tess.elixir-europe.org/events/linux-command-line> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Many data-intensive research tasks require interacting with files and software through the Linux command line. For researchers and support staff unfamiliar with this environment, learning the basics is essential to work efficiently and independently. This introductory course is designed for those with no prior command-line experience who plan to attend training involving Linux-based tools or infrastructure like the Vlaamse SuperComputer. By the end of the session, participants will be able to navigate the file system, manipulate files and folders, and run simple scripts. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2026-01-20 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2026-01-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "programming" ;
    schema1:name "Linux command line" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "Construct simple bash scripts to automate routine tasks",
        "Manipulate files and folders by applying commands such as cp mv rm and mkdir",
        "Navigate directories and files using basic command-line operations",
        "Recognize the structure and components of the Linux file system" ;
    schema1:url <https://training.vib.be/all-trainings/linux-command-line> .

