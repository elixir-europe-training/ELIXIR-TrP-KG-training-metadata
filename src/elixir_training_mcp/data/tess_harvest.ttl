<https://tess.elixir-europe.org/events/short-read-alignment-and-small-size-variants-calling-session-13-11-2023-14-11-2023> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Variant calling" ;
    schema1:description """This training session, organized jointly with the Sigenae platform, is designed to introduce NGS data, in particular Illumina Solexa technologies with command line. You will discover the new sequence formats, the assembly formats and the known biases of these technologies. You will use mapping on reference genome software, polymorphisms detection with the GATK pipeline and alignment visualization software.\r
\r
This training is focused on the practice. It consists of modules with a large variety of exercises:\r
\r
Day 1 (09:00 am to 12:30 am): Fastq format / Sequence quality. Read mapping.\r
Day 1 (14:00 pm to 17:00 pm): SAM format. Visualisation.\r
Day 2 (09:00 am to 17:00 am): Variant calling. VCF format. Variant annotation (SNPeff / SNPsift).\r
 \r
The session will take place in the room ‘salle de formation’ at INRAE center of Toulouse-Auzeville.\r
\r
Prerequisites: ability to use a Unix environment (see Unix training) and Cluster (see Cluster training).\r
 \r
Tool box: FastQC, BWA, Samtools, Picard tools, GATK, SnpSift / SnpEff, IGV.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-12-16 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "castanet-tolosan" ;
                            schema1:postalCode "31326" ;
                            schema1:streetAddress "24 chemin de borderouge CS 52627 – Auzeville" ] ;
                    schema1:latitude "43.517214" ;
                    schema1:longitude "1.49808" ] ;
            schema1:maximumAttendeeCapacity 12 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Genotoul-bioinfo (http://bioinfo.genotoul.fr/), MIAT 0875 ()" ] ;
            schema1:startDate "2025-12-15 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "SHORT-READ ALIGNMENT AND SMALL SIZE VARIANTS CALLING - December 14-16 2025" ;
