<https://tess.elixir-europe.org/events/analysis-of-16s-rrna-metagenomic-experiments-online> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """Processing and statistical analysis of 16S rRNA metagenomic experiments using R &amp; Lotus pipeline.\r
The following analytical steps from raw data to communicable results will be on the program:\r
\r
\r
	Metagenomic experiment planning, execution and analysis\r
	Analyzing amplicon sequencing data with up-to-date tools and how to increase the quality of ASVs and OTUs, when to use what technique\r
	Post-clustering of ASVs to avoid intra-genomic ASV false-positives\r
	Working with low-biomass experiments, removing exogenous contamination in several scenarios\r
	Numerical ecology focused analysis workflow for both metagenomic and amplicon sequencing based studies\r
	Analysis of alpha/beta diversity\r
	Univariate statistics to identify species enriched in sample groups\r
	Multivariate statistics and visualization to identify clusters of samples\r
	Assessing microbial communities based on ecological principles and species distributions\r
""" ;
    schema1:endDate "2021-06-16 00:00:00 UTC"^^schema1:Date ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Belgium" ;
                    schema1:addressLocality "Leuven" ;
                    schema1:postalCode "3010" ;
                    schema1:streetAddress "Park Inn by Radisson Leuven" ] ;
            schema1:latitude "50.881367" ;
            schema1:longitude "4.717319" ] ;
    schema1:name "Analysis of 16S rRNA metagenomic experiments, online" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "VIB Bioinformatics Core" ] ;
    schema1:startDate "2021-06-14 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://training.vib.be/product/323> .

