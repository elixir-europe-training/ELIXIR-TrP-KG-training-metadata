<https://tess.elixir-europe.org/materials/registering-datasets-in-wikidata> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_4012> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Data stewards" ],
        [ a schema1:Audience ;
            schema1:audienceType "Data Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bioinformatician" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Egon Willighagen" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:description "Useful datasets become more useful when they are easily found. This recipe is about making an already archived dataset metadata more Findable by getting the metadata distributed into other databases. Learn how to register a published dataset on Wikidata with the appropriate citation to increase its findability." ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Wikidata" ;
    schema1:learningResourceType "tutorial" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Registering Datasets in Wikidata" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR" ;
            schema1:url <https://www.elixir-europe.org/> ] ;
    schema1:url <https://faircookbook.elixir-europe.org/content/recipes/findability/registeringDatasets.html> .

<https://tess.elixir-europe.org/materials/registering-swisslipids-identifiers-in-wikidata> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3314> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Bioinformatician" ],
        [ a schema1:Audience ;
            schema1:audienceType "Data Scientists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Egon Willighagen" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:description "To make datasets more findable and databases more interoperable, it is recommended to share not just top-level metadata, but also record-level metadata. For example, for chemical databases, one may share the chemical compound identifiers as open data, while keeping the data itself in their own database. That allows other resources, like Wikidata, to link to a private database. First, that makes such data more findable, but it also makes the same data easier to integrate, and therefore more interoperable." ;
    schema1:keywords "Wikidata",
        "lipids" ;
    schema1:learningResourceType "Tutorial" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
