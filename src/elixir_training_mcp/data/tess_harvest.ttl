<https://tess.elixir-europe.org/materials/cytoscape-stringapp-exercises> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0092>,
        <http://edamontology.org/topic_0121>,
        <http://edamontology.org/topic_0128>,
        <http://edamontology.org/topic_0602> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Lars Juhl Jensen" ],
        [ a schema1:Person ;
            schema1:name "Nadezhda T. Doncheva" ],
        [ a schema1:Person ;
            schema1:name "Helen V. Cook" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "John \"Scooter\" Morris" ] ;
    schema1:description """Hands-on exercises using the [stringApp](http://apps.cytoscape.org/apps/stringApp) for [Cytoscape](http://cytoscape.org/) to retrieve molecular networks from the [STRING](https://string-db.org/) and [STITCH](https://stitch-db.org/) databases.\r
\r
The exercises will teach you how to:\r
\r
* retrieve networks for proteins or small-molecule compounds of interest\r
* retrieve networks for a disease or an arbitrary topics in PubMed\r
* layout and visually style the resulting networks\r
* import external data and map them onto a network\r
* perform enrichment analyses and visualize the results\r
* merge and compare networks\r
* select proteins by attributes\r
* identify functional modules through network clustering""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "STRING" ;
            schema1:url <https://bio.tools/tool/string> ],
        [ a schema1:Thing ;
            schema1:name "STITCH" ;
            schema1:url <https://bio.tools/tool/stitch> ],
        [ a schema1:Thing ;
            schema1:name "DISEASES" ;
            schema1:url <https://bio.tools/tool/DISEASES> ],
        [ a schema1:Thing ;
            schema1:name "Cytoscape" ;
            schema1:url <https://bio.tools/tool/cytoscape> ],
        [ a schema1:Thing ;
            schema1:name "Search Tool for Interactions of Chemicals" ;
            schema1:url <https://fairsharing.org/bsg-d000104> ],
        [ a schema1:Thing ;
            schema1:name "STRING: functional protein association networks" ;
            schema1:url <https://fairsharing.org/bsg-d000340> ],
        [ a schema1:Thing ;
            schema1:name "stringApp" ;
            schema1:url <https://bio.tools/tool/stringApp> ] ;
    schema1:name "Cytoscape stringApp exercises" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Denmark" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
