<https://tess.elixir-europe.org/events/training-platform-f2f-hybrid-meeting> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """The ELIXIR Training Platform meeting is confirmed to take place from Wednesday, 16th March, 12:00 CET, to Friday, 18th March, 14:00 CET. This meeting is planned as a hybrid meeting. If the face-to-face component is not possible then the meeting will be switched to fully virtual. \r
\r
After two years, the Training Platform, including all of ELIXIR’s Training Coordinators will meet to share updates and jointly work on open Training related aspects and ELIXIR Training Platform tasks, part of the 2022-2023 programme. \r
\r
The meeting will include presentations, workshops and participant engagement. \r
\r
This meeting is limited to 25 in-person participants on the first-come-first-serve basis, with no-limit on virtual participant number.\r
\r
Date\r
\r
Wednesday, 16th March, 12:00 CET, to Friday, 18th March\r
\r
\r
	Day 1, 12:00 - 17:00 CET Training Platform meeting\r
	Day 2, 09:00 - 17:00 CET Training Platform  meeting\r
	Day 3, 09:00 - 14:00 CET Training Platform meeting\r
\r
\r
Location:\r
\r
Novotel Brussels Hotel, Rue de la Vierge Noire 32, 1000 Brussels, Belgium\r
\r
Registration info/form \r
\r
Please note, if you have selected to attend face to face, this option is limited to first come first served basis. Registration has been extended to 25th February. Face-to-face attendance will be confirmed on after this.\r
\r
Please do not book any travel till after you have been notified.\r
\r
Travel and venue\r
\r
Once notified of your face to face attendance you will be expected to make your own travel and accommodation arrangements to the venue.\r
\r
Logistics\r
\r
For details on how to get to the venue or in-country information, please visit our logistics document. """ ;
    schema1:endDate "2022-03-18 14:00:00 UTC"^^schema1:Date ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Belgium" ;
                    schema1:addressLocality "BRUSSELS" ;
                    schema1:streetAddress "Rue de la Vierge Noire 32, 1000" ] ;
            schema1:latitude "50.846557" ;
            schema1:longitude "4.351697" ] ;
    schema1:name "Training Platform F2F Hybrid Meeting" ;
    schema1:startDate "2022-03-16 12:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/training-platform-f2f-hybrid-meeting> .

<https://tess.elixir-europe.org/events/training-platform-f2f-hybrid-meeting-2f85b043-d9f0-429c-9d2e-9f71448aaf09> a schema1:Event ;
