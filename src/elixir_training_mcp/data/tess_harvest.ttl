<https://tess.elixir-europe.org/events/functional-plant-bioinformatics-plaza-5e977efa-32fd-43c3-a5d2-7a6091cdd564> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """\r
	Introduction plant comparative genomics (genes and gene families) + introduction PLAZA platform\r
	Functional characterization of plant genes (Gene families, GO, InterPro)\r
	Synteny analysis in polyploid cereals\r
	Gene set analysis for different plant -omics data sets:\r
	\r
		Functional interpretation of RNA-Seq and ChIP-Seq genes using the PLAZA Workbench\r
		Comparing gene sets between different di/polyploidy crop species\r
	\r
	\r
""" ;
