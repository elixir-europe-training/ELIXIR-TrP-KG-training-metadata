<https://tess.elixir-europe.org/events/clinic-priorities-and-the-whirlwind-of-daily-tasks> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "This session, focusing on Daily Priority Setting, is a two-hour clinic designed to enhance participants' ability to effectively manage their daily tasks and responsibilities, building further on the insights of Clinic Managing your agenda and Clinic Mastering Long-Term Goals and Milestones. It covers techniques for organizing and prioritizing daily tasks, strategies for managing workloads, and tools for efficient time management, including to-do lists and digital calendars. A significant aspect of this session is learning effective strategies for saying no, which is crucial in maintaining focus on prioritized tasks and managing time efficiently. Participants will engage in practical exercises to apply these strategies in real-life scenarios, aiming to structure their day for maximum productivity and minimal stress." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-06-03 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-06-03 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "online",
        "personal effectiveness",
        "time management" ;
    schema1:name "Clinic Priorities and the Whirlwind of Daily Tasks" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:url <https://training.vib.be/all-trainings/clinic-priorities-and-whirlwind-daily-tasks> .

