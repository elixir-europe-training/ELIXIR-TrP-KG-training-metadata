<https://tess.elixir-europe.org/events/basic-statistics-in-r-011ad5b2-0f63-42b2-b89a-164c5e271d37> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """\r
	Get an idea of what R and Rstudio is\r
	Use R to handle data: creating, reading, reformatting and writing data\r
	Use R to create graphics\r
	Use basic statistical techniques in R : normality tests, t-tests, wilcoxon tests, chi square tests, correlations, survival analysis...\r
	Write and use R scripts\r
""" ;
