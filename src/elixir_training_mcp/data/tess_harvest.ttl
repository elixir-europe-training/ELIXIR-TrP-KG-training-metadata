<https://tess.elixir-europe.org/materials/introductory-bioinformatics-q-a-session-genes-and-gene-expression> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description """This Q&amp;A (question and answer) webinar will provide an opportunity for anyone who has completed Introductory bioinformatics: a curated set of EMBL-EBI online courses to join some of EMBL-EBI's experts and ask their own questions. This session will focus on genes and gene expression, including the EMBL-EBI resources Ensembl and Expression Atlas.\r
\r
The questions covered during the Q&amp;A webinar will depend on those asked by attendees, however we will likely cover topics such as:\r
\r
\r
	Browsing genomes with Ensembl\r
	Discovering gene expression data with Expression Atlas\r
	Data management of biological data and open data\r
	Finding the right EMBL-EBI resource""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Introductory bioinformatics Q&A session: genes and gene expression" ;
    schema1:provider [ a schema1:Organization ;
