                            schema1:addressLocality "Espoo" ;
                            schema1:postalCode "02150" ;
                            schema1:streetAddress "Life Science Center - Keilaranta 14" ] ;
                    schema1:latitude "60.178095" ;
                    schema1:longitude "24.832703" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "CSC - LUMI" ] ;
            schema1:startDate "2023-04-17 09:00:00 UTC"^^schema1:Date ] ;
