                    schema1:addressCountry "Germany" ;
                    schema1:addressLocality "Frankfurt am Main" ;
                    schema1:addressRegion "Darmstadt" ;
                    schema1:streetAddress "Frankfurt am Main" ] ;
            schema1:latitude "50.110922" ;
            schema1:longitude "8.682127" ] ;
    schema1:name "ProteinsPlus at the German Conference for Bioinformatics (GCB) " ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "de.NBI" ] ;
    schema1:startDate "2020-09-14 13:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.denbi.de/training/807-proteinsplus-at-the-german-conference-for-bioinformatics-gcb> .

<https://tess.elixir-europe.org/events/proteinsplus-supporting-structure-based-design-on-the-web> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """Educators:\r
Dr. Christiane Ehrt\r
\r
Date:\r
04.03.2024\r
\r
Location:\r
Erlangen - 36th Molecular Modelling Workshop 2024 (https://mmws2024.mgms-ds.de/index.php)\r
\r
Contents:\r
Introduction to Structure-Based Design on ProteinsPlus: Exploring Structures with Protoss, EDIA, SIENA and MicroMiner, Exploring Protein-Ligand Interactions with PoseEdit and GeoMine\r
\r
Learning goals:\r
learning to perform protein structure analyses, protein ensemble generation, protein-ligand interaction analysis\r
