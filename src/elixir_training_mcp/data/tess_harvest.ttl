                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressRegion "Hinxton" ;
                            schema1:postalCode "CB10 1SD" ;
                            schema1:streetAddress ", Wellcome Genome Campus" ] ] ;
            schema1:maximumAttendeeCapacity 40 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2023-03-21 09:00:00 UTC"^^schema1:Date ] ;
