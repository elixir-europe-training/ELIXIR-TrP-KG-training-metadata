                    schema1:addressRegion "Oost-Vlaanderen" ;
                    schema1:postalCode "9000" ;
                    schema1:streetAddress "NV Zebrastraat, 32, Zebrastraat" ] ;
            schema1:latitude "51.039718" ;
            schema1:longitude "3.733555" ] ;
    schema1:maximumAttendeeCapacity 250 ;
    schema1:name "At The Forefront Of Plant Research" ;
    schema1:organizer [ a schema1:Organization ;
