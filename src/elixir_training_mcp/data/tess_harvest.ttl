<https://tess.elixir-europe.org/materials/training-on-integration-of-services-to-elixir-aai> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "service administrators in organizations that want to make use of ELIXIR AAI " ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Lukas Hämmerle" ],
        [ a schema1:Person ;
            schema1:name "Michal Prochazka" ],
        [ a schema1:Person ;
            schema1:name "Ondrej Velisek" ],
        [ a schema1:Person ;
            schema1:name "Mikael Linden" ] ;
    schema1:description """ELIXIR AAI is the ELIXIR service portfolio for authenticating researchers and managing their access rights in ELIXIR services. This training material was used in a workshop 24-25 Apr 2018 that was intended in particular for service administrators in organizations that want to make use of ELIXIR AAI in controlling access to their services.\r
\r
The workshop had down-to-earth approach that consisted of lectures and hands-on sessions where the participants were instructed to configure a server running in a virtual machine in their own laptop. The workshop was rather technical and detailed at times.\r
\r
The workshop consisted of two days. During the first day the participants learned to integrate a SAML Service Provider or OpenID Connect Relying Party to ELIXIR AAI. The second day focused on the additional services the ELIXIR AAI provides.""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords "AAI",
        "Shibboleth",
        "authentication" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Training on integration of services to ELIXIR AAI" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR AAI" ;
            schema1:url <https://elixir-europe.org/platforms/compute/aai> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Finland" ;
            schema1:url <https://www.csc.fi/web/training> ] ;
    schema1:url <https://docs.google.com/document/d/1BQGRz6bw2rb-bksiNAAKL14OihVfNDKD9vinfWQ1NVM/edit> .

<https://tess.elixir-europe.org/materials/training-primer-rdf-and-sparql> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0089>,
        <http://edamontology.org/topic_3063>,
        <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_3316>,
        <http://edamontology.org/topic_4012> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Research Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biomedical Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Data Managers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Data Scientists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Vasundra Touré" ],
        [ a schema1:Person ;
            schema1:name "Philip Krauss" ],
        [ a schema1:Person ;
            schema1:name "Personalized Health Informatics Group" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Sabine Österle" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:description """The RDF and SPARQL training primer was developed in the context of the [Swiss Personalized Health Network (SPHN)](https://sphn.ch) initiative and is part of a series of trainings centered around the [SPHN Interoperability Framework](https://sphn.ch/network/data-coordination-center/the-sphn-semantic-interoperability-framework/) developed by the SPHN Data Coordination Center (DCC). The framework aims at facilitating collaborative research by providing a decentralized infrastructure sustained by a strong semantic layer (SPHN Dataset) and graph technology, based on RDF, for the exchange and storage of data.\r
\r
This introductory course provides general information about the motivations behind the use of RDF as the implementation technology behind the SPHN Interoperability Framework as well as an introduction to the use of ontologies and SPARQL as query language to interrogate RDF data.\r
\r
__Prerequisites:__\r
\r
None\r
\r
__After the training you will be able to:__\r
\r
- Have a basic understanding of semantic web technologies such as RDF \r
- How to build ontologies using RDF\r
- How to load data into a triplestore (e.g., GraphDB)\r
- Have a basic understanding of SPARQL as query language\r
- Build a SPARQL query in the context of SPHN and run it in a triplestore\r
\r
\r
__Resources:__\r
\r
All resources are available on the [training's GitLab space](https://git.dcc.sib.swiss/sphn-semantic-framework/sphn-training-material/-/tree/master/SPHN%20RDF%20and%20SPARQL%20primer#training-primer-rdf-and-sparql)""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Clinical data",
        "Knowledge graph",
        "Ontology",
        "Query data",
        "RDF",
        "SPARQL",
        "Triplestore" ;
    schema1:learningResourceType "E-learning",
        "Training materials",
        "Video" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:name "Training Primer (RDF and SPARQL)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Switzerland" ;
            schema1:url <http://www.sib.swiss/training/> ],
        <https://ror.org/002n09z45> ;
    schema1:url <https://sphn.ch/training/sphn-rdf-training-primer/> .

