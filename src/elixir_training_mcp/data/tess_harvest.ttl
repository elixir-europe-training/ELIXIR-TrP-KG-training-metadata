<https://tess.elixir-europe.org/events/ai-readiness-in-omics-workshop-hackathon> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "software developers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Postgraduate Students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Life Science Researcher" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bioscientists" ] ;
    schema1:description """The F2F AI in Omics Workshop will be held at the University of Bradford. Organised by members affiliated with the UKRI Digital Skills Catalyst: Pasky Miranda (University of York) and Khaled Jum'ah (University of Bradford).\r
\r
**Programme Agenda** \r
\r
| Time | Topic| Speacker|\r
| ------------- |:-------------:| -----:|\r
| 10:00 | Introduction to Machine Learning Concepts Used in -Omics | Eva Caamano |\r
| 11:00 |  Coffee + Chat Break  |    |\r
| 11:30 | Practical Demo: Pitfalls in ML and Good Practice Using Tidymodels | Jamie Soul  |\r
|13:00 | Lunch  | |\r
| 14:00 | Hackathon/Code Retreat | |\r
|16:00| End + networking afterwards | |\r
\r
**Event Details**\r
This one-day event (organised by UKRI Digital Skills Catalyst) will support AI readiness for bioscientists. \r
\r
The morning includes two talks: \r
\r
**Lecture: Introduction to Machine Learning Concepts Used in -Omics**\r
Description:\r
This session will introduce participants to the core principles of supervised machine learning (ML) as applied to omics data analysis. The lecture will cover the unique challenges posed by high-dimensional and complex omics datasets, including issues of reproducibility, overfitting, and the pitfalls of poor feature selection. Participants will learn about best practices for robust and interpretable ML workflows and will be introduced to reporting standards such as DOME and FAIR. The session will include a practical critical appraisal of published examples, to help attendees identify good and bad practice in real-world contexts.\r
\r
**Practical Demo: Pitfalls in ML and Good Practice Using Tidymodels**\r
Description:\r
Building on the introduction, this live session demonstrates common pitfalls in ML workflows for omics and shows how the Tidymodels framework in R promotes best practice. Through a guided tutorial, participants will learn how to build a robust ML pipeline: from preprocessing and avoiding data leakage, to model fitting and proper evaluation. Participants will follow along with a Quarto notebook, applying what they learn to a classification and regression problems relevant to omics.\r
The afternoon will consist of a bring your own data Code Retreat where our team of experts will be on hand to help you with your personal projects, and a Hackathon challenge activity for those without their own data who want to try out their new skills. \r
\r
Networking tea/coffee and lunch will be included.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-09-12 16:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "AIBIO" ],
                [ a schema1:Organization ;
                    schema1:name "UKRI" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressLocality "Bradford" ;
                            schema1:addressRegion "West Yorkshire" ;
                            schema1:postalCode "BD7 1DP" ;
                            schema1:streetAddress "Richmond Building (RICH/WB19), University of Bradford,  Richmond Road" ] ;
                    schema1:latitude "53.791468" ;
                    schema1:longitude "-1.766069" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "University of Bradford, University of York and  UKRI Digital Skills Catalyst" ] ;
            schema1:startDate "2025-09-12 10:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "AI",
        "ML",
        "Omics",
        "Research skills" ;
    schema1:name "AI Readiness in Omics: Workshop & Hackathon" ;
    schema1:provider [ a schema1:Organization ;
