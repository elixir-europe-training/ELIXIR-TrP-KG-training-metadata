<https://tess.elixir-europe.org/materials/abstat18-advanced-biostatistics-for-bioinformatics-tool-users-using-r-2018> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
