<https://tess.elixir-europe.org/events/genomic-features-that-regulate-gene-expression-with-ensembl> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Anna Swan" ;
    schema1:description "Join Ensembl to investigate a genomic region which controls gene expression, determine its activity in different cell types and view the epigenomic markers at that locus, plus see how to access these data in bulk." ;
    schema1:endDate "2019-06-12 16:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "Genomic features that regulate gene expression, with Ensembl" ;
    schema1:startDate "2019-06-12 15:30:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2019/genomic-features-regulate-gene-expression-ensembl> .

<https://tess.elixir-europe.org/events/genomic-features-that-regulate-gene-expression-with-ensembl-22d6d386-2cef-49fb-9157-9fd36ded9fc9> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_2610>,
        <http://edamontology.org/topic_0203>,
        <http://edamontology.org/topic_3173>,
        <http://edamontology.org/topic_3295> ;
    schema1:description """Gene expression is controlled by a complicated network of transcription factors and repressors, interacting with genomic features such as promoters and enhancers, dependant on epigenetic marks at those loci. Ensembl provides access to epigenomic data on histone modifications and protein binding across the genome, integrated with data on genes and genetic variation.

Join Ensembl to investigate a genomic region which controls gene expression, determine its activity in different cell types and view the epigenomic markers at that locus, plus see how to access these data in bulk.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2019-06-12 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 200 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-06-12 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Ensembl",
        "Gene expression (gene-expression)",
        "Gene regulation" ;
    schema1:name "Genomic features that regulate gene expression, with Ensembl" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
