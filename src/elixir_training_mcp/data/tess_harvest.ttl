<https://tess.elixir-europe.org/materials/using-r-with-python> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists, Genomicists, Computer Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "beginner bioinformaticians" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "allegra.via Via" ] ;
    schema1:description "This is a module from the \"Python for Biologists\" course. It describes the Python module interfacing the R package for statistics. The module shows how to calculate mean, standard deviation, z-score and p-value of a set of numbers, and how to generate plots. Input files for the scripts presented are also provided." ;
    schema1:keywords "Programming",
        "Python",
        "Python biologists" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
