<https://tess.elixir-europe.org/events/role-of-variations-in-modern-drug-development-and-research-a-way-forward-via-structural-bioinformatics-approaches-with-prof-ozlem-tastan-bishop> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "To date the effect of variations at the protein level is poorly studied in computational drug discovery research. This is mainly due to experimental difficulties in analyzing data at the protein structural level. We previously proposed a post-hoc analysis approach of molecular dynamics simulations using dynamic residue network analysis to consider the dynamic nature of functional proteins and protein-drug complexes and to probe the impact of mutations and their allosteric effects. This talk focuses on examples including drug resistance in infectious diseases; proposing computational approaches for common ways of dealing with different health problems." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2022-07-20 17:00:00 UTC"^^schema1:Date ;
            schema1:startDate "2022-07-20 13:02:00 UTC"^^schema1:Date ] ;
    schema1:keywords "database",
        "variations" ;
    schema1:name "Role of variations in modern drug development and research –  a way forward via structural bioinformatics approaches with Prof Ozlem Tastan Bishop" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "H3ABioNet" ;
            schema1:url <https://h3abionet.org> ] ;
    schema1:url <https://www.h3abionet.org/categories/event/webinars/h3abionet-webinars-series-role-of-variations-in-modern-drug-development-and-research-a-way-forward-via-structural-bioinformatics-approaches-with-prof-ozlem-tastan-bishop> .

