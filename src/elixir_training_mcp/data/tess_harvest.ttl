<https://tess.elixir-europe.org/events/exploring-chembl-data-with-the-new-chembl-interface-e34c1090-622e-49aa-9f60-bf44b00e24fa> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3336> ;
    schema1:description """ChEMBL is a manually curated open database of bioactivity data of molecules with drug-like properties. It enables users to identify data that relates chemical structural information to biological function and used to facilitate the discovery of new drugs.  
  
 This webinar will highlight the data that is available in the ChEMBL database and how it can be accessed using the new ChEMBL web interface //[www.ebi.ac.uk/chembl/](https://www.ebi.ac.uk/chembl/). The webinar will include a walkthrough of several typical drug discovery use cases and will show how the data can be queried via the interface to identify this data.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
