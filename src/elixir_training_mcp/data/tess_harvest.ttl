<https://tess.elixir-europe.org/events/introduction-to-research-data-management-rdm-in-life-sciences> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Effective research data management (RDM) is more than just a compliance requirement - it's a practical tool that simplifies your workflow, strengthens your research, and enhances the impact of your publications. This training is designed to help researchers embed RDM practices into their projects from the very beginning, always keeping the publication process in focus. Throughout the day, participants will learn how to organize, document, and share their data in ways that promote transparency, reproducibility, long-term accessibility, and high-impact publishing. Through hands-on exercises and interactive discussions, the course introduces essential concepts such as FAIR data, open data, and data management, while also covering practical topics like metadata standards and selecting appropriate repositories. Whether you're preparing your first manuscript or refining your data practices, this course will provide the tools and confidence to manage your research data more effectively and publish with greater confidence. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-10-17 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Belgium" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-10-17 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "ELIXIR",
        "hands-on",
        "research data management" ;
    schema1:name "Introduction to Research Data Management (RDM) in Life Sciences" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Apply appropriate metadata standards to describe datasets effectively”",
        "“Appraise and select repositories to deposit research data”",
        "“Define key concepts such as Research Data Management (RDM) FAIR data Open data and Personal and Sensitive Data”",
        "“Distinguish between general and discipline-specific repositories for data sharing”",
        "“Evaluate the components of the Data Management Plan and justify its relevance to research projects”",
        "“Explain the role of data documentation in enhancing publication quality and reproducibility”",
        "“Identify reliable sources and institutional resources that support RDM practices”",
        "“Organize research data and documentation in a structured and standardized format”",
        "“Recognize the ethical and legal implications of data handling under GDPR”" ;
    schema1:url <https://training.vib.be/all-trainings/introduction-research-data-management-rdm-life-sciences> .

<https://tess.elixir-europe.org/events/introduction-to-research-data-management-rdm-in-life-sciences-806a4c58-493a-4f99-ad0e-d4d9972a05e2> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Effective research data management (RDM) is more than just a compliance requirement - it's a practical tool that simplifies your workflow, strengthens your research, and enhances the impact of your publications. This training is designed to help researchers embed RDM practices into their projects from the very beginning, always keeping the publication process in focus. Throughout the day, participants will learn how to organize, document, and share their data in ways that promote transparency, reproducibility, long-term accessibility, and high-impact publishing. Through hands-on exercises and interactive discussions, the course introduces essential concepts such as FAIR data, open data, and data management, while also covering practical topics like metadata standards and selecting appropriate repositories. Whether you're preparing your first manuscript or refining your data practices, this course will provide the tools and confidence to manage your research data more effectively and publish with greater confidence. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
