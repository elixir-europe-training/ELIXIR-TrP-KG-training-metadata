                            schema1:addressCountry "Czech Republic" ;
                            schema1:addressLocality "Brno" ;
                            schema1:addressRegion "Brno" ;
                            schema1:streetAddress "University Campus Bohunice, Masaryk University, Brno, Czech Republic" ] ;
                    schema1:latitude "49.19506" ;
                    schema1:longitude "16.606837" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Loschmidt Laboratories, Masaryk University" ] ;
            schema1:startDate "2020-02-02 15:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "bioinformatics",
        "enzyme mining",
        "protein engineering",
        "software tools" ;
