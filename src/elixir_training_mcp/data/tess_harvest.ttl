                    schema1:latitude "51.22111" ;
                    schema1:longitude "4.399708" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2026-06-11 09:00:00 UTC"^^schema1:Date ] ;
