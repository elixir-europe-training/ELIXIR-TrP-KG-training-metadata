<https://tess.elixir-europe.org/events/from-bench-to-database-the-journey-of-a-uniprot-entry> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/format_1208>,
        <http://edamontology.org/topic_0219>,
        <http://edamontology.org/topic_1775> ;
    schema1:description """UniProt serves as a leading global data resource for protein sequence and functional information. Behind every UniProt entry lies a story that begins at the laboratory bench. 

This webinar will trace the journey of protein data from experimental discovery and literature curation to integration within the UniProt Knowledgebase. Participants will gain insight into how UniProt collects, evaluates, and organises functional information, ensuring its accuracy and accessibility. The session will also demonstrate how to explore this information effectively on the UniProt website, helping you to quickly locate the data you need.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2025-12-11 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2025-12-11 09:00:00 UTC"^^schema1:Date ] ;
