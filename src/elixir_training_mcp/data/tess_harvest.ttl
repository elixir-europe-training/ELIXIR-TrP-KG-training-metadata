                            schema1:addressRegion "Newfoundland and Labrador" ] ;
                    schema1:latitude "47.561471" ;
                    schema1:longitude "-52.712616" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:startDate "2024-05-27 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "(2024) Beginner Microbiome Analysis: St. John&#8217;s, NL" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Bioinformatics.ca" ;
            schema1:url <https://bioinformatics.ca/> ] ;
    schema1:teaches "Participants will gain practical experience and skills to be able to:  Design appropriate microbiome-focused experiments Understand the advantages and limitations of marker gene data analysis Devise an appropriate bioinformatics workflow for processing and analyzing microbiome marker-gene sequence data Apply appropriate statistics to undertake rigorous data analysis" ;
    schema1:url <https://bioinformatics.ca/workshops-all/2024-beginner-microbiome-analysis-st-johns-nl/> .

