<https://tess.elixir-europe.org/events/embl-ebi-workshop-resources-and-tools-for-genomics-protein-interactions-and-structural-applications> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Johanna Langrish" ;
    schema1:description "In this course participants will explore EMBL-EBI resources for genomics, protein interaction and structural biological applications. The sessions focus on browsing, searching and retrieving genomic data, protein interaction information and three-dimensional structures." ;
    schema1:endDate "2019-02-21 17:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Italy" ;
