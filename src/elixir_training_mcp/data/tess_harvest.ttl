<https://tess.elixir-europe.org/materials/ppb18-programming-in-python-for-biologists-2018> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Academia/ Research Institution" ],
        [ a schema1:Audience ;
            schema1:audienceType "Healthcare" ],
        [ a schema1:Audience ;
            schema1:audienceType "Non-Profit Organisation" ],
        [ a schema1:Audience ;
            schema1:audienceType "Industry" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "The Gulbenkian Training Programme in Bioinformatics" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Vincenza Colonna" ],
        [ a schema1:Person ;
            schema1:name "David Philip Judge" ],
        [ a schema1:Person ;
            schema1:name "Allegra Via" ] ;
    schema1:description """Python is an object-oriented programming language that is ideal for biological data analysis. The course will start from zero knowledge, and will introduce the participants to all the basic concepts of Python such as calculating, organizing data, reading and writing files, program logic and writing larger programs. All the examples and practical sessions will focus on solving biological problems. In particular the sessions will cover:\r
\r
* working with DNA and protein sequences\r
* data retrieval from files and their manipulation\r
* running applications, such as BLAST, locally and from a script\r
* finding motifs in sequence\r
* parsing common file formats (Uniprot, GenBank, PDB, BLAST) with Biopython \r
* ways to find and correct program errors\r
\r
The course will be highly interactive and the students will continuously put theory into practice while learning.""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:identifier "10.5281/zenodo.3813780" ;
    schema1:keywords "Bioinformatics",
        "Biological databases",
        "Biology" ;
    schema1:learningResourceType "Documentation",
        "Exercise",
        "Handout",
        "Scripts" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "PPB18 - Programming in Python for Biologists (2018)" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Portugal" ;
            schema1:url <https://elixir-portugal.org> ] ;
    schema1:url <https://gtpb.github.io/PPB18/> .

