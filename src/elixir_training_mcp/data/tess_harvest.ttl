            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Be able to attach a Pulsar node to Galaxy
- Send jobs to Pulsar""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/admin/tutorials/surf-research-cloud-pulsar/tutorial.html> ;
    schema1:version "3" .

