    schema1:keywords "BioExcel",
        "tess" ;
    schema1:name "BioExcel Webinar: A Virtual Research Environment for Integrative Modelling of Biomolecular Complexes with the New Modular Version of HADDOCK" ;
    schema1:provider [ a schema1:Organization ;
