<https://tess.elixir-europe.org/events/elixir-all-hands-keynote-ii-dimitris-koureas-electric-butterflies-from-field-to-bytes-and-back> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """\r
\r
Electric Butterflies, from field to bytes and back\r
\r
The second keynote of the ELIXIR All Hands 2020 was given by Dimitris Koureas from the Naturalis Biodiversity Center, the Netherlands.\r
\r
What is a digital museum specimen? How can it be used to reunite biological information such as molecular, morphological, ecological and taxonomic data? How do we bring 1.5 billion specimens and hundreds of museums into the world of open science?      \r
\r
 """ ;
    schema1:endDate "2020-06-05 11:00:00 UTC"^^schema1:Date ;
    schema1:name "ELIXIR All Hands Keynote II — Dimitris Koureas: Electric Butterflies, from field to bytes and back" ;
    schema1:startDate "2020-06-05 10:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/all-hands-keynote-ii> .

