    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "EATRIS Transmed Academy - course on translational medicine" ;
    schema1:url <https://eatris.eu/services/education/> .

<https://tess.elixir-europe.org/materials/ebi-metagenomics-analysing-and-exploring-metagenomics-data> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3174> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Life Scientists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Alex Mitchell" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Alex Mitchell" ] ;
    schema1:description """EBI metagenomics is a freely available hub for the analysis and exploration of metagenomic, metatranscriptomic, amplicon and assembly datasets. The resource provides rich functional and taxonomic analyses of user-submitted sequences, as well as analysis of publicly available metagenomic datasets held within the European Nucleotide Archive. It is one of the largest metagenomics data repositories in the world, with over 75,000 publicly available datasets analysed using a standardised pipeline, helping to support comparison of results. This webinar will introduce users to the data analysis pipeline, the web site and database, and illustrate the use of the search facility for data discovery.\r
\r
This webinar was recorded on 8 March 2017. \r
\r
This webinar is aimed at scientists with an interest in learning more about the EBI Metagenomics database.\r
\r
No prior knowledge of bioinformatics is required, but an undergraduate level understanding of biology would be useful.""" ;
    schema1:identifier "10.6019/TOL.EBImetagen-w.2017.00001.1" ;
    schema1:keywords "MGnify",
        "Metagenomics",
        "Microbiology",
        "Sequence Analysis" ;
    schema1:learningResourceType "Webinar" ;
    schema1:license <https://spdx.org/licenses/CC-BY-NC-SA-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "MGnify (was EBI Metagenomics)" ;
            schema1:url <https://bio.tools/tool/ebi_metagenomics> ] ;
    schema1:name "EBI Metagenomics: analysing and exploring metagenomics data" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/online/course/ebi-metagenomics-analysing-and-exploring-metagenomics-data> .

