<https://tess.elixir-europe.org/materials/methods-and-resources-for-omics-studies-a-curated-collection-of-embl-ebi-on-demand-training> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0092>,
        <http://edamontology.org/topic_0121>,
        <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_3172>,
        <http://edamontology.org/topic_3308>,
        <http://edamontology.org/topic_3391> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Clinicians" ] ;
    schema1:description "Omics studies entail the analysis of extensive datasets across various domains, including genomics, transcriptomics, proteomics, metabolomics, and more. Such studies offer deeper insights into intricate biological processes. This curated collection is designed to introduce key concepts and valuable resources, facilitating the exploration of functional genomics, proteomics, metabolomics, and spatial omics data. Additionally, it highlights relevant methods and tools for analysing, integrating, and visualising omics data." ;
    schema1:keywords "Spatial omics",
        "multi-omics data integration",
        "transcriptomics" ;
    schema1:learningResourceType "e-learning" ;
