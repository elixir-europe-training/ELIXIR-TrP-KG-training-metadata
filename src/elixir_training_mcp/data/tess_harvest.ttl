<https://tess.elixir-europe.org/materials/workshop-make-your-bioinformatics-workflows-findable-and-citable> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
