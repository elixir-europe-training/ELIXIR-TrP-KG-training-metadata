<https://tess.elixir-europe.org/events/bioinformatic-approaches-to-understand-the-role-of-the-human-microbiome-in-health-and-disease> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3063>,
        <http://edamontology.org/topic_3301>,
        <http://edamontology.org/topic_3697> ;
    schema1:description """The human microbiome represents a diverse community of microbes with important roles for the maintenance of human health. The wealth of metagenomics data currently available has brought about a new era of research for the human microbiome field. The ability to reconstruct high-quality microbial genomes purely from metagenomic sequencing data has unlocked our ability to study the hidden microbial universe living alongside us. Given there are thousands of human-associated bacterial species that cannot yet be experimentally characterised, there is a need to develop and apply bioinformatics methods to better understand their role in health and disease. 

This webinar will provide an overview of current metagenomic approaches to study the human microbiome and introduce several statistical methods that can be used to link its composition and function to different human phenotypes and populations.

You may either watch the entire presentation from the introduction or navigate directly to a specific section by clicking the links provided below:

- [Introduction](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=be0f54f2-59c8-4b93-be3a-b12b011cbff0&amp;start=13.590218)

- [The microbiome in human biology](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=be0f54f2-59c8-4b93-be3a-b12b011cbff0&amp;start=143.198999)

- [What can metagenomics tell us?](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=be0f54f2-59c8-4b93-be3a-b12b011cbff0&amp;start=362.198999)

- [What is genome assembly?](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=be0f54f2-59c8-4b93-be3a-b12b011cbff0&amp;start=782.199)

- [Evaluating genome (MAG) quality](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=be0f54f2-59c8-4b93-be3a-b12b011cbff0&amp;start=1031.198999)

- [Linking microbiome composition to phenotype](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=be0f54f2-59c8-4b93-be3a-b12b011cbff0&amp;start=1952.198999)

- [Additional resources](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=be0f54f2-59c8-4b93-be3a-b12b011cbff0&amp;start=2277)

- [Q&amp;A](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=be0f54f2-59c8-4b93-be3a-b12b011cbff0&amp;start=2379.167781)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-03-06 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-03-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Microbial ecosystems webinar" ;
    schema1:name "Bioinformatic approaches to understand the role of the human microbiome in health and disease" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
