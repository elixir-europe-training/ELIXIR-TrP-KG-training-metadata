<https://tess.elixir-europe.org/events/electronic-lab-notebook-eln-essentials> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Efficient documentation and collaboration are essential in any research environment. The eLabJournal serves as the central platform for managing experimental workflows, samples, and team communication. This introductory training offers a practical overview of how to use the Electronic Lab Notebook (ELN) to streamline daily lab operations.Participants will explore the platform’s core features — from documenting experiments and organizing samples to facilitating collaboration across research teams. The training is hands-on and designed to help users quickly become confident in navigating the system, improving productivity while ensuring compliance with research standards (e.g. FAIR principles)." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2026-06-02 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Antwerpen" ;
                            schema1:postalCode "2610" ;
                            schema1:streetAddress "Antwerp - Campus Drie Eiken UAntwerpen, Universiteitsplein 1" ] ;
                    schema1:latitude "51.22111" ;
                    schema1:longitude "4.399708" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2026-06-02 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "ELN",
        "hands-on",
        "personal effectiveness" ;
    schema1:name "Electronic Lab Notebook (ELN): essentials" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Configure inventory settings including sample types and storage units”",
        "“Create and edit protocols within the platform”",
        "“Create and organize experiments and experiment templates”",
        "“Develop a unified naming structure for samples projects studies and experiments”",
        "“Differentiate the three core components of eLabJournal: inventory protocols and journal”",
        "“Explain the importance of the ELNs in research projects”",
        "“List the benefits of using eLabJournal in scientific workflows”",
        "“Search and retrieve inventory and journal entries efficiently”",
        "“Track samples supplies and equipment bookings”",
        "“Use collaborative features such as sharing experiments and adding collaborators”" ;
    schema1:url <https://training.vib.be/all-trainings/electronic-lab-notebook-eln-essentials> .

