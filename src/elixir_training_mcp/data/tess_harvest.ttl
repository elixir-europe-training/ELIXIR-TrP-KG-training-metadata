            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:url <https://docs.google.com/forms/d/e/1FAIpQLSdskUUaFnEDevlbCnzWHMfa_xkEf3DCmsOwIchEHfAMV3Pi-A/viewform> .

