        [ a schema1:Person ;
            schema1:name "Saskia Hiltemann" ],
        [ a schema1:Person ;
            schema1:name "Niall Beard" ],
        [ a schema1:Person ;
            schema1:name "Dave Clements" ],
        [ a schema1:Person ;
            schema1:name "Bérénice Batut" ],
