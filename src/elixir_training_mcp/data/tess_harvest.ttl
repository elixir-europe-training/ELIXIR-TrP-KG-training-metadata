<https://tess.elixir-europe.org/events/artificial-intelligence-machine-learning-and-alphafold-in-research-experiences-from-latin-america> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3474> ;
    schema1:description """In this webinar, we share experiences developed in Latin America regarding the use of artificial intelligence (AI) in Biosciences, specifically through machine learning algorithms for pattern recognition and AlphaFold for protein structure prediction. We explore how these technologies are used to understand and analyse biological and medical questions of interest in the region, including studies on stress tolerance in bacteria, epidemiological data analysis of infectious diseases, and antimicrobial resistance. We also discuss the search for potential therapeutic targets through structural modeling, applicable to proteins of interest in both pathogens and non-communicable diseases.  
  
This webinar is part of the [“Applications of artificial intelligence for biosciences in Latin America”](https://www.ebi.ac.uk/training/events/applications-artificial-intelligence-biosciences-latin-america/) webinar series, organised as part of the [BiotrAIn project](https://www.ebi.ac.uk/training/our-partnerships/biotrain), a collaboration between [University of Costa Rica](https://www.ucr.ac.cr/),  [CABANAnet](https://cabana.network/) and EMBL-EBI, funded by the Chan Zuckerberg initiative.    
  
This webinar is delivered in English. Synchronised captions are provided in both English and Spanish. The Spanish translation has been automatically generated and is currently under review. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2025-11-04 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2025-11-04 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Artificial intelligence" ;
    schema1:name "Artificial intelligence, machine learning and AlphaFold in research: experiences from Latin America" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/artificial-intelligence-machine-learning-and-alphafold-research-experiences-latin-america> .

