    schema1:contact "Piraveen Gopalasingam" ;
    schema1:description "This workshop will provide training on the use of bioinformatic tools for the design and analysis of SARS-CoV-2 sequences." ;
    schema1:endDate "2020-12-04 12:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
