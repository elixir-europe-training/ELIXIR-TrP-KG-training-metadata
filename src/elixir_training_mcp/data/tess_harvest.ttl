            schema1:startDate "2023-03-22 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Plant research",
        "Plant webinar series",
        "Spatial transcriptomics",
        "plant-microbe interactions" ;
    schema1:name "Single-cell and spatial omics technologies in plant science" ;
