<https://tess.elixir-europe.org/events/by-covid-consortium-meeting> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """BEYOND-COVID, or BY-COVID is a new EU-funded Horizon Europe project that works towards ensuring that data on SARS-CoV-2 and other infectious diseases can be found and used by everyone.\r
\r
BY-COVID will build and expand upon the successful COVID-19 Data Platform, a resource initiated in the early stages of the pandemic and led by EMBL-EBI.\r
\r
The project started in October 2021 and this is its second Consortium meeting, after 6 months of coordinated work.\r
\r
Date and time: \r
\r
Day 1 - Tuesday 29 March, 10:00 -13:00 CET\r
	Day 2 - Wednesday 30 March, 14:00-17:00 CET\r
\r
Full details of this meeting can be found on the agenda.\r
\r
Registration info/form \r
\r
Please register using the link below. The deadline is 20 March 2022.\r
\r
 """ ;
    schema1:endDate "2022-03-29 10:00:00 UTC"^^schema1:Date ;
    schema1:name "BY-COVID Consortium Meeting" ;
    schema1:startDate "2022-03-29 10:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/covid-consortium-meeting> .

