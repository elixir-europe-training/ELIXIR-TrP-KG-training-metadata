<https://tess.elixir-europe.org/materials/chemical-biology-q-a-session> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0154>,
        <http://edamontology.org/topic_3369> ;
    schema1:description """This Q&amp;A (question and answer) webinar will provide an opportunity for anyone who has completed ‘Chemical biology: A curated set of EMBL-EBI online courses’ to join some of EMBL-EBI's experts and ask their own questions. This session will focus on exploring chemical compounds or drug molecules, finding drug targets and target disease associations using resources such as ChEMBL and Open Targets.\r
\r
The questions covered during the Q&amp;A webinar will depend on those asked by attendees, however we will likely cover topics such as:\r
\r
\r
	Curation and maintenance of chemical compounds database \r
	Chemogenomics\r
	Finding data about interactions between drugs or drug-like molecules and their targets\r
	Drug discovery and target identification""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Chemical biology Q&A session" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/chemical-biology-qa-session> .

