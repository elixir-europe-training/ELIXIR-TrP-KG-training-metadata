    schema1:version "6" .

<https://tess.elixir-europe.org/materials/fair-open-data-and-open-science-an-introduction> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_4012> ;
    schema1:author [ a schema1:Person ;
            schema1:name "VLIZ" ],
        [ a schema1:Person ;
            schema1:name "UGent" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2022-11-01"^^schema1:Date ;
    schema1:dateModified "2023-05-01"^^schema1:Date ;
    schema1:datePublished "2023-05-01"^^schema1:Date ;
    schema1:description """FAIR is an acronym that embodies a set of principles for sharing data. In this short course, we provide an introduction to the FAIR data principles, Open Science and Open data. \r
\r
This is a self-paced course (no facilitators support available). Since there is no evaluation, a certificate will not be issued.""" ;
    schema1:keywords "FAIR principles" ;
    schema1:learningResourceType "lessons" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "FAIR, Open Data and Open Science: an introduction" ;
    schema1:teaches """At the end of this course, the learner should be able to:\r
\r
    explain what are the FAIR principles and its importance\r
    explain the Open Data concept and its relation with the FAIR principles\r
    explain the difference between Open Data and Open Science\r
    apply the FAIR principles to research data (including metadata) and research publications""" ;
    schema1:url <https://oceantraining.eu/moodle/course/view.php?id=29> .

<https://tess.elixir-europe.org/materials/fair-principles-applied-to-bioinformatics> a schema1:LearningResource ;
