                            schema1:addressCountry "United States of America" ;
                            schema1:addressRegion "Stanford" ;
                            schema1:postalCode "94305" ;
                            schema1:streetAddress "Stanford University, Li and Ma Science Library, 376 Lomita Drive" ] ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-01-21 09:00:00 UTC"^^schema1:Date ] ;
