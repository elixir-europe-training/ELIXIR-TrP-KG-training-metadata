<https://tess.elixir-europe.org/events/7th-advanced-in-silico-drug-design-workshop-challenge-2024> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0081>,
