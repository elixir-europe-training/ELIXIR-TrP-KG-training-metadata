<https://tess.elixir-europe.org/events/introduction-to-git-github-73610533-f1f3-4840-bfd3-406c9a90f33f> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """Get you started with Git from zero (note that if you already use Git, this workshop will be too basic for you). We'll explore Git on the command-line and its interaction with GitHub. \r
\r
\r
	Introduction, set-up &amp; configurations\r
	Working locally: Create a repository, clone, edit, staging commits, commit &amp; push\r
	Working with your history &amp; logs\r
	Working in a project: Forking, branching &amp; pull requests\r
	How to version control your code in Rstudio with GitHub\r
\r
\r
During the workshop we also briefly discuss how you can setup a collaboration project.  """ ;
    schema1:endDate "2021-05-11 00:00:00 UTC"^^schema1:Date ;
