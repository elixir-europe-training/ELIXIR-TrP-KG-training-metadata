<https://tess.elixir-europe.org/events/training-plant-data-management-2021> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "MIAPPE 2021" ;
    schema1:description """The Minimal Information About Plant Phenotyping Experiment (MIAPPE, www.miappe.org) standard has been designed by ELIXIR, EMPHASIS and Bioversity international to guide plant scientist in the management of experimental data. Furthermore, since genetic studies relies on the integration and the linking between phenotype and genotype datasets, relevant section of MIAPPE are beginning to be used for genotyping standards.\r
This formation will cover a general introduction of the MIAPPE principles and some examples to illustrate different use cases on the usage of MIAPPE for plant phenotyping data standardization.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2021-09-23 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "INRAE (https://www.inrae.fr/), URGI (https://urgi.versailles.inrae.fr/), URGI - US1164 (https://urgi.versailles.inrae.fr/)" ] ;
            schema1:startDate "2021-09-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Training Plant Data Management  - 2021" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "IFB French Institute of Bioinformatics" ;
            schema1:url <http://www.france-bioinformatique.fr> ] ;
    schema1:url <https://catalogue.france-bioinformatique.fr/api/event/736/?format=json-ld> .

