<https://tess.elixir-europe.org/materials/elixir-cz-friday-coffee-5-data-management-with-data-stewardship-wizard> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "data managers" ],
        [ a schema1:Audience ;
            schema1:audienceType "data stewards" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Tereza Machacova" ],
        [ a schema1:Person ;
            schema1:name "Jana Freeman" ] ;
    schema1:description """This short presentation was presented as part of the Friday Coffee presentation series organized by the ELIXIR CZ infrastructure and offered students a basic insight into data management and data management plans, which are important (not only) for the success of scientific projects, but increasingly for grant applications as well. The presentation also introduced students to the possibility of creating these plans using the [Data Stewardship Wizard](https://ds-wizard.org), a tool that creates the data management plan by filling out a simple, synoptic questionnaire. It offers a simple and very effective solution without the need for deep knowledge of data stewardship or data management.\r
\r
Video available [here](https://www.youtube.com/watch?v=2YGrVGa9JYY).""" ;
