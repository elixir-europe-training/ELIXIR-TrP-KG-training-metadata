<https://tess.elixir-europe.org/events/gtn-smorgasbord> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "A Global Galaxy Course" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "beginner bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "intermediate bioinformaticians" ] ;
    schema1:description """In February 2021, we will organize a global 5-day Galaxy Training event showcasing a wide variety of GTN (Galaxy Training Network) tutorials. This will be an online event, spanning all time zones. All training sessions are pre-recorded, so you can work through them at your own pace, and manage your own time. A large community of GTN trainers will be available via online support to answer all your questions.\r
\r
The program covers a general introduction to the Galaxy platform, NGS Analysis (DNA-seq and RNA-seq), Proteomics, and also features a Choose your own adventure day on Friday, where we encourage you to explore all the tutorials that the GTN training repository has to offer, and follow those that are of interest to you. The GTN tutorials cover a wide range of scientific topics, from NGS to ecology, climate science, machine learning, visualization, and many more. All the tutorials can be found on the GTN website""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-02-19 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Global" ;
                            schema1:streetAddress "Zoom" ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Galaxy Training Network" ] ;
            schema1:startDate "2021-02-15 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Galaxy",
        "Training" ;
    schema1:name "GTN Smörgåsbord" ;
