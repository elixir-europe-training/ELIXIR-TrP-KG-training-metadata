                            schema1:postalCode "3004-531" ;
                            schema1:streetAddress "Department of Informatics Engineering, University of Coimbra - Pólo II" ] ;
                    schema1:latitude "40.207639" ;
                    schema1:longitude "-8.426093" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "BioData.pt" ] ;
            schema1:startDate "2025-03-08 14:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "pt" ;
    schema1:name "All of the genes, none of the code" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Portugal" ;
            schema1:url <https://elixir-portugal.org> ],
        [ a schema1:Organization ;
