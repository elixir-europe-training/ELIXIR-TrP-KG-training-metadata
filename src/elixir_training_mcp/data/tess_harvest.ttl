                    schema1:streetAddress "University of Minho, Campus de Gualtar, Rua da Universidade" ] ;
            schema1:latitude "41.551058" ;
            schema1:longitude "-8.428005" ] ;
    schema1:name "6th BioData.pt | ELIXIR-PT Technical Meeting" ;
    schema1:startDate "2025-03-25 13:30:00 UTC"^^schema1:Date ;
    schema1:url <https://biodata.pt/events/6th-biodatapt-elixir-pt-technical-meeting> .

