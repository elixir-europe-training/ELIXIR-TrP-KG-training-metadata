<https://tess.elixir-europe.org/events/hands-on-introduction-to-spatial-transcriptomics-data-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "In recent years, spatial transcriptomics technologies have become increasingly accessible to researchers with the emergence of a wide-array of commercially available targeted and untargeted approaches. While these technologies offer tantalizing opportunities to study extensive gene panels in their spatial context, the resulting data are often complex and answering research questions of interest requires a thorough understanding of spatial data analysis and the use of dedicated tools. To this end, this training will present a hands-on introduction into the analysis of spatial transcriptomics data using the SPArrOW pipeline developed by the Yvan Saeys group (VIB)." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-12-03 17:00:00 UTC"^^schema1:Date ;
