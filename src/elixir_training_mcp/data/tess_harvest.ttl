<https://tess.elixir-europe.org/events/cabana-train-the-trainer-workshop-for-iscb-latin-america-2020> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
