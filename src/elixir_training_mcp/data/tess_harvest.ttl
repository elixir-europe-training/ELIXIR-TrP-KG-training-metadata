    schema1:url <https://www.ebi.ac.uk/training/online/courses/biostatistics-introduction> .

<https://tess.elixir-europe.org/materials/biostudies-database-aggregating-all-outputs-of-a-life-sciences-study> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3068>,
        <http://edamontology.org/topic_3678> ;
    schema1:description """The goal of the BioStudies database is to facilitate transparency and reproducibility of research by aggregating all the outputs of a study (a ‘data package’) in a single place. A data package consists of the overall biological study description (metadata), links to data generated in this study in key community databases at EMBL-EBI and elsewhere, as well as “orphan data” such as supplemental data. The database can accept a wide range of types of studies described via a simple format and does not impose minimum requirements outside those agreed by the respective community.\r
\r
In this webinar we will introduce the basic principles of BioStudies, explore data access and data deposition interfaces, as well as briefly consider some more advanced topics such as use of BioStudies for data sharing in an ongoing project.""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "BioStudies database: aggregating all outputs of a life sciences study" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/biostudies-database-aggregating-all-outputs-life-sciences-study> .

