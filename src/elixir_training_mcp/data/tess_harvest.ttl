            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- To confirm you have already comprehend the diversity of MS pre-processing analysis.
- To discover the principal functions of the metaMS package for GC-MS data processing available in Galaxy.
- To evaluate the potential of two Galaxy-based workflow approaches when dealing with GC-MS metabolomic analysis.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/metabolomics/tutorials/gcms/tutorial.html> ;
    schema1:version "8" .

<https://tess.elixir-europe.org/materials/hands-on-for-mass-spectrometry-gc-ms-data-processing-with-xcms-ramclustr-riassigner-and-matchms-tutorial> a schema1:LearningResource ;
