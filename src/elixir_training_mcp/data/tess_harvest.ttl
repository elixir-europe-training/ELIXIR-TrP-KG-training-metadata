<https://tess.elixir-europe.org/events/training-course-on-python-for-life-scientists> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3307>,
        <http://edamontology.org/topic_3316> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Bioinformatics beginners " ],
        [ a schema1:Audience ;
            schema1:audienceType "Biologists" ] ;
    schema1:description """Python is an object-oriented programming language that is ideal for biological data analysis. The course will start from zero knowledge, and will introduce the participants to all the basic concepts of Python such as calculating, organizing data, reading and writing files, program logic and writing larger programs. All the examples and practical sessions will focus on solving biological problems. In particular the sessions will cover:\r
- working with DNA and protein sequences\r
- data retrieval from files and their manipulation\r
- running applications, such as BLAST, locally and from a script\r
- finding motifs in sequence\r
- parsing common file formats (Uniprot, GenBank, PDB)\r
- ways to find and correct program errors.\r
\r
The course will be highly interactive and the students will continuously put theory into practice while learning. Basic Unix/Linux skills will be provided at the beginning of the course.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2017-09-15 18:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Italy" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Italy" ;
                            schema1:addressLocality "Roma" ;
                            schema1:addressRegion "Città Metropolitana di Roma" ;
                            schema1:postalCode "00185" ;
                            schema1:streetAddress "Dipartimento di Scienze Biochimiche - Alessandro Rossi Fanelli, 332, Viale Regina Elena" ] ;
                    schema1:latitude "41.904976" ;
                    schema1:longitude "12.515681" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Veronica Morea (CNR-IBPM, Rome, Italy), Allegra Via (ELIXIR-IIB Training Coordinator, CNR-IBPM, Italy), Loredana Le Pera (ELIXIR-IIB Training Team, IIT@Sapienza, Italy) " ] ;
            schema1:startDate "2017-09-11 09:00:00 UTC"^^schema1:Date ] ;
