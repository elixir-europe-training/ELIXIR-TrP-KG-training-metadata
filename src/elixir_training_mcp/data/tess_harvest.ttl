            schema1:name "Bérénice Batut" ] ;
    schema1:creativeWorkStatus "Active" ;
    schema1:dateModified "2025-01-07"^^schema1:Date ;
    schema1:datePublished "2025-01-07"^^schema1:Date ;
    schema1:description """## Abstract

Identifying and annotating mobile genetic elements (MGE) in metagenomic data can be tricky. To facilitate the process, we can use existing and custom annotated mobile genetic element database.


## About This Material

This is a Hands-on Tutorial from the GTN which is usable either for individual self-study, or as a teaching material in a classroom.


## Questions this  will address

 - How can we use an existing database annotated database to identify and annotate genetic elements in metagenomics data?


## Learning Objectives

- Perform metagenomics read mapping against mobile genetic element database.
- Evaluate the distribution of mapping scores to identify high-quality alignments.
- Evaluate plasmid coverage to determine effective filtering thresholds.
- Filter alignments based on plasmid coverage and mapping quality.
- Justify the filtering thresholds chosen for identifying plasmid sequences.
- Generate a curated table of plasmid sequences and convert it into a FASTA file for further analysis.
- Use tools to process sequences, ensuring data is sorted, deduplicated, and formatted correctly.
- Annotate features on the identified plasmids using mobile genetic element database annotations.
- Construct a final annotated dataset integrating genetic element information for downstream applications.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Microbiome" ;
    schema1:learningResourceType "e-learning" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ],
        [ a schema1:Thing ;
            schema1:name "Minimap2" ;
            schema1:url <https://bio.tools/tool/minimap2> ],
        [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/records/14501567> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/microbiome/tutorials/metaplasmidome_query/workflows/> ],
        [ a schema1:Thing ;
            schema1:name "ggplot2" ;
            schema1:url <https://bio.tools/tool/ggplot2> ] ;
    schema1:name "Query an annotated mobile genetic element database to identify and annotate genetic elements (e.g. plasmids) in metagenomics data" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Perform metagenomics read mapping against mobile genetic element database.
- Evaluate the distribution of mapping scores to identify high-quality alignments.
- Evaluate plasmid coverage to determine effective filtering thresholds.
- Filter alignments based on plasmid coverage and mapping quality.
- Justify the filtering thresholds chosen for identifying plasmid sequences.
- Generate a curated table of plasmid sequences and convert it into a FASTA file for further analysis.
- Use tools to process sequences, ensuring data is sorted, deduplicated, and formatted correctly.
- Annotate features on the identified plasmids using mobile genetic element database annotations.
- Construct a final annotated dataset integrating genetic element information for downstream applications.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/microbiome/tutorials/metaplasmidome_query/tutorial.html> ;
    schema1:version "1" .

