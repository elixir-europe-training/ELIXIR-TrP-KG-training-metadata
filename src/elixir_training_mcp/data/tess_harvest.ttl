<https://tess.elixir-europe.org/materials/best-practices-for-citing-galaxy> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Marisa Loach" ],
        [ a schema1:Person ;
            schema1:name "Mirela Minkova" ],
        [ a schema1:Person ;
            schema1:name "Tristan Reynolds" ],
        [ a schema1:Person ;
            schema1:name "Gareth Price" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Helena Rasche" ],
        [ a schema1:Person ;
            schema1:name "David López" ],
        [ a schema1:Person ;
            schema1:name "Teresa Müller" ],
        [ a schema1:Person ;
            schema1:name "Tristan Reynolds" ],
        [ a schema1:Person ;
            schema1:name "Saskia Hiltemann" ] ;
    schema1:creativeWorkStatus "Active" ;
    schema1:dateModified "2025-11-06"^^schema1:Date ;
    schema1:datePublished "2025-11-06"^^schema1:Date ;
    schema1:description """## Abstract

# Overview


## About This Material

This is a Hands-on Tutorial from the GTN which is usable either for individual self-study, or as a teaching material in a classroom.


## Questions this  will address

 - How to cite Galaxy in Publications?


## Learning Objectives

- Apply the Galaxy citation guidelines to your own work.
- Prepare your methodology section based on your Galaxy Histories.""" ;
