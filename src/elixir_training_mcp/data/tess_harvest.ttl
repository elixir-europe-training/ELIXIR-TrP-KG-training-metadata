<https://tess.elixir-europe.org/materials/accessing-single-cell-transcriptome-data-with-the-human-cell-atlas-data-portal> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_2815>,
        <http://edamontology.org/topic_3170>,
        <http://edamontology.org/topic_3308> ;
    schema1:description """The Human Cell Atlas is an ambitious project that aims to map the transcriptome of all the cell types in the human body. This effort relies on single cell data generated from hundreds of labs across the globe, which will be combined together into one comprehensive reference atlas. The Data Portal helps to coordinate the data produced and standardise the format of data and metadata, to reduce the burden of the integration efforts.\r
\r
In this webinar we will provide an overview of data generation for HCA and how the data is curated for the Data Portal. We will demonstrate how to navigate the Data Portal to find data that can be used for integration, or as controls for your studies, how to access the data, and how to find the latest data from the integration efforts.\r
\r
 """ ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Accessing single cell transcriptome data with the Human Cell Atlas Data Portal" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/accessing-single-cell-transcriptome-data-human-cell-atlas-data-portal> .

<https://tess.elixir-europe.org/materials/accessing-variant-data-at-the-european-variation-archive> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description """The European Variation Archive (EVA) is a primary open repository for archiving, accessioning, and distributing genome variation including single nucleotide variants, short insertions and deletions (indels), and larger structural variants (SVs) in any species.\r
\r
This webinar will demonstrate how to access the latest EVA release, consisting of submitted variants clustered into RS IDs. It will also provide an overview of the recent updates to this data including what species have had their variant data remapped and how we annotate remapped variant data.""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Accessing variant data at the European Variation Archive" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/accessing-variant-data-european-variation-archive> .

<https://tess.elixir-europe.org/materials/adding-and-updating-best-practice-metadata-for-galaxy-tools-using-the-bio-tools-registry> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3372> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Galaxy Administrators" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Bérénice Batut" ],
        [ a schema1:Person ;
