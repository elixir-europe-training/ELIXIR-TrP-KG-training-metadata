<https://tess.elixir-europe.org/events/professional-skillset-training-for-support-staff-change-management> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Navigating change management: Leveraging transformation for success and organizational growth in laboratory and administrative management. In this final segment of our professional skillset training, we embark on the ultimate journey of mastering the dynamics of change in our workplace. Our focus is on effectively adapting to new challenges, adjusting our boundaries, managing team resistance, and navigating confrontations.How does our communication evolve based on our role?As leaders, how do we respond when our boundaries are tested?Recognizing that change often sparks resistance, both internally and externally, we equip you with the tools and techniques to effectively manage and mitigate this resistance. We uncover strategies for optimizing time management, identifying quick wins, and mastering the art of delegation.Through a combination of role-playing exercises, reflective tools, and immersive real-life scenario analysis, participants will have the opportunity to develop a resilient and professional approach to change management within a supportive environment, fostering collective growth and experiential learning." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-12-03 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Leuven" ;
                            schema1:postalCode "3000" ;
                            schema1:streetAddress "Leuven - Campus Gasthuisberg, Herestraat 49" ] ;
                    schema1:latitude "50.879202" ;
                    schema1:longitude "4.701168" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-12-03 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "communication skills",
        "personal effectiveness" ;
    schema1:name "Professional Skillset Training for Support Staff: Change Management" ;
    schema1:provider [ a schema1:Organization ;
