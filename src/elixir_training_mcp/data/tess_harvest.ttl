<https://tess.elixir-europe.org/events/accessing-interpro-programmatically> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Melissa Burke" ;
    schema1:description "The InterPro website relies on an Application Programming Interface (API) which can also be utilised by users for direct access to the data. This webinar describes how the InterPro data is structured in the API, and how it could be accessed programmatically for further bioinformatics analyses." ;
    schema1:endDate "2020-05-20 16:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "Accessing InterPro programmatically" ;
    schema1:startDate "2020-05-20 15:30:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2020/accessing-interpro-programmatically> .

<https://tess.elixir-europe.org/events/accessing-interpro-programmatically-f309b5d3-03cd-436e-8002-6de57c2ee587> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_1777>,
        <http://edamontology.org/operation_2479>,
        <http://edamontology.org/topic_0078> ;
    schema1:description """This is the third and last part of a webinar series on InterPro which is held between May 6th 2020 and May 20th 2020.\r
\r
InterPro is a database that helps users to understand the possible functions of proteins sequence by identifying what family it belongs to or what domains and motifs it contains. To deal with the growing volume of protein sequence data and an increasing demand to retrieve subsets of the data, often via programmatic access, the InterPro website has been entirely redesigned. It provides additional features and more flexibility in querying, presenting and retrieving data. The website relies on an Application Programming Interface (API) which can also be utilised by users for direct access to the data.\r
\r
This webinar describes how the InterPro data is structured in the API, and how it could be accessed programmatically for further bioinformatics analyses.\r
\r
You can access the slides via GitHub.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2020-05-20 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 200 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-05-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "InterPro",
        "Interpro API",
        "Programmatic access",
        "Proteins (proteins)" ;
    schema1:name "Accessing InterPro programmatically" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/accessing-interpro-programmatically> .

<https://tess.elixir-europe.org/events/accessing-sequence-analysis-tools-via-the-new-job-dispatcher-website> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_1192>,
        <http://edamontology.org/operation_0292> ;
    schema1:description "The Job Dispatcher team at EMBL-EBI provides access to various bioinformatics sequence analysis tools (EMBOSS, Clustal omega, NCBI BLAST+, etc) and biological datasets.This webinar will introduce the new Job Dispatcher website, showcasing how to navigate through various categories of tools and access them for sequence analysis. We will also demonstrate the latest features and user documentation of the Job Dispatcher." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
