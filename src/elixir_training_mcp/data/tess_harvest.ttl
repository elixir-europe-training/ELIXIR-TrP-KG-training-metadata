<https://tess.elixir-europe.org/events/r-for-data-science> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_2269> ;
    schema1:alternateName "Applied to Life Sciences and Clinical research (intermediate level)" ;
    schema1:description """The course covered content for these learning objectives:\r
\r
    To write your own custom functions\r
    To use for loops, apply functions and if statements\r
    To analyse large matrices of data in a semi-automated way\r
    To normalise data\r
    To quantify and correct batch effect\r
    To undertake the most common clustering algorithms including k-means and hierarchical\r
    To perform variable selection and present these results in different plots including heatmaps\r
    To do 2-way ANOVA\r
    To undertake multivariate modelling\r
    A brief introduction to machine learning.\r
\r
The course included brief theoretical introductions followed by hands on exercises based on real life research examples. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
