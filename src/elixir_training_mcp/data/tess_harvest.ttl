<https://tess.elixir-europe.org/materials/hybrid-genome-assembly-nanopore-and-illumina> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0196> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Grace Hall" ],
        [ a schema1:Person ;
            schema1:name "Tristan Reynolds" ] ;
