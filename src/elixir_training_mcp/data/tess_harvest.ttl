<https://tess.elixir-europe.org/materials/statistical-analysis-using-graphpad-prism> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name " Anne Segonds-Pichon" ] ;
    schema1:description """GraphPad Prism is a powerful and friendly package which allows you to plot and analyse your data. This course acts not only as an introduction to Prism, but also goes through the basic statistical knowledge which should allow you to make the most of your data.\r
\r
**Course Content**\r
\r
* Introduction to GraphPad Prism\r
* Preparing your data for analysis\r
* Getting to know your data\r
* Graphical representations\r
* Choosing an appropriate analysis\r
* Interpreting analysis output\r
\r
**Course Material**\r
\r
* [Course Manual (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Prism%20course%20manual.pdf)\r
* [Course Manual (doc)](http://www.bioinformatics.babraham.ac.uk/training/Prism%20course%20manual.doc)\r
* [Course Slides (pdf)](http://www.bioinformatics.babraham.ac.uk/training/Prism%20course%20slides.pdf)\r
* [Course Slides (ppt)](http://www.bioinformatics.babraham.ac.uk/training/Prism%20course%20slides.pptx)\r
* [Course Exercise Files (zip)](http://www.bioinformatics.babraham.ac.uk/training/Prism_Exercises.zip)""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Babraham Institute",
        "GraphPad Prism" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/other-nc> ;
    schema1:name "Statistical Analysis using GraphPad Prism" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Bioinformatics and Biomathematics Training Hub" ;
            schema1:url <http://www.earlham.ac.uk/bbsrc-bioinformatics-and-biomathematics-training-hub> ] ;
    schema1:url <http://www.bioinformatics.babraham.ac.uk/training.html#prism> .

<https://tess.elixir-europe.org/materials/statistical-analysis-using-spss> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
