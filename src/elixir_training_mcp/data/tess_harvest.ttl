<https://tess.elixir-europe.org/events/online-software-carpentry-workshop-eosc-life-de-nbi-git> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Magnus Karl Moritz, Hagdorn, Martin Braun\r
\r
Date:\r
20.07.2023 9am-1pm\r
\r
Location:\r
online\r
\r
Content:\r
Our Software Carpentry Workshop aims to help researchers get their work done in less time and with less pain by teaching them basic research \r
computing skills. This hands-on workshop will cover basic concepts and good practices of using a version control system (git). Participants \r
will be encouraged to help one another and to apply what they have learned to their own research problems.\r
\r
Prerequisites:\r
Browser\r
\r
Keywords:\r
Python, Git, Cloud Computing, Linux, de.NBI Cloud, EOSC Life\r
\r
Tools:\r
Bash, Python\r
\r
Contact:\r
martin.braun@charite.de""" ;
