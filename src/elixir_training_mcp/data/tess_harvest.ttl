                            schema1:postalCode "25655-031" ;
                            schema1:streetAddress "Fiocruz - Palácio Itaboraí, R. Visc. of Itaboraí188" ] ;
                    schema1:latitude "-22.13527" ;
                    schema1:longitude "-42.708021" ] ;
            schema1:maximumAttendeeCapacity 15 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-03-31 09:00:00 UTC"^^schema1:Date ] ;
