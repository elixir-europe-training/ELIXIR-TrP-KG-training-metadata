    schema1:name "Methods and resources for omics studies: A curated collection of EMBL-EBI on-demand training" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/online/courses/methods-and-resources-for-omics-studies> .

<https://tess.elixir-europe.org/materials/methods-for-exploring-newly-annotated-species-in-ensembl-rapid-release> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description """Newly sequenced genomes, including those produced by the Darwin Tree of Life project, are all added to Ensembl Rapid Release. These genomes have minimal annotation, with genes mapped onto the genome, protein domain analysis and homologue predictions. \r
\r
This webinar will guide you through the data available for newly-annotated species in the Ensembl Rapid Release site and how to cross-reference against more fully-annotated genomes in the main Ensembl genome browser.""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Methods for exploring newly-annotated species in Ensembl Rapid Release" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/methods-exploring-newly-annotated-species-ensembl-rapid-release> .

<https://tess.elixir-europe.org/materials/methods-for-infectious-disease-modelling-using-genomics> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description "Here, we have made some of the EMBO Practical Course: Methods for infectious disease modelling using genomics course's materials available for you to access any time. The last edition of the course ran in September 2025.This set of materials goes through concepts, methods, and tools for carrying out infectious disease modelling, as well as for developing models further by leveraging the power of genomics." ;
    schema1:learningResourceType "Course materials" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Methods for infectious disease modelling using genomics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/materials/infectious-disease-modelling-using-genomics-materials> .

<https://tess.elixir-europe.org/materials/methods-for-rare-variant-association-analysis> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0622> ;
    schema1:description """Rare variants contribute to development of familial cancer.  Genes carrying rare variants may contribute to molecular mechanisms of sporadic cancers.  Historically, many of the rare variants were discovered by co-segregation with the disease in cancer families.  However, recent progress in population scale sequencing opens new opportunities for using association analysis for detection of rare variants.  \r
\r
The standard methods of association analysis were developed for common variants.  While the standard regression framework and population stratification approaches hold in the rare-variant analysis, it may additionally require (i) aggregating of variants per gene (or pathway), (ii) weighting by biological significance and allelic frequency, and (iii) applying permutation-style tests for estimating statistical significance.  \r
\r
The webinar will discuss these features of rare-variant analysis and illustrate their implementation using SKAT R library.  \r
\r
 """ ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Methods for rare-variant association analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/methods-rare-variant-association-analysis> .

<https://tess.elixir-europe.org/materials/methods-in-bioimage-analysis> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description """Microscopy is a key technology driving biological discovery. Nowadays, microscopy based scientific findings must be substantiated by quantitative image analysis. The discipline concerned with such quantification of biological microscopy images is called bioimage analysis.\r
\r
This webinar will walk us through the main concepts of a typical bioimage analysis workflow, including how to quantitatively interpret the content of microscopy images, how to automatically detect objects in images and derive object-based measurements. It will emphasise the importance of visual inspection and quality control of automated image analysis.\r
\r
Finally, this webinar will also provide an overview of current bioimage analysis tools and communities.\r
\r
 """ ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Methods in bioimage analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/methods-bioimage-analysis> .

<https://tess.elixir-europe.org/materials/methods-in-bioinformatics> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Clinicians" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD students" ] ;
    schema1:description "This collection brings together introductions to a variety of methods used in bioinformatics, including building biological networks, genomic variant calling, mass spectrometry-based proteomics, and bioimage analysis, through videos presented by experts from EMBL and worldwide." ;
    schema1:keywords "Networks" ;
    schema1:learningResourceType "e-learning" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Methods in bioinformatics: Biological data analysis and interpretation" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/online/courses/methods-in-bioinformatics> .

<https://tess.elixir-europe.org/materials/methods-in-building-and-analysing-biological-networks> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0128> ;
    schema1:description """Cells are complex and dynamic systems able to modify their behaviour and their morphology in response to internal or environment-induced cues. Such response is achieved thanks to enzymatic reactions and physical interactions that occur between cellular components such as proteins, genes and molecules. Complex diseases (e.g. cancer), have proven to result from alterations in the capacity of cell components to interact and communicate. \r
\r
During this webinar we will:\r
\r
\r
	Introduce biological networks: conceptual and intuitive framework to investigate, visualise and understand this complex web of interactions.\r
	Show applications of basic graph theory concepts to physical or signalling interaction networks.\r
	Familiarise with open-access repositories that capture, organise and display physical and signalling interactions.\r
	Introduce Cytoscape, an open source software platform for querying public databases and for visualising and analysing networks.\r
\r
\r
 """ ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Methods in building and analysing biological networks" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/methods-building-and-analysing-biological-networks> .

<https://tess.elixir-europe.org/materials/methods-in-genomic-variant-calling> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:description """Genomic variant calling entails identifying single nucleotide polymorphisms, small insertions and deletion (InDels) and larger variants (structural variants and copy-number variants) from next generation sequencing data. \r
\r
This webinar will cover the basics of germline and somatic variant calling as well as their annotation and visualisation. We will get to know workflows to perform variant calling, look at relevant file formats and discuss some variant calling applications in rare diseases, cancer genomics and population genomics.""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Methods in genomic variant calling" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/methods-genomic-variant-calling> .

