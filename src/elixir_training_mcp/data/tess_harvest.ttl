                            schema1:addressRegion "Città Metropolitana di Milano" ;
                            schema1:streetAddress "University of Milano-Bicocca, Building U7, Lab 715" ] ;
                    schema1:latitude "45.517431" ;
                    schema1:longitude "9.212474" ] ;
