<https://tess.elixir-europe.org/events/introduction-to-biostatistics-and-machine-learning-a7e0f34f-5a0b-4cae-9c17-3377615281ca> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """National course open for PhD students, postdocs, researchers and other employees in need of biostatistical skills within all Swedish universities. The course is geared towards life scientists wanting to be able to understand and use basic statistical and machine learning methods. It would also suit those already applying biostatistical methods but have never got a chance to truly understand the basic statistical concepts, such as the commonly misinterpreted p-value.

In this course we focus on an active learning approach. The course participants are expected to do some pre-course reading and exercises, corresponding up to 40h studying. The education consists of teaching blocks alternating between mini-lectures, group discussions, live coding sessions etc.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-04-11 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Sweden" ;
                            schema1:addressLocality "Uppsala" ;
                            schema1:streetAddress "SciLifeLab Uppsala - Navet, Husargatan 3" ] ;
                    schema1:latitude "59.858613" ;
                    schema1:longitude "17.638744" ] ;
            schema1:startDate "2025-04-07 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "Introduction to Biostatistics and Machine Learning" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "NBIS" ;
            schema1:url <http://nbis.se> ] ;
    schema1:url <https://uppsala.instructure.com/courses/98820> .

