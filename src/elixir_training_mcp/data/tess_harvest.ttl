<https://tess.elixir-europe.org/events/research-data-management-rdm-in-life-sciences-essentials> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Effective research data management (RDM) is more than just a compliance requirement - it's a practical tool that simplifies your workflow, strengthens your research, and enhances the impact of your publications. This training is designed to help researchers embed RDM practices into their projects from the very beginning, always keeping the publication process in focus. Throughout the day, participants will learn how to organize, document, and share their data in ways that promote transparency, reproducibility, long-term accessibility, and high-impact publishing. Through hands-on exercises and interactive discussions, the course introduces essential concepts such as FAIR data, open data, and data management, while also covering practical topics like metadata standards and selecting appropriate repositories. Whether you're preparing your first manuscript or refining your data practices, this course will provide the tools and confidence to manage your research data more effectively and publish with greater confidence. " ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2026-03-31 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Belgium" ] ;
            schema1:location [ a schema1:Place ;
