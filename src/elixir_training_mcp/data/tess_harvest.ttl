            schema1:organizer [ a schema1:Organization ;
                    schema1:name "CSC - Webinar" ] ;
            schema1:startDate "2021-04-23 10:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "TESS",
        "tess" ;
    schema1:name "Mitä tutkimuksen toistettavuus tarkoittaa?" ;
