<https://tess.elixir-europe.org/materials/a-beginner-s-guide-to-interpreting-results-from-biostatistics> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_2269> ;
    schema1:description """This webinar will cover the general concepts behind hypothesis testing workflow, including summary statistics, null and alternative hypotheses, and p-values. We will focus specifically on what you should pay attention to when you interpret results from a biostatistical analysis. \r
\r
During the webinar, we will be using gene expression as an example, and work with visuals rather than equations, to make the topic accessible to a broad audience.""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "A beginner’s guide to interpreting results from biostatistics" ;
