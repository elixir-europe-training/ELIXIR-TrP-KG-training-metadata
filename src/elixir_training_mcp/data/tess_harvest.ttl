    schema1:name "Crash Course in Data Management" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <https://elixir.ut.ee> ] ;
    schema1:teaches """* Apply best practices in file naming and folder structuring\r
* Select and apply appropriate ontologies and metadata standards\r
* Describe data storage and backup strategies\r
* Choose the right license for your data/published results""" ;
