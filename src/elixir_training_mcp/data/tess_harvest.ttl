    schema1:teaches """- Perform group comparison analysis.
- Analyze significant proteins
- Look at the taxonomic distribution of the quantified peptides""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/clinical-mp-5-data-interpretation/tutorial.html> ;
    schema1:version "4" .

