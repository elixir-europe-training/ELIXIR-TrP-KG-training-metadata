            schema1:maximumAttendeeCapacity 22 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Estonia" ] ;
            schema1:startDate "2023-03-21 14:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "CONVERGE",
        "Data management",
