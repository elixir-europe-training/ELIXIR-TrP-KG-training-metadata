<https://tess.elixir-europe.org/events/glycosciences> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "European Training Course on Carbohydrates" ;
    schema1:coursePrerequisites """The course is at graduate level and participants will have a background in the life sciences, and are working with carbohydrates. The course is a must for those working in academia, research institutes or industry that want to refresh their knowledge on carbohydrates and for graduate students working on a PhD project related to carbohydrate chemistry, biochemistry, biology, chemical technology or food science. All participants are encouraged to bring a poster in which they introduce themselves and their work.\r
\r
It is expected that the participants have a sufficient command of the English language to actively participate in the discussions and to present their own work in English.""" ;
    schema1:description "The 18th Summer Course Glycosciences offers a blend of broad introductory lectures and in-depth sessions on carbohydrates and glycoproteins, complemented by interactive activities to foster discussion and networking. Aimed at graduate students and professionals in academia, research, and industry, the program covers topics ranging from glycoscience nomenclature and analytical techniques to biosynthesis, enzymology, health applications, and food science." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-06-05 13:30:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Netherlands" ;
                            schema1:addressLocality "Groningen" ;
                            schema1:addressRegion "Groningen" ;
                            schema1:postalCode "9728 JT" ;
                            schema1:streetAddress "Flonk Hotel Groningen Zuid" ] ;
                    schema1:latitude "53.219384" ;
                    schema1:longitude "6.566502" ] ;
            schema1:startDate "2025-06-01 16:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "Enzymes",
        "Proteomics",
        "glycomics",
        "glycoproteomics",
        "mass spectrometry" ;
    schema1:name "Glycosciences" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University of Groningen" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Netherlands" ;
            schema1:url <http://www.dtls.nl/courses/> ] ;
    schema1:teaches """After this course you will be able to:\r
\r
Understand different glycan architectures, methods to study glycans, and applications of glycans in health and disease,\r
\r
Assign glycan structure based on MS spectra.\r
\r
Workload\r
Lectures: 28 hours\r
Poster presentations (voluntary): 4 hours\r
Assignment: 3 hours\r
\r
Upon successful completion of the programme, the Summer School offers a Certificate of Attendance that mentions the workload of 35 hours (28 hours corresponds to 1 ECTS). Students can apply for recognition of these credits to the relevant authorities in their home institutions, therefore the final decision on awarding credits is at the discretion of their home institutions. We will be happy to provide any necessary information that might be requested in addition to the certificate of attendance.""" ;
    schema1:url <https://www.rug.nl/education/summer-winter-schools/glycosciences/?lang=en> .

