            schema1:endDate "2021-11-03 17:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2021-11-03 14:00:00 UTC"^^schema1:Date ] ;
    schema1:name "On-The-Fly Molecular Docking with JAMDA on the ProteinsPlus Web Server" ;
    schema1:provider [ a schema1:Organization ;
