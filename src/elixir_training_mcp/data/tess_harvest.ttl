                    schema1:latitude "40.768712" ;
                    schema1:longitude "14.792018" ] ;
            schema1:startDate "2017-09-27 11:00:00 UTC"^^schema1:Date ] ;
    schema1:name "ELIXIR-EXCELERATE Train the Trainer" ;
    schema1:provider [ a schema1:Organization ;
