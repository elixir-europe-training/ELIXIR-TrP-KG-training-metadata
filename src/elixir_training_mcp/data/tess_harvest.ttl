<https://tess.elixir-europe.org/events/fair-ification-of-toxicological-research-output-leveraging-elixir-resources> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description "This webinar serves as preparation for the free-of-charge 2-days hands-on workshop entitled \"FAIR-ification of Toxicological Research Output: Leveraging ELIXIR Resources\" to be held on 28-29 May 2024 in Utrecht, The Netherlands. This is the first of five workshops organized during 2024 -2025 by the ELIXIR Toxicology Community as part of their Implementation Study (INTOXICOM)." ;
