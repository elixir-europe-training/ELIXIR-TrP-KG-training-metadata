<https://tess.elixir-europe.org/materials/a-tour-of-machine-learning-classification-c808b616-c204-4d1c-893f-187c205e512a> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
