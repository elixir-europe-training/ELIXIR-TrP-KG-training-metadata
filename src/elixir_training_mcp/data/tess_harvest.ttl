<https://tess.elixir-europe.org/events/cabana-workshop-genomic-and-transcriptomic-resources-for-eukaryotic-species> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_3225>,
        <http://edamontology.org/topic_3168>,
        <http://edamontology.org/topic_3308> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType """This course is suitable for postgraduate students (MSc-level and above), postdoctoral-level researchers, newly established principal investigators and other research scientists within Latin America, who wish to use omics resources/analysis in their own research. We welcome applications from universities, research centres, hospitals, public health, and private laboratories.\r
\r
Scientists from underrepresented ethnic and gender groups are especially encouraged to apply for this workshop, for example women and those with Black and/or Indigenous heritage.\r
\r
Please note this course will be taught in English, however the trainers are fluent in either Portuguese or Spanish and can offer language support where feasible. Attendance priority will be given to those who have not attended a CABANA event yet.\r
\r
Prerequisites\r
Working knowledge of genetics and/or molecular biology would be advantageous. You will also require access to a computer for the duration of the workshop. You do not need to know how to use UNIX / Linux operating systems and the command line, as the course covers the basics.\r
&nbsp;""" ] ;
    schema1:description "This course is intended to be a gentle introduction to the computational resources available for analysis of omics data in eukaryotic species. Specifically, we will cover: 1) an optional Linux crash course; 2) file formats commonly used in NGS data analysis; 3) web resources available for the analysis of eukaryotic omics data; 4) common bioinformatics pipelines used to analyse genomic/transcriptomic data from eukaryotic species (sequence alignment, phylogenetic tree reconstruction, variant detection, RNA-Seq and data visualization in genome browsers). Live components of the course will run around 09:00-12:00 BRT and you are encouraged to use the afternoon to practice, using a specified forum or communication method to ask for support. Support will end around 17:00 BRT each day." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-08-10 17:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2021-08-02 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "DNA & RNA (dna-rna)",
        "Ensembl Genomes" ;
    schema1:name "CABANA Workshop: Genomic and transcriptomic resources for eukaryotic species" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/cabana-workshop-genomic-and-transcriptomic-resources-eukaryotic-species> .

<https://tess.elixir-europe.org/events/cabana-workshop-genotyping-by-sequencing-applied-to-plant-breeding> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Laura Brenes Guillén" ;
    schema1:description "This workshop will provide training around the experimental design and multiple applications of Genotyping by Sequencing (GBS) in plants. In addition, detailed computational analysis of GBS data and resources will be explored." ;
    schema1:endDate "2019-08-09 13:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Costa Rica" ;
