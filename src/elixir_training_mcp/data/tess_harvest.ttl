            schema1:url <https://www.bigcat.unimaas.nl/> ] ;
    schema1:url <https://bmcgenomics.biomedcentral.com/articles/10.1186/1471-2164-15-971> .

<https://tess.elixir-europe.org/materials/a-practical-guide-for-sars-cov-2-whole-genome-sequencing-join-now> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "scientific researchers, public health professionals and clinicians" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Our core educator team can be found on our course page." ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Our list of contributors can be found on our course page." ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2022-09-19"^^schema1:Date ;
    schema1:datePublished "2022-09-19"^^schema1:Date ;
    schema1:description """**Investigate SARS-CoV-2 sequencing methodologies**\r
Using research, articles, and videos, you will access information and techniques to optimise your current data handling and processing. You will learn about sequencing platforms and library preparation methodologies, comparing the benefits and limitations of each approach and its associated protocols.\r
\r
**Apply data quality control and analysis**\r
With an introduction to data quality control metrics and standards, you will learn how to interpret high-quality data and how to perform basic viral genetic diversity analyses. You will learn how to process and report on your quality control and also the ethical considerations of genomic sequencing.\r
\r
**Contribute to the global response to COVID-19**\r
Once equipped with the skills to gather and analyse your data, you will be able to discuss and plan the most appropriate strategy for your team. You will gain an overview of how global experts overcame the challenges to tackle a pandemic and how you can apply these experiences to other global health threats.\r
\r
You will finish this course understanding the entire process of viral sequencing, able to make vital contributions to the development of pathogen genomics capacity in a global context.""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Best Practices",
        "Genomic data",
        "Genomics",
        "Metagenomics",
        "Sequencing",
        "covid-19",
        "library preparation",
        "quality control",
        "sars-cov-2",
        "surveillance" ;
    schema1:learningResourceType "FREE online course" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "A Practical Guide for SARS-CoV-2 Whole Genome Sequencing   Join now" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "COG-Train" ;
            schema1:url <https://www.cogconsortium.uk/priority-areas/training/> ] ;
    schema1:url <https://www.futurelearn.com/courses/a-practical-guide-for-sars-cov-2-whole-genome-sequencing> .

