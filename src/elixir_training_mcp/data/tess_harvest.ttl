                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM I, Technologiepark 71" ] ;
                    schema1:latitude "51.010766" ;
                    schema1:longitude "3.705625" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2020-01-07 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
