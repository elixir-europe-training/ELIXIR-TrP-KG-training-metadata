<https://tess.elixir-europe.org/materials/europe-pmc-api-workshop-part-one> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Madhumiethaa Jayaprabha Palanisamy" ] ;
    schema1:dateCreated "2024-08-07"^^schema1:Date ;
    schema1:datePublished "2024-08-09"^^schema1:Date ;
    schema1:description """Recording of the Europe PMC API workshop: Part one. A workshop covering Europe PMC developer resources, focusing on the Articles API. Slides available: https://figshare.com/articles/presentation/Europe_PMC_API_workshop_Part_one/26527138?file=48305962\r
\r
Explaining how to apply Europe PMC tools for following use cases: \r
- Identifying publications on a particular topic with associated PDB Structures and analysing their citations\r
- Identify authors linked to specific concepts\r
- Get evaluators list for a specific article published by a specific author\r
- Get notified if an article is retracted, or a preprint is published.\r
\r
To find part two of this workshop please follow the following link here: https://tess.elixir-europe.org/materials/europe-pmc-api-workshop-part-two""" ;
    schema1:keywords "API",
        "Europe PMC",
        "Literature database search",
        "Literature search" ;
    schema1:learningResourceType "Recorded webinar",
        "Slidedeck" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Europe PMC API workshop: Part one" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.youtube.com/watch?v=E4mhXJTr7To> .

<https://tess.elixir-europe.org/materials/europe-pmc-api-workshop-part-two> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Zunaira Shafique" ] ;
    schema1:description """Recording of the Europe PMC API workshop: Part two. A workshop covering Europe PMC developer resources, focusing on the Annotations API. Slides available: https://figshare.com/articles/presentation/Europe_PMC_API_workshop_Part_two/26947717?file=49028434 \r
\r
Covering: \r
-how to find biological entities in articles \r
-article IDs with annotation details of cited databases  \r
-annotations from supplementary files of the articles.\r
\r
To find part one of this workshop series please follow the link here: https://tess.elixir-europe.org/materials/europe-pmc-api-workshop-part-one""" ;
