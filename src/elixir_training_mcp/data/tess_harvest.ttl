<https://tess.elixir-europe.org/events/nerc-mdibl-environmental-genomics-and-metabolomics-2018> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:about <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_3172> ;
    schema1:description "This NERC funded short course will provide a hands-on approach to guide genomics and metabolomics research applied to the environmental scientists. Participation in the course is open to everyone but priority is given to NERC-funded PhD students and early-career scientists. The course will include ~1.5 days generic environmental omics training and ~3.5 days specialized genomics or metabolomics training. Case studies using multi-omics data will be provided so that you gain practical experience of analyzing and interpreting multi-omics data. Distinguished visiting academics will provide keynote lectures on each day of the course to highlight environmental omics applictions that draw on the expertise of the guest faculty." ;
    schema1:endDate "2018-03-09 00:00:00 UTC"^^schema1:Date ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "United Kingdom" ;
                    schema1:addressLocality "Birmingham" ;
                    schema1:postalCode "B15 2TT" ;
                    schema1:streetAddress "Birmingham Metabolomics Training Centre" ] ;
            schema1:latitude "52.448972" ;
            schema1:longitude "-1.93086" ] ;
    schema1:name "NERC-MDIBL Environmental Genomics and Metabolomics 2018" ;
    schema1:startDate "2018-03-04 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.birmingham.ac.uk/schools/biosciences/conferences/mdibl-course/index.aspx> .

