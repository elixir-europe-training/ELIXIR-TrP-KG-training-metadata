<https://tess.elixir-europe.org/events/galaxy-admin-training-e8fe46a1-a150-4a0d-a33f-e7e8b2653258> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Linux system administrators" ] ;
    schema1:description """Galaxy is an open web based platform for biomedical data integration and analysis. It is deployed at large and small organizations around the world and used in a broad range of biomedical research domains, and across the tree of life.\r
\r
This [workshop](https://gxy.io/gat) will cover introductory and advanced topics you need to know to set up your own production, high-performance and multi-user Galaxy instance. Sessions will be intensive and hands-on, and taught by experienced instructors from the Galaxy Community. Participants will learn how to install, configure, customize, and extend their own Galaxy servers. Topics include tool configuration, authentication and user management, using heterogeneous storage and compute services, and many other topics that will enable you to get your own Galaxy server up and running, performing well, and used by your community.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-01-29 23:00:00 UTC"^^schema1:Date ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Galaxy Training Network" ] ;
            schema1:startDate "2021-01-25 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Galaxy",
        "System Administration",
        "training" ;
    schema1:name "Galaxy Admin Training" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR France" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Netherlands" ;
            schema1:url <http://www.dtls.nl/courses/> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Czech Republic" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:url <https://galaxyproject.org/events/2021-01-admin-training/> .

<https://tess.elixir-europe.org/events/galaxy-admin-workshop-2020> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Björn Grüning, Gianmauro Cuccuru (RBC)\r
\r
Date:\r
2020-03-02 to 2020-03-06\r
\r
Location:\r
Barcelona Supercomputing Center, Barcelona, Spain\r
\r
Contents:\r
This workshop will cover introductory and advanced topics you need to know to set up your own production, high-performance and multi-user Galaxy instance. Sessions will be intensive and hands-on, and taught by experienced instructors from the Galaxy Community. Participants will learn how to install, configure, customize, and extend their own Galaxy servers. Topics include tool configuration, authentication and user management, using heterogeneous storage and compute services, and many other topics that will enable you to get your own Galaxy server up and running, performing well, and used by your community.\r
Galaxy is an open web based platform for biomedical data integration and analysis. It is deployed at large and small organizations around the world and used in a broad range of biomedical research domains, and across the tree of life.\r
\r
Prerequisites:\r
- Comfortable with the Unix/Linux command line\r
- Competent in a Unix/Linux text editor\r
- Some experience with Linux Package Management\r
\r
All participants should bring a wifi-enabled laptop with at least 4GB of memory (more is better), Software to access the command line of a Linux server\r
      - If you are running Linux or Mac OS, then you already have this.\r
      - If you are running Windows than you’ll need to get something like putty installed before the workshop.\r
A recent version of either the Chrome or Firefox web browser installed.\r
\r
Keywords:\r
Galaxy\r
\r
Tools:\r
Galaxy""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2020-03-06 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Spain" ;
                            schema1:addressLocality "Barcelona" ;
                            schema1:addressRegion "Provinz Barcelona" ;
                            schema1:streetAddress "Barcelona" ] ;
                    schema1:latitude "41.385064" ;
                    schema1:longitude "2.173404" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI" ] ;
            schema1:startDate "2020-03-02 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Galaxy Admin workshop 2020 " ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:url <https://www.denbi.de/training/803-galaxy-admin-workshop> .

<https://tess.elixir-europe.org/events/galaxy-africa> a schema1:Event ;
