<https://tess.elixir-europe.org/events/genome3d-annotations-in-interpro> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Anna Swan" ;
    schema1:description "Genome3D provides consensus structural annotations and 3D models for sequences from ten model organisms, including human." ;
    schema1:endDate "2019-09-11 16:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "Genome3D annotations in InterPro" ;
    schema1:startDate "2019-09-11 15:30:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2019/genome3d-annotations-interpro> .

<https://tess.elixir-europe.org/events/genome3d-annotations-in-interpro-12d32d4a-2965-4def-be55-17ef6130f54c> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_1460>,
        <http://edamontology.org/topic_0166>,
        <http://edamontology.org/topic_2814> ;
    schema1:description """Genome3D provides consensus structural annotations and 3D models for sequences from ten model organisms, including human. These data are generated by several UK-based resources that together form the Genome3D consortium: SCOP, CATH, SUPERFAMILY, Gene3D, FUGUE, pDomTHREADER and PHYRE. InterPro, meanwhile, provides functional analysis of proteins by classifying them into homologous superfamilies and families, and by predicting domains, repeats and important sites, based on data from 14 member databases.

This webinar presents the new InterPro entry type, Homologous superfamily, as well as describing domain and structure predictions from Genome3D annotations, and how they are integrated in InterPro.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2019-09-11 17:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 200 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2019-09-11 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Genome annotations",
        "Genome3D",
        "InterPro",
        "Protein domain prediction",
        "Proteins (proteins)" ;
    schema1:name "Genome3D annotations in InterPro" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/genome3d-annotations-interpro> .

