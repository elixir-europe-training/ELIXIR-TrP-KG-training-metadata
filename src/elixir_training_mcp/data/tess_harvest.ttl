    schema1:url <https://www.denbi.de/training/848-introduction-to-python-programming> .

<https://tess.elixir-europe.org/events/introduction-to-python-session-16-10-2024-17-10-2024> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Introduction To Python - session 16/10/2024 - 17/10/2024" ;
    schema1:description """The Toulouse Genotoul bioinformatics platform, organizes a 2 days long training course for non computer scientist and biologists aiming at learning the foundation of Python programming. In this training you will learn the basics of programming (variables, functions, control structures such as “if” condition, “for” loop”), writing simple programs which read files, and write results to others. The training course does not require any knowledge in programming, but basic Linux/bash commands are required (cd, ls).\r
\r
This training focuses on practice. It consists of modules with a large variety of exercises described hereunder (PROVISIONAL SCHEDULE):\r
\r
Using a Jupyter notebook (Day 1).\r
Using variables (Day 1).\r
Basic operations and functions (Day 1).\r
Reading a file, writing to a file (Day 1).\r
Character string manipulation (Day 1).\r
Lists and dictionaries (Day 2).\r
The if and for controls (Day 2).\r
Bases of algorithms (Day 2).""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
