            schema1:name "ELIXIR Estonia" ;
            schema1:url <https://elixir.ut.ee> ] ;
    schema1:teaches """* Understand the principles and importance of EDA.\r
* Summarize datasets using descriptive statistics.\r
* Visualize trends and distributions using R, including histograms, boxplots, and scatterplots.\r
* Identify and address data issues like missing values and outliers.\r
* Interpret patterns and anomalies to guide further analysis.""" ;
    schema1:url <https://github.com/ELIXIREstonia/2025-01-29-EDA> .

