<https://tess.elixir-europe.org/events/hands-on-introduction-to-the-python-package-unifair-a-systematic-and-scalable-approach-to-research-data-wrangling> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0219>,
        <http://edamontology.org/topic_0769>,
        <http://edamontology.org/topic_3345>,
        <http://edamontology.org/topic_3571>,
        <http://edamontology.org/topic_3572> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Engineers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Postdoctoral Fellows" ] ;
    schema1:coursePrerequisites "The participant should have experience with Python programming. Experience with type hints in Python is useful, but not required." ;
    schema1:description """Researchers often need to extract, manipulate and integrate data and/or metadata from different sources, such as repositories, databases, or flat files. Much research time is spent on trivial and not-so-trivial details of data wrangling: to reformat data structures; clean up errors; remove duplicate data; or map and integrate dataset fields. Software for data wrangling and analysis, such as Pandas, R or Frictionless, is useful, but researchers still regularly end up with hard-to-reuse scripts, often with manual steps.\r
\r
uniFAIR is a new Python library with a systematic and scalable approach to research data wrangling. With uniFAIR, researchers can import (meta)data in almost any shape or form: nested JSON; tabular (relational) data; binary streams; or other data structures. Data is continuously parsed and reshaped through a step-by-step process according to a series of data model transformations. uniFAIR provides a catalogue of generic task and subflow templates that the researcher can refine and apply to carry out the transformations needed to wrangle data into the required shape.\r
\r
For large datasets, uniFAIR allows local test jobs on sample-sized data to be seamlessly scaled up to the full datasets and offloaded to external compute resources. Persistent access to the state of the data is available at every step.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2023-01-12 16:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Norway" ;
                            schema1:addressLocality "Oslo" ;
                            schema1:addressRegion "Oslo kommune" ;
                            schema1:postalCode "0851" ;
                            schema1:streetAddress "Georg Sverdrups hus, 39 Moltke Moes vei" ] ;
                    schema1:latitude "59.938478" ;
                    schema1:longitude "10.721364" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "The workshop is provided by ELIXIR Oslo as part of an extended event organised by Digital Scholarship Center (DSC), USIT, Carpentry@UiO, Coderefinery, dScience, Simula, Data Managers Network at UiO, ELIXIR Oslo, Norway's Reproducibility Network (norrn) and University of Oslo Library" ] ;
            schema1:startDate "2023-01-12 12:00:00 UTC"^^schema1:Date ] ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "FAIRtracks" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.807b9d> ],
        [ a schema1:Thing ;
            schema1:name "omnipy" ;
            schema1:url <https://bio.tools/tool/omnipy> ] ;
    schema1:name "Hands-on introduction to the Python package uniFAIR: a systematic and scalable approach to research data wrangling" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ;
            schema1:url <http://elixir-norway.org> ],
        [ a schema1:Organization ;
            schema1:name "University of Oslo" ] ;
    schema1:teaches """* Use type hints in Python in general and to define data models in uniFAIR/Pydantic\r
* Understand the ideas behind the slogan "parse, don't validate"\r
* Know the architecture of uniFAIR and its main classes, and have an overview of the different modules and their usage\r
* Define, refine, apply and revise tasks and flows in uniFAIR - Import data from external REST APIs and flat files\r
* Develop data transformation flows to solve a selection of use cases\r
* Inspect data after each transformation step. Make informed choices on how to configure the next tasks.\r
* Transform nested JSON output into normalized tables (without duplicate data)\r
*Map (meta)data fields from the input data model to the user-defined output model\r
\r
These outcomes will be demonstrated and not hands-on due to time constraints:\r
\r
* Scale up the data import from a representative sample to a large dataset and deploy the flow on external compute resources (e.g. NIRD service platform)\r
* Orchestrate flow runs using the Prefect web-based GUI and inspect data output from external runs\r
* Get started with contributing to the Open Source catalogue of uniFAIR modules""" ;
    schema1:url <https://www.ub.uio.no/english/courses-events/events/all-libraries/2023/digital-scholarship-days/unifair.html> .

<https://tess.elixir-europe.org/events/hands-on-introduction-to-unifair-a-systematic-and-scalable-approach-to-research-data-wrangling-in-python> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0219>,
        <http://edamontology.org/topic_0769>,
        <http://edamontology.org/topic_3345>,
        <http://edamontology.org/topic_3571>,
        <http://edamontology.org/topic_3572> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "PhD" ],
        [ a schema1:Audience ;
            schema1:audienceType "Engineers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Postdoctoral Fellows" ] ;
    schema1:coursePrerequisites "The participant should have at least an intermediate level of experience with Python programming. Experience with type hints in Python is useful, but not required." ;
    schema1:description "Life science researchers often need to extract, manipulate and integrate data and/or metadata from different sources, such as repositories, databases or flat files. Much research time is spent on trivial and not-so-trivial details of data wrangling: to reformat data structures; clean up errors; remove duplicate data; or map and integrate dataset fields. Software for data wrangling and analysis, such as Pandas, R or Frictionless, is useful, but researchers still regularly end up with hard-to-reuse scripts, often with manual steps. uniFAIR is a new Python library with a systematic and scalable approach to research data wrangling. With uniFAIR, researchers can import (meta)data in almost any shape or form: nested JSON; tabular (relational) data; binary streams; or other data structures. Data is continuously parsed and reshaped through a step-by-step process according to a series of data model transformations. uniFAIR provides a catalogue of generic task and subflow templates that the researcher can refine and apply to carry out the transformations needed to wrangle data into the required shape. For large datasets, uniFAIR allows local test jobs on sample-sized data to be seamlessly scaled up to the full datasets and offloaded to external compute resources. Persistent access to the state of the data is available at every step. This workshop will introduce you to the technical and conceptual background needed to make use of uniFAIR, including the new type hints in Python. Participants will follow hands-on tutorials that are based on a series of use cases from genomics, proteomics, and machine learning." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2022-12-09 16:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Norway" ;
                            schema1:addressLocality "Oslo" ;
                            schema1:addressRegion "Oslo kommune" ;
                            schema1:postalCode "0373" ;
                            schema1:streetAddress "Ole-Johan Dahl's House, 23B Gaustadalléen" ] ;
                    schema1:latitude "59.943081" ;
                    schema1:longitude "10.717312" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "The workshop is provided by ELIXIR Oslo as part of an extended event organised by the Student Committee of the Centre for Bioinformatics at the University of Oslo in collaboration with the ISCB Regional Student group in Norway" ] ;
            schema1:startDate "2022-12-09 13:00:00 UTC"^^schema1:Date ] ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "FAIRtracks" ;
            schema1:url <https://fairsharing.org/10.25504/FAIRsharing.807b9d> ],
        [ a schema1:Thing ;
            schema1:name "omnipy" ;
            schema1:url <https://bio.tools/tool/omnipy> ] ;
    schema1:name "Hands-on introduction to uniFAIR: a systematic and scalable approach to research data wrangling in Python" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University of Oslo" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Norway" ;
            schema1:url <http://elixir-norway.org> ] ;
    schema1:teaches """* Use type hints in Python in general and to define data models in uniFAIR/Pydantic\r
* Understand the ideas behind the slogan "parse, don't validate"\r
* Know the architecture of uniFAIR and its main classes, and have an overview of the different modules and their usage\r
* Define, refine, apply and revise tasks and flows in uniFAIR\r
* Import data from external REST APIs and flat files\r
* Develop data transformation flows to solve a selection of use cases\r
* Inspect data after each transformation step. Make informed choices on how to configure the next tasks.\r
* Transform nested JSON output into normalized tables (without duplicate data)\r
* Map (meta)data fields from the input data model to the user-defined output model \r
\r
These outcomes will be demonstrated and not hands-on due to time constraints:\r
\r
* Scale up the data import from a representative sample to a large dataset and deploy the flow on external compute resources (NIRD service platform)\r
* Orchestrate flow runs using the Prefect web-based GUI and inspect data output from external runs\r
* Get started with contributing to the Open Source catalogue of uniFAIR modules""" ;
    schema1:url <https://www.mn.uio.no/sbi/english/events/oslo-bioinformatics-week-2022/#19> .

<https://tess.elixir-europe.org/events/hands-on-on-protein-function-prediction-with-machine-learning-and-interactive-analytics> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Sangya Pundir" ;
    schema1:description "Understanding protein functions is crucial to unlocking the value of genomic data for biomedical research and innovation. Delivering personalized health and precision medicine requires a detailed understanding of the consequences of sequence variants in proteins and their impact on phenotype. This tutorial will help you understanding how to use Spark and Interactive Analytics to make sense of protein data and build Machine Learning models to infer their functions." ;
    schema1:endDate "2018-05-11 17:00:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "Hands-on on Protein Function Prediction with Machine Learning and Interactive Analytics" ;
    schema1:startDate "2018-05-11 16:00:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2018/hands-protein-function-prediction-machine-learning-and-interactive-analytics> .

<https://tess.elixir-europe.org/events/hands-on-on-protein-function-prediction-with-machine-learning-and-interactive-analytics-dfeeeed5-4f2f-48d5-9bc3-3a2e7671f231> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:about <http://edamontology.org/operation_1777>,
        <http://edamontology.org/topic_1775>,
        <http://edamontology.org/topic_3474> ;
    schema1:contact "Sangya Pundir - webinars@ebi.ac.uk" ;
    schema1:description """Understanding protein functions is crucial to unlocking the value of genomic data for biomedical research and innovation. Delivering personalised health and precision medicine requires a detailed understanding of the consequences of sequence variants in proteins and their impact on phenotype. The widening gap between known proteins and their functions has encouraged the development of methods to automatically infer annotations. Artificial intelligence and machine learning hold a large repertoire of algorithms and methodologies to discover and infer prediction models. Coupled with the new big data technologies for interactive analytics and data transformation, the AI/ML methods represent valuable assets that could enhance the discovery of protein functions.   
  
 This tutorial will help you understanding how to use Spark and Interactive Analytics to make sense of protein data and build machine learning models to infer their functions. """ ;
    schema1:endDate "2018-05-11 00:00:00 UTC"^^schema1:Date ;
    schema1:hostInstitution "EMBL-EBI" ;
    schema1:maximumAttendeeCapacity 200 ;
    schema1:name "Hands-on on protein function prediction with machine learning and interactive analytics" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ] ;
    schema1:startDate "2018-05-11 00:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.ebi.ac.uk/training/events/hands-protein-function-prediction-machine-learning-and-interactive-analytics> .

