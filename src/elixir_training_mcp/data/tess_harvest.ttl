<https://tess.elixir-europe.org/events/redefining-uniprot-reference-proteomes-and-upcoming-changes-in-uniprotkb> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/data_2093>,
        <http://edamontology.org/operation_1777>,
        <http://edamontology.org/topic_3473> ;
    schema1:description """In [Uniprot](https://www.uniprot.org/), proteomes are the set of all translatable proteins from a genome assembly. A reference proteome (RP) is the one that best represents a species, is of the best quality, or is a ‘landmark’ for that taxon. We have developed a novel workflow to select RPs, which will ensure every species has at least one RP. After the first half of 2026, the UniProt Knowledgebase (UniProtKB) will exclusively consist of proteins from RPs, supplemented by a relatively small set of additional biologically important proteins. 

This webinar will explain the future changes in the set of RPs in Uniprot and the consequent impact on UniProtKB content. At the end of the talk, there will be an opportunity for participants to ask questions.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2025-10-23 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2025-10-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "UniProt: The Universal Protein Resource",
        "protein",
        "proteome reference" ;
    schema1:name "Redefining UniProt reference proteomes and upcoming changes in UniProtKB" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ],
        [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/redefining-uniprot-reference-proteomes-and-upcoming-changes-uniprotkb> .

