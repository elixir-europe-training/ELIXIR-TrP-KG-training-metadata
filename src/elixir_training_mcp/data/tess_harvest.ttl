<https://tess.elixir-europe.org/events/introduction-to-the-analysis-of-ngs-data-29290307-aebd-49d0-89f9-bc31fe089b47> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """This training is an introduction to a series of trainings on the analysis of Next Generation Sequencing data. This training is intended for newbies to the field and will teach them all background knowledge required to successfully complete the advanced NGS analysis trainings. To this end the training will give an overview of:\r
- The Illumina platform\r
- NGS data formats and file handling\r
- Quality control of NGS data\r
- Assembly and mapping of NGS data\r
- Supporting IT: Galaxy and GenePattern platform""" ;
