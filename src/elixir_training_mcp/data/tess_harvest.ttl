<https://tess.elixir-europe.org/events/data-visualisation-at-pdbe-a757f6f0-eaa3-404e-b9b2-545e79568490> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
