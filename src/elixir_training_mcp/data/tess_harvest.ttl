<https://tess.elixir-europe.org/events/climate-fresk-0d5aa692-5427-4f41-8a53-4613a7e0c61e> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """The Climate Fresk is a LEARNING workshop led by a community of Freskers, based on a game with 42 cards taken from the scientific reports of the The Intergovernmental Panel on Climate Change (IPCC). The game raises AWARENESS about CLIMATE CHANGE in a playful and collaborative way.

In the face of this emergency, everyone must be able to understand climate change, make sense of the information, form an opinion, accept the necessary changes for the preservation of life on the planet and act quickly! """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
