            schema1:maximumAttendeeCapacity 20 ;
            schema1:startDate "2022-05-10 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "ELIXIR-GOBLET Train-the-Trainer" ;
