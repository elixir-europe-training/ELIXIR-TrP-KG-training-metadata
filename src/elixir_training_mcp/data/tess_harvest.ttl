                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Sheffield" ;
                            schema1:postalCode "S1 3JD" ;
                            schema1:streetAddress "Pam Liversidge Design Studio 2 - E06" ] ] ;
            schema1:startDate "2017-12-15 09:30:00 UTC"^^schema1:Date ] ;
    schema1:keywords "R",
        "R-programming",
        "bioinformatics",
        "data analysis",
        "data science",
        "dplyr",
        "ggplot2",
        "tidyverse" ;
    schema1:name "Data Manipulation and Visualisation using R" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Sheffield Bioinformatics Core" ;
            schema1:url <http://sbc.shef.ac.uk//training/> ] ;
    schema1:url <http://sbc.shef.ac.uk/training/r-tidyverse-2017-12-15> .

