                            schema1:addressLocality "Tartu" ;
                            schema1:addressRegion "Tartumaa" ;
                            schema1:postalCode "51009" ;
                            schema1:streetAddress "Auditorium 2005 (the Linux classroom), Narva mnt 18 (UT Delta Centre)" ] ;
                    schema1:latitude "58.38543" ;
                    schema1:longitude "26.724736" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Estonia" ] ;
            schema1:startDate "2020-03-03 10:15:00 UTC"^^schema1:Date ] ;
