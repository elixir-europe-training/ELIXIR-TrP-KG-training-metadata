<https://tess.elixir-europe.org/events/docker-and-singularity-for-reproducible-research-getting-started-with-containers> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
