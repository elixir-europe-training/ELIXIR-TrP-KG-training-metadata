<https://tess.elixir-europe.org/events/genome-assembly-and-annotation-course-7889b014-cdcf-4698-a6e6-821b51e9005e> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0622> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Life Science Researchers" ] ;
    schema1:description """The course is aimed at researchers interested in learning more about genome assembly and annotation, all the way from raw data to an assembled and annotated genome. There will be a mix of lectures and hands-on exercises using the Linux command line.\r
\r
**Time**: Monday May 3rd - Friday May 7th 2021 - every day from 09:00 CEST - 16:00 CEST\r
**Prerequisites**: Mandatory to complete a short online Linux command line course prior to the event. Everyone who registers for the GAA course will get access to the Linux online course (see the registration form - link above - for more details).\r
**Special notes**: The course is limited to 25 people, and maximum 2 participants per national ELIXIR node (except Norway which allows participants from NORBIS). The course is an advanced course. The course organizers will select participants.\r
**Course certificate**: Each participant will receive a certificate of attendance after the course.\r
**Course fee**: The course is free of charge.\r
**Course organizers**: Christophe Klopp (FR), Lucile Soler (SE), Mahesh Binzer-Panchal (SE), Nima Rafati (SE), Tomas Larsson (SE), Henrik Lantz (SE), Brane Leskosek (SL), Marko Vidak (SL) and Erik Hjerde (NO)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-05-07 16:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "ELIXIR Training Platform" ] ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR-NO, ELIXIR-SE (NBIS), ELIXIR-SI, ELIXIR-FR (INRAE)" ] ;
            schema1:startDate "2021-05-03 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "EeLP",
        "Genome Assembly",
        "Unix/Linux",
        "eLearning",
        "genome annotation" ;
    schema1:name "ELIXIR Genome assembly and annotation course" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Sweden" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR-SI eLearning Platform (EeLP)" ;
            schema1:url <https://elixir.mf.uni-lj.si/> ],
        [ a schema1:Organization ;
            schema1:name "University of Tromsø" ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR France" ;
