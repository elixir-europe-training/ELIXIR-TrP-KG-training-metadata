<https://tess.elixir-europe.org/events/training-metabolomics-repository-metabolights> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Educators:\r
Guillaume Patoine, Steffen Neumann (CIBI, MASH)\r
\r
Date:\r
18.11.2025 @ 14-16\r
\r
Location:\r
Hybrid: Online and On-site @ Leibniz Institute of Plant Biochemistry, Weinberg 3, Halle\r
\r
Information on travel and accommodation:\r
https://www.ipb-halle.de/en/contact/directions-for-visitors \r
\r
Content &amp; Learning goals:\r
MetaboLights is the most important open-access repository for metabolomics data, hosted by EMBL-EBI. It hosts high-quality metabolomics studies across species and techniques, enabling:\r
\r
Curation and quality control of submitted data\r
Rich, standardized metadata that supports reproducibility\r
Easy metadata exploration and analysis for downstream research\r
Because of its curated content and powerful metadata structure, MetaboLights is the go-to platform for both data submission and data re-use in metabolomics.\r
\r
We will guide you through the key features and practical use of MetaboLights in three 40-minute blocks:\r
\r
Introduction &amp; Submission: Overview of MetaboLights, How to prepare and submit your own data\r
Data Re-Use from MetaboLights: Retrieving and exploring datasets, Using Galaxy and MetaboAnalyst for downstream analysis\r
Bring Your Own Data: Hands-on session to apply what you’ve learned to your own datasets\r
Prerequisites:\r
Laptop, understanding in Metabolomics\r
\r
Keywords:\r
Metabolomics, mass spectrometry,""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "hybrid" ;
            schema1:endDate "2025-11-18 16:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Germany" ;
                            schema1:addressLocality "Halle (Saale)" ;
                            schema1:postalCode "06120" ;
                            schema1:streetAddress "Weinberg 3, 3 Weinberg" ] ;
                    schema1:latitude "51.495809" ;
                    schema1:longitude "11.944644" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "de.NBI & ELIXIR-DE" ] ;
            schema1:startDate "2025-11-18 14:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Training Metabolomics Repository Metabolights" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Germany" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ],
        [ a schema1:Organization ;
            schema1:name "de.NBI" ;
            schema1:url <https://www.denbi.de> ] ;
    schema1:url <https://www.denbi.de/training-courses-2025/1954-training-metabolomics-repository-metabolights> .

<https://tess.elixir-europe.org/events/training-on-accessing-processing-and-curating-datasets-2025> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """EMO-BON establishes a long-term omics observatory for marine biodiversity through bimonthly sampling of coastal waters and both soft and hard sediments across more than 20 stations in Europe. Standard operating procedures are applied for sample collection, sequencing, and workflow analysis to ensure consistent taxonomic and functional annotation. FAIR principles are implemented using appropriate ontologies, RO-Crates, and a Python-based data analysis toolkit prepared for deployment in Virtual Research Environments (VREs).\r
\r
Session 1 :: November 3rd :: Online\r
\r
Accessing and Processing EMO-BON Metagenomic Data\r
\r
Session 2 :: November 17th :: Faculty of Pharmacy of the University of Porto\r
\r
EMO-BON Metagenomics: From Backend Integration to Frontend Processing""" ;
    schema1:endDate "2025-11-17 17:00:00 UTC"^^schema1:Date ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Portugal" ;
                    schema1:addressLocality "Porto" ;
                    schema1:postalCode "4050-313" ;
                    schema1:streetAddress "Faculty of Pharmacy, University of Porto" ] ;
            schema1:latitude "41.147066" ;
            schema1:longitude "-8.624052" ] ;
    schema1:name "Training on accessing, processing, and curating datasets 2025" ;
    schema1:startDate "2025-11-03 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://events.biodata.pt/e/apcd2025> .

