<https://tess.elixir-europe.org/events/navigating-change-with-confidence-for-support-staff> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "Change is constant in research environments — from shifting priorities to new processes or leadership structures. This module focuses on developing resilience, adaptability, and time management skills to help participants navigate change with confidence. It also provides tools to handle resistance, manage difficult situations, and communicate effectively during transitions." ;
