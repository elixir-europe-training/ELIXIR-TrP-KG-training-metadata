<https://tess.elixir-europe.org/events/chemistry-development-kit-2025-user-group-meeting> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description "The Chemistry Development is a Java library for chemistry and handle chemical structures. The first code dates from 1997 and the project was one of the first Open Science projects. This User Group Meeting is organized by the NWO-funded The Chemistry Development Kit in 2024: improving cheminformatics research grant (see doi:10.3897/rio.10.e124884) and hosted by Egon Willighagen, Rene van der Ploeg, and Marc Teunis. The meeting will consists of one day with talks, discussion, and planning. The other day will be workshop and hackathon like." ;
    schema1:endDate "2025-03-11 17:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
