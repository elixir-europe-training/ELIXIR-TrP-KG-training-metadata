<https://tess.elixir-europe.org/materials/biosimulations-help> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_2259>,
        <http://edamontology.org/topic_3307>,
        <http://edamontology.org/topic_3524> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "modelers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Life Science Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Computational biologists" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Bilal Shaikh" ],
        [ a schema1:Person ;
            schema1:name "Jonathan Karr" ] ;
    schema1:description "BioSimulations is a web application for sharing and re-using biomodels, simulations, and visualizations of simulations results. BioSimulations supports a wide range of modeling frameworks (e.g., kinetic, constraint-based, and logical modeling), model formats (e.g., BNGL, CellML, SBML), and simulation tools (e.g., COPASI, libRoadRunner/tellurium, NFSim, VCell). BioSimulations aims to help researchers discover published models that might be useful for their research and quickly try them via a simple web-based interface." ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords "Biomodelling",
        "COMBINE",
        "Computational modelling",
        "ComputationalBiology",
        "Kinetic modeling",
        "Model",
        "Modeling",
        "SED-ML",
        "SystemsBiology" ;
    schema1:learningResourceType "Documentation" ;
    schema1:license <https://spdx.org/licenses/MIT.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "BioSimulations" ;
            schema1:url <https://bio.tools/tool/biosimulations> ] ;
    schema1:name "BioSimulations tutorial and help" ;
    schema1:url <https://www.biosimulations.org/about/help> .

<https://tess.elixir-europe.org/materials/biosimulators-help> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_2259>,
        <http://edamontology.org/topic_3307>,
        <http://edamontology.org/topic_3524> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Computational biologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "software developers, bioinformaticians" ],
        [ a schema1:Audience ;
            schema1:audienceType "modelers" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Jonathan Karr" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Bilal Shaikh" ],
        [ a schema1:Person ;
            schema1:name "Ion Moraru" ] ;
    schema1:description """BioSimulators is a registry of containerized biosimulation tools that provide consistent command-line interfaces. The BioSimulations web application helps investigators browse this registry to find simulation tools that have the capabilities (supported modeling frameworks, simulation algorithms, and modeling formats) needed for specific modeling projects.\r
\r
The BioSimulators help describes how to use this registry:\r
- How to find a containerized simulation tools that are capable of executing a modeling study.\r
- How to use containerized simulation tools to execute modeling studies.\r
- How to containerize a simulation tool and submit it to the BioSimulators registry.""" ;
    schema1:educationalLevel "intermediate" ;
    schema1:keywords "BNGL",
        "COMBINE",
        "Modeling",
        "OMEX",
        "SBML",
        "SED-ML",
        "biomodel",
        "dynamic simulations" ;
    schema1:learningResourceType "Documentation",
        "Tutorial" ;
    schema1:license <https://spdx.org/licenses/CC0-1.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "BioSimulators" ;
            schema1:url <https://bio.tools/tool/biosimulators> ] ;
    schema1:name "BioSimulators tutorial and help" ;
    schema1:url <https://biosimulators.org/help> .

<https://tess.elixir-europe.org/materials/biostatistics> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_2269> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "PhD students" ],
        [ a schema1:Audience ;
            schema1:audienceType "Clinicians" ] ;
    schema1:description "This collection will introduce you to common principles of statistical methods, and give you hands-on experience of user-friendly tools for data visualisation and testing. It is tailored to the properties of biological data, and uses biological examples. In the interactive online tutorials contained in this collection, R is used throughout. " ;
    schema1:keywords "Biostatistics",
        "R" ;
    schema1:learningResourceType "e-learning" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Biostatistics: A practical introduction" ;
    schema1:provider [ a schema1:Organization ;
