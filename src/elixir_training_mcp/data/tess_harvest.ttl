<https://tess.elixir-europe.org/events/neof-edna-wetlab-and-bioinformatics-in-person-training> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Generating DNA sequence barcodes from mixed sources of DNA is an increasingly-used and efficient way to survey biodiversity, whether monitoring aquatic species by sampling water-derived DNA, characterising communities from soil samples, or analysing diet from faecal-derived DNA. This course provides an overview of metabarcoding with different barcoding genes to target particular taxa, and consists of a technical wet lab component and a bioinformatics component. Interested delegates may apply to attend either or both workshops.\r
\r
During the wet lab component, we will give an overview of experimental design, head outside for a field sampling demonstration and return to the laboratory for a full course on the metabarcoding process. The laboratory techniques will include DNA extraction, polymerase chain reaction (PCR), gel electrophoresis, magnetic bead cleaning and quantification. Finally, we will outline the different platforms that are typically used for sequencing.\r
\r
In the bioinformatics component, we will use an example data set to go from raw sequence data through to assigning taxonomy to identified sequence variants. We will then conduct typical downstream analyses to quantify and examine differences in diversity.\r
\r
Register by Monday 21/7/25""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2025-09-12 13:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "NERC" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Sheffield" ;
                            schema1:streetAddress "Full location will be shared with invited participants. There will also be an opportunity to tour the NEOF Visitor Facility labs and hear about how they can be accessed for your research." ] ;
                    schema1:latitude "43.590472" ;
                    schema1:longitude "3.859513" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "NEOF" ] ;
            schema1:startDate "2025-09-08 13:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:name "NEOF - eDNA wetlab and bioinformatics IN PERSON Training" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ] ;
    schema1:url <https://docs.google.com/forms/d/e/1FAIpQLSfS1VzxXoKVkNu7D0FPSOoWrIJu9u83MDbjN1c0lZvic6s2ng/viewform> .

<https://tess.elixir-europe.org/events/neof-eukaryote-genome-assembly> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Eukaryotic genomes can be large and complex and there have been many recent developments in the tools available for optimal genome assembly. This course will give an overview of long read genome assembly using PacBio HiFi sequencing and scaffolding using Hi-C reads. We will cover initial assessment of the sequencing data, genome assembly and scaffolding, determining the contiguity and completeness of the assembly and also explore visualisation tools.\r
\r
Places are restricted to UK-based researchers and only 30 places are available so please only register if you intend on attending.\r
\r
The workshop will be held over two days on Tuesday 4 and Thursday 6 June 2024, 10am-4pm, with registration opening 9.30am on Tuesday.\r
\r
The deadline to register is Monday 20th May, 2 weeks before the course. You will hear later that week whether you have been invited and will need to confirm your attendance.\r
\r
Register to NEOF mailing list to hear first about future NEOF free bioinformatics courses: https://neof.org.uk/news/""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-06-06 16:00:00 UTC"^^schema1:Date ;
