    schema1:name "(2025) Introduction to R: Saskatoon, SK" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Bioinformatics.ca" ;
            schema1:url <https://bioinformatics.ca/> ] ;
    schema1:teaches "After the course, participants should be able to:  Apply basic conventions of data handling, including organization and analysis Break down and compose solutions to computing tasks in R Identify and implement key R syntax, functions, and packages" ;
    schema1:url <https://bioinformatics.ca/workshops-all/2025-introduction-to-r-saskatoon-sk/> .

