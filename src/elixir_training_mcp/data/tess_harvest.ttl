<https://tess.elixir-europe.org/events/data-curation-with-dataverse-a-norwegian-perspective> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0219> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "curators" ],
        [ a schema1:Audience ;
            schema1:audienceType "data managers" ],
        [ a schema1:Audience ;
            schema1:audienceType "researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "data librarians" ],
        [ a schema1:Audience ;
            schema1:audienceType "data scientists" ] ;
    schema1:description """The Norwegian Dataverse team will let us glimpse behind the curtain of repository management, addressing significant challenges, data curation processes, migration of data from one repository to another, and ensuring data quality. The course slides will be in English but most lecture information will be spoken in Estonian.



DataverseNO ([https://dataverse.no/](https://dataverse.no/)) is a national, generic repository for open research data, owned and operated by UiT The Arctic University of Norway. DataverseNO is aligned with the FAIR Guiding Principles for scientific data management and stewardship. The technical infrastructure of the repository is based on the open source application Dataverse, developed by an international developer and user community led by Harvard University. DataverseNO is CoreTrustSeal certified.

Data curation is carried out by data curators at the DataverseNO partner institutions. Datasets deposited in the top-level collection are curated by data curators at UiT The Arctic University of Norway (owner of DataverseNO). Data curators are staff members employed at the partner institutions, usually at the library of the institution.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-04-05 14:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Estonia" ;
                            schema1:addressLocality "Tartu" ;
                            schema1:addressRegion "Tartumaa" ;
                            schema1:postalCode "51009" ;
                            schema1:streetAddress "Narva mnt 18, room 2010" ] ;
                    schema1:latitude "58.385253" ;
                    schema1:longitude "26.724993" ] ;
            schema1:maximumAttendeeCapacity 30 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Estonia" ] ;
            schema1:startDate "2024-04-05 12:00:00 UTC"^^schema1:Date ] ;
