<https://tess.elixir-europe.org/materials/bioinformatics-data-types-and-databases> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3372> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Lisanna Paladin" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Bérénice Batut" ],
        [ a schema1:Person ;
            schema1:name "Saskia Hiltemann" ] ;
    schema1:creativeWorkStatus "Active" ;
    schema1:dateModified "2023-09-07"^^schema1:Date ;
    schema1:datePublished "2023-09-07"^^schema1:Date ;
    schema1:description """## Abstract

# Background


## Questions this  will address

 - What are some of the main resources to explore bioinformatics information?
 - How is this information represented in file formats?
 - What type of information do these file formats convey?


## Learning Objectives

- Understand that the biological data is multi-layered
- Identify multiple sources of information in biology
- Describe how this different types of information are conveyed through different file formats""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Foundations of Data Science" ;
    schema1:learningResourceType "slides" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Associated Training Datasets" ;
            schema1:url <https://zenodo.org/record/8304465> ],
        [ a schema1:Thing ;
            schema1:name "BLAST" ;
            schema1:url <https://bio.tools/tool/blast> ],
        [ a schema1:Thing ;
            schema1:name "Galaxy" ;
            schema1:url <https://bio.tools/tool/galaxy> ] ;
    schema1:name "Bioinformatics Data Types and Databases" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Understand that the biological data is multi-layered
- Identify multiple sources of information in biology
- Describe how this different types of information are conveyed through different file formats""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/data-science/tutorials/online-resources-gene/slides.html> ;
    schema1:version "1" .

