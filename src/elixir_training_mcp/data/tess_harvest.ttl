<https://tess.elixir-europe.org/events/mathematical-and-computational-evolutionary-biology-mceb> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:alternateName "MCEB" ;
    schema1:description """MCEB will take place in Granada, Spain for its 2025 edition. The meeting will put the emphasis on methods and models for phylogenomics and population genomics. Beyond this year's themes, general concepts, models, methods and algorithms will be presented and discussed, just as in the previous editions of MCEB. As usual, the meeting will bring together researchers originating from various disciplines: mathematics, statistics, computer science, phylogenetics, population genetics, molecular epidemiology, biodiversity and macroevolution... Keynote speakers will\r
introduce a field of research and discuss their own work in this field. Afternoon will be for short presentations and posters, with plenty of time for discussions. We will stop early every day, thus leaving time for other activities.\r
\r
KEYNOTES:\r
** Sophie Abby - "Evolution of biosynthetic pathways in Bacteria"\r
** Richard Durbin - "Population genome variation – going beyond SNPs"\r
** Lisa Pokorny Montero - "Genomic approaches to the study of plant evolution"\r
** Harald Ringbauer - "Advanced ancient DNA analysis"\r
** Kristina Wicke - "Inference of phylogenetic networks"\r
** Jaime Huerta-Cepas - "Evolutionary significance of unknown microbial genes\"""" ;
    schema1:endDate "2025-05-16 17:00:00 UTC"^^schema1:Date ;
    schema1:location [ a schema1:Place ;
            schema1:address [ a schema1:PostalAddress ;
                    schema1:addressCountry "Spain" ;
                    schema1:addressLocality "Granada" ] ;
            schema1:latitude "37.1735" ;
            schema1:longitude "-3.599534" ] ;
    schema1:maximumAttendeeCapacity 60 ;
    schema1:name "Mathematical and Computational Evolutionary Biology (MCEB)" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "ATGC (http://www.atgc-montpellier.fr/)" ] ;
    schema1:startDate "2025-05-12 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://mceb2025.sciencesconf.org/> .

