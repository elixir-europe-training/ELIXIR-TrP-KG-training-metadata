                    schema1:name "de.NBI / ELIXIR-DE" ] ;
            schema1:startDate "2024-05-02 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "PANGAEA Community Workshop May 2024: \"Finding and retrieving data from PANGAEA\"" ;
    schema1:provider [ a schema1:Organization ;
