    schema1:description "Recent years, imaging and image processing has become essential for life scientists dealing with scientific images. In Life science, microscopy and imaging have become more and more important. Imaging has evolved from showing examples images towards quantitative biology. Image processing is playing a crucial role and is becoming a means of quantification in life science." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2024-06-06 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Belgium" ;
                            schema1:addressLocality "Antwerpen" ;
                            schema1:postalCode "2610" ;
                            schema1:streetAddress "Antwerp - Campus Drie Eiken UAntwerpen, Universiteitsplein 1" ] ;
                    schema1:latitude "51.22111" ;
                    schema1:longitude "4.399708" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-06-06 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "hands-on",
        "imaging",
        "software" ;
    schema1:name "Basic Image Processing using Fiji" ;
    schema1:provider [ a schema1:Organization ;
