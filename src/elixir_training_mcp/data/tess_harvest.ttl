    schema1:author [ a schema1:Person ;
            schema1:name "Live Kvale" ],
        [ a schema1:Person ;
            schema1:name "Federico Bianchini" ] ;
    schema1:competencyRequired "A general understanding of DMPs and common practices in data management is an advantage. No additional software is required, but the participants are requested to create an account beforehand on [UiO’s instance of DSW](https://uio.dsw.elixir-europe.org/)" ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2024-01-12"^^schema1:Date ;
    schema1:datePublished "2024-02-02"^^schema1:Date ;
    schema1:description "This workshop will provide an overview of the Data Stewardship Wizard (DSW), a tool for creating and handling data management plans. This workshop was delivered as part of the 2025 edition of Digital Scholarship Days at the University of Oslo." ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "10.5281/zenodo.7534362" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:mentions [ a schema1:Thing ;
