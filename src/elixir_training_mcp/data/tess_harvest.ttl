    schema1:teaches """- Downloading databases related to 16SrRNA data
- For better neoantigen identification results.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/neoantigen-fusion-database-generation/tutorial.html> ;
    schema1:version "2" .

<https://tess.elixir-europe.org/materials/neoantigen-2-non-normal-database-generation> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0121> ;
    schema1:audience [ a schema1:Audience ;
