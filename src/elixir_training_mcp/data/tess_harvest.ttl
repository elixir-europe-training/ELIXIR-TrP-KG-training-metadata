<https://tess.elixir-europe.org/events/supporting-fair-exchange-of-chemical-data-through-standards-development> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071> ;
    schema1:description "The GO FAIR initiative is intended to encourage and enable accurate and reproducible data exchange among and across disciplines. FAIR encapsulates the concepts that data should be Findable, Accessible, Interoperable and Reusable. This workshop will explore how these goals can be accomplished in the context of chemical data, addressing some of the issues present within chemistry, but also in the context of broader interaction with other disciplines. The topics have been chosen to begin a process of standards development and maintenance, tool development and maintenance, and addressing use cases from other domains. Key opportunities include interoperability criteria for spectra using IUPAC standards, prioritizing activities within the GO FAIR ecosystem, creating draft roadmaps with key milestones, and recruiting key leaders for ongoing activity." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2018-07-18 17:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name " the Committee on Data of the International Council for Science" ],
                [ a schema1:Organization ;
                    schema1:name "International Union of Pure and Applied Chemistry (IUPAC) Committee on Publications and Cheminformatics Data Standards (CPCDS) CPCDS Subcommittee on Cheminformatics Data Standards (SCDS) CODATA" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Netherlands" ;
                            schema1:addressLocality "Amsterdam" ;
                            schema1:addressRegion "Amsterdam" ;
                            schema1:streetAddress "Science Park, Science Park" ] ;
                    schema1:latitude "52.355343" ;
                    schema1:longitude "4.954019" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "GO FAIR" ] ;
            schema1:startDate "2018-07-16 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "FAIR" ;
    schema1:name "Supporting FAIR Exchange of Chemical Data  through Standards Development " ;
    schema1:url <https://docs.google.com/document/d/1cefYKvFEYxgBuAUzVsEQsZRu41y-0qYo2Tdw3LPLQjc/edit> .

