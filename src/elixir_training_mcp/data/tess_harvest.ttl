    schema1:name "Integrative Bioinformatics Symposium 2018" ;
    schema1:startDate "2018-06-13 09:00:00 UTC"^^schema1:Date ;
    schema1:url <http://ib2018.eventzilla.net/web/event?eventid=2138944931> .

