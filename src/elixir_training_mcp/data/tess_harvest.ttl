    schema1:url <https://training.galaxyproject.org/training-material/topics/data-science/tutorials/python-plotting/tutorial.html> ;
    schema1:version "7" .

<https://tess.elixir-europe.org/materials/hands-on-for-pox-virus-genome-analysis-from-tiled-amplicon-sequencing-data-tutorial> a schema1:LearningResource ;
