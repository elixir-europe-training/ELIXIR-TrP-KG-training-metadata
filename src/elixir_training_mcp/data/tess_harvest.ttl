            schema1:url <https://training.galaxyproject.org/training-material/topics/data-science/tutorials/python-functions/data-science-python-functions-course.ipynb> ] ;
    schema1:name "Python - Functions" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches "- Understand the structure of a \"function\" in order to be able to construct their own functions and predict which functions will not work." ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/data-science/tutorials/python-functions/tutorial.html> ;
    schema1:version "4" .

