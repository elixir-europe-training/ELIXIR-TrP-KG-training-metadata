        [ a schema1:Audience ;
            schema1:audienceType "Researchers" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Dalmolin Systems Biology Group" ] ;
    schema1:competencyRequired """1.    Basic knowledge of the R programming language (loading libraries, handling data frames).\r
2.   Familiarity with fundamental concepts in evolutionary biology (e.g., genes, orthologs, phylogenetic trees).\r
3.    Being comfortable working with RStudio or a similar R environment.\r
""" ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2024-11-07"^^schema1:Date ;
    schema1:dateModified "2025-11-05"^^schema1:Date ;
    schema1:description "The course \"GeneBridge: Inferring the Evolutionary Rooting of Orthologous Genes\" is organized by Dalmolin's Systems Biology Group, based at the Bioinformatics Multidisciplinary Environment (BioME) at UFRN. This workshop is divided into three parts: (1) Performing the Rooting Analysis, (2) Plotting Rooted Genes, and (3) Plotting Abundances." ;
    schema1:educationalLevel "intermediate" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.17533991" ;
    schema1:keywords "Evolutionary bioinformatics",
        "Systems biology",
        "orthology" ;
    schema1:learningResourceType "Course materials" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:name "GeneBridge: Inferring the Evolutionary Rooting of Orthologous Genes" ;
    schema1:teaches """1.  **Understand** the theoretical basis of evolutionary rooting and the Bridge algorithm. [Understanding]\r
2.  **Apply** the GeneBridge package to infer the evolutionary root for a set of orthologous genes. [Applying]\r
3.  **Analyze** and **interpret** the output tables and rooting results. [Analysing]\r
4.  **Create** and **customize** plots to visualize rooted genes on a phylogenetic tree. [Creating]\r
5.  **Generate** and **evaluate** plots of gene abundances across different clades. [Evaluating]""" ;
    schema1:url <https://dalmolingroup.imd.ufrn.br/genebridge-course> ;
    schema1:version "v1.0" .

