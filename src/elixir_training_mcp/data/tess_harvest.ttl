<https://tess.elixir-europe.org/events/statistical-thinking-for-microbial-ecology> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/operation_2238>,
        <http://edamontology.org/topic_3301>,
        <http://edamontology.org/topic_3697> ;
    schema1:description """Most microbial ecologists understand the importance of rigorous statistical analysis for conducting a replicable study. However, formal courses in the statistical analysis of high-dimensional ecological data are rare, and traditional courses in applied statistics may not teach skills applicable to modern microbiome analysis.

This webinar will introduce foundational concepts in statistics, with a focus on applying these concepts to the analysis of modern microbiome datasets. To illustrate these concepts, we will use the field of "differential abundance" as a case study. We will contrast popular differential abundance parameters and estimators, specifically focusing on estimating meaningful contrasts using high-throughput sequencing data.

You may either watch the entire presentation from the introduction or navigate directly to a specific section by clicking the links provided below:

- [Introduction](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=04072199-13c4-4382-9f3e-b155010a592f&amp;start=12.173022)

- [Three approaches to analysing data](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=04072199-13c4-4382-9f3e-b155010a592f&amp;start=145.786619)

- [Case study: Microbial abundance parameters](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=04072199-13c4-4382-9f3e-b155010a592f&amp;start=498.244)

- [RadEmu and its application](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=04072199-13c4-4382-9f3e-b155010a592f&amp;start=1290.244)

- [Examples of statistical tools suitable for different parameters](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=04072199-13c4-4382-9f3e-b155010a592f&amp;start=2169.243999)

- [Q&amp;A](https://embl-ebi.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=04072199-13c4-4382-9f3e-b155010a592f&amp;start=2245.134705)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-04-17 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 1000 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2024-04-17 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Microbial ecosystems webinar" ;
    schema1:name "Statistical thinking for microbial ecology" ;
