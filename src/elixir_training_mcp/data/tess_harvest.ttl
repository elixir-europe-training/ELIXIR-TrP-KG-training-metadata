<https://tess.elixir-europe.org/materials/recommended-metadata-for-biological-images-metadata-guidelines-for-bioimaging-data> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_3382> ;
    schema1:creativeWorkStatus "active" ;
    schema1:description "REMBI (Recommended Metadata for Biological Images) was proposed as a draft metadata guidelines to begin addressing the needs of diverse communities within light and electron microscopy. Currently, these guidelines are in draft form to encourage discussion within the community, but they provide a useful guide as to what metadata should be gathered to make your image data FAIR. They divide the metadata requirements into eight modules which further split into attributes - that seems to be a daunting task, doesn’t it? But at the same time it’s exciting news for the community! To find out more, have a look at the REMBI article." ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "REMBI" ;
    schema1:learningResourceType "hands-on tutorial" ;
    schema1:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    schema1:name "Recommended Metadata for Biological Images – metadata guidelines for bioimaging data" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR UK" ;
            schema1:url <https://elixiruknode.org/activities/training> ],
        [ a schema1:Organization ;
            schema1:name "ELXIR-UK DaSH" ;
            schema1:url <https://elixiruknode.org/projects/elixir-uk-dash/> ] ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/fair/tutorials/bioimage-REMBI/tutorial.html> .

<https://tess.elixir-europe.org/materials/redefining-uniprot-reference-proteomes-and-upcoming-changes-in-uniprotkb> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_1775>,
        <http://edamontology.org/topic_3473> ;
    schema1:description "In Uniprot, proteomes are the set of all translatable proteins from a genome assembly. A reference proteome (RP) is the one that best represents a species, is of the best quality, or is a ‘landmark’ for that taxon. We have developed a novel workflow to select RPs, which will ensure every species has at least one RP. After the first half of 2026, the UniProt Knowledgebase (UniProtKB) will exclusively consist of proteins from RPs, supplemented by a relatively small set of additional biologically important proteins. This webinar will explain the future changes in the set of RPs in Uniprot and the consequent impact on UniProtKB content. At the end of the talk, there will be an opportunity for participants to ask questions." ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Redefining UniProt reference proteomes and upcoming changes in UniProtKB" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/redefining-uniprot-reference-proteomes-and-upcoming-changes-uniprotkb> .

