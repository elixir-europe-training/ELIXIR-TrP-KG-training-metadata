<https://tess.elixir-europe.org/materials/annotating-genomes-with-non-coding-rnas-using-rfam-and-infernal> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0622> ;
    schema1:description """Rfam is a database of RNA families that currently contains over 4,000 families. Together with the Infernal software, Rfam is commonly used to annotate non-coding RNAs in newly sequenced genomes.\r
\r
In this webinar, we will give an overview of the data available in Rfam and give a live demo of annotating a genome with non-coding RNAs using Rfam and the Infernal software. We will also discuss recent efforts to synchronise Rfam and miRBase.""" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "Annotating genomes with non-coding RNAs using Rfam and Infernal" ;
    schema1:provider [ a schema1:Organization ;
