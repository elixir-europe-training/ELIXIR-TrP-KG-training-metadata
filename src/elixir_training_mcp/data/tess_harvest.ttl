        [ a schema1:Thing ;
            schema1:name "Full collection of presentation slides" ;
            schema1:url <https://zenodo.org/record/4314975#.YFC3HecxlhE> ] ;
    schema1:name "EU Nanosafety Cluster Education Day @ NanoSAFE 2020 Digital Conference" ;
    schema1:provider [ a schema1:Organization ;
