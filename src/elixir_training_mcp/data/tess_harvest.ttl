                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Sheffield" ] ;
                    schema1:latitude "53.380663" ;
                    schema1:longitude "-1.470228" ] ;
            schema1:startDate "2019-07-09 10:30:00 UTC"^^schema1:Date ] ;
    schema1:name "Sharing Bioinformatics Training and Building a Region-wide Programme" ;
