            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/how-make-training-fair> .

<https://tess.elixir-europe.org/events/how-to-make-your-messy-data-usable> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Graduate Students" ] ;
    schema1:description """More attention is put on what researchers do with the data (and other resources) they produce in recent years, especially in Europe, also in everywhere else. Since most of your data needs to be uploaded to a repository, it is essential that the data is tidy and other people understand and can easily read your data.  \r
\r
In this course, in the first part (online 1h lecture) we will be going over how to name your files and variables, version control, compile a data dictionary, and what to do with empty cells. In the second part, OpenRefine software is introduced. With this, you can easily clean up the messy data. For the more practical aspect of using the OpenRefine software, I will share a video that will teach the basics. You can watch it anytime and do the lessons yourself. On three days there will be a 1h slot on Zoom, when you can come and ask any question you have regarding tables and OpenRefine software. """ ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2021-12-01 12:00:00 UTC"^^schema1:Date ;
            schema1:maximumAttendeeCapacity 25 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR Estonia" ] ;
            schema1:startDate "2021-11-25 13:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "CONVERGE",
        "ELIXIR-CONVERGE",
        "FAIR",
        "Software skills",
        "spreadsheet" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "How to make your messy data usable?" ;
            schema1:url <https://doi.org/10.5281/zenodo.5720271> ] ;
    schema1:name "How to make your messy data usable?" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Estonia" ;
            schema1:url <http://elixir.ut.ee> ],
        [ a schema1:Organization ;
            schema1:name "University of Tartu, Institute of Computer Science" ] ;
    schema1:url <https://elixir.ut.ee/node/406> .

