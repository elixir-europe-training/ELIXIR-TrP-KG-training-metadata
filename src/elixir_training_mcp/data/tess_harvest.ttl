                    schema1:addressLocality "UQ Brisbane City" ;
                    schema1:addressRegion "QLD" ;
                    schema1:postalCode "4000" ;
                    schema1:streetAddress "308 Queen Street, Brisbane" ] ] ;
    schema1:name "Euro-Australian research infrastructure collaboration in the molecular life sciences" ;
    schema1:startDate "2024-12-06 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.elixir-europe.org/events/euro-australian-research-infrastructure-collaboration-molecular-life-sciences-0> .

<https://tess.elixir-europe.org/events/eurofaang-aqua-faang-workshop-methods-to-use-and-reuse-the-aqua-faang-data-and-ensembl-resources-to-advance-science> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """This one and a half day workshop will provide detailed training on methods to use and reuse the wealth of data generated by the [EuroFAANG AQUA-FAANG project](https://www.aqua-faang.eu/). AQUA-FAANG aims to improve understanding the genome function and usage of genotype-to-phenotype prediction in the six most important European farmed fish species (EUROPEAN SEABASS | GILTHEAD SEABREAM | RAINBOW TROUT | ATLANTIC SALMON | COMMON CARP | TURBOT). The workshop will primarily focus on the comprehensive and integrated annotation of these six species by the [Ensembl genome browser](www.ensembl.org). The course will also include a deeper dive from the Ensembl analysis teams into gene annotation and regulation, and demonstrations of the specific analyses and research conducted by AQUA-FAANG scientists.

 """ ;
