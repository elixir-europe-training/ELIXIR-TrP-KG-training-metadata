            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Describe why indexed data repositories are important.
- Summarise resources enabling you to choose a searchable repository.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/fair/tutorials/fair-data-registration/tutorial.html> ;
    schema1:version "3" .

