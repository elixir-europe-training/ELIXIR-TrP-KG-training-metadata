    schema1:url <https://www.ebi.ac.uk/training/events/ensembl-rapid-release-genome-browser> .

<https://tess.elixir-europe.org/materials/the-environmental-impact-of-computational-biology> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3307> ;
    schema1:description """The environmental impact of (scientific) computing, computational biology in particular, is a growing concern in light of the urgency of the climate crisis, and there is widespread interest in the research community; so what can we all do about it? Tackling this issue and making it easier for scientists to engage with sustainable computing is what motivated the Green Algorithms project. \r
\r
During this webinar, we will discuss what we learned along the way, how to estimate the impact of our work and dive into the carbon footprint of common bioinformatic analyses. We will also highlight the levers scientists and institutions have to make their research more sustainable, debate the ethical implications of these environmental costs and examine what is still needed moving forward.\r
\r
About the speaker\r
\r
Dr Loïc Lannelongue is a Research Associate in Biomedical Data Science in the Cardiovascular Epidemiology Unit and the Inouye lab at the University of Cambridge. He is also a College Post-Doctoral Associate at Jesus College, Cambridge, and an Associate Fellow of Advance HE. Loïc developed the Greener Algorithms project, in collaboration with Jason Grealey and Michael Inouye, to understand the carbon footprint of analyses and promote best practices in green computing. """ ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:name "The environmental impact of computational biology" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/environmental-impact-computational-biology> .

<https://tess.elixir-europe.org/materials/the-essentials-of-duo-codes> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0622> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers and bioinformaticians involved in the VEIS project" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers and bioinformaticians in other projects interested in depositiong data at the EGA" ],
        [ a schema1:Audience ;
            schema1:audienceType "Data Access Committeses from the EGA" ] ;
    schema1:competencyRequired "The webinar is open to everyone, though it will be more relevant for researchers interested in depositing data at the EGA or who have already done so." ;
    schema1:description """The [European Genome-phenome Archive (EGA)](https://ega-archive.org/) offers permanent archiving and sharing of all types of personally identifiable genetic and phenotypic data from research projects and healthcare studies.\r
\r
During this webinar, the speaker will:\r
- Introduce the audience to the [GA4GH](https://www.ga4gh.org/) and [DURI](https://www.ga4gh.org/work_stream/data-use-researcher-identities-duri-2/) [work streams](https://ga4gh-duri.github.io/categories/howto.html).\r
- Explain what are the DUO (Data Use Ontology) codes, what is their scope, and how to use them in the EGA workflow.\r
\r
After this webinar, the participant will be able to understand how to use and interpret the DUO codes.""" ;
    schema1:keywords "ELIXIR Converge",
        "FEGA",
        "Federated EGA",
        "Genomics",
        "bioinformatics" ;
    schema1:learningResourceType "Presentation",
        "Video" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
    schema1:mentions [ a schema1:Thing ;
