    schema1:url <https://www.ebi.ac.uk/training/events/introduction-ensembl-bacteria-genome-browser> .

<https://tess.elixir-europe.org/events/introduction-to-the-fair-principles> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Researchers collect, receive, and manage data in many ways. Making sure this data is well-managed and reusable can be complex, but the FAIR Principles are here to help. The concepts underlying the FAIR principles are grounded in good scientific practice and aim to guide people to maximise the Findability, Accessibility, Interoperability, and Reuse of digital assets. Making your data FAIR can help you work more effectively, raise your research profile, and engage with open research initiatives.\r
\r
This workshop is for people in academia with little or no experience of FAIR. This course aims to be succinct in introducing FAIR, its concepts and terminology, and supplements all material with introducing and signposting to useful FAIR resources.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2024-05-22 15:30:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Manchester" ] ;
                    schema1:latitude "53.479489" ;
                    schema1:longitude "-2.245115" ] ;
            schema1:startDate "2024-05-22 14:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Introduction to the FAIR Principles" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University of Manchester" ] ;
    schema1:url <https://www.library.manchester.ac.uk/training/my-research-essentials/workshops/details/?event=et5XUNlR> .

<https://tess.elixir-europe.org/events/introduction-to-the-genomics-virtual-laboratory-and-galaxy-for-life-scientists> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_3307>,
        <http://edamontology.org/topic_3316> ;
    schema1:description """Galaxy is an open source, web-based platform for accessible, reproducible, and transparent computational biomedical research. It allows users without programming experience to easily specify parameters and run individual tools as well as larger workflows. It also captures run information so that any user can repeat and understand a complete computational analysis. Finally, it allows users to share and publish analyses via the web. 

This beginners workshop will introduce Galaxy's interface, tool use, histories, and workflows and get new users of the Genomics Virtual Laboratory up and running.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2016-06-07 00:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Australia" ;
                            schema1:addressLocality "University of Melbourne" ;
                            schema1:streetAddress "Lab-14, VLSCI" ] ;
                    schema1:latitude "-37.801993" ;
                    schema1:longitude "144.959087" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VLSCI - University of Melbourne" ] ;
            schema1:startDate "2016-06-07 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "ABR",
        "Bioinformatics",
        "VLSCI" ;
    schema1:name "Introduction to the Genomics Virtual Laboratory and Galaxy for life scientists" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "iAnn" ;
            schema1:url <http://iann.pro> ] ;
    schema1:url <https://intro-gvl-galaxy.eventbrite.com.au> .

