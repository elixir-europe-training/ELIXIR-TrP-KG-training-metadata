<https://tess.elixir-europe.org/events/cabana-workshop-analysis-of-crop-genomics-data-803a9b61-9151-4e37-9cb3-0e7e11e65273> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Marco Cristancho" ;
    schema1:description "This course will introduce crop biologists to methods and approaches for analysing crop genomics data." ;
