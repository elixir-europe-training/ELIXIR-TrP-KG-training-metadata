<https://tess.elixir-europe.org/materials/filter-plot-and-explore-single-cell-rna-seq-data-with-scanpy-python> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Wendi Bacon" ],
        [ a schema1:Person ;
