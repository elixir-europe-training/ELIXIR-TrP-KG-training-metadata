                            schema1:streetAddress "Ghent - Clemenspoort, Overwale 3" ] ;
                    schema1:latitude "51.053829" ;
                    schema1:longitude "3.725012" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2024-03-25 09:00:00 UTC"^^schema1:Date ] ;
