        "Docking",
        "Drug design",
        "Protein interactions",
        "protein structure" ;
    schema1:name "Computational approaches to the study of protein interactions and rational drug design" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University of Padova, Italy" ],
