            schema1:url <https://zenodo.org/record/1324204> ],
        [ a schema1:Thing ;
            schema1:name "Associated Workflows" ;
            schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/regionalGAM/workflows/> ] ;
    schema1:name "Regional GAM" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Obtain and filter/manipulate occurrence data
- Compute and visualize phenology of a species through the years
- Compute temporal abundance trends""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/ecology/tutorials/regionalGAM/tutorial.html> ;
    schema1:version "18" .

<https://tess.elixir-europe.org/materials/hands-on-for-regression-in-machine-learning-tutorial> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_2269> ;
