            schema1:url <https://zenodo.org/records/14375693> ] ;
    schema1:name "Neoantigen 4: Variant Annotation" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Identify potential neoantigens from sequencing data.
- Annotate somatic mutations and predict peptide sequences.
- Predict MHC binding affinities for neoantigens.
- Interpret data using bioinformatics tools for cancer immunotherapy applications.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/neoantigen-variant-annotation/tutorial.html> ;
    schema1:version "3" .

<https://tess.elixir-europe.org/materials/neoantigen-6-predicting-hla-binding> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0121> ;
    schema1:audience [ a schema1:Audience ;
