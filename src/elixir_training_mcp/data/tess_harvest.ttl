<https://tess.elixir-europe.org/events/mastering-data-management-go-fair-go-open-go-smart-emo-bon-and-trec-showcases> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_3383>,
        <http://edamontology.org/topic_3387> ;
    schema1:description "Making data FAIR (findable, accessible, interoperable and reusable) and open benefits both for the data provider and future users.  In this webinar, we will discuss how making data FAIR and open has allowed us to develop smart and efficient data management workflows in the context of the [EMBRC EMO BON](https://www.embrc.eu/emo-bon/) (European Marine Omics Biodiversity Observation Network) project. By focusing on the interoperability and reusability of our (meta)data, codes, and analysis results, we can use the web itself to make our data findable and accessible. We will then present examples of metadata curation from EMBL’s Planetary biology flagship expedition [TREC](https://www.embl.org/about/info/trec/) (Traversing European Coastlines), an expedition to study coastal ecosystems and their response to the environment, from molecules to communities. We will see how one can go FAIR, Open and Smart by registering sample metadata at EMBL-EBI’s [BioSamples](https://www.ebi.ac.uk/biosamples/) service using checklists, controlled vocabularies and ontologies." ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2025-05-21 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2025-05-21 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Mastering data management: Go FAIR, Go Open, Go Smart — EMO BON and TREC showcases" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/mastering-data-management-go-fair-go-open-go-smart-emo-bon-and-trec-showcases> .

