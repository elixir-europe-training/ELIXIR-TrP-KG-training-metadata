<https://tess.elixir-europe.org/materials/microbiome-analysis-of-amplicon-sequencing> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Bioinformatician, Bioanalysts" ],
        [ a schema1:Audience ;
            schema1:audienceType "life science researchers" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "David Palecek" ],
        [ a schema1:Person ;
            schema1:name "Tania Aires" ] ;
    schema1:competencyRequired "Qiime2" ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2025-05-07"^^schema1:Date ;
    schema1:dateModified "2025-06-02"^^schema1:Date ;
    schema1:datePublished "2025-08-07"^^schema1:Date ;
    schema1:description """In a coral associated microbiome dataset, where we have two different coral species (with one incipient speciation) and two different reproductive strategies, we want to address the **following scientific questions**:\r
\r
1. Is the microbiome of these cold-water corals species-specific?\r
2. Is the microbiome related to the reproductive strategy?\r
3. Or is the microbiome shaped by both factors?""" ;
    schema1:educationalLevel "beginner" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.16530108" ;
    schema1:keywords "16S",
        "Microbiome",
        "Qiime2",
        "amplicon" ;
    schema1:learningResourceType "Tutorial" ;
    schema1:license <https://spdx.org/licenses/MIT.html> ;
    schema1:name "Microbiome Analysis of Amplicon Sequencing" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Pattern Institute" ;
            schema1:url <https://www.pattern.institute/training/> ] ;
    schema1:teaches "Introduce basic concepts to preprocess (QIIME2) and analyse (MicrobiomeAnalyst) microbiome data, in particular bacteria associated with cold-water corals." ;
    schema1:url <https://py-ualg.github.io/biohap/2025_spring/250507_taires.html> ;
    schema1:version "1.0.0" .

