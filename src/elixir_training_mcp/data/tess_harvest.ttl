<https://tess.elixir-europe.org/events/phenotyping-neurological-syndromes-for-systems-genetics> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "From data standards to analysis - an interdisciplinary course" ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Biologists, Genomicists, Computer Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Core Facility Managers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Clinical Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "database managers" ] ;
    schema1:description """Neurological syndromes from migraine to Alzheimer's disease are affecting an increasing number of people. Large, international consortia have formed around the various syndromes to unravel their genetic architecture by taking advantage of decreasing costs of sequencing.\r
\r
Clinical phenotyping is becoming a bottleneck in these collaborations as it requires the interplay of clinicians, medical informaticists and statistical geneticists, often in the absence of adequate funding. Neurological disorders present complex phenotypes with complex data acquisition and interpretation challenges.\r
\r
This EMBO Practical Course reflects on design of phenotyping sheets, data management and stewardship in the context of large neurological studies with respect to secondary use, integration of existing data, harmonization, ethical consideration and transferability as well as statistical considerations for their analysis.\r
\r
Participants should have been involved in such studies as we aim to select an interdisciplinary group for this course.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2018-10-10 09:00:00 UTC"^^schema1:Date ;
            schema1:funder [ a schema1:Organization ;
                    schema1:name "EMBO Courses and Workshops" ] ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Luxembourg" ;
                            schema1:addressLocality "Luxembourg" ;
                            schema1:addressRegion "Luxembourg" ;
                            schema1:streetAddress "Alvisse Parc Hotel****, 120, Route d'Echternach" ] ;
                    schema1:latitude "49.63993" ;
                    schema1:longitude "6.153912" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Roland Krause" ] ;
            schema1:startDate "2018-10-04 16:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Ontologies",
        "human disease" ;
    schema1:mentions [ a schema1:Thing ;
            schema1:name "Registration" ;
            schema1:url <https://www.conference-service.com/pc18-11/welcome.cgi> ] ;
    schema1:name "EMBO Practical Course: Phenotyping neurological syndromes for systems genetics" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "University of Luxembourg" ] ;
    schema1:url <http://meetings.embo.org/event/18-syndromes> .

