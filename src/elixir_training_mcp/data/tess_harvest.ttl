            schema1:url <http://www.mygoblet.org> ] ;
    schema1:url <https://www.mygoblet.org/training-portal/materials/tgacseqahead-ngs-current-challenges-and-data-analysis-plant-researchers> .

<https://tess.elixir-europe.org/materials/the-bioimage-archive-home-for-life-sciences-microscopy-data> a schema1:LearningResource ;
