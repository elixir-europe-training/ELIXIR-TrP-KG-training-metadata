<https://tess.elixir-europe.org/events/elixir-outreach-webinar-with-india-data-management-human-data-and-infectious-diseases-opportunities-for-engagement> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:description """\r
\r
This is the first joint webinar between ELIXIR, Asia Pacific Bioinformatics Interaction &amp; Networking Society (APbians) and RSG India. The aim is to provide an overview of ELIXIR data management and human data activities, as well as opportunities for engagement for Indian scientists. The webinar is openly accessible and we encourage anyone interested in the programme to register!\r
\r
This event will take place from 11:00 –13:30 (CEST) / 14:30 –17:00 (IST).\r
\r
The full programme is available on Google Drive and is as follows:\r
\r
\r
	\r
		\r
			Time\r
			Presentation\r
		\r
		\r
			11:00 / 14:30\r
			Andrew Smith, ELIXIR Head of External Relations\r
				ELIXIR Europe: overview and opportunities \r
		\r
		\r
			11:20 / 14:50\r
			Frederik Coppens, ELIXIR Belgium\r
				Research data management (RDM) in ELIXIR and insight into the RDM Toolkit\r
		\r
		\r
			11:40 / 15:10\r
			Shandar Ahmad, Professor, Jawaharlal Nehru University (JNU)\r
				Data accessibility, integration and management challenges for a Bioinformatics research lab in India\r
		\r
		\r
			12:00 / 15:30\r
			Break\r
		\r
		\r
			12:10 / 15:40\r
			Melissa Konopko, ELIXIR Scientific Project Manager\r
				Human genomic data-sharing infrastructure: challenges and opportunities\r
		\r
		\r
			12:30 / 16:00\r
			Katharina Lauer, ELIXIR Senior Scientific Coordinator for Infectious Diseases\r
				ELIXIR COVID-19 and infectious diseases activities\r
		\r
		\r
			12:50 / 16:20\r
			Arfa Jabin, President of RSG India\r
				Data accessibility and management challenges for bioinformatics students in India\r
		\r
		\r
			13:00 / 16:30\r
			Open Discussion\r
		\r
		\r
			13:30 / 17:00\r
			Close\r
		\r
	\r
""" ;
    schema1:endDate "2022-08-17 11:00:00 UTC"^^schema1:Date ;
