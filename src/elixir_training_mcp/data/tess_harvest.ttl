            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2022-04-26 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Cell signaling",
        "Computational simulations" ;
    schema1:name "Mathematical modelling as knowledge mapping in PhysiCell: a guided tour" ;
    schema1:provider [ a schema1:Organization ;
