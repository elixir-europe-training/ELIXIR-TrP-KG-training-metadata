            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Norway" ;
                            schema1:addressLocality "Oslo" ;
                            schema1:addressRegion "Oslo kommune" ;
                            schema1:postalCode "0373" ;
                            schema1:streetAddress "Ole-Johan Dahls hus, 23B, Gaustadalléen" ] ;
                    schema1:latitude "59.94362" ;
                    schema1:longitude "10.718329" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "ELIXIR UiO node" ] ;
            schema1:startDate "2019-06-03 10:00:00 UTC"^^schema1:Date ] ;
