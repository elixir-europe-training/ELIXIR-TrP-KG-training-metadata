<https://tess.elixir-europe.org/materials/train-the-trainer-integration-of-the-sex-and-gender-dimension-in-life-sciences-research-slides> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training Coordinators" ],
        [ a schema1:Audience ;
            schema1:audienceType "Researchers in Life Sciences" ],
        [ a schema1:Audience ;
            schema1:audienceType "Trainers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training Designers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training Organisers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Training instructors" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Davide Cirillo" ],
        [ a schema1:Person ;
            schema1:name "Àtia Cortés" ],
        [ a schema1:Person ;
            schema1:name "Mónica Cano Abadía" ] ;
    schema1:competencyRequired "No prerequisites required. " ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2023-06-28"^^schema1:Date ;
    schema1:datePublished "2023-07-25"^^schema1:Date ;
    schema1:description """Supporting slides used during the Train-the-Trainer course "Integration of the sex and gender dimension in life sciences research" that took place in the Barcelona Supercomputing Center (BSC) on 28th and 29th of June 2023.\r
\r
The slides include the agenda of the course, information about the handbook (to be published in Zenodo and linked in TeSS) and two activities 1) the discussion around sex and gender concepts, and 2) the red and green flags of "A day in the life of a PhD student in Life Sciences" with supporting documents to each situation.\r
\r
The inclusion of the sex and gender dimension in life sciences is increasingly promoted by the European Union to rethink standards and reference models for sex and gender representation in research projects. Thus, training biomedical researchers in this topic will increase their capacity to integrate the sex and gender dimension into their work, leading to more inclusive and impactful science.\r
\r
The course aimed to develop participants’ skills on how to introduce the sex and gender dimension into their training activities related to the life sciences.\r
\r
To guide participants in this endeavour, a set of methodological tools and case studies were provided by a group of experts in the field in order to illustrate a successful sex and gender integration into key Research and Innovation areas. \r
\r
The course was organised by the Bioinfo4Women programme of the Life Sciences Department at the Barcelona Supercomputing Center (BSC), BBMRI-ERIC, INB/ELIXIR-ES, EATRIS, and it has been funded by the 3rd EOSC-Life Training Open Call.""" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.8183681" ;
    schema1:keywords "EDI",
        "Training material",
        "design research",
        "dimension",
        "diversity",
        "equity",
        "gender",
        "inclusion",
        "life sciences",
        "research",
        "sex",
        "train-the-trainer",
        "training" ;
    schema1:learningResourceType "PDF" ;
    schema1:license <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;
    schema1:name "Train-the-Trainer | Integration of the sex and gender dimension in life sciences research - slides" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Barcelona Supercomputing Center (BSC)" ;
            schema1:url <http://www.bsc.es> ],
        [ a schema1:Organization ;
            schema1:name "ELIXIR Spain" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
    schema1:teaches """These are only supportive slides to complete the handbook (to be published in Zenodo and registered in TeSS). Both materials together would help to accomplish these learning objectives:\r
- Understand the appropriate applications of the terms “sex” and “gender” in biomedical research in training actions.\r
- Identify, understand, and think critically about complex aspects of sex and gender dimensions in biomedical research and how to communicate these in training activities. \r
- Identify how sex and gender categories affect the life sciences and their related trainings, and especially the research data generation, collection and use.\r
- Select, compile, and synthesize information that helps include the sex and gender dimension in research and integrate it into their training portfolio.\r
""" ;
    schema1:url <https://doi.org/10.5281/zenodo.8183681> .

