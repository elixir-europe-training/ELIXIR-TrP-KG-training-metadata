<https://tess.elixir-europe.org/events/introducing-the-new-uniprot-disease-portal> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Anna Swan" ;
    schema1:description "This webinar will provide an interactive introduction to the new UniProt Disease Portal: a single centralized resource of UniProt disease-centric information which has been developed with the help of our users to better serve the needs of the research community and facilitate protein discoverability." ;
    schema1:endDate "2020-10-29 16:30:00 UTC"^^schema1:Date ;
    schema1:keywords "HDRUK" ;
    schema1:name "Introducing the new UniProt Disease Portal" ;
    schema1:startDate "2020-10-29 15:30:00 UTC"^^schema1:Date ;
    schema1:url <http://www.ebi.ac.uk/training/events/2020/introducing-new-uniprot-disease-portal> .

<https://tess.elixir-europe.org/events/introducing-the-new-uniprot-disease-portal-52cd37dd-26e0-4550-84c6-a4f6f8303037> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0078>,
        <http://edamontology.org/topic_3336> ;
    schema1:description """This webinar will provide an interactive introduction to the new UniProt Disease Portal: a single centralised resource of UniProt disease-centric information which has been developed with the help of our users to better serve the needs of the research community and facilitate protein discoverability.

The UniProt knowledgebase (UniProtKB) supports biomedical research by providing a comprehensive, high-quality and freely accessible resource of protein sequence and functional information. To do this, UniProt integrates, interprets and standardises data from a range of sources including scientific literature, protein sequence analysis tools, other databases and automatic annotation systems to provide a detailed overview of the available protein knowledge.

This webinar will introduce you to the UniProt Disease Portal which aims to help researchers explore and access current genomic disease-related data from the UniProtKB database, but in a single centralised resource. The portal incorporates UniProt functional annotations, protein network visualisations, genomic variant and drug-related data, and organises in a way that allows users to easily visualise and compare data to identify similarities using variants, protein interactions, diseases, and drug data.

The Disease Portal is currently in its first beta release, so we hope that this interactive introduction will give you an understanding of how to access disease-centric protein data in UniProt and encourage your feedback to assist ongoing development of the Portal to further suit the requirements of our users.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2020-10-29 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:streetAddress ", " ] ] ;
            schema1:maximumAttendeeCapacity 200 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-10-29 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Proteins (proteins)",
        "UniProt Disease Portal",
        "UniProt: The Universal Protein Resource",
        "UniProtKB" ;
    schema1:name "Introducing the new UniProt Disease Portal" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "EMBL-EBI" ;
            schema1:url <http://www.ebi.ac.uk/training> ],
        [ a schema1:Organization ;
            schema1:name "European Bioinformatics Institute (EBI)" ;
            schema1:url <http://www.ebi.ac.uk> ] ;
    schema1:url <https://www.ebi.ac.uk/training/events/introducing-new-uniprot-disease-portal> .

<https://tess.elixir-europe.org/events/introducing-utap-user-friendly-transcriptome-analysis-pipeline> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3170> ;
    schema1:description """RNA-Seq (including bulk Mars-seq) technology is routinely used to characterize the transcriptome and detect gene expression differences among cell types, genotypes and conditions. In order to enable fast and user-friendly data analysis, we developed an intuitive and scalable transcriptome pipeline: UTAP that executes the full process on Weizmann computer cluster (WEXAC), starting from sequences and ending with a comprehensive report. The workshop includes a lecture regarding the analysis steps UTAP performs and a hands on session to run the pipeline and understand the outputs it produces.\r
\r
Registration is required and will open near the workshop date.\r
\r
First you need to register for the BBCU activities here:\r
http://bip.weizmann.ac.il/activbin/events\r
(click on the LogIn button) and then you need to register for the workshop. (click on the Register button)""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2019-09-09 16:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "Israel" ;
                            schema1:addressLocality "Rehovot" ;
                            schema1:addressRegion "Israel" ;
                            schema1:streetAddress "Feinberg Room B" ] ;
                    schema1:latitude "31.904506" ;
                    schema1:longitude "34.808341" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "Dr. Dena Leshkowitz" ] ;
            schema1:startDate "2019-09-09 13:30:00 UTC"^^schema1:Date ] ;
    schema1:name "Introducing UTAP: User-friendly Transcriptome Analysis Pipeline" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Israel" ;
            schema1:url <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/> ] ;
