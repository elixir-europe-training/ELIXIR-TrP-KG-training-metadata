<https://tess.elixir-europe.org/materials/secondary-metabolite-discovery> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0622> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Students" ] ;
