            schema1:organizer [ a schema1:Organization ;
                    schema1:name "European Bioinformatics Institute (EBI)" ] ;
            schema1:startDate "2020-09-02 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "Ensembl" ;
    schema1:name "Ensembl API workshop, University of Cambridge (Virtual)" ;
