            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Define the term ‘metadata’.
- Recall examples of community/domain standards that apply to data and metadata.""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/fair/tutorials/fair-metadata/tutorial.html> ;
    schema1:version "2" .

