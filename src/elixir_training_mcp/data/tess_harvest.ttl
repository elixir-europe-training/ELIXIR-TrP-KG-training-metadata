<https://tess.elixir-europe.org/events/principes-fair-pour-la-gestion-des-donnees-de-recherche-en-sciences-de-la-vie-edition-francilienne-session-1-mars> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "FAIR data Paris mars 2022" ;
    schema1:description """Présentation et application des principes FAIR de gestion des données dans un projet bioinformatique.\r
L’Institut Français de Bioinformatique (IFB) organise une formation à destination de bioinformaticiens, biologistes et médecins impliqués dans des projets d’analyse bioinformatique de jeux de données omiques et souhaitant mettre en œuvre les principes “FAIR” (Facile à trouver, Accessible, Interopérable, Réutilisable) tout au long du déroulement du projet. La formation abordera les différents points fondamentaux (théoriques, pratiques, juridiques) en lien avec la politique nationale d’ouverture des données de la recherche et présentera sous forme de séances pratiques les ressources nationales accessibles à la communauté scientifique ainsi que les solutions proposées par l’IFB pour gérer les données d’un projet de recherche.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2022-03-23 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "France" ;
                            schema1:addressLocality "Paris" ] ;
                    schema1:latitude "48.85889" ;
                    schema1:longitude "2.320041" ] ;
            schema1:maximumAttendeeCapacity 20 ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "IFB Core (https://www.france-bioinformatique.fr/), IFB-core ()" ] ;
            schema1:startDate "2022-03-22 09:00:00 UTC"^^schema1:Date ] ;
    schema1:name "Principes FAIR pour la gestion des données de recherche en sciences de la vie - édition Francilienne - Session 1 (mars)" ;
