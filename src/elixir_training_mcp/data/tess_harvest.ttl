            schema1:name "University of Tartu, Institute of Computer Science" ] ;
    schema1:teaches """Understands how to tell a story through data visualization\r
Knows what chart type to pick for different kinds of data\r
Knows what to pay attention to while designing a figure""" ;
    schema1:url <https://elixir.ut.ee/node/452> .

