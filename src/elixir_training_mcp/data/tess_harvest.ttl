            schema1:name "Associated Training Datasets" ;
            schema1:url <https://doi.org/10.5281/zenodo.8115178> ],
        [ a schema1:Thing ;
            schema1:name "FastQC" ;
            schema1:url <https://bio.tools/tool/fastqc> ] ;
    schema1:name "SARS-CoV-2 Viral Sample Alignment and Variant Visualization" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "GTN" ;
            schema1:url <https://training.galaxyproject.org/> ] ;
    schema1:teaches """- Gather and evaluate experimental evidence, including qualitative and quantitative data
- Generate and interpret graphs displaying experimental results
- Critique large data sets and use bioinformatics to assess genetics data
- Tap into the interdisciplinary nature of science""" ;
    schema1:url <https://training.galaxyproject.org/training-material/topics/sequence-analysis/tutorials/sars-with-galaxy-on-anvil/tutorial.html> ;
    schema1:version "2" .

