<https://tess.elixir-europe.org/materials/make-your-computational-workflows-findable-and-citable> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:author [ a schema1:Person ;
            schema1:name "Johan Gustafsson" ] ;
    schema1:dateCreated "2025-05-13"^^schema1:Date ;
    schema1:datePublished "2025-06-12"^^schema1:Date ;
    schema1:description """A recording online event focused on enabling computational workflow best practices with the use of WorkflowHub hosted by the ELIXIR Tools Platform and  Single Cell Omics community to present and explore concepts and functions that are broadly applicable to computational workflows.\r
Presented by Johan Gustafsson ([Australian BioCommons](https://www.biocommons.org.au/)).\r
![Australian BioCommons](https://images.squarespace-cdn.com/content/v1/5d3a4213cf4f5b00014ea1db/1689141619044-F67XDPQLP4PG6KY862VA/Australian-Biocommons-Logo-Horizontal-RGB.png?format=400w)""" ;
    schema1:keywords "FAIR",
        "WorkflowHub",
        "Workflows" ;
    schema1:learningResourceType "Recorded webinar" ;
    schema1:license <file:///home/runner/work/ELIXIR-TrP-KG-training-metadata/ELIXIR-TrP-KG-training-metadata/notspecified> ;
