<https://tess.elixir-europe.org/events/3rd-programmable-nucleases-crispr-cas9-transgenesis-course-ensembl-sessions> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:contact "Astrid Gall" ;
    schema1:description "Ensembl (www.ensembl.org) is an open access resource integrating genome, variation, comparative genomics and regulation data for over 100 vertebrate species including 16 mouse strains. These sessions are an introduction to the Ensembl genome browser and its mouse genomics resources as part of the '3rd Programmable nucleases (CRISPR/Cas9) – Transgenesis Course' in Prague, 16th – 20th April 2018." ;
    schema1:endDate "2018-04-17 12:00:00 UTC"^^schema1:Date ;
