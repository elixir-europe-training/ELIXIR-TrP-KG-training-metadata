<https://tess.elixir-europe.org/events/de-novo-assembly-of-transcriptomes-using-hpc-resources> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
