    schema1:name "Bulk RNASeq: from counts to differential expression" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Belgium" ;
            schema1:url <https://www.elixir-belgium.org/training> ],
        [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches """* Learn how RNA-seq reads are converted into counts\r
* Understand QC steps that can be performed on RNA-seq reads\r
* Generate interactive reports to summarize QC information with MultiQC\r
* Use the Galaxy Rule-based Uploader to import FASTQs from URLs\r
* Create a Galaxy Workflow that converts RNA-seq reads into counts""" ;
    schema1:url <https://training.vib.be/all-trainings/bulk-rnaseq-counts-differential-expression-3> .

