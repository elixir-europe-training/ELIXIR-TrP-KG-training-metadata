<https://tess.elixir-europe.org/events/bioschemas-adoption-meeting> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """Third meeting for the Bioschemas ELIXIR implementation study\r
	The ELIXIR Bioschemas project has 4 stages: planning, agreement, adoption and application. The topic of this third meeting is adoption. We expect data resources especially those part of the project to adopt and implement Bioschemas compliant markup. The main bioschemas types developed during this implementation study to be considered for adoption will be “Data repository”, “Datasets”, “Biological Entry”, “Beacons”, “Protein”, “Samples” and “Phenotypes”. We welcome data resources, especially external data resources, willing to evaluate during the meeting the adoption and implementation of bioschemas markup. We also welcome other groups in Bioschemas willing to push adoption of other content types like “Tools”, “Events” and “Training materials”.\r
\r
This day and a half meeting will\r
\r
\r
	Demonstrate through examples the usage of the Bioschemas specifications\r
	Develop markup for a wider set of resources\r
	Identify revisions to the Bioschemas specifications to enable their uptake for a wide range of biological resources.\r
""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2017-10-04 12:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:streetAddress "Wellcome Genome Campus" ] ;
                    schema1:latitude "52.078533" ;
                    schema1:longitude "0.186135" ] ;
            schema1:startDate "2017-10-02 11:45:00 UTC"^^schema1:Date ] ;
    schema1:name "Bioschemas Adoption Meeting" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR" ;
            schema1:url <https://www.elixir-europe.org/> ] ;
    schema1:url <https://www.elixir-europe.org/events/bioschemas-adoption-meeting> .

<https://tess.elixir-europe.org/events/bioschemas-agreement-meeting> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description """On Wednesday 24 May we expect to recap the objectives and outcomes of the project and update on progress made during/after the previous meeting.\r
\r
On Thursday 25 May we will work in groups to finalise a first draft of our bioschemas types. We will also revise dependencies and relationship among our types and how this could affect our schema proposals.\r
\r
On Friday 26 May we will devise action plans for implementing the provisional agreement and we will discuss priority activities for 2018.""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
