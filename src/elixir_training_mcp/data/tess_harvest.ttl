            schema1:organizer <https://ror.org/002n09z45> ;
            schema1:startDate "2025-05-20 09:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "API",
        "high-performance computing",
        "programming",
        "torsten schwede &amp; thierry sengstag group",
        "training" ;
    schema1:name "First Steps in Parallelization with OpenMP" ;
    schema1:provider <https://ror.org/002n09z45> ;
    schema1:url <https://www.sib.swiss/training/course/20250520_OPEMP> .

