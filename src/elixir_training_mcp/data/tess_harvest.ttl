<https://tess.elixir-europe.org/events/introductory-bioinformatics-q-a-session-genes-and-gene-expression> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description """This Q&amp;A (question and answer) webinar will provide an opportunity for anyone who has completed [Introductory bioinformatics: a curated set of EMBL-EBI online courses](https://www.ebi.ac.uk/training/online/courses/introductory-bioinformatics-pathway/) to join some of EMBL-EBI's experts and ask their own questions. This session will focus on genes and gene expression, including the EMBL-EBI resources Ensembl and Expression Atlas.

The questions covered during the Q&amp;A webinar will depend on those asked by attendees, however we will likely cover topics such as:

- Browsing genomes with Ensembl
- Discovering gene expression data with Expression Atlas
- Data management of biological data and open data
- Finding the right EMBL-EBI resource""" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "online" ;
            schema1:endDate "2022-10-05 17:00:00 UTC"^^schema1:Date ;
