<https://tess.elixir-europe.org/events/introduction-to-exploratory-data-analysis-eda-with-r> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Post Docs" ],
        [ a schema1:Audience ;
