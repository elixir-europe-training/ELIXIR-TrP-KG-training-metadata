<https://tess.elixir-europe.org/events/uk-conference-of-bioinformatics-and-computational-biology-2020> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_3172> ;
    schema1:alternateName "Bringing together researchers, software developers and data managers working across the life sciences to share ideas, discoveries, tools and best practice in computational methods." ;
    schema1:contact "Training@earlham.ac.uk" ;
    schema1:description """The UK-CBCB conference is designed to bring together biologists, bioinformaticians, computer scientists, software engineers and data scientists across the life sciences to share innovations, applications and best practice in their fields.\r
\r
The conference will be applicable to bioinformatics researchers working on core services or in research teams as well as computer scientists or bioinformaticians developing tools or maintaining data resources.\r
""" ;
    schema1:eligibility "registration_of_interest" ;
    schema1:endDate "2020-09-30 17:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:hostInstitution "Earlham Institute" ;
    schema1:keywords "Bioinformatics",
        "Metabolomics",
        "Microbial evolution",
        "Single Cell Genomics",
        "life sciences" ;
    schema1:name "UK Conference of Bioinformatics and Computational Biology 2020" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "Earlham Institute" ] ;
    schema1:startDate "2020-09-29 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.earlham.ac.uk/uk-conference-bioinformatics-and-computational-biology-2020> .

<https://tess.elixir-europe.org/events/uk-conference-of-bioinformatics-and-computational-biology-uk-cbcb-2022> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:alternateName "How to manage biological data and use computational methods to power life science research" ;
    schema1:contact """\r
training@earlham.ac.uk""" ;
    schema1:description """Modern life science research is increasingly reliant on data science, and a failure to keep pace with computational methods will leave UK life science research treading water.\r
\r
In partnership with ELIXIR-UK, the UK-CBCB conference will cover the breadth of biological data management, analysis and sharing.\r
\r
This three-day event will combine a keynote lecture with presentations of use cases from researchers working at the cutting edge, plus breakout discussion groups where participants can exchange expertise and challenges with one another, working to provide multidisciplinary solutions to complex problems together.\r
\r
In order to maximise engagement across multiple disciplines in this online event, we have opted for a streamlined programme (no parallel sessions), short introductory talks and targeted breakout discussion groups to focus on particular challenges underpinned by a biological question. There will be numerous breakout discussions in each themed session, based upon the flash presentations from our research facilitators.\r
\r
The confirmed themes for this event are:\r
\r
Bioimaging and Artificial Intelligence\r
Structural Bioinformatics\r
Metagenomics and Microbial Bioinformatics\r
Spatial Transcriptomics\r
Federated Analytics/Learning\r
Open Science\r
Sex and Gender Bias in Computational Disciplines""" ;
    schema1:endDate "2022-09-29 17:00:00 UTC"^^schema1:Date ;
    schema1:event_types "meetings_and_conferences" ;
    schema1:hostInstitution "Earlham Institute" ;
    schema1:name "UK Conference of Bioinformatics and Computational Biology (UK-CBCB) 2022" ;
    schema1:organizer [ a schema1:Organization ;
            schema1:name "Earlham Institute" ] ;
    schema1:startDate "2022-09-27 09:00:00 UTC"^^schema1:Date ;
    schema1:url <https://www.earlham.ac.uk/uk-cbcb-2022> .

