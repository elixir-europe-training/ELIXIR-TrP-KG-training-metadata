            schema1:url <https://www.youtube.com/watch?v=uxs-4Nn8Vh8&t=4527s> ],
        [ a schema1:Thing ;
            schema1:name "link to instance map tool" ;
            schema1:url <https://instance-maps.stage.sevenpastnine.com/> ] ;
    schema1:name "Hackathon on the NanoCommons Instance map tool" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "NanoCommons" ;
