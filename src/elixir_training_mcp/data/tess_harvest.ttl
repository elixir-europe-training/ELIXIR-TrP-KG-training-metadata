<https://tess.elixir-europe.org/events/cancer-genomics-7664850b-6647-4f9d-a30b-4ec772e79fb2> a schema1:Event ;
    dct:conformsTo <https://bioschemas.org/profiles/Event/0.2-DRAFT-2019_06_14> ;
    schema1:about <http://edamontology.org/topic_0091> ;
    schema1:description "This conference will provide an opportunity to learn about and keep up to date with the rapidly progressing area of cancer genomics. It will cover presentations from cancer genome projects, the areas of cancer functional genomics, systems biology, cancer mouse models and the translation and clinical impact of scientific results obtained. The meeting will bring together leading scientists from across these areas for a unique opportunity to interact and stimulate further integration of these efforts." ;
