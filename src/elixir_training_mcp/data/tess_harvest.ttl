<https://tess.elixir-europe.org/events/biophysics-summer-school-2025> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:alternateName "Pattern Formation and Developmental Processes" ;
    schema1:audience [ a schema1:Audience ;
