                            schema1:addressLocality "Zwijnaarde" ;
                            schema1:postalCode "9052" ;
                            schema1:streetAddress "Ghent - VIB/UGent FSVM II, Technologiepark 75" ] ;
                    schema1:latitude "51.000392" ;
                    schema1:longitude "3.71677" ] ;
            schema1:organizer [ a schema1:Organization ;
                    schema1:name "VIB" ] ;
            schema1:startDate "2025-10-23 09:00:00 UTC"^^schema1:Date ] ;
    schema1:inLanguage "en" ;
    schema1:keywords "ELIXIR",
        "advanced bioinformatics",
        "programming",
        "research data management" ;
    schema1:name "Introduction to Docker and Apptainer: reproducible and automated data analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "VIB Training" ;
            schema1:url <https://training.vib.be/> ] ;
    schema1:teaches "“Build a Docker image”",
        "“Indicate the difference between Docker & Apptainer containers”",
        "“Pull Docker images as an Apptainer (Singularity) image”",
        "“Pull and push Docker image to/ from Docker Hub”",
        "“Run Apptainer images on HPC”",
        "“Run a Docker image while working with volumes and ports”",
        "“Write a Docker recipe”" ;
    schema1:url <https://training.vib.be/all-trainings/introduction-docker-and-apptainer-reproducible-and-automated-data-analysis> .

