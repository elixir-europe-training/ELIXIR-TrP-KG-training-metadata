<https://tess.elixir-europe.org/materials/how-to-create-a-concept-for-the-sphn-dataset> a schema1:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    schema1:about <http://edamontology.org/topic_3063>,
        <http://edamontology.org/topic_3071>,
        <http://edamontology.org/topic_3316>,
        <http://edamontology.org/topic_4012> ;
    schema1:audience [ a schema1:Audience ;
            schema1:audienceType "Data Managers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Ontologists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Biomedical researchers" ],
        [ a schema1:Audience ;
            schema1:audienceType "Data Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Research Scientists" ],
        [ a schema1:Audience ;
            schema1:audienceType "Bioinformaticians" ] ;
    schema1:author [ a schema1:Person ;
            schema1:name "Kristin Gnodtke" ],
        [ a schema1:Person ;
            schema1:name "Personalized Health Informatics Group" ] ;
    schema1:contributor [ a schema1:Person ;
            schema1:name "Sabine Österle" ] ;
    schema1:creativeWorkStatus "active" ;
    schema1:dateCreated "2022-11-08"^^schema1:Date ;
    schema1:dateModified "2022-11-08"^^schema1:Date ;
    schema1:datePublished "2022-11-08"^^schema1:Date ;
    schema1:description """How to create a concept for the SPHN Dataset is a training that was developed in the context of the [Swiss Personalized Health Network (SPHN)](https://sphn.ch) initiative and is part of a series of trainings centred around the SPHN Interoperability Framework developed by the SPHN Data Coordination Center (DCC). The framework aims to facilitate collaborative research by providing a decentralized infrastructure based on a strong semantic layer (SPHN dataset) and implemented through an RDF-based graph technology for data exchange and storage.\r
\r
The SPHN Dataset contains all SPHN concepts, their general and contextualized descriptions, value sets and information about the connected semantic standards. The training explains the principles applied in the development of the concepts and illustrates the individual steps with a practical example. After the training, you will be able to develop new concepts for the SPHN Dataset or for your project Dataset, following the guiding principles of concept design.\r
\r
__Prerequisites:__\r
\r
-	Basic knowledge of SNOMED CT.\r
\r
__After the training you will be able to:__\r
\r
-	Create a concept following the SPHN guiding principles of concept design.\r
\r
__Resources:__\r
\r
All resources are available on the [training's GitLab space](https://git.dcc.sib.swiss/sphn-semantic-framework/sphn-training-material/-/tree/master/How%20to%20create%20concepts%20for%20the%20SPHN%20Dataset#how-to-create-a-concept-for-the-sphn-dataset)""" ;
    schema1:educationalLevel "beginner" ;
    schema1:keywords "Clinical data",
        "Concepts design",
        "Conceptualization",
        "FAIR",
        "Ontology",
        "SNOMED CT",
        "Semantic Framework",
        "Semantic inheritance" ;
    schema1:learningResourceType "E-Learning",
        "Video" ;
    schema1:license <https://spdx.org/licenses/CC-BY-NC-SA-4.0.html> ;
    schema1:name "How to create a concept for the SPHN Dataset" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "ELIXIR Switzerland" ;
            schema1:url <http://www.sib.swiss/training/> ],
        <https://ror.org/002n09z45> ;
    schema1:url <https://sphn.ch/training/create-a-concept-for-sphn-dataset/> .

