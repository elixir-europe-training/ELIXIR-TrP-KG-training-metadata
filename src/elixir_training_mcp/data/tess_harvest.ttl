<https://tess.elixir-europe.org/events/intro-to-rna-seq-analysis> a schema1:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    schema1:description "High-throughput RNA-sequencing is now the standard technique for quantifying transcript abundance in a biological sample of interest. In this course we will describe the processes that take place once you submit a library for RNA sequencing. We will describe the steps involved to go from sequencing counts to a list of genes that show statistically significant differences between your biological conditions of interest. Practical sessions will use the user-friendly Degust interface (https://degust.erc.monash.edu/) to demonstrate tasks such as quality control and assessing differential expression. We will also showcase some web sites you can use for enrichment and pathways analysis" ;
    schema1:hasCourseInstance [ a schema1:CourseInstance ;
            dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
            schema1:courseMode "onsite" ;
            schema1:endDate "2022-09-12 17:00:00 UTC"^^schema1:Date ;
            schema1:location [ a schema1:Place ;
                    schema1:address [ a schema1:PostalAddress ;
                            schema1:addressCountry "United Kingdom" ;
                            schema1:addressLocality "Sheffield, or online" ;
                            schema1:postalCode "S10 2HQ" ;
                            schema1:streetAddress "Barber House Boardroom (Sheffield), or ONLINE" ] ] ;
            schema1:startDate "2022-09-12 13:00:00 UTC"^^schema1:Date ] ;
    schema1:keywords "NGS",
        "RNA-seq",
        "bioinformatics" ;
    schema1:name "Intro to RNA-Seq Analysis" ;
    schema1:provider [ a schema1:Organization ;
            schema1:name "Sheffield Bioinformatics Core" ;
            schema1:url <http://sbc.shef.ac.uk//training/> ] ;
    schema1:url <http://sbc.shef.ac.uk/training/rna-seq-introduction-online-2022-09-12> .

